{
  "name": "kyde-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "qa:spell": "cspell \"src/pages/**/*.astro\" \"src/components/**/*.astro\" --no-progress",
    "qa:links": "lychee --root-dir \"$PWD/dist\" --no-progress --exclude 'formspree\\.io' 'dist/**/*.html'",
    "qa:html": "html-validate 'dist/**/*.html'",
    "qa:i18n": "node scripts/i18n-drift.mjs",
    "qa:placeholders": "node scripts/no-placeholders.mjs",
    "qa": "./scripts/qa.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.39.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.5",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "cspell": "^10.0.0",
    "html-validate": "^10.11.3",
    "playwright-core": "^1.61.1",
    "satori": "^0.33.4"
  }
}
