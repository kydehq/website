---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import LegalNotice from '../components/LegalNotice.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://kyde.com/" },
    { "@type": "ListItem", position: 2, name: "Resources", item: "https://kyde.com/resources/" },
    { "@type": "ListItem", position: 3, name: "AI Agent Governance", item: "https://kyde.com/ai-agent-governance/" },
  ],
};

const faqs = [
  {
    q: "What is the difference between AI safety and AI governance?",
    a: "AI safety is about the model: whether it behaves predictably, avoids harmful outputs and follows instructions reliably. AI governance is about the deployment: what the system is allowed to do, who authorized it and whether that can be shown later. A safe model deployed without governance can still create compliance risk, and a well-governed deployment of an imperfect model is easier to control and review."
  },
  {
    q: "Does AI governance require changes to existing agents?",
    a: "Usually not, if the governance layer runs outside the agent. A gateway that sits in the path of the agent's model and tool calls can be added by changing an endpoint, often a single environment variable, or by a network routing rule. The agent's code stays the same."
  },
  {
    q: "Can't I just govern agents through the application layer, prompt templates, output validation, guardrails?",
    a: "Application-level controls are worth having, but they are not enough on their own. They can be weakened by prompt injection or model updates, they live in the same system as the agent, and the evidence they produce sits in the stack being examined. A layer outside the agent avoids those problems and keeps a record that does not depend on the application."
  },
  {
    q: "What is a behavioral firewall for AI agents?",
    a: "The term is sometimes used for a layer between an agent and the systems or models it calls, which allows actions within the agent's scope and blocks the rest before they execute. It differs from content filters, which inspect what goes in and out, because it governs what the agent is permitted to do. In Kyde Control, every allowed and blocked action routed through the gateway is also written to a tamper-evident record, and each agent has its own identity so actions can be attributed."
  },
  {
    q: "How does MCP (Model Context Protocol) affect AI agent governance?",
    a: "MCP gives agents a standard way to connect directly to databases, APIs, file systems and SaaS tools. That widens what an agent can do and removes the application layer that used to act as an informal checkpoint. A governance layer therefore needs to see and apply policy to MCP tool calls, not only to model calls, or it will miss much of what the agent does."
  },
  {
    q: "Who in the enterprise owns AI agent governance?",
    a: "Ownership is usually shared between the CISO (security and risk), legal and compliance (regulation and liability) and the AI or IT team (implementation). Which function leads often depends on the main regulatory driver, such as the EU AI Act, DORA or GDPR. In many regulated companies, security or compliance starts the process because the risk sits with them, and the AI team implements it."
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
