              <div class="space-y-2">
                {[
                  "NIST AI RMF, CI Profile",
                  "EU AI Act, Annex III, Art. 12 &amp; 14",
                  "NIS-2, Essential entities",
                                    "KRITIS, OT/ICS layer",
                ].map((r) => (
                  <p class="font-mono text-xs text-ink-1">{r}</p>
                ))}
              </div>
            </div>
            <div class="border border-line-0 bg-bg-1 p-6 space-y-3">
