---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

type ExampleLine = { text: string; cls: string };
type Input = { num: string; label: string; desc: string; example: ExampleLine[] | null };

const inputs: Input[] = [
  {
    num: "01",
    label: "Identity",
    desc: "Is this a known agent, attributable, operating under a defined role? Self-hosted agents get a cryptographic identity per instance. Cloud-executed agents bind to credentials and connector authorizations the enterprise actually issued — enforceable and revocable.",
    example: null,
  },
  {
    num: "02",
    label: "Mandate",
    desc: "Every agent has a declared purpose. The firewall scores actions against it. A support connector that initiates a bulk export has violated its mandate — a fact, established at the boundary, requiring no interpretation of inner state.",
    example: [
      { text: "Declared purpose:  customer_support · read:tickets, send:messages", cls: "text-[#0a7c4e]" },
      { text: "Attempted action:  export:all_contacts",                           cls: "text-[#c00000]" },
      { text: "→ Mandate violation · Blocked · Score updated to 72",             cls: "text-[#666]"    },
    ],
  },
  {
    num: "03",
    label: "Baseline",
    desc: "How does current activity compare with this agent's own established pattern — call volumes, endpoint sequences, cost profiles, timing? Drift is the earliest observable signal of compromise or goal hijacking, visible before any single action looks wrong.",
    example: null,
  },
  {
    num: "04",
    label: "Benchmark",
    desc: "How does this agent compare with anonymized peers in the same role class across the network? An outlier among hundreds of comparable agents deserves scrutiny even when its own history is clean. Role classes matter: CRM agents and coding agents have structurally different baselines.",
    example: null,
  },
];
---

<Base
  title="KYDE Trust Score™ — The Independence Rating for Autonomous AI"
  description="Behavioral scoring for AI agents computed at the boundary — the only metric that exists identically across every provider, because it's computed from what agents do, not what vendors report."
>
  <Navbar />
  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative bg-[#0d0e10] overflow-hidden min-h-screen flex flex-col justify-center pt-24 pb-20">
      <div class="absolute inset-0 bg-grid opacity-[0.06] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 w-full">
        <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">

          <!-- Copy -->
          <div>
            <div class="flex items-center gap-2 mb-8">
              <span class="font-mono text-[10px] uppercase tracking-widest text-white/30 border border-dotted border-white/15 px-3 py-1">Product</span>
              <span class="font-mono text-[10px] text-white/20">·</span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-[#fcb830]/80 border border-dotted border-[#fcb830]/30 px-3 py-1">Trust Score™</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.05] mb-6">
              The Independence Rating for Autonomous AI.
            </h1>
            <p class="text-lg text-white/55 leading-relaxed max-w-lg mb-10">
              Behavioral scoring computed at the boundary — the only point where every agent from every provider is measurable in the same currency.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 mb-8">
              <button
                onclick="openModal()"
                class="inline-flex items-center gap-2 bg-white text-[#0d0e10] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#dae4e5] transition-all"
              >
                Start Enterprise Sandbox →
              </button>
              <a
                href="mailto:hello@kyde.com"
                class="inline-flex items-center gap-2 border border-dotted border-white/25 text-white/60 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-white/60 hover:text-white/90 transition-all"
              >
                Partner as Underwriter →
              </a>
            </div>
            <p class="font-mono text-xs text-white/20 uppercase tracking-widest">EU AI Act · NIS-2 · DORA · Insurance-ready</p>
          </div>

          <!-- Score mockup -->
          <div class="border border-white/10 bg-white/[0.03] p-6 md:p-8">
            <div class="flex items-start justify-between mb-5 pb-5 border-b border-white/8">
              <div>
                <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/30 mb-1">KYDE Trust Score™</p>
                <p class="font-mono text-[10px] text-white/20">agent:CRM-Sales-04 · Acme Corp</p>
              </div>
              <div class="text-right">
                <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/30 mb-1">Coverage</p>
                <p class="font-mono text-xl font-bold text-[#0a7c4e]">92%</p>
              </div>
            </div>

            <div class="flex items-end gap-4 mb-8">
              <p class="font-mono text-7xl md:text-8xl font-bold text-white leading-none tracking-tighter">84</p>
              <div class="pb-2">
                <p class="font-mono text-sm text-white/20">/100</p>
                <p class="font-mono text-[10px] text-[#fcb830] uppercase tracking-widest mt-1">Above median</p>
              </div>
            </div>

            <div class="space-y-3.5 mb-6">
              {[
                { label: "Identity",   pct: 95, note: "Verified · Ed25519"       },
                { label: "Mandate",    pct: 72, note: "1 boundary deviation"     },
                { label: "Baseline",   pct: 88, note: "Within normal range"      },
                { label: "Benchmark",  pct: 91, note: "Above role-class median"  },
              ].map(({ label, pct, note }) => (
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-mono text-[10px] uppercase tracking-widest text-white/40">{label}</span>
                    <span class="font-mono text-[10px] text-white/25">{note}</span>
                  </div>
                  <div class="h-1 bg-white/8 rounded-full overflow-hidden">
                    <div class="h-full rounded-full bg-[#0a7c4e]/70" style={`width:${pct}%`}></div>
                  </div>
                </div>
              ))}
            </div>

            <div class="border-t border-white/8 pt-4 space-y-2.5">
              <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/20 mb-3">Live activity</p>
              {[
                { action: "bulk_export initiated",   result: "Blocked · mandate violation",  warn: true  },
                { action: "crm.query completed",     result: "Signed · score stable",        warn: false },
                { action: "slack.send completed",    result: "Signed · within scope",        warn: false },
              ].map(({ action, result, warn }) => (
                <div class="flex items-center justify-between gap-4">
                  <span class="font-mono text-[10px] text-white/30 truncate">{action}</span>
                  <span class={`font-mono text-[9px] shrink-0 ${warn ? 'text-[#c00000]' : 'text-[#0a7c4e]'}`}>{result}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ THE PATTERN ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-[#999] mb-12">The pattern that keeps repeating</p>

        <div class="relative">
          <div class="absolute top-5 left-5 right-5 h-px bg-[#0d0e10]/8 hidden md:block"></div>
          <div class="grid md:grid-cols-4 gap-8 md:gap-6">
            {[
              { era: "1860s", name: "Steam Boilers",  signal: "Inspection records", outcome: "Insurance made industrialization safe"        },
              { era: "1950s", name: "Credit Scores",  signal: "Payment history",    outcome: "Lending scaled beyond personal acquaintance" },
              { era: "2000s", name: "Telematics",     signal: "Driving behavior",   outcome: "Risk priced from data, not proxies"           },
              { era: "Now",   name: "AI Agents",      signal: "Boundary behavior",  outcome: "Trust Score™ — the denominator"              },
            ].map(({ era, name, signal, outcome }, i) => (
              <div class="relative">
                <div class={`w-10 h-10 rounded-full border-2 flex items-center justify-center mb-5 bg-white z-10 relative ${i === 3 ? 'border-[#0d0e10]' : 'border-[#0d0e10]/20'}`}>
                  <span class="font-mono text-[9px] font-bold text-[#0d0e10]">{`0${i+1}`}</span>
                </div>
                <p class="font-mono text-[10px] text-[#bbb] uppercase tracking-widest mb-2">{era}</p>
                <p class={`font-bold text-sm mb-2 ${i === 3 ? 'text-[#0d0e10]' : 'text-[#444]'}`}>{name}</p>
                <p class="text-xs text-[#999] mb-2">Signal: {signal}</p>
                <p class="text-xs text-[#666] leading-snug">{outcome}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-12 border-l-2 border-[#0d0e10]/15 pl-6 max-w-3xl">
          <p class="text-base text-[#444] leading-relaxed">
            Behavior has never been the fallback for when intentions are unavailable. It is the only thing that has ever been scored. No credit score reads a borrower's intentions. The telematics box doesn't know what the driver was thinking. It doesn't need to.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ FOUR INPUTS ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-24 bg-[#f1f3f5]">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-500 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ What the score is computed from</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0e10] leading-tight mb-4 max-w-2xl">
          Four inputs. All behavioral. All verifiable at the boundary.
        </h2>
        <p class="text-[#555] leading-relaxed mb-14 max-w-2xl">
          No access to the agent's reasoning required. No reliance on any provider's word.
        </p>

        <div class="space-y-px">
          {inputs.map(({ num, label, desc, example }) => (
            <div class="grid md:grid-cols-[220px_1fr] divide-y md:divide-y-0 md:divide-x divide-dotted divide-[#0d0e10]/12 border border-dotted border-[#0d0e10]/12 bg-white">
              <div class="p-6 md:p-8 flex flex-col justify-center">
                <span class="font-mono text-xs text-[#fcb830] bg-[#fcb830]/10 px-2 py-0.5 mb-3 inline-block w-fit">{num}</span>
                <p class="text-xl font-bold text-[#0d0e10]">{label}</p>
              </div>
              <div class="p-6 md:p-8">
                <p class="text-sm text-[#444] leading-relaxed">{desc}</p>
                {example && (
                  <div class="mt-5 border border-dotted border-[#0d0e10]/12 bg-[#f9fafb] p-4 font-mono text-xs space-y-1">
                    {example.map(({ text, cls }) => (
                      <p class={cls}>{text}</p>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ COVERAGE ARCHITECTURE ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-400 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Coverage — the number behind the number</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0e10] leading-tight mb-4 max-w-2xl">
          A score without a denominator is a claim, not a fact.
        </h2>
        <p class="text-[#555] leading-relaxed mb-14 max-w-2xl">
          Every KYDE Trust Score ships with a coverage figure. Coverage 89% and Coverage 42% are different facts wearing the same number.
        </p>

        <!-- Architecture flow -->
        <div class="grid md:grid-cols-[1fr_40px_1fr_40px_1fr] gap-0 items-stretch mb-12">
          <div class="border border-dotted border-[#0d0e10]/12 bg-[#f9fafb] p-6 md:p-8">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#bbb] mb-4">Dark</p>
            <p class="font-semibold text-[#666] mb-5">Vendor-internal</p>
            <ul class="space-y-2.5 mb-6">
              {["Intra-cloud reasoning", "Sub-agent delegation", "Vendor-native connectors"].map(item => (
                <li class="text-xs text-[#999] flex items-center gap-2">
                  <span class="h-px w-3 bg-[#ccc] shrink-0"></span>{item}
                </li>
              ))}
            </ul>
            <span class="font-mono text-[10px] text-[#bbb] border border-dotted border-[#0d0e10]/10 px-2 py-1 inline-block">Quantified in Coverage Report</span>
          </div>

          <div class="hidden md:flex items-center justify-center text-[#ccc] font-mono text-base">→</div>

          <div class="border-2 border-[#4472c4] bg-white p-6 md:p-8 md:-my-2">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#4472c4] mb-4">KYDE Gateway · Boundary</p>
            <p class="font-semibold text-[#0d0e10] mb-5">The interception layer</p>
            <ul class="space-y-2.5 mb-6">
              {["Intercept · verify identity", "Score against mandate", "Sign & chain to ledger", "Enforce or block"].map(item => (
                <li class="text-xs text-[#444] flex items-center gap-2">
                  <svg class="h-3 w-3 shrink-0 text-[#4472c4]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
            <span class="font-mono text-[10px] text-[#4472c4] border border-dotted border-[#4472c4]/40 px-2 py-1 inline-block">Full telemetry · Full enforcement</span>
          </div>

          <div class="hidden md:flex items-center justify-center text-[#ccc] font-mono text-base">→</div>

          <div class="border border-dotted border-[#0a7c4e]/30 bg-[#0a7c4e]/5 p-6 md:p-8">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#0a7c4e] mb-4">Governed</p>
            <p class="font-semibold text-[#333] mb-5">Your systems</p>
            <ul class="space-y-2.5 mb-6">
              {["APIs & databases", "MCP servers", "Internal services", "SaaS endpoints"].map(item => (
                <li class="text-xs text-[#555] flex items-center gap-2">
                  <svg class="h-3 w-3 shrink-0 text-[#0a7c4e]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
            <span class="font-mono text-[10px] text-[#0a7c4e] border border-dotted border-[#0a7c4e]/30 px-2 py-1 inline-block">Protected · Score-contributing</span>
          </div>
        </div>

        <div class="border-l-2 border-[#0d0e10]/15 pl-6 max-w-3xl">
          <p class="text-sm text-[#444] leading-relaxed">
            The EU AI Act and NIS-2 demand traceability of actions with effect — not thought protocols. The action layer carries the liability. That layer is ours, completely.
          </p>
        </div>

      </div>
    </section>

    <!-- ══════════ DEPLOY ══════════ -->
    <section class="bg-[#0d0e10] border-t border-white/5 py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">

          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-white/35 mb-4">↳ Deployment</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-6">
              One variable.<br />Everything governed.
            </h2>
            <p class="text-white/50 leading-relaxed mb-8">
              Point any agent at the proxy. No SDK. No code changes. No framework dependency. The Behavioral Firewall intercepts every inference call — and starts computing the Trust Score — from that moment forward.
            </p>
            <ul class="space-y-2.5">
              {[
                "Under 100ms target latency",
                "Every provider — OpenAI, Anthropic, Gemini, local models",
                "MCP-ready",
                "Group Policy for enterprise-wide rollout without developer action",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-white/50">
                  <svg class="h-4 w-4 shrink-0 text-[#0a7c4e] mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="border border-white/10">
            <div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-[#c00000]/40"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#fcb830]/40"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#0a7c4e]/40"></span>
              <span class="ml-2 font-mono text-[10px] text-white/20">terminal</span>
            </div>
            <div class="p-6 font-mono text-sm leading-loose">
              <p class="text-white/30"><span class="text-[#0a7c4e]">$</span> export OPENAI_BASE_URL=https://kyde.intranet/v1</p>
              <p class="text-white/30"><span class="text-[#0a7c4e]">$</span> kyde fleet init</p>
              <p class="text-[#4472c4]">✓ Gateway active · Trust Score™ initialized</p>
              <p class="text-[#4472c4]">✓ Ed25519 ledger started</p>
              <p class="text-white/30 mt-2"><span class="text-[#0a7c4e]">$</span> kyde fleet status</p>
              <p class="text-[#0a7c4e]">✓ 14 agents · Coverage: 94% · Score: 87</p>
              <p class="text-white/15 text-xs mt-1"># All traffic intercepted, scored, and cryptographically signed</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ NETWORK MOAT ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-400 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Why the network makes the score</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0e10] leading-tight mb-14 max-w-2xl">
          Vendors grade their own homework.<br />We grade behavior.
        </h2>

        <div class="grid md:grid-cols-3 gap-6 mb-8">
          {[
            {
              who: "Model providers",
              can: "See agents on their own models only.",
              cannot: "Be the neutral scorer of their own outputs. No bank rates its own bonds.",
            },
            {
              who: "Single enterprises",
              can: "See their own fleet only.",
              cannot: "Benchmark against peers or establish role-class baselines at scale.",
            },
            {
              who: "Vendor consortia",
              can: "Aggregate logs.",
              cannot: "Normalize them. Anthropic, Microsoft, and Google have different schemas, different definitions — each grades itself.",
            },
          ].map(({ who, can, cannot }) => (
            <div class="border border-dotted border-[#0d0e10]/15 p-8 bg-white">
              <p class="font-mono text-xs uppercase tracking-widest text-[#0d0e10] mb-6">{who}</p>
              <p class="text-sm text-[#555] mb-4 flex items-start gap-2">
                <span class="font-mono text-[9px] text-[#0a7c4e] bg-[#0a7c4e]/8 px-1.5 py-0.5 shrink-0 mt-0.5 uppercase tracking-widest">Can</span>
                {can}
              </p>
              <p class="text-sm text-[#555] flex items-start gap-2">
                <span class="font-mono text-[9px] text-[#c00000] bg-[#c00000]/6 px-1.5 py-0.5 shrink-0 mt-0.5 uppercase tracking-widest">Cannot</span>
                {cannot}
              </p>
            </div>
          ))}
        </div>

        <div class="border border-dotted border-[#fcb830]/50 bg-[#fcb830]/5 p-8">
          <p class="text-lg font-semibold text-[#0d0e10] leading-snug max-w-3xl">
            The one point where every agent from every provider is measurable in the same currency is the boundary where actions meet the world. We provide the only independent measurement that exists identically across all of them.
          </p>
        </div>

      </div>
    </section>

    <!-- ══════════ TRAJECTORY ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-24 bg-[#f1f3f5]">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-500 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Where the score goes</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white border border-dotted border-[#0d0e10]/15 p-8 md:p-10">
            <p class="font-mono text-xs uppercase tracking-widest text-[#999] mb-6">Today · Operational instrument</p>
            <ul class="space-y-4">
              {[
                "Drift detection for security teams",
                "Quantitative basis for every allow / block / quarantine decision",
                "Board-level answer: how much of our autonomous activity can we account for?",
                "Coverage Report: which connections are governed, which run past governance",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-[#333]">
                  <span class="font-mono text-[#fcb830] shrink-0 mt-0.5">→</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-white border border-dotted border-[#0d0e10]/15 p-8 md:p-10">
            <p class="font-mono text-xs uppercase tracking-widest text-[#999] mb-6">Tomorrow · Insurance underwriting input</p>
            <p class="text-sm text-[#555] leading-relaxed mb-4">
              The credit score began as a signal a few lenders found more predictive than interviews. The institutional weight came after the predictive power was proven. For agents, the next institution is insurance.
            </p>
            <p class="text-sm text-[#555] leading-relaxed">
              We won't promise premium reductions before loss data exists to calibrate against. We're building the denominator now — so that when insurers arrive, the question is already answered.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ DUAL CTA ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-6">

