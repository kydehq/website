---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

type ScoreEvent = { label: string; ok: boolean };
const scoreEvents: ScoreEvent[] = [
  { label: "Identity verified · Ed25519",       ok: true  },
  { label: "Within approved scope",             ok: true  },
  { label: "Blocked: unauthorized data export", ok: false },
];

type Dimension = { key: string; label: string; question: string; desc: string; example?: string[] };
const dimensions: Dimension[] = [
  {
    key:      "WHO",
    label:    "Identity",
    question: "Which agent is acting?",
    desc:     "Cryptographic agent identity per instance — not shared service accounts. Cloud-executed agents bind to credentials the enterprise actually issued.",
  },
  {
    key:      "WHY",
    label:    "Mandate",
    question: "Was this action allowed?",
    desc:     "Every agent has a declared purpose. The firewall scores actions against it. No interpretation of inner state required.",
    example:  [
      "Declared:  customer_support · read:tickets, send:messages",
      "Attempted: export:all_contacts  ← Mandate violation → Blocked",
    ],
  },
  {
    key:      "NORMAL",
    label:    "Baseline",
    question: "Is this behavior unusual for this agent?",
    desc:     "Continuous comparison against the agent's own established pattern — call volumes, endpoint sequences, timing. Drift is the earliest observable signal of compromise.",
  },
  {
    key:      "COMPARED",
    label:    "Benchmark",
    question: "How does this agent compare to peers?",
    desc:     "Anonymized role-class comparison across the network. An outlier among hundreds of comparable agents deserves scrutiny even when its own history is clean.",
  },
];
---

<Base
  title="KYDE Trust Score™ — Trust Infrastructure for AI Agents"
  description="A behavioral trust score for every autonomous AI agent. Measured at the boundary across four signals: identity, mandate, baseline, and benchmark. Always published with its coverage figure."
>
  <Navbar />
  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative bg-[#0d0e10] overflow-hidden min-h-screen flex flex-col justify-center pt-24 pb-20">
      <div class="absolute inset-0 bg-grid opacity-[0.06] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 w-full">
        <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">

          <!-- Copy -->
          <div>
            <div class="flex items-center gap-2 mb-8">
              <span class="font-mono text-[10px] uppercase tracking-widest text-white/30 border border-dotted border-white/15 px-3 py-1">Product</span>
              <span class="font-mono text-[10px] text-white/20">·</span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-[#fcb830]/80 border border-dotted border-[#fcb830]/30 px-3 py-1">Trust Score™</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.05] mb-6">
              Trust infrastructure for AI agents.
            </h1>
            <p class="text-xl text-white/55 leading-relaxed max-w-lg mb-4">
              AI agents are becoming autonomous. KYDE measures whether they can be trusted — by scoring what they do, not what they claim.
            </p>
            <p class="text-base text-white/35 leading-relaxed max-w-lg mb-10">
              Deployed via one environment variable. No SDK. No model dependency.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <button
                onclick="openModal()"
                class="inline-flex items-center gap-2 bg-white text-[#0d0e10] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#dae4e5] transition-all"
              >
                Deploy the Gateway →
              </button>
              <a
                href="/platform"
                class="inline-flex items-center gap-2 border border-dotted border-white/25 text-white/60 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-white/60 hover:text-white/90 transition-all"
              >
                See how it works →
              </a>
            </div>
          </div>

          <!-- Score mockup — simplified, Apple-style -->
          <div class="border border-white/10 bg-white/[0.03] p-8 md:p-10">
            <div class="mb-6 pb-5 border-b border-white/8">
              <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/30 mb-1">KYDE Trust Score™</p>
              <p class="font-mono text-xs text-white/20">CRM Sales Agent · Acme Corp</p>
            </div>

            <div class="flex items-end gap-4 mb-3">
              <p class="font-mono text-8xl font-bold text-white leading-none tracking-tighter">84</p>
              <p class="font-mono text-sm text-white/20 pb-2">/100</p>
            </div>
            <p class="font-mono text-xs text-[#fcb830] mb-8">Trusted above comparable agents</p>

            <div class="space-y-3 mb-8">
              {scoreEvents.map(({ label, ok }) => (
                <div class="flex items-center gap-3">
                  <span class={`font-mono text-base leading-none shrink-0 ${ok ? 'text-[#0a7c4e]' : 'text-[#c00000]'}`}>{ok ? '✓' : '⚠'}</span>
                  <span class={`text-sm ${ok ? 'text-white/50' : 'text-white/70'}`}>{label}</span>
                </div>
              ))}
            </div>

            <div class="border-t border-white/8 pt-5 flex items-center justify-between">
              <div>
                <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/25 mb-1">Coverage</p>
                <p class="font-mono text-2xl font-bold text-[#0a7c4e]">92%</p>
              </div>
              <p class="text-xs text-white/20 text-right max-w-[140px] leading-snug">94% of agent traffic observed and scored</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ THE PROBLEM ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[#999] mb-6">The problem</p>
            <h2 class="text-3xl md:text-4xl font-bold text-[#0d0e10] leading-tight">
              AI agents don't fail because we can't understand their intentions.
            </h2>
          </div>
          <div class="md:pt-12">
            <p class="text-lg text-[#444] leading-relaxed mb-6">
              They fail because we can't measure their behavior.
            </p>
            <p class="text-base text-[#666] leading-relaxed">
              Every provider ships a governance console. Every console governs only its own stack. When an agent crosses providers, connects to your systems, or acts on your data — nothing is scored. The liability is yours. The visibility is theirs.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ COVERAGE — "the denominator" ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-24 bg-[#f1f3f5]">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-500 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ The denominator</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center mb-16">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#0d0e10] leading-tight mb-6">
              A score without a denominator is a claim, not a fact.
            </h2>
            <p class="text-base text-[#555] leading-relaxed mb-4">
              Every KYDE Trust Score ships with a coverage figure: the share of observable activity that flowed through governed paths.
            </p>
            <p class="text-base text-[#555] leading-relaxed">
              Coverage 89% and Coverage 42% are different facts wearing the same number. We publish both — because the gap is the risk.
            </p>
          </div>
          <div class="border border-dotted border-[#0d0e10]/15 bg-white p-6 md:p-8">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#999] mb-6">Coverage Report · Acme Corp · Q3 2026</p>
            <div class="space-y-4">
              {[
                { label: "Governed",    pct: 92, note: "Intercepted, scored, signed",  color: "#0a7c4e" },
                { label: "Governable",  pct:  6, note: "Identified, not yet routed",   color: "#fcb830" },
                { label: "Dark",        pct:  2, note: "Unobserved — vendor-internal", color: "#999"    },
              ].map(({ label, pct, note, color }) => (
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-mono text-[10px] uppercase tracking-widest text-[#333]">{label}</span>
                    <span class="font-mono text-xs font-bold" style={`color:${color}`}>{pct}%</span>
                  </div>
                  <div class="h-1.5 bg-[#f0f0f0] rounded-full overflow-hidden mb-1">
                    <div class="h-full rounded-full" style={`width:${pct}%;background-color:${color};opacity:0.8`}></div>
                  </div>
                  <p class="text-[10px] text-[#aaa]">{note}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Architecture diagram -->
        <div class="grid md:grid-cols-[1fr_36px_1fr_36px_1fr] items-stretch gap-0">
          <div class="border border-dotted border-[#0d0e10]/12 bg-white p-6">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#ccc] mb-3">Dark</p>
            <p class="text-sm font-semibold text-[#aaa] mb-3">Vendor-internal</p>
            <p class="text-xs text-[#bbb] leading-relaxed">Intra-cloud reasoning, sub-agent delegation, vendor-native connectors. Quantified in the Coverage Report.</p>
          </div>
          <div class="hidden md:flex items-center justify-center text-[#ccc] font-mono">→</div>
          <div class="border-2 border-[#4472c4] bg-white p-6 md:-my-2">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#4472c4] mb-3">KYDE Gateway</p>
            <p class="text-sm font-semibold text-[#0d0e10] mb-3">The boundary</p>
            <p class="text-xs text-[#555] leading-relaxed">Intercepts every inference call. Verifies identity. Scores against mandate. Signs to ledger. Enforces or blocks.</p>
          </div>
          <div class="hidden md:flex items-center justify-center text-[#ccc] font-mono">→</div>
          <div class="border border-dotted border-[#0a7c4e]/30 bg-white p-6">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#0a7c4e] mb-3">Governed</p>
            <p class="text-sm font-semibold text-[#333] mb-3">Your systems</p>
            <p class="text-xs text-[#555] leading-relaxed">APIs, databases, MCP servers, SaaS endpoints. Every call scored, every action signed.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ FOUR DIMENSIONS ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-400 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ How the score is computed</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <div class="grid md:grid-cols-2 gap-4 items-start mb-8">
          <h2 class="text-3xl md:text-4xl font-bold text-[#0d0e10] leading-tight">
            Four signals. All behavioral. No vendor input required.
          </h2>
          <p class="md:pt-2 text-base text-[#555] leading-relaxed">
            No access to the agent's reasoning. No reliance on any provider's word. Everything computed from what happens at the boundary.
          </p>
        </div>

        <div class="space-y-px">
          {dimensions.map(({ key, label, question, desc, example }) => (
            <div class="grid md:grid-cols-[200px_1fr] divide-y md:divide-y-0 md:divide-x divide-dotted divide-[#0d0e10]/10 border border-dotted border-[#0d0e10]/10 bg-white hover:bg-[#fafafa] transition-colors">
              <div class="p-6 md:p-8 flex flex-col justify-center">
                <span class="font-mono text-[10px] text-[#fcb830] bg-[#fcb830]/8 px-2 py-0.5 mb-3 inline-block w-fit uppercase tracking-widest">{key}</span>
                <p class="text-lg font-bold text-[#0d0e10] mb-1">{label}</p>
                <p class="text-sm text-[#888] italic">"{question}"</p>
              </div>
              <div class="p-6 md:p-8">
                <p class="text-sm text-[#444] leading-relaxed">{desc}</p>
                {example && (
                  <div class="mt-4 border border-dotted border-[#0d0e10]/10 bg-[#f9fafb] p-4 font-mono text-xs space-y-1.5">
                    {example.map((line) => (
                      <p class={line.includes('←') ? 'text-[#c00000]' : 'text-[#0a7c4e]'}>{line}</p>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ══════════ WHY INDEPENDENT ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-20 bg-[#0d0e10]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-[1fr_1fr] gap-12 md:gap-20 items-center">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-white/30 mb-6">Why independence matters</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-6">
              Vendors grade their own homework.
            </h2>
            <p class="text-base text-white/50 leading-relaxed">
              OpenAI, Anthropic, and Google can observe their own agents. None can objectively score the ecosystem. No bank rates its own bonds. The only independent measurement point is the boundary where agent actions meet your world — and that boundary is ours.
            </p>
          </div>
          <div class="space-y-4">
            {[
              { who: "Model providers",   note: "See their own models only. Cannot score competitors." },
              { who: "Single enterprises", note: "See their own fleet only. Cannot benchmark against peers." },
              { who: "Vendor consortia",   note: "Aggregate logs, but different schemas — each grades itself." },
              { who: "KYDE",              note: "Measures every agent at the boundary. One currency.", highlight: true },
            ].map(({ who, note, highlight }) => (
              <div class={`p-4 border border-dotted flex items-start gap-4 ${highlight ? 'border-[#fcb830]/40 bg-[#fcb830]/5' : 'border-white/10 bg-white/[0.02]'}`}>
                <span class={`font-mono text-[10px] uppercase tracking-widest shrink-0 mt-0.5 ${highlight ? 'text-[#fcb830]' : 'text-white/30'}`}>{who}</span>
                <p class={`text-sm ${highlight ? 'text-white/80' : 'text-white/40'}`}>{note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ DEPLOY ══════════ -->
    <section class="border-t border-white/5 bg-[#0d0e10] py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">

          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-white/30 mb-6">Deployment</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-6">
              One variable.<br />Everything governed.
            </h2>
            <p class="text-white/50 leading-relaxed mb-8">
              No SDK. No code changes. No framework dependency. Point any agent at the proxy — scoring and signing start immediately.
            </p>
            <ul class="space-y-2.5">
              {[
                "All providers: OpenAI, Anthropic, Gemini, local models",
                "Under 100ms target latency",
                "MCP-ready",
                "Group Policy for zero-developer fleet rollout",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-white/40">
                  <svg class="h-4 w-4 shrink-0 text-[#0a7c4e] mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="border border-white/10">
            <div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-[#c00000]/40"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#fcb830]/40"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#0a7c4e]/40"></span>
              <span class="ml-2 font-mono text-[10px] text-white/20">terminal</span>
            </div>
            <div class="p-6 font-mono text-sm leading-loose">
              <p class="text-white/30"><span class="text-[#0a7c4e]">$</span> export OPENAI_BASE_URL=https://kyde.intranet/v1</p>
              <p class="text-white/30"><span class="text-[#0a7c4e]">$</span> kyde fleet init</p>
              <p class="text-[#4472c4]">✓ Gateway active · Trust Score™ initialized</p>
              <p class="text-[#4472c4]">✓ Ed25519 ledger started</p>
              <p class="text-white/30 mt-2"><span class="text-[#0a7c4e]">$</span> kyde fleet status</p>
              <p class="text-[#0a7c4e]">✓ 14 agents · Coverage: 94% · Score: 87</p>
              <p class="text-white/15 text-xs mt-1"># All traffic intercepted, scored, and cryptographically signed</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ CONTEXT (brief historical note, not a full section) ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-12 md:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-3xl">
          <p class="font-mono text-xs uppercase tracking-widest text-[#bbb] mb-5">Context</p>
          <p class="text-base text-[#555] leading-relaxed">
            From credit scores to telematics to AI: every scalable system of trust eventually found a measurable behavioral signal. No credit score has ever read a borrower's intentions. The telematics box doesn't know what the driver was thinking. It doesn't need to. Behavior at the moment of action is the only thing that has ever been scored at scale — and the only thing that can be.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/12 py-16 md:py-20 bg-[#f1f3f5]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-start">

          <!-- Primary: Enterprise -->
          <div class="bg-[#0d0e10] p-8 md:p-10">
            <p class="font-mono text-xs uppercase tracking-widest text-white/30 mb-4">For enterprises</p>
            <h3 class="text-2xl font-bold text-white mb-4">See the score in action.</h3>
            <p class="text-sm text-white/50 leading-relaxed mb-8">
              Kyde Gateway Sandbox is free. One environment variable, cryptographically signed records from day one. No SLA, no commitment.
            </p>
            <button
              onclick="openModal()"
              class="inline-flex items-center gap-2 bg-white text-[#0d0e10] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#dae4e5] transition-all"
            >
              Deploy the Sandbox →
            </button>
          </div>

          <!-- Secondary: Insurers -->
          <div class="p-8 md:p-10 border border-dotted border-[#0d0e10]/15 bg-white">
            <p class="font-mono text-xs uppercase tracking-widest text-[#999] mb-4">For insurers &amp; auditors</p>
            <h3 class="text-2xl font-bold text-[#0d0e10] mb-4">Building AI confidence infrastructure?</h3>
            <p class="text-sm text-[#555] leading-relaxed mb-8">
              The Trust Score is the underwriting input the AI insurance market needs. We're building the denominator. If you're pricing AI agent risk or certifying AI systems, let's talk.
            </p>
            <a
              href="mailto:hello@kyde.com"
              class="inline-flex items-center gap-2 border border-dotted border-[#0d0e10] text-[#0d0e10] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#0d0e10] hover:text-white transition-all"
            >
              hello@kyde.com →
            </a>
          </div>

        </div>

        <div class="mt-8 flex flex-wrap gap-4 text-xs text-[#999]">
          <a href="/blog/trust-is-a-number" class="font-mono hover:text-[#0d0e10] transition-colors underline underline-offset-4 decoration-[#0d0e10]/20">Trust Is a Number — announcement →</a>
          <a href="/ai-agent-insurance" class="font-mono hover:text-[#0d0e10] transition-colors underline underline-offset-4 decoration-[#0d0e10]/20">AI Agent Insurance Guide →</a>
          <a href="/blog/confidence-infrastructure-part-3" class="font-mono hover:text-[#0d0e10] transition-colors underline underline-offset-4 decoration-[#0d0e10]/20">Technical Architecture →</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
