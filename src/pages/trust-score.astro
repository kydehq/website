---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

type ScoreEvent = { label: string; ok: boolean };
const scoreEvents: ScoreEvent[] = [
  { label: "Identity verified (Ed25519)",                           ok: true  },
  { label: "Operating within approved scope",                       ok: true  },
  { label: "One unauthorized export attempt intercepted and blocked", ok: false },
];

type MandateLine = { label: string; value: string; cls: string };
const mandateExample: MandateLine[] = [
  { label: "Declared role", value: "Customer Support",                        cls: "text-[#A8A8A8]"    },
  { label: "Permitted",     value: "Read tickets · Send customer messages",   cls: "text-[#3DDC84]" },
  { label: "Observed",      value: "Export all contacts",                     cls: "text-[#FF5C5C]" },
  { label: "Result",        value: "Mandate deviation · Action blocked · Trust Score updated", cls: "text-[#A8A8A8]" },
];

type PeerRow = { name: string; score: number; cls: string; note?: string };
const benchmarkExample: PeerRow[] = [
  { name: "this agent",        score: 84, cls: "text-[#3DDC84]", note: "above median" },
  { name: "peer median",       score: 78, cls: "text-[#F2F2F2]" },
  { name: "peer p10",          score: 61, cls: "text-[#FFB84D]" },
  { name: "flagged threshold", score: 40, cls: "text-[#FF5C5C]" },
];

type Dimension = { label: string; question: string; desc: string; hasExample: boolean };
const dimensions: Dimension[] = [
  {
    label:      "Identity",
    question:   "Who performed the action?",
    desc:       "Each agent receives a cryptographically verifiable identity. Self-hosted agents are identified per instance. Cloud-executed agents are bound to enterprise-issued credentials and connector authorizations.",
    hasExample: false,
  },
  {
    label:      "Mandate",
    question:   "Was the action consistent with the agent's declared role?",
    desc:       "Every agent operates within a defined mandate. Observed actions are continuously compared against that mandate.",
    hasExample: true,
  },
  {
    label:      "Baseline",
    question:   "Is the behavior consistent with this agent's established pattern?",
    desc:       "Normal operating characteristics are learned over time, including call sequences, timing, endpoint usage and execution profiles. Persistent deviation may indicate compromise, misuse or unintended behavior.",
    hasExample: false,
  },
  {
    label:      "Benchmark",
    question:   "How does this agent compare with similar agents?",
    desc:       "Anonymized comparison across comparable role classes provides additional context. A CRM agent is evaluated against CRM agents. A coding agent is evaluated against coding agents. The comparison reflects behavior rather than implementation.",
    hasExample: false,
  },
];
---

<Base
  title="KYDE Trust Score™ — Independent Measurement for AI Agents"
  description="The KYDE Trust Score is an independent behavioral measurement for AI agents, computed from four observable signals at the execution boundary. Always published with its Coverage figure."
>
  <Navbar />
  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative bg-[#0C0C0C] overflow-hidden min-h-screen flex flex-col justify-center pt-24 pb-20">
      <div class="absolute inset-0 bg-grid opacity-[0.06] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 w-full">
        <div class="grid lg:grid-cols-2 gap-16 lg:gap-0 lg:divide-x lg:divide-[#1F1F1F] [&>*:first-child]:lg:pr-12 [&>*:last-child]:lg:pl-12 items-center">

          <!-- Copy -->
          <div>
            <div class="flex items-center gap-2 mb-8">
              <span class="font-mono text-[10px] uppercase tracking-widest text-white/30 border border-white/15 px-3 py-1">Product</span>
              <span class="font-mono text-[10px] text-white/20">·</span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-[#FFB84D]/80 border border-[#FFB84D]/30 px-3 py-1">Trust Score™</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.05] mb-6">
              Trust begins with independent measurement.
            </h1>
            <p class="text-lg text-white/55 leading-relaxed max-w-lg mb-4">
              AI agents increasingly perform actions on behalf of organizations. Trust requires those actions to be observable, attributable and measurable.
            </p>
            <p class="text-base text-white/35 leading-relaxed max-w-lg mb-4">
              KYDE computes an independent Trust Score from the observable behavior of AI agents at the execution boundary.
            </p>
            <p class="text-base text-white/30 leading-relaxed max-w-lg mb-10">
              Deploy through a single gateway. Existing agents continue to operate unchanged.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <button
                onclick="openModal()"
                class="inline-flex items-center gap-2 bg-white text-[#0A0A0A] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#E5E5E5] transition-all"
              >
                Deploy the Gateway →
              </button>
              <a
                href="/blog/confidence-infrastructure-part-3"
                class="inline-flex items-center gap-2 border border-white/25 text-white/60 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-white/60 hover:text-white/90 transition-all"
              >
                Technical Architecture →
              </a>
            </div>
          </div>

          <!-- Score mockup -->
          <div class="border border-white/10 bg-white/[0.03] p-8 md:p-10">
            <div class="mb-6 pb-5 border-b border-white/8">
              <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/30 mb-1">KYDE Trust Score™</p>
              <p class="font-mono text-[10px] text-white/20">CRM Sales Agent · Acme Corp</p>
            </div>

            <div class="flex items-end gap-4 mb-3">
              <p id="ts-score" class="font-mono text-8xl font-bold text-white leading-none tracking-tighter">84</p>
              <p class="font-mono text-sm text-white/20 pb-2">/100</p>
            </div>
            <p class="text-sm text-white/35 mb-8 leading-snug row-in" style="animation-delay:1.1s">Within the expected range for comparable enterprise agents.</p>

            <div class="space-y-3.5 mb-8">
              {scoreEvents.map(({ label, ok }, i) => (
                <div class="flex items-start gap-3 row-in" style={`animation-delay:${1.3 + i * 0.25}s`}>
                  <span class={`font-mono text-base leading-none shrink-0 mt-0.5 ${ok ? 'text-[#3DDC84]' : 'text-[#FF5C5C]'}`}>{ok ? '✓' : '⚠'}</span>
                  <span class={`text-sm leading-snug ${ok ? 'text-white/45' : 'text-white/65'}`}>{label}</span>
                </div>
              ))}
            </div>

            <div class="border-t border-white/8 pt-5 row-in" style="animation-delay:2.1s">
              <div class="flex items-center justify-between mb-2">
                <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-white/25">Coverage</p>
                <p id="ts-coverage" class="font-mono text-xl font-bold text-[#3DDC84]">92%</p>
              </div>
              <p class="text-xs text-white/20 leading-snug">92% of observable agent activity contributed to the score.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <script>
      // Score + coverage count up on load, mono-stable via easing
      const rmTs = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const scoreEl = document.getElementById("ts-score");
      const covEl = document.getElementById("ts-coverage");
      if (scoreEl && covEl && !rmTs) {
        const T = 1400;
        const start = performance.now();
        const ease = (x: number) => 1 - Math.pow(1 - x, 3);
        function tick(now: number) {
          const p = Math.min((now - start) / T, 1);
          const e = ease(p);
          scoreEl!.textContent = String(Math.round(84 * e));
          covEl!.textContent = `${Math.round(92 * e)}%`;
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
    </script>

    <!-- ══════════ INDEPENDENT MEASUREMENT ══════════ -->
    <section class="border-t border-[#1F1F1F] bg-[#0C0C0C]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-[#1F1F1F]">
        <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-[#1F1F1F] [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-start">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[#6B6B6B] mb-6">Independent measurement</p>
            <h2 class="text-3xl md:text-4xl font-bold text-[#F2F2F2] leading-tight">
              Organizations increasingly rely on AI agents across models, providers and enterprise systems.
            </h2>
          </div>
          <div class="md:pt-10">
            <p class="text-base text-[#A8A8A8] leading-relaxed mb-5">
              Existing governance tools describe individual environments. They cannot provide a consistent measure of behavior across organizational boundaries.
            </p>
            <p class="text-base text-[#A8A8A8] leading-relaxed">
              The Trust Score addresses this by measuring observable actions where they occur: at the execution boundary.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ COVERAGE ══════════ -->
    <section class="border-t border-[#1F1F1F] bg-[#050505]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">

        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">01 · Coverage</span></div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-[#1F1F1F] [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-start mb-16">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#F2F2F2] leading-tight mb-6">
              Every score requires a denominator.
            </h2>
            <p class="text-base text-[#A8A8A8] leading-relaxed mb-4">
              A Trust Score without Coverage describes only part of the observed reality.
            </p>
            <p class="text-base text-[#A8A8A8] leading-relaxed mb-4">
              Coverage expresses how much of an agent's observable activity passed through governed paths and therefore contributed to the score.
            </p>
            <p class="text-base text-[#A8A8A8] leading-relaxed">
              Coverage of 92% and Coverage of 41% may produce the same score, but they describe fundamentally different levels of confidence. For this reason, every Trust Score is accompanied by a Coverage Report.
            </p>
          </div>
          <div class="border border-[#1F1F1F] bg-[#0C0C0C] p-6 md:p-8">
            <p class="font-mono text-[10px] uppercase tracking-widest text-[#6B6B6B] mb-6">Coverage Report · Acme Corp</p>
            <div class="space-y-6">
              {[
                { label: "Governed",    pct: 92, desc: "Observed, measured and cryptographically signed.",                                                                          color: "#3DDC84" },
                { label: "Governable",  pct:  6, desc: "Known paths that have not yet been routed through the gateway.",                                                           color: "#FFB84D" },
                { label: "Unobserved",  pct:  2, desc: "Provider-internal execution outside enterprise visibility, such as internal reasoning, delegated sub-agents or provider-native integrations.", color: "#aaa" },
              ].map(({ label, pct, desc, color }) => (
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-mono text-[10px] uppercase tracking-widest text-[#A8A8A8]">{label}</span>
                    <span class="font-mono text-sm font-bold" style={`color:${color}`}>{pct}%</span>
                  </div>
                  <div class="h-1 bg-[#1C1C1C] rounded-full overflow-hidden mb-2">
                    <div class="h-full rounded-full bar-fill" style={`width:${pct}%;background-color:${color};opacity:0.75`}></div>
                  </div>
                  <p class="text-xs text-[#6B6B6B] leading-snug">{desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Architecture diagram -->
        <div class="mb-8">
          <p class="font-mono text-xs uppercase tracking-widest text-[#6B6B6B] mb-6">The execution boundary</p>
          <div class="grid md:grid-cols-[1fr_36px_1fr_36px_1fr] items-stretch gap-0">
            <div class="border border-[#1F1F1F] bg-[#0C0C0C] p-6">
              <p class="font-mono text-[10px] uppercase tracking-widest text-[#6B6B6B] mb-3">Unobserved</p>
              <p class="text-sm font-semibold text-[#6B6B6B] mb-3">Provider-internal</p>
              <p class="text-xs text-[#6B6B6B] leading-relaxed">Internal reasoning, sub-agent delegation, provider-native connectors. Quantified in the Coverage Report.</p>
            </div>
            <div class="hidden md:flex items-center justify-center text-[#6B6B6B] font-mono">→</div>
            <div class="border border-[#F2F2F2]/60 bg-[#0C0C0C] p-6 md:-my-2">
              <p class="font-mono text-[10px] uppercase tracking-widest text-[#F2F2F2]/60 mb-3">KYDE Gateway</p>
              <p class="text-sm font-semibold text-[#F2F2F2] mb-3">Execution boundary</p>
              <p class="text-xs text-[#A8A8A8] leading-relaxed">Verifies agent identity, evaluates actions against mandate, computes the Trust Score, signs every event, and enforces organizational policy where required.</p>
            </div>
            <div class="hidden md:flex items-center justify-center text-[#6B6B6B] font-mono">→</div>
            <div class="border border-[#3DDC84]/25 bg-[#0C0C0C] p-6">
              <p class="font-mono text-[10px] uppercase tracking-widest text-[#3DDC84] mb-3">Governed</p>
              <p class="text-sm font-semibold text-[#A8A8A8] mb-3">Enterprise systems</p>
              <p class="text-xs text-[#A8A8A8] leading-relaxed">APIs, databases, MCP servers, SaaS endpoints. Every action measured, signed and recorded.</p>
            </div>
          </div>
        </div>

        <div class="border-l-2 border-[#1F1F1F] pl-6 max-w-2xl">
          <p class="text-sm text-[#A8A8A8] leading-relaxed">The resulting measurement is independent of model provider or framework.</p>
        </div>

      </div>
    </section>

    <!-- ══════════ HOW THE SCORE IS COMPUTED ══════════ -->
    <section class="border-t border-[#1F1F1F] bg-[#0C0C0C]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">

        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">02 · How the Trust Score is computed</span></div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-[#1F1F1F] [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-center mb-12">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[#F2F2F2] leading-tight mb-6">
              The score is derived from four observable signals.
            </h2>
            <p class="text-base text-[#A8A8A8] leading-relaxed">
              No access to model internals is required. No provider-supplied assessment is used.
            </p>
          </div>

          <!-- FIG.3 — score computation -->
          <div class="relative flex items-center justify-center">
            <span class="fig-label absolute top-0 right-0">FIG.3</span>
            <svg viewBox="0 0 620 400" class="w-full max-w-lg h-auto" aria-hidden="true">
              <defs>
                <pattern id="cube-dots" width="10" height="10" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1" fill="rgba(242,242,242,0.22)" />
                </pattern>
              </defs>

              <!-- input chips -->
              {[
                { label: "IDENTITY",  y: 90  },
                { label: "MANDATE",   y: 150 },
                { label: "BASELINE",  y: 210 },
                { label: "BENCHMARK", y: 270 },
              ].map(({ label, y }) => (
                <>
                  <rect x="30" y={y - 13} width="108" height="26" fill="#1C1C1C" stroke="rgba(242,242,242,0.15)" stroke-width="1" />
                  <text x="84" y={y + 4} text-anchor="middle" fill="rgba(242,242,242,0.65)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.14em;">{label}</text>
                  <path d={`M138 ${y} L200 ${y} L240 ${180}`} fill="none" stroke="rgba(242,242,242,0.18)" stroke-width="1" stroke-dasharray="3 3" />
                </>
              ))}

              <!-- isometric cube -->
              <path class="draw" pathLength="1" d="M330 80 L420 125 L420 235 L330 280 L240 235 L240 125 Z" fill="none" stroke="rgba(242,242,242,0.4)" stroke-width="1" />
              <path class="draw" pathLength="1" d="M240 125 L330 170 L420 125" fill="none" stroke="rgba(242,242,242,0.4)" stroke-width="1" />
              <path class="draw" pathLength="1" d="M330 170 L330 280" fill="none" stroke="rgba(242,242,242,0.4)" stroke-width="1" />
              <path d="M330 80 L420 125 L330 170 L240 125 Z" fill="url(#cube-dots)" />

              <!-- output callout -->
              <path d="M420 180 L490 180" fill="none" stroke="rgba(242,242,242,0.3)" stroke-width="1" />
              <circle cx="420" cy="180" r="3" fill="#F2F2F2" />
              <text x="498" y="172" text-anchor="start" fill="rgba(242,242,242,0.55)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.18em;">TRUST SCORE</text>
              <text x="498" y="198" text-anchor="start" fill="#3DDC84" style="font-family:'JetBrains Mono Variable',monospace;font-size:24px;font-weight:700;">84</text>

              <!-- coverage footnote -->
              <text x="330" y="320" text-anchor="middle" fill="rgba(242,242,242,0.3)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.14em;">COVERAGE 92%</text>
            </svg>
          </div>
        </div>

        <div class="space-y-px">
          {dimensions.map(({ label, question, desc, hasExample }) => (
            <div class="grid md:grid-cols-[200px_1fr] divide-y md:divide-y-0 md:divide-x divide-[#1F1F1F] border border-[#1F1F1F] bg-[#0C0C0C]">
              <div class="p-6 md:p-8 flex flex-col justify-center">
                <p class="text-lg font-bold text-[#F2F2F2] mb-1.5">{label}</p>
                <p class="text-sm text-[#6B6B6B] leading-snug">{question}</p>
              </div>
              <div class="p-6 md:p-8">
                <p class="text-sm text-[#A8A8A8] leading-relaxed">{desc}</p>
                {hasExample && (
                  <div class="mt-5 border border-[#1F1F1F] bg-[#141414] p-5">
                    <p class="font-mono text-[9px] uppercase tracking-widest text-[#6B6B6B] mb-4">Example</p>
                    <div class="space-y-2 font-mono text-xs">
                      {mandateExample.map(({ label: l, value, cls }) => (
                        <div class="grid grid-cols-[100px_1fr] gap-3">
                          <span class="text-[#6B6B6B]">{l}</span>
                          <span class={cls}>{value}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {label === "Benchmark" && (
                  <div class="mt-5 border border-[#1F1F1F] bg-[#141414] p-5">
                    <p class="font-mono text-[9px] uppercase tracking-widest text-[#6B6B6B] mb-4">role class: crm-agents · anonymized · n=214</p>
                    <div class="space-y-2.5 font-mono text-xs">
                      {benchmarkExample.map(({ name, score, cls, note }) => (
                        <div class="flex items-baseline gap-2">
                          <span class="text-[#6B6B6B] shrink-0">{name}</span>
                          <span class="flex-1 border-b border-dashed border-[#2E2E2E] translate-y-[-3px]"></span>
                          <span class={`font-bold ${cls}`}>{score}</span>
                          {note && <span class="text-[#6B6B6B] text-[10px]">· {note}</span>}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ══════════ WHY INDEPENDENCE MATTERS ══════════ -->
    <section class="border-t border-[#1F1F1F] bg-[#0C0C0C]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-[#1F1F1F]">
        <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-[#1F1F1F] [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-start">

          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-white/30 mb-6">Why independence matters</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-6">
              Trust measurements are currently produced within individual platforms.
            </h2>
            <p class="text-base text-white/45 leading-relaxed mb-4">
              Model providers observe their own environments. Enterprises observe only their own deployments. Neither provides an independent measure across providers, infrastructures and organizational boundaries.
            </p>
            <p class="text-base text-white/45 leading-relaxed">
              The execution boundary is the only location where every externally observable action can be measured using the same methodology. KYDE provides that common measurement layer.
            </p>
          </div>

          <div class="space-y-px">
            {[
              { who: "Model providers", note: "Observe activity within their own platforms.",                                               highlight: false },
              { who: "Enterprises",     note: "Observe their own deployments.",                                                            highlight: false },
              { who: "KYDE",            note: "Computes one independent Trust Score across providers, models and enterprise environments.", highlight: true  },
            ].map(({ who, note, highlight }) => (
              <div class={`p-5 border grid grid-cols-[140px_1fr] gap-4 items-start ${highlight ? 'border-[#FFB84D]/40 bg-[#FFB84D]/5' : 'border-white/8 bg-white/[0.02]'}`}>
                <span class={`font-mono text-[10px] uppercase tracking-widest shrink-0 pt-0.5 ${highlight ? 'text-[#FFB84D]' : 'text-white/25'}`}>{who}</span>
                <p class={`text-sm leading-snug ${highlight ? 'text-white/70' : 'text-white/35'}`}>{note}</p>
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ DEPLOYMENT ══════════ -->
    <section class="border-t border-white/5 bg-[#0C0C0C]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-[#1F1F1F]">
        <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-[#1F1F1F] [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-center">

          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-white/30 mb-6">Deployment</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-6">
              Deployment requires a single endpoint change.
            </h2>
            <p class="text-white/45 leading-relaxed mb-6">
              No SDKs. No application changes. No framework dependency. Existing agents continue operating while every observable action becomes attributable, measurable and cryptographically recorded.
            </p>
            <p class="text-white/35 leading-relaxed text-sm">
              Supported environments include OpenAI, Anthropic, Gemini, self-hosted models and MCP-based architectures. Target latency: below 100 ms.
            </p>
          </div>

          <div class="border border-white/10">
            <div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-[#FF5C5C]/40"></span>
