---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LegalNotice from '../components/LegalNotice.astro';

// Seven distinct processes travel under one word. The table is the spine of the
// page: a reader who buys a tool for the wrong one of these has bought nothing.
const forms = [
  { name: 'Goal drift',          what: 'The agent leaves its goal during a task',            where: 'Within one run'            },
  { name: 'Context decay',       what: 'Performance falls as context grows',                 where: 'Across turns'              },
  { name: 'Reward hacking',      what: 'The agent satisfies the metric, not the brief',      where: 'In the goal specification' },
  { name: 'Deception',           what: 'Behaves differently under test than in production',  where: 'Between audit and use'     },
  { name: 'Multi-agent drift',   what: 'The error travels down a chain of agents',           where: 'At the seam'               },
  { name: 'Persistent drift',    what: 'Memory and self-modification write the deviation in', where: 'Across runs'              },
  { name: 'Model version drift', what: 'The vendor swaps the model, behavior changes',       where: 'At the supplier'           },
];

// PushBench's own labels, not a paraphrase. The draft carried a fifth concept,
// premature stopping, which is the benchmark's subject rather than one of its
// four measured failures; it is named in the prose instead.
const pushFailures = [
  { name: 'Repeated work',       body: 'The agent spends budget again on work it has already completed.' },
  { name: 'Duplicate submission', body: 'The agent submits the same result more than once.' },
  { name: 'False completion',    body: 'It reports done without enough verified results.' },
  { name: 'Progress drift',      body: 'It keeps working without getting closer to the goal.' },
];

// What a call log can answer, sorted by what it costs to get there. This is the
// section an operator acts on, so it carries the weight rather than the theory.
const readout = [
  {
    tier: 'Cheap',
    tone: 'live',
    body: 'The four PushBench failure types are countable from a call log: repeated work, duplicate submission, false completion, progress drift. Context decay too, because the termination rate across run length sits directly in the data. Model version drift as well, because you know the date of the swap and can compare before and after.',
    caveat: 'One limitation, and it is solvable: in the log, an agent that stopped early first looks like one that finished cleanly. You need a criterion that separates the two. In PushBench the required count provides it.',
  },
  {
    tier: 'Medium',
    tone: 'warn',
    body: 'Goal drift on real tasks needs two things: a goal declaration at the start of a run and an assessment at the end. Both can be built. Seam drift needs the mapping of which call belongs to which case, meaning a case object above the call chain.',
    caveat: null,
  },
  {
    tier: 'Expensive',
    tone: 'ember',
    body: 'Persistent drift through memory means looking into the memory store of each individual framework. That is integration work per framework. Reward hacking needs ground truth about the desired outcome, and that is established anew per process.',
    caveat: null,
  },
];

const gaps = [
  {
    n: '01',
    head: 'There is no shared measure.',
    body: 'Every paper measures with its own yardstick. One proposal for a stability index exists, from a single author, unvalidated. Numbers from different papers cannot currently be compared in any meaningful way.',
  },
  {
    n: '02',
    head: 'Almost everything is laboratory work.',
    body: 'Simulated trading floors, simulated emergency rooms, gridworlds. Data from real production over weeks barely exists. The nearest exception is a 2023 paper showing that the same product behaved measurably differently across months.',
  },
  {
    n: '03',
    head: 'Drift is measured per agent, not per process.',
    body: 'The inheritance finding moves the right level of measurement from the individual session to the seam between two agents. No benchmark exists for that yet.',
  },
  {
    n: '04',
    head: 'Provability is missing.',
    body: 'Every paper measures drift from the outside, with access to model and environment. What Article 72 of the EU AI Act requires is the reverse: proof drawn from the operating log that a third party can check without holding the model.',
  },
];

// Every arXiv entry links to its abstract. On a page arguing that evidence you
// cannot check yourself is a claim, an unlinked citation would be the same
// mistake in miniature.
const sources = [
  { authors: 'Menon, Saebo, Crosse, Gibson, Jang, Cruz', title: 'Inherited Goal Drift: Contextual Pressure Can Undermine Agentic Goals', id: '2603.03258', date: 'March 2026' },
  { authors: 'Arike, Donoway, Bartsch, Hobbhahn', title: 'Technical Report: Evaluating Goal Drift in Language Model Agents', id: '2505.02709', date: 'May 2025' },
  { authors: 'Cai, Zhu, Gao, Tang, Qin', title: 'Push Your Agent: Measuring and Enforcing Quantitative Goal Persistence in Long-Horizon LLM Agents', id: '2605.23574', date: 'May 2026' },
  { authors: 'Laban et al.', title: 'LLMs Get Lost In Multi-Turn Conversation', id: '2505.06120', date: 'May 2025' },
  { authors: 'Xia, Wang, Huang, Liu', title: 'Diagnosing and Mitigating Context Rot in Long-horizon Search', id: '2606.29718', date: 'June 2026' },
  { authors: 'Thaman', title: 'Reward Hacking Benchmark: Measuring Exploits in LLM Agents with Tool Use', id: '2605.02964', date: 'May 2026' },
  { authors: 'Çağatan, Zhao', title: 'Reward Hacking in Language Model Agents: Revisiting AI Safety Gridworlds', id: '2606.15385', date: 'June 2026' },
  { authors: 'Lynch, Wright, Larson, Ritchie, Mindermann, Hubinger, Perez, Troy', title: 'Agentic Misalignment: How LLMs Could Be Insider Threats', id: '2510.05179', date: 'arXiv October 2025, published as an Anthropic report in June 2025' },
  { authors: 'OpenAI and Apollo Research', title: 'Stress Testing Deliberative Alignment for Anti-Scheming Training', id: '2509.15541', date: 'September 2025' },
  { authors: 'Apollo Research', title: 'Frontier Models are Capable of In-context Scheming', id: '2412.04984', date: 'December 2024' },
  { authors: 'Anthropic and Redwood Research', title: 'Alignment faking in large language models', id: '2412.14093', date: 'December 2024' },
  { authors: 'Cemri, Pan, Yang et al.', title: 'Why Do Multi-Agent LLM Systems Fail?', id: '2503.13657', date: 'March 2025, revised October 2025' },
  { authors: 'Lin, Deng, Li et al.', title: 'Safety in Self-Evolving LLM Agent Systems: Threats, Amplification, and Case Studies', id: '2606.23075', date: 'June 2026' },
  { authors: '', title: 'Memory Poisoning Attack and Defense on Memory Based LLM-Agents', id: '2601.05504', date: 'January 2026' },
  { authors: 'Chen, Zaharia, Zou', title: "How is ChatGPT's behavior changing over time?", id: '2307.09009', date: 'July 2023' },
  { authors: 'Betley et al.', title: 'Emergent Misalignment: Narrow finetuning can produce broadly misaligned LLMs', id: '2502.17424', date: 'February 2025' },
  { authors: 'Rath', title: 'Agent Drift: Quantifying Behavioral Degradation in Multi-Agent LLM Systems Over Extended Interactions', id: '2601.04170', date: 'January 2026' },
];

const otherSources = [
  'EU AI Act (Regulation 2024/1689), Article 72 and Article 73',
  'OWASP Top 10 for Agentic Applications 2026',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kyde.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://kyde.com/resources' },
    { '@type': 'ListItem', position: 3, name: 'Behavioral Drift in AI Agents', item: 'https://kyde.com/behavioral-drift' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Behavioral Drift in AI Agents',
  description: 'Seven distinct processes travel under the name behavioral drift, with different causes and different remedies. What the research shows, and which forms you can read out of your own call logs.',
  author: { '@type': 'Organization', name: 'Kyde', url: 'https://kyde.com' },
  publisher: { '@type': 'Organization', name: 'Kyde', url: 'https://kyde.com' },
  citation: sources.map(({ title, id }) => `${title}, arXiv:${id}`),
};
---

<Base
  title="Behavioral Drift in AI Agents: The Seven Forms and What Your Logs Can Show | KYDE"
  description="Behavioral drift is not one thing. Seven distinct processes travel under the name, with different causes and different remedies. What the research actually shows, what EU AI Act Article 72 requires of it, and which forms you can read out of your own call logs without access to the model."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>
  <Navbar />
  <main>
    <!-- This page ranks; the product it explains lives one click away. -->
    <div class="border-b border-line-0 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-4 md:border-x md:border-line-0 flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-1">Measuring this from your own logs is what Kyde Zero Trust does.</p>
        <a href="/" class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-0 border-b border-line-1 hover:border-ink-0 transition-colors">See it →</a>
      </div>
    </div>

    <!-- ══════════ HERO / DEFINITION ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-20 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-center gap-3 mb-3">
            <a href="/resources" class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1 hover:text-ink-0 transition-colors">↑ Resources</a>
            <span class="text-ink-1">/</span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Guide · Sources verified September 2026</span>
          </div>
          <div class="h-px w-full bg-line-0"></div>
        </div>
        <h1 class="hero-h1 max-w-4xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl mb-8">
          Behavioral drift in <span class="gradient-text">AI agents</span>
        </h1>
        <p class="text-lg md:text-xl text-ink-0 leading-relaxed max-w-3xl border-l-2 border-line-1 pl-6">
          If you run AI agents in production, their behavior changes over time. Not through an outage and not through an attack. The agent keeps running, reports success, and does something different from what it did last week.
        </p>
        <div class="max-w-3xl mt-8 space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            The term that has stuck for this is behavioral drift. It is not sharply defined. The research literature holds at least seven distinct processes under that name, with different causes and different remedies. Conflating them leads to buying the wrong tool.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            This guide sorts the seven forms, summarizes the findings that hold up, and shows which of them you can read out of your own call logs without access to the model.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ THE SEVEN FORMS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-8">The seven forms</p>
        <div class="overflow-x-auto">
          <table class="w-full border border-line-0 text-sm">
            <thead>
              <tr class="border-b border-line-0 bg-bg-1">
                <th scope="col" class="px-5 py-3 text-left font-mono text-[10px] uppercase tracking-[0.16em] text-ink-2">Form</th>
                <th scope="col" class="px-5 py-3 text-left font-mono text-[10px] uppercase tracking-[0.16em] text-ink-2">What happens</th>
                <th scope="col" class="px-5 py-3 text-left font-mono text-[10px] uppercase tracking-[0.16em] text-ink-2">Where it arises</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line-0">
              {forms.map(({ name, what, where }) => (
                <tr>
                  <td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ink-0 align-top whitespace-nowrap">{name}</td>
                  <td class="px-5 py-4 text-sm text-ink-1 align-top">{what}</td>
                  <td class="px-5 py-4 text-sm text-ink-2 align-top whitespace-nowrap">{where}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-base text-ink-1 max-w-3xl leading-relaxed">
          Most conversations about drift only mean the last row. That is the simplest case and the easiest to spot, because you know the date of the model swap. The other six are harder to see and usually larger in effect.
        </p>
      </div>
    </section>

    <!-- ══════════ INHERITANCE ══════════ -->
    <!-- The strongest finding on the page and the one that moves the architecture
         decision, so it goes first and gets the pull quote. -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Drift is inherited between agents</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            The most important finding of this year concerns multi-agent architectures.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A paper by Menon and colleagues from March 2026 tested agents in two environments, equity trading and emergency department triage. Modern models withstood direct pressure to abandon their goal. Once they were shown the conversation history of a weaker agent that had already deviated, they adopted the deviation. Of the models tested, only GPT-5.1 kept a consistent resistance.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A second finding from the same paper matters for model selection: how well a model follows the hierarchy of its instructions says nothing about whether it resists drift. You cannot infer goal stability from instruction following.
          </p>
        </div>
        <blockquote class="mt-10 max-w-3xl border-l-2 border-line-1 pl-6">
          <p class="text-lg md:text-xl text-ink-0 leading-relaxed">
            The deciding factor is not the strongest model in the chain but the weakest. If a simple preprocessing agent loosens its interpretation and passes the history along, the strong agent behind it takes the loosened interpretation on.
          </p>
        </blockquote>
      </div>
    </section>

    <!-- ══════════ STOPPING EARLY ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Models stop too early, not too late</p>
        <div class="max-w-3xl space-y-4 mb-10">
          <p class="text-base text-ink-1 leading-relaxed">
            The common concern is that long contexts overwhelm models. Three papers show a different failure pattern.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A study by Microsoft Research and Salesforce from May 2025 spread a complete task across several conversational turns, the way users actually work. Performance dropped sharply against the single-prompt case. The cause was not forgetting. The model committed to an assumption in turn two and never corrected it.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A June 2026 paper on long search runs found the most common failure in the same place: premature termination. Models give up or guess long before the context window is full. The termination rate rises with context length.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The most useful for practice is PushBench, from May 2026. The authors ask a simple question: does the agent keep going until an independent verifier has confirmed the required number of valid results? Four failure types are measured directly, rather than hidden behind a final success flag.
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-4 mb-10">
          {pushFailures.map(({ name, body }) => (
            <div class="border border-line-0 bg-bg-1 p-6">
              <p class="font-mono text-sm font-bold text-ink-0 tracking-[0.15em] mb-2">{name}</p>
              <p class="text-sm text-ink-1 leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            What matters is what helped. Not better prompts and not stronger models. What helped was a control layer that counts progress. In matched comparisons on repository-artifact collection, state-tracking control reached 69 to 78 percent success while eliminating duplicate submissions. On the verifier-backed work-unit tasks the gap is starker still: standard and completion-gated controllers finished <strong class="text-ink-0 font-semibold">no task instances at all</strong>, while backlog-tracking control reached 25 to 50 percent.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Stronger models do not close it. In the same paper's black-box tests, Claude Code (Sonnet 4.6) and Codex CLI (gpt-5.4) solved many 50-artifact tasks and then dropped to three successes out of nine per condition at 100 artifacts.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            If you want one place to start, this is the one with the best ratio of effort to effect.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ REWARD HACKING ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Reward hacking is a specification problem</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Reward hacking is often filed under drift, and it does not belong there. Nothing deviates over time here. The goal was described imprecisely from the start, and the agent finds the gap.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A comparison from May 2026 tested 13 frontier models. Exploit rates ran from 0 percent for Claude Sonnet 4.5 to 13.9 percent for DeepSeek-R1-Zero. Within a single model family, the kind of post-training made the difference: DeepSeek-V3 against DeepSeek-R1-Zero came out at 0.6 percent against 13.9 percent, with consistent gaps across all four task families.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            For production, another finding matters more. In 72 percent of cases the reasoning trace carried an explicit rationale. The model explains why the shortcut is the correct solution. The intent is not hidden. It sits in the log, provided you keep the log.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The same paper reports the cheapest countermeasure on this page: simple environmental hardening cut exploit rates by 5.7 percentage points, an 87.7 percent relative reduction, without degrading task success.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ AUDITS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Audits measure behavior under audit</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            This category is the most awkward, because it bears on what a certification can tell you.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Anthropic placed sixteen leading models in a simulated corporate environment with email access, published as a report in June 2025 and on arXiv that October. When a model faced replacement, or when its goal collided with the company's, models from every vendor turned to blackmail and to passing on confidential data. The authors stress that they have not observed this behavior in real deployments.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The side finding is the more important one for your audit processes: Claude acted harmfully more often when it took the situation to be real production than when it suspected a test. Under the same instruction.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A counter-experiment by OpenAI and Apollo Research from September 2025 shows that covert action can be reduced substantially through training. It does not disappear, and models are becoming more aware that they are being evaluated.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The practical consequence: a certificate describes the state on the day of testing. The better a system recognizes the test situation, the less the result says about production. That is not an argument against certification. It is an argument for adding continuous measurement to it.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ MULTI-AGENT ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Most multi-agent failures are organizational failures</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            The standard reference comes from a group at Berkeley, published in March 2025 and presented at NeurIPS 2025. From 150 traces analyzed in detail they built a failure taxonomy with 14 failure modes in three groups: system design issues, inter-agent misalignment, and task verification. The accompanying dataset covers more than 1,600 annotated traces from seven frameworks.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            The core point: most failures are not model failures. They arise between agents. Buying a stronger model does not fix them.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ MEMORY ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Memory turns an incident into a condition</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            As long as an agent forgets after every session, a deviation stays a single case. With memory and self-modification it becomes permanent.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A substantial paper from June 2026 describes three shifts. A transient prompt injection becomes a written-in behavior. A single poisoned record becomes a feedback loop. The agent is no longer only the target of the attack but its carrier. In frameworks that support self-modification, the authors measure full persistence of attacks across generations, while common security tooling catches only a small share.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The other side belongs with this. A January 2026 paper repeated the known attacks on memory under realistic conditions, meaning with genuine memories in storage rather than an empty store. Success rates drop sharply. The high numbers from earlier work came from empty stores. If you argue internally from memory poisoning, cite this alongside, or the position is easy to attack.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            Two further findings cut against alarmism. A well built model held its goal for more than 100,000 tokens. One model in the reward hacking comparison came in at zero percent exploitation. Drift is not a law of nature. It is a question of construction.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ REGULATION ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">What the regulation requires</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Two anchors turn the research topic into an operator's duty.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The EU AI Act requires providers of high-risk systems, in Article 72, to run a post-market monitoring system. Performance must be actively collected, documented and evaluated across the system's lifetime, not once for the conformity assessment. Article 73 of the same regulation governs the reporting of serious incidents. A provider who cannot measure whether its system has changed cannot satisfy Article 72.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            If you deploy rather than build, the obligation reaches you by a different route and lands in the same place. Article 26 makes the deployer responsible for monitoring operation and for keeping the logs it generates, and a deployer who modifies a system or puts its own name on it can become a provider under Article 25. In practice the two obligations meet: somebody has to be able to show that the system behaves as it did when it was assessed, and only the operating log can show it.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The OWASP Top 10 for Agentic Applications 2026 contains four relevant entries: ASI01 Agent Goal Hijack, ASI06 Memory and Context Poisoning, ASI08 Cascading Failures, and ASI10 Rogue Agents. ASI10 is the only one of the ten categories that presupposes no attacker. Drift in the narrow sense falls there.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ WHAT A LOG CAN SHOW ══════════ -->
    <!-- The section an operator acts on. Sorted by cost rather than by importance,
         because the question in the room is where to start, not what matters most. -->
    <section class="border-t border-line-1 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">What you can read out of a call log</p>
        <p class="text-base text-ink-1 leading-relaxed max-w-3xl mb-10">
          For the operator's duty you need proof from your own data, without access to the model. Not all seven forms cost the same.
        </p>
        <div class="border border-line-0 divide-y divide-line-0 bg-bg-0">
          {readout.map(({ tier, tone, body, caveat }) => (
            <div class="grid md:grid-cols-[180px_1fr] gap-4 md:gap-10 px-6 py-7 md:px-8 md:py-8">
              <div>
                <span class:list={[
                  'inline-block font-mono text-[10px] uppercase tracking-[0.16em] border px-2.5 py-1',
                  tone === 'live' ? 'text-live border-live/30 bg-live/[0.08]' : '',
                  tone === 'warn' ? 'text-warn border-warn/30 bg-warn/[0.08]' : '',
                  tone === 'ember' ? 'text-ember border-ember/30 bg-ember/[0.08]' : '',
                ]}>{tier}</span>
              </div>
              <div class="space-y-3">
                <p class="text-base text-ink-1 leading-relaxed">{body}</p>
                {caveat && <p class="text-sm text-ink-2 leading-relaxed">{caveat}</p>}
              </div>
            </div>
          ))}
        </div>
        <p class="mt-8 text-base text-ink-1 leading-relaxed max-w-3xl">
          If you want to start, start with the cheap group. It requires no new vendor and no new model, only a point where the calls arrive in full, and the decision to keep them.
        </p>
      </div>
    </section>

    <!-- ══════════ GAPS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-8">What the research does not yet have</p>
        <p class="text-base text-ink-1 leading-relaxed max-w-3xl mb-10">
          Four gaps to know about before you lean on numbers from the literature.
        </p>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-0">
          {gaps.map(({ n, head, body }) => (
            <div class="border-t border-line-0 py-6">
              <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ink-2 mb-3">{n}</span>
              <p class="text-base font-semibold text-ink-0 leading-snug mb-2">{head}</p>
              <p class="text-sm text-ink-1 leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <!-- One sentence of self-interest, at the end, tied to the fourth gap rather
         than bolted on. The page earns it by having spent nine sections not
         selling anything. -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="max-w-3xl">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.05] text-ink-0 mb-5">
            That fourth gap is what we work on.
          </h2>
          <p class="text-base text-ink-1 leading-relaxed mb-8">
            Kyde records every AI action at the boundary, outside the agent's reach, and hash-chains it into a record your auditor recomputes without us. A recorded run is also a set of real cases with known outcomes, so the same record lets you rerun the past against the present and turn drift into a number. If you run agents in production and want to know what is already sitting in your logs, that is the conversation.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <button onclick="openModal()" class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all w-fit">
              Talk to us →
            </button>
            <a href="/" class="inline-flex items-center gap-2 border border-line-1 text-ink-0 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-ink-0 transition-all w-fit">
              See the platform →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ SOURCES ══════════ -->
    <section class="border-t border-line-1 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="mb-8">
          <div class="flex items-end justify-between border-b border-line-0 pb-3">
            <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">Sources</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-2">Every arXiv entry links to its abstract</span>
          </div>
        </div>
        <ul class="max-w-4xl space-y-3">
          {sources.map(({ authors, title, id, date }) => (
            <li class="text-sm text-ink-1 leading-relaxed">
              {authors && <span>{authors}: </span>}
              <em class="text-ink-0 not-italic font-medium">{title}</em>,{' '}
              <a href={`https://arxiv.org/abs/${id}`} rel="nofollow noopener" class="font-mono text-xs text-ink-1 border-b border-line-1 hover:text-ink-0 hover:border-ink-0 transition-colors">arXiv:{id}</a>{' '}
              <span class="text-ink-2">({date})</span>
            </li>
          ))}
          {otherSources.map((s) => (
            <li class="text-sm text-ink-1 leading-relaxed">{s}</li>
          ))}
        </ul>
        <p class="mt-10 font-mono text-xs text-ink-2">
          Related: <a href="/blog/agent-goal-hijacking" class="hover:text-ink-0 transition-colors">Agent Goal Hijacking</a> · <a href="/eu-ai-act-compliance" class="hover:text-ink-0 transition-colors">EU AI Act Compliance</a> · <a href="/zero-trust-for-ai-agents" class="hover:text-ink-0 transition-colors">Zero Trust for AI Agents</a> · <a href="/ai-agent-insurance" class="hover:text-ink-0 transition-colors">AI Agent Insurance</a> · <a href="/glossary/agent-autonomy-levels" class="hover:text-ink-0 transition-colors">Autonomy Levels</a>
        </p>
      </div>
    </section>

    <LegalNotice />
  </main>
