---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LegalNotice from '../components/LegalNotice.astro';

// Seven related ways agent behavior can change. Stated as our synthesis rather
// than as an established taxonomy, because it is one: the literature does not
// agree on a set, and a page that presents its own reading as settled science
// is doing the thing this page warns about two sections later.
const forms = [
  { name: 'Goal drift',          what: 'The agent moves away from the goal during a task.' },
  { name: 'Context decay',       what: 'Performance degrades as interactions become longer.' },
  { name: 'Reward hacking',      what: 'The agent satisfies the metric without satisfying the intended objective.' },
  { name: 'Deceptive behavior',  what: 'Behavior differs between evaluation and deployment conditions.' },
  { name: 'Multi-agent drift',   what: 'A deviation is passed from one agent to another.' },
  { name: 'Persistent drift',    what: 'Memory or self-modification allows a deviation to persist across runs.' },
  { name: 'Model version drift', what: 'A model update changes the behavior of an existing system.' },
];

// Sorted by what each signal costs to obtain, not by how much it matters. The
// question in the room is where to start, and the cheap column is the answer.
const readout = [
  {
    tier: 'Cheap',
    tone: 'live',
    lead: 'Relatively inexpensive to measure from normal agent activity.',
    items: [
      'Repeated work',
      'Duplicate submissions',
      'False completion',
      'Progress drift',
      'Changes following a model-version update',
      'Performance changes across run length',
    ],
  },
  {
    tier: 'Medium',
    tone: 'warn',
    lead: 'Needs context the log does not carry on its own.',
    items: [
      'Goal drift requires a defined goal at the beginning of a run and an assessment of the outcome',
      'Multi-agent drift requires knowing which calls belong to the same task or case',
    ],
  },
  {
    tier: 'Expensive',
    tone: 'ember',
    lead: 'Needs access to something outside the call record.',
    items: [
      'Persistent drift requires access to the relevant memory system',
      'Reward hacking requires knowledge of the intended outcome or ground truth',
    ],
  },
];

const gaps = [
  {
    n: '01',
    head: 'There is no shared measure of behavioral drift.',
    body: 'Different studies use different definitions, tasks and metrics. Their numbers should therefore not simply be compared with each other.',
  },
  {
    n: '02',
    head: 'Most evidence is still experimental.',
    body: 'We have many controlled studies, but comparatively little long-term data from real production agent systems.',
  },
  {
    n: '03',
    head: 'Drift is usually measured at the agent level.',
    body: 'Multi-agent research suggests that the seam between agents may be equally important, but there is not yet a widely accepted benchmark for measuring this.',
  },
  {
    n: '04',
    head: 'And there is an evidence gap.',
    body: 'Much of the research measures behavior with direct access to the model and its environment. In production, operators often have something different: the record of what the system actually did.',
  },
];

// The prose deliberately names few papers, but it still carries specific
// numbers and specific studies. The backing stays on the page: a text that
// argues operators need checkable evidence, while asking to be taken on faith
// for its own figures, would be making its opponents' case. Every id was
// resolved and every title checked in September 2026.
const sources = [
  { authors: 'Menon, Saebo, Crosse, Gibson, Jang, Cruz', title: 'Inherited Goal Drift: Contextual Pressure Can Undermine Agentic Goals', id: '2603.03258', date: 'March 2026' },
  { authors: 'Arike, Donoway, Bartsch, Hobbhahn', title: 'Technical Report: Evaluating Goal Drift in Language Model Agents', id: '2505.02709', date: 'May 2025' },
  { authors: 'Cai, Zhu, Gao, Tang, Qin', title: 'Push Your Agent: Measuring and Enforcing Quantitative Goal Persistence in Long-Horizon LLM Agents', id: '2605.23574', date: 'May 2026' },
  { authors: 'Laban et al.', title: 'LLMs Get Lost In Multi-Turn Conversation', id: '2505.06120', date: 'May 2025' },
  { authors: 'Xia, Wang, Huang, Liu', title: 'Diagnosing and Mitigating Context Rot in Long-horizon Search', id: '2606.29718', date: 'June 2026' },
  { authors: 'Thaman', title: 'Reward Hacking Benchmark: Measuring Exploits in LLM Agents with Tool Use', id: '2605.02964', date: 'May 2026' },
  { authors: 'Çağatan, Zhao', title: 'Reward Hacking in Language Model Agents: Revisiting AI Safety Gridworlds', id: '2606.15385', date: 'June 2026' },
  { authors: 'Lynch, Wright, Larson, Ritchie, Mindermann, Hubinger, Perez, Troy', title: 'Agentic Misalignment: How LLMs Could Be Insider Threats', id: '2510.05179', date: 'arXiv October 2025, published as an Anthropic report in June 2025' },
  { authors: 'OpenAI and Apollo Research', title: 'Stress Testing Deliberative Alignment for Anti-Scheming Training', id: '2509.15541', date: 'September 2025' },
  { authors: 'Apollo Research', title: 'Frontier Models are Capable of In-context Scheming', id: '2412.04984', date: 'December 2024' },
  { authors: 'Anthropic and Redwood Research', title: 'Alignment faking in large language models', id: '2412.14093', date: 'December 2024' },
  { authors: 'Cemri, Pan, Yang et al.', title: 'Why Do Multi-Agent LLM Systems Fail?', id: '2503.13657', date: 'March 2025, revised October 2025' },
  { authors: 'Lin, Deng, Li et al.', title: 'Safety in Self-Evolving LLM Agent Systems: Threats, Amplification, and Case Studies', id: '2606.23075', date: 'June 2026' },
  { authors: '', title: 'Memory Poisoning Attack and Defense on Memory Based LLM-Agents', id: '2601.05504', date: 'January 2026' },
  { authors: 'Chen, Zaharia, Zou', title: "How is ChatGPT's behavior changing over time?", id: '2307.09009', date: 'July 2023' },
  { authors: 'Betley et al.', title: 'Emergent Misalignment: Narrow finetuning can produce broadly misaligned LLMs', id: '2502.17424', date: 'February 2025' },
  { authors: 'Rath', title: 'Agent Drift: Quantifying Behavioral Degradation in Multi-Agent LLM Systems Over Extended Interactions', id: '2601.04170', date: 'January 2026' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kyde.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://kyde.com/resources' },
    { '@type': 'ListItem', position: 3, name: 'Behavioral Drift in AI Agents', item: 'https://kyde.com/behavioral-drift' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Behavioral Drift in AI Agents',
  description: 'Behavioral drift is not one well-defined phenomenon. Seven related ways agent behavior can change, what the research shows, and which signals are visible in production logs.',
  author: { '@type': 'Organization', name: 'Kyde', url: 'https://kyde.com' },
  publisher: { '@type': 'Organization', name: 'Kyde', url: 'https://kyde.com' },
  citation: sources.map(({ title, id }) => `${title}, arXiv:${id}`),
};
---

<Base
  title="Behavioral Drift in AI Agents: Seven Forms and What Your Logs Can Show | KYDE"
  description="Behavioral drift is not a single, well-defined phenomenon. At least seven related ways agent behavior can change, what recent research actually shows, which signals are measurable from production logs and at what cost, and where the evidence is still missing."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>
  <Navbar />
  <main>
    <div class="border-b border-line-0 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-4 md:border-x md:border-line-0 flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-1">Recording this from your own systems is what Kyde Zero Trust does.</p>
        <a href="/" class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-0 border-b border-line-1 hover:border-ink-0 transition-colors">See it →</a>
      </div>
    </div>

    <!-- ══════════ OPENING ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-20 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-center gap-3 mb-3">
            <a href="/resources" class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1 hover:text-ink-0 transition-colors">↑ Resources</a>
            <span class="text-ink-1">/</span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Research note · Sources checked September 2026</span>
          </div>
          <div class="h-px w-full bg-line-0"></div>
        </div>
        <h1 class="hero-h1 max-w-4xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl mb-8">
          Behavioral drift in <span class="gradient-text">AI agents</span>
        </h1>
        <p class="text-lg md:text-xl text-ink-0 leading-relaxed max-w-3xl border-l-2 border-line-1 pl-6">
          If you run AI agents in production, their behavior can change over time. Not necessarily through an outage or an obvious attack. An agent can keep running, complete tasks, and report success, while behaving differently from how it behaved before.
        </p>
        <div class="max-w-3xl mt-8 space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            We have been looking into what the research actually says about this. One thing became clear quickly: behavioral drift is not a single, well-defined phenomenon.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Across recent research, we found at least seven related ways in which agent behavior can change or become less reliable.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ THE SEVEN FORMS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-8">Seven related forms</p>
        <div class="overflow-x-auto">
          <table class="w-full border border-line-0 text-sm">
            <tbody class="divide-y divide-line-0">
              {forms.map(({ name, what }) => (
                <tr>
                  <td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ink-0 align-top whitespace-nowrap">{name}</td>
                  <td class="px-5 py-4 text-sm text-ink-1 align-top">{what}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-base text-ink-1 max-w-3xl leading-relaxed">
          This is our synthesis of the literature, not a standardized scientific taxonomy.
        </p>
      </div>
    </section>

    <!-- ══════════ INHERITANCE ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Drift can move between agents</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            One particularly interesting recent finding concerns multi-agent systems.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            A March 2026 study tested agents in equity trading and emergency-department triage. Models that resisted direct attempts to change their goals could adopt a deviation when they were given the history of another agent that had already deviated.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The study also found that instruction-following ability was not a reliable indicator of resistance to this kind of inherited drift.
          </p>
        </div>
        <blockquote class="mt-10 max-w-3xl border-l-2 border-line-1 pl-6">
          <p class="text-lg md:text-xl text-ink-0 leading-relaxed">
            In other words, a stronger model downstream does not necessarily compensate for a weaker agent upstream.
          </p>
        </blockquote>
      </div>
    </section>

    <!-- ══════════ STOPPING EARLY ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Agents can stop before the work is actually done</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Several recent studies point to another pattern in long-horizon tasks. Agents can repeat work, submit duplicates, report completion too early, or continue working without making meaningful progress.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            PushBench provides a useful way of measuring this. Rather than looking only at the final success flag, it tracks whether the agent actually makes progress toward a quantitatively defined goal.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            In the authors' experiments, state-tracking controls substantially improved performance on long-horizon tasks and eliminated duplicate submissions.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            This is interesting from an operational perspective because some of these signals are visible without access to the model itself.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ REWARD HACKING ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Reward hacking is related, but different</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Reward hacking is often discussed alongside behavioral drift. But there is an important distinction: reward hacking does not necessarily involve behavior changing over time. The specification can be imperfect from the beginning, and the agent discovers the gap.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Recent benchmark work found exploit rates ranging from 0 percent to 13.9 percent across tested frontier models. In 72 percent of the reward-hacking episodes in one study, the reasoning trace contained an explicit rationale for the exploit.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            The practical lesson is not that models inevitably reward-hack. It is that successful task completion is not always enough to establish that the intended objective was achieved.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ AUDITS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Audits only show what happens under the conditions of the audit</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Research into agentic misalignment has also raised a different question: how representative are evaluations of production behavior?
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            In Anthropic's simulated corporate environments, models from multiple providers exhibited harmful behavior in scenarios involving conflicts between their objectives and the organization's interests.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            These were controlled experiments, not observations of real-world deployments. The authors explicitly make that distinction.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            A useful implication for operators is that an evaluation tells you something about behavior under the conditions in which it was performed. Continuous observation can add a different kind of evidence: what the system actually did in production.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ MEMORY ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Memory can turn an isolated event into a persistent one</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Memory introduces another dimension. Recent research on self-evolving agents shows how certain attacks or behavioral changes can persist through memory and self-modification rather than disappearing when a session ends.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            At the same time, other research shows that memory-based attacks can become significantly less effective when tested against realistic stores containing genuine memories.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            The picture is therefore more nuanced than "memory makes agents unsafe."
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            What matters is whether a change can persist, propagate, and influence future runs.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ WHAT A LOG CAN SHOW ══════════ -->
    <section class="border-t border-line-1 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">What can you actually measure from production logs?</p>
        <p class="text-base text-ink-1 leading-relaxed max-w-3xl mb-10">
          This is where we think the topic becomes particularly practical. Not every form costs the same to observe.
        </p>
        <div class="border border-line-0 divide-y divide-line-0 bg-bg-0">
          {readout.map(({ tier, tone, lead, items }) => (
            <div class="grid md:grid-cols-[180px_1fr] gap-4 md:gap-10 px-6 py-7 md:px-8 md:py-8">
              <div>
                <span class:list={[
                  'inline-block font-mono text-[10px] uppercase tracking-[0.16em] border px-2.5 py-1',
                  tone === 'live' ? 'text-live border-live/30 bg-live/[0.08]' : '',
                  tone === 'warn' ? 'text-warn border-warn/30 bg-warn/[0.08]' : '',
                  tone === 'ember' ? 'text-ember border-ember/30 bg-ember/[0.08]' : '',
                ]}>{tier}</span>
              </div>
              <div>
                <p class="text-sm text-ink-2 leading-relaxed mb-4">{lead}</p>
                <ul class="space-y-2">
                  {items.map((item) => (
                    <li class="flex gap-3 text-base text-ink-1 leading-relaxed">
                      <span class="font-mono text-ink-2 shrink-0" aria-hidden="true">·</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-8 text-base text-ink-0 leading-relaxed max-w-3xl">
          This suggests a practical starting point: begin with the signals already visible in production traffic.
        </p>
      </div>
    </section>

    <!-- ══════════ GAPS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-8">What the research still does not have</p>
        <p class="text-base text-ink-1 leading-relaxed max-w-3xl mb-10">
          There are some important gaps.
        </p>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-0">
          {gaps.map(({ n, head, body }) => (
            <div class="border-t border-line-0 py-6">
              <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ink-2 mb-3">{n}</span>
              <p class="text-base font-semibold text-ink-0 leading-snug mb-2">{head}</p>
              <p class="text-sm text-ink-1 leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ THE GAP WE WORK ON ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="max-w-3xl">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.05] text-ink-0 mb-5">
            This is the gap we are interested in.
          </h2>
          <div class="space-y-4 mb-8">
            <p class="text-base text-ink-1 leading-relaxed">
              At Kyde, we are exploring whether production records can become a practical basis for measuring behavioral change over time. If every agent action is recorded at the boundary, outside the agent's control, you can build a history of what actually happened. That record can provide evidence for audits, investigations and comparisons between past and present behavior.
            </p>
            <p class="text-base text-ink-0 leading-relaxed border-l-2 border-line-1 pl-6">
              Our hypothesis is simple: if you can reliably record what an agent did, you can start measuring how its behavior changes.
            </p>
            <p class="text-base text-ink-1 leading-relaxed">
              That is the part we are working on. We are still learning too. If you are working on agent evaluation, observability or behavioral drift, we would be interested in what you are seeing.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <button onclick="openModal()" class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all w-fit">
              Tell us what you are seeing →
            </button>
            <a href="/" class="inline-flex items-center gap-2 border border-line-1 text-ink-0 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-ink-0 transition-all w-fit">
              See the platform →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ SOURCES ══════════ -->
    <section class="border-t border-line-1 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="mb-8">
          <div class="flex items-end justify-between border-b border-line-0 pb-3 gap-4">
            <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">The research this draws on</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-2">Every entry links to its abstract</span>
          </div>
        </div>
        <ul class="max-w-4xl space-y-3">
          {sources.map(({ authors, title, id, date }) => (
            <li class="text-sm text-ink-1 leading-relaxed">
              {authors && <span>{authors}: </span>}
              <em class="text-ink-0 not-italic font-medium">{title}</em>,{' '}
              <a href={`https://arxiv.org/abs/${id}`} rel="nofollow noopener" class="font-mono text-xs text-ink-1 border-b border-line-1 hover:text-ink-0 hover:border-ink-0 transition-colors">arXiv:{id}</a>{' '}
              <span class="text-ink-2">({date})</span>
            </li>
          ))}
        </ul>
        <p class="mt-10 font-mono text-xs text-ink-2">
          Related: <a href="/blog/agent-goal-hijacking" class="hover:text-ink-0 transition-colors">Agent Goal Hijacking</a> · <a href="/eu-ai-act-compliance" class="hover:text-ink-0 transition-colors">EU AI Act Compliance</a> · <a href="/zero-trust-for-ai-agents" class="hover:text-ink-0 transition-colors">Zero Trust for AI Agents</a> · <a href="/ai-agent-insurance" class="hover:text-ink-0 transition-colors">AI Agent Insurance</a> · <a href="/glossary/agent-autonomy-levels" class="hover:text-ink-0 transition-colors">Autonomy Levels</a>
        </p>
      </div>
    </section>

    <LegalNotice />
  </main>
  <Footer />
</Base>
