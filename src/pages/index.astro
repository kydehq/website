---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Base
    title="KYDE — Prevent · Prove · Rate."
    description="KYDE is the behavioral firewall between AI agents and the real world: we prevent what must not happen, prove what did, and rate agent behavior across every provider. The suspect can't write the police report."
>
    <Navbar />

    <main>
        <!-- ══════════ HERO STAGE ══════════ -->
        <section class="relative overflow-hidden h-screen min-h-[600px] flex flex-col justify-center pt-20">
            <video class="absolute inset-0 w-full h-full object-cover hero-video" muted loop playsinline poster="/stage-poster.jpg">
