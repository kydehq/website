                <script>
                        // FIG.3 · the cycle ticks. The triangle is rigid; every
                        // ~10s it rotates one step like a slow clock, and a
                        // pulse breathes out of the center as it moves.
                        const vprReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                        const fig = document.getElementById("vpr-fig");

                        if (fig && !vprReduced) {
                            const $ = (id: string) => document.getElementById(id)!;
                            const outer = $("vpr-outer");
                            const inner = $("vpr-inner");
                            const center = $("vpr-center");
                            const pulse = $("vpr-pulse");
                            const nodes = [0, 1, 2].map((i) => $(`vpr-node-${i}`));
                            const labels = [0, 1, 2].map((i) => $(`vpr-label-${i}`));
                            const arrows = [0, 1, 2].map((i) => $(`vpr-arrow-${i}`));

                            const anchors = [
                                { x: 260, y: 70 },
                                { x: 440, y: 390 },
                                { x: 80, y: 390 },
                            ];
                            const C = {
                                x: (anchors[0].x + anchors[1].x + anchors[2].x) / 3,
                                y: (anchors[0].y + anchors[1].y + anchors[2].y) / 3,
                            };
                            const base = anchors.map((a) => ({
                                r: Math.hypot(a.x - C.x, a.y - C.y),
                                ang: Math.atan2(a.y - C.y, a.x - C.x),
                            }));

                            const TICK_EVERY = 4000;  // ms between ticks
                            const TICK_DUR = 1100;    // rotation ease duration
                            const PULSE_DUR = 1800;   // center pulse duration
                            const STEP = Math.PI / 6; // 30° per tick, like minute marks

                            let angleFrom = 0, angleTo = 0, angle = 0;
                            let tickStart = -1e9;
                            let nextTick = performance.now() + 2500;

                            const easeInOut = (x: number) =>
                                x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;

                            let visible = true;
                            new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(fig);

                            center.setAttribute("x", String(C.x));
                            center.setAttribute("y", String(C.y + 4));
                            pulse.setAttribute("cx", String(C.x));
                            pulse.setAttribute("cy", String(C.y));

                            function frame(t: number) {
                                if (visible) {
                                    if (t >= nextTick) {
                                        angleFrom = angleTo;
                                        angleTo += STEP;
                                        tickStart = t;
                                        nextTick = t + TICK_EVERY;
                                    }

                                    const rp = Math.min((t - tickStart) / TICK_DUR, 1);
                                    angle = angleFrom + (angleTo - angleFrom) * easeInOut(rp);

                                    // pulse breathing out of the center during the tick
                                    const pp = (t - tickStart) / PULSE_DUR;
                                    if (pp >= 0 && pp <= 1) {
                                        pulse.setAttribute("r", String(16 + pp * 150));
                                        pulse.setAttribute("opacity", String((1 - pp) * 0.55));
                                    } else {
                                        pulse.setAttribute("opacity", "0");
                                    }
                                    const breath = pp >= 0 && pp <= 1 ? Math.sin(pp * Math.PI) * 0.05 : 0;

                                    const v = base.map((b) => ({
                                        x: C.x + b.r * Math.cos(b.ang + angle),
                                        y: C.y + b.r * Math.sin(b.ang + angle),
                                    }));

                                    outer.setAttribute("d", `M${v[0].x} ${v[0].y} L${v[1].x} ${v[1].y} L${v[2].x} ${v[2].y} Z`);

                                    const s = 0.52 + breath;
                                    const inV = v.map((p) => ({ x: C.x + (p.x - C.x) * s, y: C.y + (p.y - C.y) * s }));
                                    inner.setAttribute("d", `M${inV[0].x} ${inV[0].y} L${inV[1].x} ${inV[1].y} L${inV[2].x} ${inV[2].y} Z`);

                                    for (let i = 0; i < 3; i++) {
                                        nodes[i].setAttribute("x", String(v[i].x - 3.5));
                                        nodes[i].setAttribute("y", String(v[i].y - 3.5));

                                        // labels sit outward from the center, always upright
                                        const dx = v[i].x - C.x, dy = v[i].y - C.y;
                                        const d = Math.hypot(dx, dy);
                                        labels[i].setAttribute("x", String(v[i].x + (dx / d) * 30));
                                        labels[i].setAttribute("y", String(v[i].y + (dy / d) * 30 + 4));

                                        const a = v[i], b = v[(i + 1) % 3];
                                        const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
                                        const ang = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
                                        arrows[i].setAttribute("transform", `translate(${mx},${my}) rotate(${ang})`);
                                    }
                                }
                                requestAnimationFrame(frame);
                            }
                            requestAnimationFrame(frame);
                        }
                    </script>
            </div>
        </section>

