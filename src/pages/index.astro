                            <rect id="vpr-node-2" x="76.5" y="386.5" width="7" height="7" fill="var(--color-ink-0)" />
                            <text id="vpr-label-2" x="72" y="424" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.85" style="font-family:'JetBrains Mono Variable',monospace;font-size:11px;letter-spacing:0.18em;">RATE</text>
