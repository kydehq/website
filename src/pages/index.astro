            <script>
                // forecast-fig · ten steps of one process area in a single row, ordered
                // by the moment each becomes available. The sweep is six months of
                // calendar passing, so a step lighting up as the line reaches it is the
                // whole idea: nobody did anything, the date arrived. The last three
                // never light, and they are the reason the count is worth believing.
                const fcFig = document.getElementById("forecast-fig");
                const fcReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (fcFig) {
                    const NS = "http://www.w3.org/2000/svg";
                    const X0 = 43, W = 34, GAP = 6, Y = 118, H = 34;
                    const SWEEP = 7000, HOLD = 2200;
                    // "at" is when the step becomes available, as a share of the window.
                    // 0 means it already runs; null means not inside this window at all.
                    const STEPS = [
                        { at: 0 }, { at: 0 }, { at: 0 },
                        { at: 0.30 }, { at: 0.56 }, { at: 0.82 },
                        { at: null },
                        { person: true }, { person: true }, { person: true },
                    ];

                    const layer = document.getElementById("fc-cells");
                    const head = document.getElementById("fc-head");
                    const count = document.getElementById("fc-count");
                    const cells = [];

                    STEPS.forEach((s, i) => {
                        const x = X0 + i * (W + GAP);
                        const r = document.createElementNS(NS, "rect");
                        r.setAttribute("x", String(x));
                        r.setAttribute("y", String(Y));
                        r.setAttribute("width", String(W));
                        r.setAttribute("height", String(H));
                        r.setAttribute("stroke-width", "1");
                        layer.appendChild(r);
                        cells.push(r);
                        if (s.person) {
                            const d = document.createElementNS(NS, "circle");
                            d.setAttribute("cx", String(x + W / 2));
                            d.setAttribute("cy", String(Y + H / 2));
                            d.setAttribute("r", "2.5");
                            d.setAttribute("fill", "var(--color-ink-0)");
                            d.setAttribute("fill-opacity", "0.55");
                            layer.appendChild(d);
                        }
                    });

                    const paint = (t) => {
                        head.setAttribute("x1", String(X0 + (437 - X0) * t));
                        head.setAttribute("x2", String(X0 + (437 - X0) * t));
                        let on = 0;
                        STEPS.forEach((s, i) => {
                            const lit = !s.person && s.at !== null && t >= s.at;
                            if (lit) on++;
                            const c = cells[i];
                            if (s.person) {
                                c.setAttribute("fill", "none");
                                c.setAttribute("stroke", "var(--color-ink-0)");
                                c.setAttribute("stroke-opacity", "0.35");
                            } else if (lit) {
                                c.setAttribute("fill", "var(--color-live)");
                                c.setAttribute("fill-opacity", "0.8");
                                c.setAttribute("stroke", "none");
                            } else {
                                c.setAttribute("fill", "none");
                                c.setAttribute("stroke", "var(--color-ember)");
                                c.setAttribute("stroke-opacity", "0.6");
                            }
                        });
                        count.textContent = String(on);
                    };

                    if (fcReduced) {
                        paint(1);
                    } else {
                        let visible = false;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(fcFig);
                        let start = 0;
                        function fcFrame(now) {
                            if (visible) {
                                if (!start) start = now;
                                const el = now - start;
                                if (el < SWEEP) paint(el / SWEEP);
                                else if (el < SWEEP + HOLD) paint(1);
                                else { start = now; paint(0); }
                            }
                            requestAnimationFrame(fcFrame);
                        }
                        paint(0);
                        requestAnimationFrame(fcFrame);
                    }
                }
            </script>
