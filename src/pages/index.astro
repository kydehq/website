---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// Orthographic dot-sphere for the closing ornament
const SPHERE_R = 290;
const sphereDots: { x: number; y: number; a: number }[] = [];
for (let lat = -80; lat <= 80; lat += 8) {
    for (let lon = -80; lon <= 80; lon += 8) {
        const la = (lat * Math.PI) / 180;
        const lo = (lon * Math.PI) / 180;
        sphereDots.push({
            x: 320 + SPHERE_R * Math.sin(lo) * Math.cos(la),
            y: 320 + SPHERE_R * Math.sin(la),
            a: 0.04 + 0.16 * Math.cos(lo) * Math.cos(la),
        });
    }
}

const orgSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "KYDE",
    url: "https://kyde.com",
    logo: "https://kyde.com/kyde-logo.svg",
    description: "KYDE is the behavioral system of record for autonomous work: verifiable identity, short-lived capabilities, real-time policy enforcement at the boundary, and a hash-chained, tamper-evident record of every agent action routed through it.",
};

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KYDE",
    url: "https://kyde.com",
};
---

<Base
    title="KYDE · Deploy AI Agents With Confidence"
    description="Identity, capabilities, real-time enforcement and a tamper-evident record, on every agent action routed through it. The behavioral system of record for autonomous work. Built for GDPR, EU AI Act, NIS-2, DORA."
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    </Fragment>
    <Navbar />

    <main>
        <!-- ══════════ HERO STAGE ══════════ -->
        <section class="relative overflow-hidden h-screen min-h-[600px] flex flex-col justify-center pt-20 border-b border-line-0 bg-bg-0">
            <canvas id="hero-datastream" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
            <div class="absolute inset-0 pointer-events-none hero-noise"></div>
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-bg-0 via-bg-0/45 to-transparent"></div>
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-transparent to-bg-0"></div>

            <div class="relative max-w-7xl mx-auto px-6 w-full">
                <!-- Regulation register: the one above-fold cue for why a buyer needs us.
                     Wording mirrors the design-partner line further down, so the claim is repeated, not re-opened. -->
                <p id="hero-eyebrow" class="mb-4 md:mb-5 font-mono text-[10px] md:text-[11px] text-white/55 uppercase tracking-[0.16em] md:tracking-[0.2em]" style="opacity:0;transition:opacity 0.9s ease;">
                    Built for GDPR <span class="text-white/30" aria-hidden="true">·</span> EU AI Act <span class="text-white/30" aria-hidden="true">·</span> NIS-2 <span class="text-white/30" aria-hidden="true">·</span> DORA
                </p>
                <!-- Short headline again: the widest line is ~9.5px per font-px, so 72px needs
                     686px and clears every container down to 768px. Base is 2rem rather than
                     text-4xl so it still fits one line on a 375px phone. -->
                <h1 class="hero-h1 text-[2rem] text-white uppercase tracking-tight leading-none sm:text-5xl md:text-6xl lg:text-7xl" style="opacity:0;">
                    <span id="hero-l1" style="display:block">One Record.</span>
                    <span id="hero-l2" style="display:block">Every Vendor.</span>
                </h1>
                <p id="hero-sub" class="mt-5 md:mt-7 text-sm md:text-base lg:text-lg text-white uppercase tracking-[0.12em] leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease;">
                    The Behavioral System of Record for Autonomous Work.
                </p>
                <p id="hero-explainer" class="mt-3 text-sm md:text-base text-white/70 leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease 0.15s;">
                    Identity, scope, enforcement and a signed record — held outside every platform your agents run on.
                </p>
                <!-- Hero CTAs mirror the navbar: download is the primary goal, contact stays one click away -->
                <div id="hero-ctas" class="mt-8 flex flex-col sm:flex-row gap-4" style="opacity:0;transition:opacity 0.9s ease 0.5s;">
                    <button
                        onclick="openModal()"
                        class="inline-flex items-center gap-2 border border-white/40 text-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:border-white hover:bg-white/10 transition-all"
                    >
                        Talk to Us →
                    </button>
                    <a
                        href="/starter"
                        class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:bg-cta-hover transition-all"
                    >
                        Start Free →
                    </a>
                </div>
                <p class="mt-8 font-mono text-sm" style="opacity:0;transition:opacity 0.9s ease 0.7s;" id="hero-terminal">
                    <span class="text-live">$</span> <span class="text-white/50">export OPENAI_BASE_URL=https://kyde.intranet/v1</span><span class="cursor-blink" aria-hidden="true"></span>
                </p>
            </div>

        </section>


<script>
  const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const SPEED = 0.22;

  function scrambleLine(el: HTMLElement, target: string, delay: number, onDone?: () => void) {
    let frame = 0;
    setTimeout(() => {
      el.innerText = target;
      const finalH = el.offsetHeight;
      el.style.height = finalH + "px";
      el.style.overflow = "hidden";

      function tick() {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          if (i < frame) {
            out += target[i];
          } else if (target[i] === " " || target[i] === ".") {
            out += target[i];
          } else {
            out += CHARS[Math.floor(Math.random() * CHARS.length)];
          }
        }
        el.innerText = out;
        frame += SPEED;
        if (frame < target.length) {
          requestAnimationFrame(tick);
        } else {
          el.innerText = target;
          el.style.height = "";
          el.style.overflow = "";
          if (onDone) onDone();
        }
      }
      tick();
    }, delay);
  }

  const l1 = document.getElementById("hero-l1") as HTMLElement;
  const l2 = document.getElementById("hero-l2") as HTMLElement;
  const sub = document.getElementById("hero-sub") as HTMLElement;
  const eyebrow = document.getElementById("hero-eyebrow") as HTMLElement;
  const h1 = l1?.closest("h1") as HTMLElement;
  if (h1) { h1.style.animation = "none"; h1.style.opacity = "0"; }
  const explainer = document.getElementById("hero-explainer") as HTMLElement;
  const ctas = document.getElementById("hero-ctas") as HTMLElement;
  if (l1) scrambleLine(l1, "ONE RECORD.", 200);
  if (l2) scrambleLine(l2, "EVERY VENDOR.", 200, () => {
    if (eyebrow) eyebrow.style.opacity = "1";
    if (sub) sub.style.opacity = "1";
    if (explainer) explainer.style.opacity = "1";
    if (ctas) ctas.style.opacity = "1";
    const term = document.getElementById("hero-terminal");
    if (term) term.style.opacity = "1";
  });
  setTimeout(() => { if (h1) h1.style.opacity = "1"; }, 200);

  // ── Boundary-gate figure ────────────────────────────────────────
  // Geometric, not "rain": unordered agents drift on the left,
  // cross the vertical gate line, and snap into a strict lattice , 
  // ungoverned chaos becomes governed order. Rare green pulse at
  // crossing (recorded), rare red flash bouncing off (blocked).
  const canvas = document.getElementById("hero-datastream") as HTMLCanvasElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0, GATE = 0, ROW = 26;

    // Theme-aware palette: the figure is drawn from CSS tokens, not literal
    // rgb triples, so it inverts cleanly (light ink on dark, dark ink on
    // light) instead of staying a fixed dark box when the theme toggles.
    const C = { ink: "242,242,242", live: "61,220,132", alert: "255,92,92" };
    function hexToRgb(hex: string): string {
      const m = hex.trim().replace("#", "");
      const n = parseInt(m.length === 3 ? m.split("").map((c) => c + c).join("") : m, 16);
      return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`;
    }
    function readColors() {
      const cs = getComputedStyle(document.documentElement);
      C.ink = hexToRgb(cs.getPropertyValue("--color-ink-0") || "#F2F2F2");
      C.live = hexToRgb(cs.getPropertyValue("--color-live") || "#3DDC84");
      C.alert = hexToRgb(cs.getPropertyValue("--color-alert") || "#FF5C5C");
    }
    readColors();

    function hash(n: number): number {
      let t = (n + 0x6d2b79f5) | 0;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }

    type P = {
      x: number; y: number; vx: number; seed: number;
      state: "wild" | "signed" | "blocked";
      rowY: number; pulse: number;
    };
    let parts: P[] = [];

    // occasional bloom when a particle crosses the gate
    type Flare = { x: number; y: number; t0: number };
    let flares: Flare[] = [];
    let lastFlare = 0;

    function spawn(p: P, i: number, initial = false) {
      p.x = initial ? hash(i * 7 + 1) * GATE : -10 - hash(i * 13) * 60;
      p.y = 40 + hash(i * 31 + performance.now() % 9973) * (H - 80);
      p.vx = 12 + hash(i * 17) * 22;
      p.seed = i * 7919 + Math.floor(performance.now());
      p.state = "wild";
      p.pulse = 0;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      GATE = W * 0.68;
      parts = [];
      const n = Math.max(40, Math.floor(W / 16));
      for (let i = 0; i < n; i++) {
        const p = {} as P;
        spawn(p, i, true);
        parts.push(p);
      }
    }

    let last = 0;
    function draw(t: number) {
      const dt = Math.min((t - last) / 1000, 0.05) || 0.016;
      last = t;
      ctx.clearRect(0, 0, W, H);

      // lattice on the governed side, faint, strict
      ctx.fillStyle = `rgba(${C.ink},0.08)`;
      for (let x = GATE + ROW; x < W; x += ROW)
        for (let y = ROW; y < H; y += ROW)
          ctx.fillRect(x - 0.75, y - 0.75, 1.5, 1.5);

      // gate line, nearly invisible at the ends, a faint shimmer mid-height;
      // it reveals itself through interaction (blooms, blocks), not presence
      const gateGrad = ctx.createLinearGradient(0, 0, 0, H);
      gateGrad.addColorStop(0, `rgba(${C.ink},0)`);
      gateGrad.addColorStop(0.5, `rgba(${C.ink},0.13)`);
      gateGrad.addColorStop(1, `rgba(${C.ink},0)`);
      ctx.fillStyle = gateGrad;
      ctx.fillRect(GATE, 0, 1, H);
      for (let y = 0; y < H; y += ROW * 2) {
        const env = Math.sin((Math.PI * y) / H);
        ctx.fillStyle = `rgba(${C.ink},${0.16 * env * env})`;
        ctx.fillRect(GATE - 3, y, 7, 1);
      }

      for (const p of parts) {
        const jitterSeed = p.seed + Math.floor(t / 300);

        if (p.state === "wild") {
          // brownian drift with slow right bias
          p.x += p.vx * dt;
          p.y += (hash(jitterSeed) - 0.5) * 34 * dt * 2.2;

          if (p.x >= GATE) {
            if (hash(p.seed + 5) > 0.93) {
              p.state = "blocked";
              p.pulse = 1;
              p.vx = -18;
            } else {
              p.state = "signed";
              p.pulse = hash(p.seed + 9) > 0.7 ? 1 : 0;
              p.rowY = Math.round(p.y / ROW) * ROW;
              p.vx = 26 + hash(p.seed + 3) * 18;
              // every few seconds, one crossing blooms
              if (t - lastFlare > 2100 && hash(p.seed + 11) > 0.4) {
                flares.push({ x: GATE, y: p.rowY, t0: t });
                lastFlare = t;
              }
            }
          }
          ctx.fillStyle = `rgba(${C.ink},0.32)`;
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
        } else if (p.state === "signed") {
          p.x += p.vx * dt;
          p.y += (p.rowY - p.y) * Math.min(dt * 6, 1); // snap to lattice row

          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(${C.live},${p.pulse * 0.7})`;
            ctx.lineWidth = 1;
            ctx.strokeRect(p.x - 4, p.y - 4, 8, 8);
            p.pulse -= dt * 1.4;
          }
          ctx.fillStyle = `rgba(${C.ink},0.68)`;
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);

          if (p.x > W + 10) spawn(p, Math.floor(p.seed / 7919));
        } else {
          // blocked: red flash at the gate, drift back, fade
          p.x += p.vx * dt;
          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(${C.alert},${p.pulse * 0.8})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p.x + 4, p.y - 4); ctx.lineTo(p.x - 4, p.y + 4);
            ctx.moveTo(p.x - 4, p.y - 4); ctx.lineTo(p.x + 4, p.y + 4);
            ctx.stroke();
            p.pulse -= dt * 0.9;
          } else {
            spawn(p, Math.floor(p.seed / 7919));
          }
        }
      }

      // flares, soft light bloom at the gate, expanding and fading
      flares = flares.filter((f) => t - f.t0 < 1600);
      for (const f of flares) {
        const age = (t - f.t0) / 1600; // 0 → 1
        const ease = 1 - Math.pow(1 - age, 2);
        const r = 16 + ease * 130;
        const a = (1 - age) * 0.85;

        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, r);
        g.addColorStop(0, `rgba(${C.ink},${a})`);
        g.addColorStop(0.25, `rgba(${C.ink},${a * 0.35})`);
        g.addColorStop(0.6, `rgba(${C.live},${a * 0.22})`);
        g.addColorStop(1, `rgba(${C.live},0)`);
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(f.x, f.y, r, 0, Math.PI * 2);
        ctx.fill();

        // bright core that snuffs out quickly
        if (age < 0.35) {
          ctx.fillStyle = `rgba(${C.ink},${(1 - age / 0.35) * 0.9})`;
          ctx.fillRect(f.x - 2, f.y - 2, 4, 4);
        }

        // brief brightening of the gate line around the bloom
        const gl = ctx.createLinearGradient(f.x, f.y - r, f.x, f.y + r);
        gl.addColorStop(0, `rgba(${C.ink},0)`);
        gl.addColorStop(0.5, `rgba(${C.ink},${a * 0.8})`);
        gl.addColorStop(1, `rgba(${C.ink},0)`);
        ctx.fillStyle = gl;
        ctx.fillRect(GATE, f.y - r, 1, r * 2);
      }
    }

    resize();
    window.addEventListener("resize", resize);

    // Re-read the palette on theme toggle. The running rAF loop repaints
    // every frame anyway and will pick the new colors up on its own; the
    // reduced-motion path only ever draws once, so it needs an explicit nudge.
    window.addEventListener("kyde:theme", () => {
      readColors();
      if (reduced) draw(performance.now());
    });

    if (reduced) {
      draw(1);
    } else {
      let heroVisible = true;
      new IntersectionObserver((es) => { heroVisible = es[0].isIntersecting; }).observe(canvas);
      const loop = (t: number) => { if (heroVisible) draw(t); requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
  }
</script>

        <!-- ══════════ THE LAYER IN THE MIDDLE ══════════ -->
        <!-- First thing past the fold. The topology is the argument: a reader has to
             see that everything crosses one place before "system of record" means
             anything. FIG.1 is full-width for that reason, like the ladder further
             down, and it is the only figure on the page that shows the whole shape. -->
        <section class="border-b border-white/10 bg-bg-0">
            <div class="max-w-7xl mx-auto px-6 py-20 md:py-28 md:border-x md:border-white/10">

                <div class="flex items-end justify-between border-b border-white/10 pb-3 mb-12">
                    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/65">What you cannot answer today</span>
                    <span class="fig-label">FIG.1</span>
                </div>

                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-white mb-4 max-w-4xl">
                    Your agents are doing work you cannot see, stop, attribute or prove.
                </h2>
                <p class="font-mono text-sm text-white/70 uppercase tracking-[0.12em] mb-8">Everything they do crosses one layer. That is where it stops being traffic.</p>
                <p class="text-lg text-white/55 leading-relaxed max-w-3xl mb-12">
                    A company running on agents does not run on one platform. The agents answer to different vendors, and the systems they reach, databases, MCP servers, ERP, payment APIs, belong to nobody in particular either. KYDE sits in the middle of that traffic and writes every action routed through it into a single chain as it passes. That is why the record of that traffic is whole: something standing beside the action only ever sees what happened. This sees what was not allowed to. What comes out the other side is a behavioral system of record.
                </p>

                <!-- The plot frame gives the topology something to stand in, same
                     treatment as the ladder figure. -->
                <div class="border border-white/10 bg-white/[0.02] px-4 py-5 md:px-8 md:py-7">
                    <div class="flex items-end justify-between border-b border-white/10 pb-3 mb-6">
                        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45">One record, written where the action passes</span>
                        <span class="fig-label">FIG.1</span>
                    </div>
                    <svg id="spine-fig" viewBox="0 0 1000 420" class="w-full h-auto" aria-hidden="true">
                        <!-- corner register marks, as on every other figure -->
                        <path d="M6 21 L6 6 L21 6" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
                        <path d="M979 6 L994 6 L994 21" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
                        <path d="M6 399 L6 414 L21 414" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
                        <path d="M994 399 L994 414 L979 414" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />

                        <text x="40" y="34" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">A COMPANY THAT RUNS ON AGENTS</text>
                        <text x="960" y="34" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">THE SYSTEMS THEY REACH</text>

                        <!-- left: the agent fleet, by function rather than by three
                             generic boxes, so "a whole company" is visible at a glance -->
                        {[
                            { y: 96,  l: "CODING" },
                            { y: 148, l: "SUPPORT" },
                            { y: 200, l: "FINANCE" },
                            { y: 252, l: "HR" },
                            { y: 304, l: "OPS" },
                        ].map(({ y, l }) => (
                            <>
                                <rect x="40" y={y - 16} width="132" height="32" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.30" stroke-width="1" />
                                <text x="106" y={y + 4} text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.6" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.12em;">{l}</text>
                                <line x1="172" y1={y} x2="436" y2={y} stroke="var(--color-ink-0)" stroke-opacity="0.14" stroke-width="1" stroke-dasharray="3 6" />
                                <line x1="564" y1={y} x2="828" y2={y} stroke="var(--color-ink-0)" stroke-opacity="0.14" stroke-width="1" stroke-dasharray="3 6" />
                            </>
                        ))}

                        <!-- right: the systems, which belong to as many vendors as the agents do -->
                        {[
                            { y: 96,  l: "POSTGRES" },
                            { y: 148, l: "MCP SERVERS" },
                            { y: 200, l: "SAP · ERP" },
                            { y: 252, l: "STRIPE" },
                            { y: 304, l: "S3" },
                        ].map(({ y, l }) => (
                            <>
                                <rect x="828" y={y - 16} width="132" height="32" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.30" stroke-width="1" />
                                <text x="894" y={y + 4} text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.6" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.12em;">{l}</text>
                            </>
                        ))}

                        <!-- the spine: one layer, full height, nothing routes around it -->
                        <rect x="436" y="64" width="128" height="276" fill="var(--color-bg-0)" stroke="var(--color-ink-0)" stroke-opacity="0.60" stroke-width="1.5" />
                        <text x="500" y="190" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.9" style="font-family:'JetBrains Mono Variable',monospace;font-size:19px;font-weight:700;letter-spacing:0.22em;">KYDE</text>
                        <text x="500" y="212" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.50" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.14em;">one record</text>

                        <!-- what leaves the spine downward is the chain itself -->
                        <line x1="500" y1="340" x2="500" y2="366" stroke="var(--color-live)" stroke-opacity="0.50" stroke-width="1" stroke-dasharray="3 4" />

                        <defs>
                            <radialGradient id="spine-glow">
                                <stop offset="0%" stop-color="var(--color-ink-0)" stop-opacity="0.9" />
                                <stop offset="25%" stop-color="var(--color-ink-0)" stop-opacity="0.32" />
                                <stop offset="60%" stop-color="var(--color-live)" stop-opacity="0.2" />
                                <stop offset="100%" stop-color="var(--color-live)" stop-opacity="0" />
                            </radialGradient>
                        </defs>
                        <g id="spine-blooms"></g>
                        <g id="spine-actions"></g>
                        <!-- the chain scrolls under a clip, so links leave the frame
                             instead of piling up at the left edge -->
                        <clipPath id="spine-chain-clip"><rect x="30" y="348" width="940" height="48" /></clipPath>
                        <g clip-path="url(#spine-chain-clip)"><g id="spine-chain"></g></g>

                        <text x="40" y="410" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.14em;">ed25519 · sha-256 · append-only</text>
                    </svg>
                    <p class="mt-4 text-center font-mono text-[10px] text-white/35 leading-relaxed">
                        FIG.1 · Every crossing appends a link. The chain is the byproduct of the traffic, not a second system someone has to remember to feed.
                    </p>
                </div>
            </div>
            <script>
                // FIG.1 · actions cross from the fleet to the systems through the spine.
                // The chain below grows by exactly one link per crossing, because that is
                // the claim: the record is not assembled afterwards from someone's logs,
                // it is a side effect of the traffic passing through.
                const spineFig = document.getElementById("spine-fig");
                const spineReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (spineFig) {
                    const NS = "http://www.w3.org/2000/svg";
                    const LANES = [96, 148, 200, 252, 304];
                    const START = 176, CROSS = 500, END = 824;
                    const CHAIN_Y = 372, LINK_W = 46, LINK_X0 = 60, VISIBLE = 17;

                    const actLayer = document.getElementById("spine-actions") as unknown as SVGGElement;
                    const chainLayer = document.getElementById("spine-chain") as unknown as SVGGElement;

                    // Bloom borrowed from the hero canvas: expands on an ease-out and
                    // burns down over roughly two seconds, so a contact glows like an
                    // ember rather than switching on.
                    const bloomLayer = document.getElementById("spine-blooms") as unknown as SVGGElement;
                    const blooms: { el: SVGCircleElement; r: number; a: number; max: number }[] = [];
                    const bloom = (bx: number, by: number, r0 = 8, peak = 0.85) => {
                        const c = document.createElementNS(NS, "circle") as SVGCircleElement;
                        c.setAttribute("cx", String(bx));
                        c.setAttribute("cy", String(by));
                        c.setAttribute("r", String(r0));
                        c.setAttribute("fill", "url(#spine-glow)");
                        c.setAttribute("opacity", String(peak));
                        bloomLayer.appendChild(c);
                        blooms.push({ el: c, r: r0, a: peak, max: r0 + 54 });
                    };
                    const stepBlooms = () => {
                        for (let i = blooms.length - 1; i >= 0; i--) {
                            const b = blooms[i];
                            b.r += (b.max - b.r) * 0.045;
                            b.a *= 0.972;
                            if (b.a < 0.02) { b.el.remove(); blooms.splice(i, 1); }
                            else { b.el.setAttribute("r", b.r.toFixed(1)); b.el.setAttribute("opacity", b.a.toFixed(3)); }
                        }
                    };


                    type Act = { el: SVGCircleElement; x: number; lane: number; signed: boolean };
                    type Link = { g: SVGGElement; x: number };
                    const acts: Act[] = [];
                    let links: Link[] = [];
                    // Absolute position of every link ever written. The chain never
                    // restarts: it slides continuously left while new links are appended
                    // on the right, so the ledger reads as endless rather than as a
                    // buffer that fills up and jumps.
                    let written = 0;
                    let scrollX = 0;

                    const appendLink = () => {
                        const g = document.createElementNS(NS, "g");
                        const conn = document.createElementNS(NS, "line");
                        conn.setAttribute("x1", String(-LINK_W + 26));
                        conn.setAttribute("y1", String(CHAIN_Y));
                        conn.setAttribute("x2", "0");
                        conn.setAttribute("y2", String(CHAIN_Y));
                        conn.setAttribute("stroke", "var(--color-ink-0)");
                        conn.setAttribute("stroke-opacity", "0.4");
                        conn.setAttribute("stroke-width", "1");
                        g.appendChild(conn);

                        const box = document.createElementNS(NS, "rect");
                        box.setAttribute("x", "0");
                        box.setAttribute("y", String(CHAIN_Y - 9));
                        box.setAttribute("width", "26");
                        box.setAttribute("height", "18");
                        box.setAttribute("fill", "none");
                        box.setAttribute("stroke", "var(--color-live)");
                        box.setAttribute("stroke-opacity", "0.85");
                        box.setAttribute("stroke-width", "1.5");
                        g.appendChild(box);

                        chainLayer.appendChild(g);
                        links.push({ g, x: written * LINK_W });
                        written += 1;

                        // the newest link is the bright one; everything behind it settles
                        links.forEach((l, i) => {
                            const r = l.g.children[1] as SVGRectElement;
                            const fresh = i === links.length - 1;
                            r.setAttribute("stroke", fresh ? "var(--color-live)" : "var(--color-ink-0)");
                            r.setAttribute("stroke-opacity", fresh ? "0.9" : "0.42");
                            r.setAttribute("stroke-width", fresh ? "1.5" : "1");
                        });
                    };

                    // Scroll target is derived from how many links exist, not from a fixed
                    // speed, so the chain self-corrects instead of drifting out of step
                    // with the crossings that feed it.
                    const advanceChain = () => {
                        const target = Math.max(0, (written - VISIBLE) * LINK_W);
                        scrollX += (target - scrollX) * 0.08;
                        for (let i = links.length - 1; i >= 0; i--) {
                            const screenX = LINK_X0 + links[i].x - scrollX;
                            if (screenX < -LINK_W * 2) {
                                links[i].g.remove();
                                links.splice(i, 1);
                            } else {
                                links[i].g.setAttribute("transform", `translate(${screenX},0)`);
                            }
                        }
                    };

                    const spawn = (lane: number) => {
                        const el = document.createElementNS(NS, "circle") as SVGCircleElement;
                        el.setAttribute("cx", String(START));
                        el.setAttribute("cy", String(LANES[lane]));
                        el.setAttribute("r", "4");
                        el.setAttribute("fill", "var(--color-ink-0)");
                        el.setAttribute("fill-opacity", "0.62");
                        actLayer.appendChild(el);
                        acts.push({ el, x: START, lane, signed: false });
                    };

                    const step = (a: Act) => {
                        a.x += 1.5;
                        // the crossing is the event: this is the moment a link exists
                        if (!a.signed && a.x >= CROSS) {
                            a.signed = true;
                            a.el.setAttribute("fill", "var(--color-live)");
                            a.el.setAttribute("fill-opacity", "0.9");
                            appendLink();
                            bloom(CROSS, LANES[a.lane]);
                        }
                        a.el.setAttribute("cx", String(a.x));
                        return a.x < END;
                    };

                    if (spineReduced) {
                        // Static equivalent: a settled chain and one action on each side.
                        for (let i = 0; i < VISIBLE; i++) appendLink();
                        advanceChain();
                        links.forEach((l) => l.g.setAttribute("transform", `translate(${LINK_X0 + l.x},0)`));
                        [0, 2, 4].forEach((lane) => {
                            spawn(lane);
                            const a = acts[acts.length - 1];
                            a.x = lane === 2 ? END - 120 : START + 90;
                            a.el.setAttribute("cx", String(a.x));
                        });
                    } else {
                        let visible = false;
                        let spawnAt = 0;
                        let n = 0;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(spineFig);
                        const loop = (now: number) => {
                            if (visible) {
                                if (now > spawnAt) {
                                    spawn(n % LANES.length);
                                    n += 1;
                                    spawnAt = now + 1000;
                                }
                                for (let i = acts.length - 1; i >= 0; i--) {
                                    if (!step(acts[i])) { acts[i].el.remove(); acts.splice(i, 1); }
                                }
                                advanceChain();
                                stepBlooms();
                            }
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
        </section>

        <!-- ══════════ THE PREMISE ══════════ -->
