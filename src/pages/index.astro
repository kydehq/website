---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Four capabilities, not a feature list. Flight recorder, inventory, DLP,
// evaluation and the ledger are the proof inside these four, which is why they
// are named here as what they let you do rather than as modules of their own.
const capabilities = [
  { n: '01', name: 'See',     line: 'See every AI action.',                              sub: 'Flight recorder · Inventory', href: '#see'     },
  { n: '02', name: 'Control', line: 'Stop actions that violate policy.',                 sub: 'Identity · Policy · Data · Limits', href: '#control' },
  { n: '03', name: 'Replay',  line: "Run past work against today's AI.",                 sub: 'Evaluation · Replay',         href: '#replay'  },
  { n: '04', name: 'Prove',   line: 'Produce evidence that can be verified without us.', sub: 'Ledger · Offline recompute',  href: '#prove'   },
];

// The five dimensions the layer checks on every action. One line each, in plain
// language, then the concrete version for a reader who wants it. This is one
// chapter of the page, not five: the proof sits further down under whichever
// capability it belongs to.
const dimensions = [
  { name: 'Identity', q: 'Know who is acting.',        a: 'Every worker and every agent carries a name of its own, not a shared key that four systems use.' },
  { name: 'Policy',   q: 'Decide what it can do.',     a: 'Rules are checked before the action executes, not written up in a report afterwards.' },
  { name: 'Data',     q: 'Control what it can see.',   a: 'Sensitive fields are masked inline, before they ever reach a model.' },
  { name: 'Limits',   q: 'Control how far it can go.', a: 'Spend, volume and reach held across a run, not just per call.', soon: true },
  { name: 'Evidence', q: 'Prove what happened.',       a: 'A hash-chained record written at the boundary, which your auditor recomputes without us.' },
];

// Four ways in. A compliance partner and an underwriter want the same platform
// and will never search for it with the same words.
const entries = [
  {
    audience: 'For compliance',
    name: 'AI audit trail',
    line: 'Continuous evidence for regulated AI systems.',
    body: 'A hash-chained record written at the boundary, exported as a dated document an auditor recomputes offline. Built against GDPR, the EU AI Act, NIS-2 and DORA.',
    href: '#prove',
  },
  {
    audience: 'For insurance',
    name: 'AI telemetry',
    line: 'Observe how AI actually behaves in production.',
    body: 'Not what a system was designed to do, and not what a questionnaire says it does. What it did: which actions, against which systems, how often, and how much of that was ever recorded.',
    href: '#see',
  },
  {
    audience: 'For AI governance',
    name: 'Continuous evals',
    line: 'Measure whether AI stays reliable as models, data and workflows change.',
    body: 'A recorded run is a set of real cases with known outcomes. Re-run them when a model ships and the drift is a number rather than an anecdote from a support ticket.',
    href: '#replay',
  },
  {
    audience: 'For incident & risk',
    name: 'Replay',
    line: 'Reconstruct and rerun what happened.',
    body: 'A model swapped under the same name does not announce itself. Replaying a recorded run against the present turns "something changed" into a difference you can point at.',
    href: '#replay',
  },
];

// Organization and WebSite schema live on the home page, which is now the
// platform page. The description leads with the layer and names the build
// service second, in the order the site itself now argues them.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Kyde",
  url: "https://kyde.com",
  logo: "https://kyde.com/kyde-logo.svg",
  description: "Kyde is the zero trust layer for AI: identity, policy, data boundaries, limits, and a hash-chained record of every action, in the customer's own environment. On top of it Kyde builds AI workers out of the processes a company already runs.",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kyde",
  url: "https://kyde.com",
};
---

<Base
  title="KYDE, Zero Trust for AI in Your Own Infrastructure"
  description="Kyde is the zero trust layer for AI. Identity, policy, data boundaries and limits checked at the moment of action, and a record anyone can verify afterwards, in your own environment. On top of it we build the AI workers that run your processes."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>
  <Navbar />

  <main>
    <!-- ══════════ HERO STAGE ══════════ -->
    <!-- The stage came over from the workers page when the two swapped places.
         It was always a picture of this argument rather than of the build
         service: unordered agents drift, cross a gate, and come out in a
         lattice. It belongs to the page that sells the gate. -->
    <section class="relative overflow-hidden h-screen min-h-[600px] flex flex-col justify-center pt-20 bg-bg-0">
      <canvas id="hero-datastream" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
      <div class="absolute inset-0 pointer-events-none hero-noise"></div>
      <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-bg-0 via-bg-0/45 to-transparent"></div>
      <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-transparent to-bg-0"></div>

      <div class="relative max-w-7xl mx-auto px-6 w-full">
        <!-- Regulation register: the one above-fold cue for why a buyer needs us. -->
        <p id="hero-eyebrow" class="mb-4 md:mb-5 font-mono text-[10px] md:text-[11px] text-white/55 uppercase tracking-[0.16em] md:tracking-[0.2em]" style="opacity:0;transition:opacity 0.9s ease;">
          Built for GDPR <span class="text-white/30" aria-hidden="true">·</span> EU AI Act <span class="text-white/30" aria-hidden="true">·</span> NIS-2 <span class="text-white/30" aria-hidden="true">·</span> DORA
        </p>
        <!-- The headline outlived the repositioning. It was never a claim about
             workers: owning your intelligence is what the layer underneath is
             for, so it stays and the subline carries the change. -->
        <h1 class="hero-h1 text-[2rem] text-white uppercase tracking-tight leading-none sm:text-5xl md:text-6xl lg:text-7xl" style="opacity:0;">
          <span id="hero-l1" style="display:block">Own Your</span>
          <span id="hero-l2" style="display:block">Intelligence.</span>
        </h1>
        <p id="hero-sub" class="mt-5 md:mt-7 text-sm md:text-base lg:text-lg text-white uppercase tracking-[0.12em] leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease;">
          Zero trust for AI. In your own infrastructure.
        </p>
        <p id="hero-explainer" class="mt-3 text-sm md:text-base text-white/70 leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease 0.15s;">
          Kyde sits between your AI and the models, tools and business systems it reaches. Identity, policy, data, limits and a record you can verify. Your environment, your models, your record.
        </p>
        <div id="hero-ctas" class="mt-8 flex flex-col sm:flex-row gap-4" style="opacity:0;transition:opacity 0.9s ease 0.5s;">
          <button
            onclick="openModal()"
            class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:bg-cta-hover transition-all"
          >
            Talk to us →
          </button>
          <a
            href="/services"
            class="inline-flex items-center gap-2 border border-white/40 text-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:border-white hover:bg-white/10 transition-all"
          >
            See the workers we build →
          </a>
        </div>
        <div class="mt-8 space-y-1.5" style="opacity:0;transition:opacity 0.9s ease 0.7s;" id="hero-terminal">
          <p class="font-mono text-[10px] md:text-[11px] text-white/45 uppercase tracking-[0.18em]">Identity <span class="text-white/20">·</span> Policy <span class="text-white/20">·</span> Data <span class="text-white/20">·</span> Limits <span class="text-white/20">·</span> Evidence</p>
          <p class="font-mono text-[10px] md:text-[11px] text-white/45 uppercase tracking-[0.18em]">On-premise <span class="text-white/20">·</span> Private cloud <span class="text-white/20">·</span> EU-hosted</p>
        </div>
      </div>
    </section>

<script>
  const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const SPEED = 0.22;

  function scrambleLine(el: HTMLElement, target: string, delay: number, onDone?: () => void) {
    let frame = 0;
    setTimeout(() => {
      el.innerText = target;
      const finalH = el.offsetHeight;
      el.style.height = finalH + "px";
      el.style.overflow = "hidden";

      function tick() {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          if (i < frame) {
            out += target[i];
          } else if (target[i] === " " || target[i] === ".") {
            out += target[i];
          } else {
            out += CHARS[Math.floor(Math.random() * CHARS.length)];
          }
        }
        el.innerText = out;
        frame += SPEED;
        if (frame < target.length) {
          requestAnimationFrame(tick);
        } else {
          el.innerText = target;
          el.style.height = "";
          el.style.overflow = "";
          if (onDone) onDone();
        }
      }
      tick();
    }, delay);
  }

  const l1 = document.getElementById("hero-l1") as HTMLElement;
  const l2 = document.getElementById("hero-l2") as HTMLElement;
  const sub = document.getElementById("hero-sub") as HTMLElement;
  const eyebrow = document.getElementById("hero-eyebrow") as HTMLElement;
  const h1 = l1?.closest("h1") as HTMLElement;
  if (h1) { h1.style.animation = "none"; h1.style.opacity = "0"; }
  const explainer = document.getElementById("hero-explainer") as HTMLElement;
  const ctas = document.getElementById("hero-ctas") as HTMLElement;
  if (l1) scrambleLine(l1, "OWN YOUR", 200);
  if (l2) scrambleLine(l2, "INTELLIGENCE.", 200, () => {
    if (eyebrow) eyebrow.style.opacity = "1";
    if (sub) sub.style.opacity = "1";
    if (explainer) explainer.style.opacity = "1";
    if (ctas) ctas.style.opacity = "1";
    const term = document.getElementById("hero-terminal");
    if (term) term.style.opacity = "1";
  });
  setTimeout(() => { if (h1) h1.style.opacity = "1"; }, 200);

  // ── Boundary-gate figure ────────────────────────────────────────
  // Geometric, not "rain": unordered agents drift on the left,
  // cross the vertical gate line, and snap into a strict lattice , 
  // ungoverned chaos becomes governed order. Rare green pulse at
  // crossing (recorded), rare red flash bouncing off (blocked).
  const canvas = document.getElementById("hero-datastream") as HTMLCanvasElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0, GATE = 0, ROW = 26;

    // Theme-aware palette: the figure is drawn from CSS tokens, not literal
    // rgb triples, so it inverts cleanly (light ink on dark, dark ink on
    // light) instead of staying a fixed dark box when the theme toggles.
    const C = { ink: "242,242,242", live: "61,220,132", alert: "255,92,92", light: false };
    function hexToRgb(hex: string): string {
      const m = hex.trim().replace("#", "");
      const n = parseInt(m.length === 3 ? m.split("").map((c) => c + c).join("") : m, 16);
      return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`;
    }
    function readColors() {
      const cs = getComputedStyle(document.documentElement);
      C.ink = hexToRgb(cs.getPropertyValue("--color-ink-0") || "#F2F2F2");
      C.live = hexToRgb(cs.getPropertyValue("--color-live") || "#3DDC84");
      C.alert = hexToRgb(cs.getPropertyValue("--color-alert") || "#FF5C5C");
      // A bloom is emitted light. On a dark ground it brightens toward ink; on
      // paper the same stops paint a grey smudge, so it has to tint toward the
      // accent instead. Everything downstream branches on this one flag.
      const bg = hexToRgb(cs.getPropertyValue("--color-bg-0") || "#050505").split(",").map(Number);
      C.light = (bg[0] * 0.299 + bg[1] * 0.587 + bg[2] * 0.114) > 128;
    }
    readColors();

    function hash(n: number): number {
      let t = (n + 0x6d2b79f5) | 0;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }

    type P = {
      x: number; y: number; vx: number; seed: number;
      state: "wild" | "signed" | "blocked";
      rowY: number; pulse: number;
    };
    let parts: P[] = [];

    // occasional bloom when a particle crosses the gate
    type Flare = { x: number; y: number; t0: number };
    let flares: Flare[] = [];
    let lastFlare = 0;

    function spawn(p: P, i: number, initial = false) {
      p.x = initial ? hash(i * 7 + 1) * GATE : -10 - hash(i * 13) * 60;
      p.y = 40 + hash(i * 31 + performance.now() % 9973) * (H - 80);
      p.vx = 12 + hash(i * 17) * 22;
      p.seed = i * 7919 + Math.floor(performance.now());
      p.state = "wild";
      p.pulse = 0;
    }

    // Measuring once at script time is not enough: on a reload the module can run
    // before layout has settled, and a canvas that is measured at zero keeps its
    // default 300x150 buffer while CSS stretches it to full width. Everything then
    // looks scaled up and, because the particles cross a much smaller space, far
    // too fast. Only a real window resize used to fix it.
    function resize() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (!w || !h) return;                       // not laid out yet, try again later
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (w === W && h === H && canvas.width === Math.round(w * dpr)) return;
      W = w;
      H = h;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      GATE = W * 0.68;
      parts = [];
      const n = Math.max(40, Math.floor(W / 16));
      for (let i = 0; i < n; i++) {
        const p = {} as P;
        spawn(p, i, true);
        parts.push(p);
      }
    }

    let last = 0;
    function draw(t: number) {
      const dt = Math.min((t - last) / 1000, 0.05) || 0.016;
      last = t;
      ctx.clearRect(0, 0, W, H);

      // lattice on the governed side, faint, strict
      ctx.fillStyle = `rgba(${C.ink},${C.light ? 0.16 : 0.08})`;
      for (let x = GATE + ROW; x < W; x += ROW)
        for (let y = ROW; y < H; y += ROW)
          ctx.fillRect(x - 0.75, y - 0.75, 1.5, 1.5);

      // gate line, nearly invisible at the ends, a faint shimmer mid-height;
      // it reveals itself through interaction (blooms, blocks), not presence
      const gateGrad = ctx.createLinearGradient(0, 0, 0, H);
      gateGrad.addColorStop(0, `rgba(${C.ink},0)`);
      gateGrad.addColorStop(0.5, `rgba(${C.ink},${C.light ? 0.22 : 0.13})`);
      gateGrad.addColorStop(1, `rgba(${C.ink},0)`);
      ctx.fillStyle = gateGrad;
      ctx.fillRect(GATE, 0, 1, H);
      for (let y = 0; y < H; y += ROW * 2) {
        const env = Math.sin((Math.PI * y) / H);
        ctx.fillStyle = `rgba(${C.ink},${(C.light ? 0.26 : 0.16) * env * env})`;
        ctx.fillRect(GATE - 3, y, 7, 1);
      }

      for (const p of parts) {
        const jitterSeed = p.seed + Math.floor(t / 300);

        if (p.state === "wild") {
          // brownian drift with slow right bias
          p.x += p.vx * dt;
          p.y += (hash(jitterSeed) - 0.5) * 34 * dt * 2.2;

          if (p.x >= GATE) {
            if (hash(p.seed + 5) > 0.93) {
              p.state = "blocked";
              p.pulse = 1;
              p.vx = -18;
            } else {
              p.state = "signed";
              p.pulse = hash(p.seed + 9) > 0.7 ? 1 : 0;
              p.rowY = Math.round(p.y / ROW) * ROW;
              p.vx = 26 + hash(p.seed + 3) * 18;
              // every few seconds, one crossing blooms
              if (t - lastFlare > 2100 && hash(p.seed + 11) > 0.4) {
                flares.push({ x: GATE, y: p.rowY, t0: t });
                lastFlare = t;
              }
            }
          }
          ctx.fillStyle = `rgba(${C.ink},${C.light ? 0.42 : 0.32})`;
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
        } else if (p.state === "signed") {
          p.x += p.vx * dt;
          p.y += (p.rowY - p.y) * Math.min(dt * 6, 1); // snap to lattice row

          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(${C.live},${p.pulse * 0.7})`;
            ctx.lineWidth = 1;
            ctx.strokeRect(p.x - 4, p.y - 4, 8, 8);
            p.pulse -= dt * 1.4;
          }
          ctx.fillStyle = `rgba(${C.ink},${C.light ? 0.82 : 0.68})`;
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);

          if (p.x > W + 10) spawn(p, Math.floor(p.seed / 7919));
        } else {
          // blocked: red flash at the gate, drift back, fade
          p.x += p.vx * dt;
          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(${C.alert},${p.pulse * 0.8})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p.x + 4, p.y - 4); ctx.lineTo(p.x - 4, p.y + 4);
            ctx.moveTo(p.x - 4, p.y - 4); ctx.lineTo(p.x + 4, p.y + 4);
            ctx.stroke();
            p.pulse -= dt * 0.9;
          } else {
            spawn(p, Math.floor(p.seed / 7919));
          }
        }
      }

      // flares, soft light bloom at the gate, expanding and fading
      flares = flares.filter((f) => t - f.t0 < 1600);
      for (const f of flares) {
        const age = (t - f.t0) / 1600; // 0 → 1
        const ease = 1 - Math.pow(1 - age, 2);
        const r = 16 + ease * 130;
        const a = (1 - age) * 0.85;

        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, r);
        if (C.light) {
          g.addColorStop(0, `rgba(${C.live},${a * 0.55})`);
          g.addColorStop(0.25, `rgba(${C.live},${a * 0.22})`);
          g.addColorStop(0.6, `rgba(${C.live},${a * 0.08})`);
          g.addColorStop(1, `rgba(${C.live},0)`);
        } else {
          g.addColorStop(0, `rgba(${C.ink},${a})`);
          g.addColorStop(0.25, `rgba(${C.ink},${a * 0.35})`);
          g.addColorStop(0.6, `rgba(${C.live},${a * 0.22})`);
          g.addColorStop(1, `rgba(${C.live},0)`);
        }
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(f.x, f.y, r, 0, Math.PI * 2);
        ctx.fill();

        // bright core that snuffs out quickly
        if (age < 0.35) {
          ctx.fillStyle = `rgba(${C.ink},${(1 - age / 0.35) * 0.9})`;
          ctx.fillRect(f.x - 2, f.y - 2, 4, 4);
        }

        // brief brightening of the gate line around the bloom
        const gl = ctx.createLinearGradient(f.x, f.y - r, f.x, f.y + r);
        gl.addColorStop(0, `rgba(${C.ink},0)`);
        gl.addColorStop(0.5, `rgba(${C.ink},${a * 0.8})`);
        gl.addColorStop(1, `rgba(${C.ink},0)`);
        ctx.fillStyle = gl;
        ctx.fillRect(GATE, f.y - r, 1, r * 2);
      }
    }

    resize();
    window.addEventListener("resize", resize);

    // Held in a variable on purpose: an observer with no reference of its own can
    // be collected, and then it silently stops firing. Measured that happening.
    const canvasObserver = "ResizeObserver" in window ? new ResizeObserver(() => resize()) : null;
    if (canvasObserver) canvasObserver.observe(canvas);

    // Belt and braces for the first paint. The observer covers later changes, but
    // the very first measurement can land before layout is final, and the guard
    // above makes each of these free once the size is already right.
    requestAnimationFrame(() => resize());
    window.addEventListener("load", () => resize());
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => resize());

    // Re-read the palette on theme toggle. The running rAF loop repaints
    // every frame anyway and will pick the new colors up on its own; the
    // reduced-motion path only ever draws once, so it needs an explicit nudge.
    window.addEventListener("kyde:theme", () => {
      readColors();
      if (reduced) draw(performance.now());
    });

    if (reduced) {
      draw(1);
    } else {
      let heroVisible = true;
      new IntersectionObserver((es) => { heroVisible = es[0].isIntersecting; }).observe(canvas);
      const loop = (t: number) => { if (heroVisible) draw(t); requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
  }
</script>


    <!-- ══════════ 01 · WHY ══════════ -->
    <!-- The page opens on the gap, not on the product. A reader who knows NIST
         SP 800-207 will check this claim in the first ten seconds, so the page
         states the difference itself rather than letting them find it. We are not
         a network access product. The boundary is the action. -->
    <section class="bg-bg-0">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-10">
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">01 · Why</span>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.03] text-ink-0 mb-10 max-w-3xl">
          Traditional security was built around access.
        </h2>
        <div class="grid md:grid-cols-2 gap-10 md:gap-0 md:divide-x md:divide-line-0 [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 lg:[&>*:first-child]:pr-16 lg:[&>*:last-child]:pl-16">
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ink-2 mb-5">Zero trust today</span>
            <p class="text-xl md:text-2xl text-ink-1 leading-snug">
              Controls people, devices and networks. Verifies who is connecting, from what, to which resource.
            </p>
          </div>
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ember mb-5">What KYDE extends it to</span>
            <p class="text-xl md:text-2xl text-ink-0 leading-snug">
              What the AI actually does. The connection was authorized hours ago. The action is the thing that needs verifying, every time, on its own.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ 02 · PRINCIPLE ══════════ -->
    <!-- The thesis of the whole page, and the only place the architecture is
         drawn. The three beats sit under the heading rather than in the hero,
         because here there is a figure next to them that shows what they mean. -->
    <section class="bg-bg-0">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">
        <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-line-0 items-stretch [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 lg:[&>*:first-child]:pr-16 lg:[&>*:last-child]:pl-16">

          <div class="flex flex-col">
            <div class="h-7 flex items-center border-b border-line-0">
