            </video>
            <div class="absolute inset-0 bg-gradient-to-b from-[#0d0e10]/30 via-[#0d0e10]/60 to-[#0d0e10]/90"></div>
            <div class="absolute inset-0 pointer-events-none hero-noise"></div>
            <div class="bg-grid absolute inset-0 pointer-events-none opacity-20"></div>
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 40% 35% at 100% 100%, #0d0e10 0%, transparent 100%);"></div>

            <div class="relative max-w-7xl mx-auto px-6 w-full">
                <div class="flex items-center gap-3 mb-6">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#fcb830] shrink-0"></span>
                    <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Real-Time Blocking · Identity Enforcement · Out-of-Band Governance</span>
                </div>
                <h1 class="hero-h1 text-4xl text-white uppercase tracking-tighter leading-none sm:text-6xl md:text-7xl lg:text-8xl" style="opacity:0;">
                    <span id="hero-l1" style="display:block">The Behavioral</span>
                    <span id="hero-l2" style="display:block">Firewall</span>
                    <span id="hero-l3" style="display:block">For AI Agents.</span>
                </h1>
                <p id="hero-sub" class="mt-5 md:mt-7 text-sm md:text-base lg:text-lg text-white uppercase tracking-[0.12em] leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease;">
                    Deploy AI agents without losing control.
                </p>
                <p id="hero-explainer" class="mt-3 text-sm md:text-base text-white/70 leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease 0.15s;">
                    KYDE verifies identity, enforces policy, and stops unsafe actions before they reach critical systems.
                </p>
                <p id="hero-meta" class="mt-3 font-mono text-xs text-white/45 uppercase tracking-[0.15em]" style="opacity:0;transition:opacity 0.9s ease 0.3s;">
                    One environment variable · Under 100ms · Any provider · Zero code changes
                </p>
                <div id="hero-ctas" class="mt-8 flex flex-col sm:flex-row gap-4" style="opacity:0;transition:opacity 0.9s ease 0.5s;">
                    <a
                        href="/sandbox"
                        class="inline-flex items-center gap-2 bg-white text-[#0d0e10] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:bg-[#dae4e5] transition-all"
                    >
                        Deploy Sandbox →
                    </a>
                    <button
                        onclick="openModal()"
                        class="inline-flex items-center gap-2 border border-white/40 text-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:border-white hover:bg-white/10 transition-all"
                    >
                        Talk to Us →
                    </button>
                </div>
            </div>
        </section>


<script>
  const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const SPEED = 0.22;

  function scrambleLine(el: HTMLElement, target: string, delay: number, onDone?: () => void) {
    let frame = 0;
    setTimeout(() => {
      el.innerText = target;
      const finalH = el.offsetHeight;
      el.style.height = finalH + "px";
      el.style.overflow = "hidden";

      function tick() {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          if (i < frame) {
            out += target[i];
          } else if (target[i] === " " || target[i] === ".") {
            out += target[i];
          } else {
            out += CHARS[Math.floor(Math.random() * CHARS.length)];
          }
        }
        el.innerText = out;
        frame += SPEED;
        if (frame < target.length) {
          requestAnimationFrame(tick);
        } else {
          el.innerText = target;
          el.style.height = "";
          el.style.overflow = "";
          if (onDone) onDone();
        }
      }
      tick();
    }, delay);
  }

  const l1 = document.getElementById("hero-l1") as HTMLElement;
  const l2 = document.getElementById("hero-l2") as HTMLElement;
  const l3 = document.getElementById("hero-l3") as HTMLElement;
  const sub = document.getElementById("hero-sub") as HTMLElement;
  const h1 = l1?.closest("h1") as HTMLElement;
  if (h1) { h1.style.animation = "none"; h1.style.opacity = "0"; }
  const explainer = document.getElementById("hero-explainer") as HTMLElement;
  const meta = document.getElementById("hero-meta") as HTMLElement;
  const ctas = document.getElementById("hero-ctas") as HTMLElement;
  if (l1) scrambleLine(l1, "THE BEHAVIORAL", 200);
  if (l2) scrambleLine(l2, "FIREWALL", 200);
  if (l3) scrambleLine(l3, "FOR AI AGENTS.", 200, () => {
    if (sub) sub.style.opacity = "1";
    if (explainer) explainer.style.opacity = "1";
    if (meta) meta.style.opacity = "1";
    if (ctas) ctas.style.opacity = "1";
  });
  setTimeout(() => { if (h1) h1.style.opacity = "1"; }, 200);

  const vid = document.querySelector(".hero-video") as HTMLVideoElement;
  if (vid) vid.play().catch(() => {});
</script>

        <!-- ══════════ PROBLEM ══════════ -->
