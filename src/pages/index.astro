---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroInstrument from '../components/home/HeroInstrument.astro';

// The home in the pitch deck's language (Pitch.pdf, September 2026): white
// paper, one rosé (#F8D9D4) for surfaces and marks, ink, neon only as a signal,
// fine 1px rules, regular-weight headlines, four text styles. One idea per
// block, short sentences, no jargon. The stage is the deck's title slide. Rosé opens and closes the page, white
// between. Five blocks, the deck's order: the
// problem, the insight (banks), how it works, how to start. Compliance sits
// in the hero band; the rest of the argument lives on the catalogue pages.

const problems = [
  { tag: '(Drift)',  line: 'They drift away from their task.' },
  { tag: '(Hijack)', line: 'They get hijacked by prompt injection.' },
  { tag: '(Loops)',  line: 'They get stuck in loops and', mark: 'burn money' },
];

// The deck's five steps. Held to what ships: the record is tamper-evident
// (hash-chained) in every edition, signing is Enterprise; no speed claims.
const steps = [
  { n: '01', name: 'Observe', line: 'Every action of an agent, through a gateway or SDK.' },
  { n: '02', name: 'Learn',   line: "Kyde learns the agent's normal behavior. Every human decision sharpens it." },
  { n: '03', name: 'Score',   line: "Every run against the agent's own normal behavior. Deterministic." },
  { n: '04', name: 'Limit',   line: 'The score decides what the agent may do.' },
  { n: '05', name: 'Stop',    line: 'A drifting agent goes into quarantine. A human decides what happens next.', mark: true },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Kyde",
  url: "https://kyde.com",
  logo: "https://kyde.com/kyde-logo.svg",
  description: "Kyde is behavioral scoring for AI agents. Every action of an agent crosses Kyde, is scored against the agent's own normal behavior, and a drifting, hijacked or looping agent goes into quarantine, with a tamper-evident record, in the customer's own network.",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kyde",
  url: "https://kyde.com",
};
---

<Base
  title="KYDE, Behavioral Scoring for AI Agents"
  description="AI agents don't fail loudly, they fail expensively. Kyde scores every action your agents take and stops them when the behavior changes: drift, prompt injection, loops that burn money. Any model, any vendor, on-prem, built in Europe."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>
  <Navbar />

  <main class="kx">
    <!-- ══════════ STAGE ══════════ -->
    <!-- The deck's title slide, nothing else: the category, one quiet link.
         Everything the old hero carried moves one screen down. -->
    <section data-surface="blush" class="surface-rose stage">
      <div class="wrap stage-inner">
        <div class="brackets stage-brackets">
          <h1 class="stage-title">Behavioral scoring for AI&nbsp;agents</h1>
          <a href="#fail" class="link-u mono stage-link">(How it works)</a>
        </div>
      </div>
      <div class="dots-band" aria-hidden="true"></div>
    </section>

    <!-- ══════════ THE CLAIM ══════════ -->
    <section class="surface-paper" id="fail">
      <div class="wrap sec">
        <div class="hero-grid">
          <div>
            <h2 class="display">
              AI agents don't fail loudly.<br />They fail <span class="hl hl-rose">expensively</span><span class="nowrap">.</span>
            </h2>
            <p class="sub">Kyde scores every action your agents take, and stops them when the behavior changes.</p>
            <div class="ctas">
              <button onclick="openModal()" class="btn btn-ink">Book a demo →</button>
              <a href="#start" class="link-u mono">How to start</a>
            </div>
            <p class="mono note claim-note">Built for EU AI Act · NIS-2 · DORA</p>
          </div>
          <HeroInstrument />
        </div>
      </div>
    </section>

    <!-- ══════════ 01 · THE PROBLEM ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec">
        <div class="kicker"><span class="num">01</span><span class="mono">The problem</span></div>
        <h2 class="h1">Your AI agents are checked <span class="hl hl-rose">once</span><span class="nowrap">,</span> on the day they go live.</h2>
        <p class="sub">After that, the only one watching the agent is the agent itself.</p>
        <div class="cols3">
          {problems.map((p) => (
            <div class="col">
              <p class="mono label">{p.tag}</p>
              <p class="body-l">{p.line}{p.mark && <> <span class="hl hl-neon">{p.mark}</span><span class="nowrap">.</span></>}</p>
            </div>
          ))}
        </div>
        <p class="mono note-strong">*You find out weeks later, from a customer, a bill or an auditor.</p>
      </div>
    </section>

    <!-- ══════════ 02 · THE INSIGHT ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec">
        <div class="kicker"><span class="num">02</span><span class="mono">The insight</span></div>
        <div class="insight-top">
          <h2 class="display-2">Banks solved this decades ago.</h2>
          <figure class="cards-fig" aria-hidden="true">
            <svg viewBox="0 0 380 250">
              {[0, 1, 2, 3].map((i) => (
                <rect x={i * 38} y={130 - i * 30} width="190" height="118" rx="8"
                  fill="var(--color-blush)" stroke="var(--color-ink)" stroke-width="1.25" />
              ))}
              <rect x="152" y="10" width="220" height="130" rx="8" fill="var(--color-card)" />
              <rect x="172" y="42" width="34" height="24" rx="3" fill="var(--color-neon)" />
              <line x1="172" y1="112" x2="290" y2="112" stroke="var(--color-blush)" stroke-width="1.25" />
            </svg>
            <span class="tag tag-dark tilt cards-tag">*Scored every swipe</span>
          </figure>
        </div>
        <div class="insight-cards">
          <div class="card card-line">
            <div class="card-head mono"><span>Banks · Card</span><span>(Behavioral score)</span></div>
            <p class="body-l">A card gets a score once, when you apply. After that, the bank scores how you use it. The score sets your limit. Unusual use blocks the card.</p>
          </div>
          <div class="card card-dark">
            <div class="card-head mono"><span>Kyde · Agent</span><span>(Behavioral score)</span></div>
            <p class="body-l">An agent gets checked once, when it goes live. After that, Kyde scores how it behaves. The score sets what it may do. Unusual behavior stops the agent.</p>
            <span class="tag tag-neon">*Every agent gets a limit.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ 03 · HOW IT WORKS ══════════ -->
    <section class="surface-paper" id="how">
      <div class="wrap sec">
        <div class="kicker"><span class="num">03</span><span class="mono">How it works</span></div>
        <div class="how">
          <div>
            <h2 class="h1">Every action of an agent crosses Kyde.</h2>
            <ol class="steps">
              {steps.map((s) => (
                <li>
                  <span class="mono step-n">{s.n}</span>
                  <span class={`step-name${s.mark ? ' hl hl-rose' : ''}`}>{s.name}</span>
                  <span class="step-line">{s.line}</span>
                </li>
              ))}
            </ol>
            <div class="prove">
              <span class="mono">(Under every step)</span>
              <p><strong>Prove.</strong> A tamper-evident record of everything. Every score can be recomputed.</p>
            </div>
          </div>
          <aside class="deploy-card">
            <p class="mono">(Deployment)</p>
            <ul>
              <li>Any model</li>
              <li>Any vendor</li>
              <li>On-prem</li>
              <li>Built in Europe</li>
            </ul>
            <p class="mono deploy-note">*Runs in your network. Your data stays with you.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ══════════ HOW TO START ══════════ -->
    <section data-surface="blush" class="surface-rose" id="start">
      <div class="wrap sec">
        <div class="start">
          <div>
            <div class="brackets">
              <h2 class="display-2">How to start</h2>
              <p class="start-sub">Setup. Then two weeks.</p>
            </div>
            <div class="ctas">
              <button onclick="openModal()" class="btn btn-ink">Book a demo →</button>
              <a href="/docs/quickstart" class="link-u mono">Run it yourself</a>
            </div>
          </div>
          <ol class="start-steps">
            <li>
              <p class="mono label">(Step 1) Setup</p>
              <p class="body-l">We connect to one agent process you run, like claims or customer service, and define its envelope together. Read only.</p>
            </li>
            <li>
              <p class="mono label">(Step 2) Two weeks</p>
              <p class="body-l">Kyde runs alongside and learns the agent's baseline. From then on, you see drift, hijacks and loops as they happen.</p>
            </li>
          </ol>
        </div>
        <p class="mono note start-note">*Kyde is pre-seed and works closely with a small number of design partners. <a href="/behavioral-drift" class="link-u">The research behind the detection</a></p>
      </div>
    </section>
  </main>

  <Footer />
</Base>


<style>
  /* The pitch's system: white paper, one rosé, ink, neon as a signal; fine
     1px rules; regular-weight headlines; four text styles (display/h1,
     sub, body, mono label). */
  .kx {
    --gap: clamp(24px, 3.3vw, 48px);
    --rule: 1px solid var(--color-ink);
  }
  .wrap { max-width: var(--kx-max); margin: 0 auto; padding-inline: var(--kx-pad); }
  .sec { padding-block: var(--kx-sec); }
  .surface-paper { background: var(--color-paper); color: var(--color-ink); }
  .surface-rose { background: var(--color-blush); color: var(--color-ink); }
  /* chapters are separated by space, never by a rule */

  /* the four styles */
  .display { font-size: var(--kx-display); font-weight: 400; line-height: 0.9; letter-spacing: -0.055em; }
  .display-2 { font-size: var(--kx-display-2); font-weight: 400; line-height: 0.92; letter-spacing: -0.05em; max-width: 16ch; }
  .h1 { font-size: var(--kx-h1); font-weight: 400; line-height: 0.98; letter-spacing: -0.045em; max-width: 22ch; }
  .sub { font-size: var(--kx-sub); line-height: 1.25; letter-spacing: -0.02em; color: var(--color-ink-2); margin-top: 1.1rem; max-width: 42ch; }
  .body-l { font-size: var(--kx-body-l); line-height: 1.32; letter-spacing: -0.012em; }
  .mono { font-family: var(--font-mono); font-weight: 500; letter-spacing: 0; }
  .label { font-size: 0.9375rem; margin-bottom: 0.6rem; }
  .muted { color: var(--color-ink-2); }
  .note { font-size: 0.875rem; line-height: 1.5; color: var(--color-ink-2); max-width: 70ch; }
  .note-strong { font-size: 0.9375rem; margin-top: 28px; }
  .nowrap { white-space: nowrap; }

  /* Marks, as in the pitch. On white: a headline word in rosé, a phrase in
     running text in neon. On rosé: never. On black: neon. A mark is a band
     behind the letters that never reaches the line above. */
  .hl { padding: 0 0.1em; box-decoration-break: clone; -webkit-box-decoration-break: clone; background-repeat: no-repeat; }
  .hl-rose { background-image: linear-gradient(transparent 20%, var(--color-blush) 20%, var(--color-blush) 96%, transparent 96%); }
  .hl-neon { background-image: linear-gradient(transparent 20%, var(--color-neon) 20%, var(--color-neon) 96%, transparent 96%); }

  .kicker { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(36px, 5vw, 72px); font-size: 0.9375rem; }
  .kicker .num { background: var(--color-card); color: #fff; font-family: var(--font-mono); font-weight: 500; padding: 2px 9px 3px; }

  .brackets { position: relative; padding: clamp(12px, 1.4vw, 20px) 0 clamp(12px, 1.4vw, 20px) var(--kx-bracket); }
  .brackets::before, .brackets::after { content: ''; position: absolute; left: 0; width: 16px; height: 16px; border-left: 1px solid currentColor; }
  .brackets::before { top: 0; border-top: 1px solid currentColor; }
  .brackets::after { bottom: 0; border-bottom: 1px solid currentColor; }

  .tag { display: inline-block; font-family: var(--font-mono); font-weight: 500; font-size: 0.875rem; padding: 3px 10px 4px; line-height: 1.3; white-space: nowrap; }
  .tag-ink, .tag-dark { background: var(--color-card); color: #fff; }
  .tag-neon { background: var(--color-neon); color: #1C1A1B; }
  .tilt { transform: rotate(-8deg); }

  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 2rem; }
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-weight: 500; font-size: 1rem; padding: 14px 22px 15px; }
  .btn-ink { background: var(--color-card); color: #fff; }
  .btn-ink:hover { background: #000; }
  .link-u { font-size: 1rem; border-bottom: 1px solid currentColor; padding-bottom: 2px; white-space: nowrap; }
  .link-u:hover { border-bottom-color: transparent; }

  .dots-band {
    border-top: var(--rule);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--color-ink) 45%, transparent) 0.8px, transparent 1px);
    background-size: 12px 12px;
    padding-block: 16px 26px;
  }
  .band-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

  /* stage: the title slide */
  .stage { padding-top: var(--kx-nav); }
  .stage-inner { min-height: calc(100svh - var(--kx-nav) - 72px); display: flex; align-items: center; padding-block: var(--kx-hero-top); }
  .stage-brackets { padding-block: clamp(40px, 7vw, 120px); width: 100%; }
  .stage-title { font-size: clamp(3.2rem, 10vw, 11rem); font-weight: 400; line-height: 0.88; letter-spacing: -0.055em; max-width: 13ch; }
  .stage-link { display: inline-block; margin-top: clamp(24px, 3vw, 40px); }
  .stage .dots-band { height: 72px; padding: 0; }
  /* on a phone the title fills the width, the way it fills the slide */
  @media (max-width: 640px) {
    .stage-title { font-size: 19vw; line-height: 0.9; letter-spacing: -0.05em; }
    .stage-brackets { padding-left: 14px; }
    .stage-inner { min-height: calc(100svh - var(--kx-nav) - 56px); }
    .stage .dots-band { height: 56px; }
  }

  /* the claim, one screen down */
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 56px var(--gap); align-items: center; }
  @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.15fr 1fr; } }
  #fail .display { font-size: var(--kx-h1); line-height: 0.96; }
  .claim-note { margin-top: 28px; }

  /* columns under a rule */
  .cols3 { display: grid; grid-template-columns: 1fr; gap: 32px var(--gap); margin-top: clamp(48px, 6vw, 88px); }
  @media (min-width: 900px) { .cols3 { grid-template-columns: repeat(3, 1fr); } }
  .col { border-top: var(--rule); padding-top: 16px; }

  /* insight */
  .insight-top { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .insight-top { grid-template-columns: 1.4fr 1fr; } }
  .cards-fig { position: relative; margin: 0; max-width: 420px; justify-self: center; width: 100%; }
  .cards-fig svg { width: 100%; height: auto; }
  .cards-tag { position: absolute; right: 2%; bottom: 10%; }
  .insight-cards { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: clamp(40px, 5vw, 72px); }
  @media (min-width: 900px) { .insight-cards { grid-template-columns: 1fr 1fr; } }
  .card { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 12px; }
  .card-line { border: var(--rule); background: var(--color-paper); }
  .card-dark { background: var(--color-card); color: #fff; }
  .card-dark .card-head { color: var(--color-blush); }
  .card-dark .tag { align-self: flex-start; }
  .card-head { display: flex; justify-content: space-between; gap: 12px; font-size: 0.875rem; }

  /* how it works */
  .how { display: grid; grid-template-columns: 1fr; gap: 40px var(--gap); align-items: stretch; }
  @media (min-width: 1024px) { .how { grid-template-columns: 1.8fr 1fr; } }
  .steps { list-style: none; padding: 0; margin: clamp(28px, 3vw, 40px) 0 0; border-top: var(--rule); }
  .steps li { display: grid; grid-template-columns: 48px minmax(120px, 170px) 1fr; gap: 12px; align-items: baseline; border-bottom: var(--rule); padding: 14px 0 15px; }
  .step-n { font-size: 0.9375rem; }
  .step-name { font-size: clamp(1.5rem, 2.2vw, 2.1rem); letter-spacing: -0.035em; line-height: 1; justify-self: start; }
  .step-line { font-size: 1.0625rem; line-height: 1.35; color: var(--color-ink-1); }
  @media (max-width: 640px) { .steps li { grid-template-columns: 36px 1fr; } .step-line { grid-column: 2; } }
  .prove { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: baseline; background: var(--color-card); color: #fff; padding: 18px 22px; margin-top: 16px; }
  .prove .mono { color: var(--color-blush); font-size: 0.875rem; }
  .prove p { font-size: 1.125rem; line-height: 1.35; flex: 1; min-width: 240px; }
  .prove strong { font-weight: 500; }
  .deploy-card { background: var(--color-card); color: #fff; padding: 22px 24px; display: flex; flex-direction: column; }
  .deploy-card > .mono { color: var(--color-blush); font-size: 0.875rem; }
  .deploy-card ul { list-style: none; padding: 0; margin: auto 0 0; }
  .deploy-card li { font-size: clamp(1.8rem, 2.6vw, 2.6rem); letter-spacing: -0.04em; line-height: 1; padding: 14px 0; border-bottom: 1px solid #3A3A3A; }
  .deploy-note { color: var(--color-blush); font-size: 0.875rem; margin-top: 18px; line-height: 1.5; }

  /* how to start */
  .start { display: grid; grid-template-columns: 1fr; gap: 40px var(--gap); align-items: center; }
  @media (min-width: 1024px) { .start { grid-template-columns: 1fr 1fr; } }
  .start-sub { font-size: clamp(1.4rem, 2.4vw, 2.3rem); letter-spacing: -0.03em; line-height: 1.1; margin-top: 14px; }
  .start-steps { list-style: none; padding: 0; margin: 0; border-top: var(--rule); }
  .start-steps li { border-bottom: var(--rule); padding: 14px 0 18px; }
  .start-note { margin-top: clamp(40px, 5vw, 64px); }
</style>
