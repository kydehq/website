                            <polygon id="vpr-arrow-1" points="0,-3.5 8,0 0,3.5" fill="rgba(242,242,242,0.85)" transform="translate(260,390) rotate(180)" />
                            <polygon id="vpr-arrow-2" points="0,-3.5 8,0 0,3.5" fill="rgba(242,242,242,0.85)" transform="translate(165,235) rotate(-60.6)" />

                            <!-- inner dot-grid triangle -->
                            <path id="vpr-inner" d="M260 175 L355 345 L165 345 Z" fill="url(#vpr-dots)" stroke="rgba(242,242,242,0.45)" stroke-width="1" />
                            <text id="vpr-center" x="260" y="310" text-anchor="middle" fill="#F2F2F2" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;letter-spacing:0.2em;">KYDE</text>

                            <!-- vertex nodes + labels -->
                            <rect id="vpr-node-0" x="256.5" y="66.5" width="7" height="7" fill="#F2F2F2" />
                            <text id="vpr-label-0" x="260" y="48" text-anchor="middle" fill="rgba(242,242,242,0.85)" style="font-family:'JetBrains Mono Variable',monospace;font-size:11px;letter-spacing:0.18em;">PREVENT</text>

                            <rect id="vpr-node-1" x="436.5" y="386.5" width="7" height="7" fill="#F2F2F2" />
                            <text id="vpr-label-1" x="452" y="424" text-anchor="middle" fill="rgba(242,242,242,0.85)" style="font-family:'JetBrains Mono Variable',monospace;font-size:11px;letter-spacing:0.18em;">PROVE</text>

                            <rect id="vpr-node-2" x="76.5" y="386.5" width="7" height="7" fill="#F2F2F2" />
                            <text id="vpr-label-2" x="72" y="424" text-anchor="middle" fill="rgba(242,242,242,0.85)" style="font-family:'JetBrains Mono Variable',monospace;font-size:11px;letter-spacing:0.18em;">RATE</text>
