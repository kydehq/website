                                <source src="/KYDE.mp4" type="video/mp4" />
                            </video>
                            <!-- Play overlay -->
                            <div id="kyde-play-overlay" class="absolute inset-0 flex flex-col items-center justify-center cursor-pointer group" onclick="document.getElementById('kyde-play-overlay').style.display='none';var v=document.getElementById('kyde-intro');v.controls=true;v.play();">
