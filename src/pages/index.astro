                    <div class="relative flex items-center justify-center min-h-[380px]">
                        <svg id="vpr-fig" viewBox="-45 5 610 545" class="w-full max-w-lg h-auto" aria-hidden="true">
                            <defs>
                                <pattern id="vpr-dots" width="11" height="11" patternUnits="userSpaceOnUse">
                                    <circle cx="2" cy="2" r="1.1" fill="rgba(242,242,242,0.3)" />
