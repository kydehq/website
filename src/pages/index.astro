<script>
                    // radar-fig · Shadow agents sit almost invisible in
                        // the field; the sweep reveals them: blip flashes, the
                        // identity label appears with its ownership state, then the
                        // afterglow fades until the next pass.
                        const radarReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                        const radar = document.getElementById("radar-fig");

                        if (radar) {
                            const NS = "http://www.w3.org/2000/svg";
                            const sweep = document.getElementById("radar-sweep")!;
                            const blipsG = document.getElementById("radar-blips")!;
                            const CX = 240, CY = 240;

                            // Theme-aware palette (ditto elsewhere on this page): read the
                            // ink/live tokens from CSS instead of hardcoding rgb triples.
                            const RC = { ink: "242,242,242", live: "61,220,132", warn: "255,184,77" };
                            function hexToRgb(hex: string): string {
                                const m = hex.trim().replace("#", "");
                                const n = parseInt(m.length === 3 ? m.split("").map((c) => c + c).join("") : m, 16);
                                return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`;
                            }
                            function readRadarColors() {
                                const cs = getComputedStyle(document.documentElement);
                                RC.ink = hexToRgb(cs.getPropertyValue("--color-ink-0") || "#F2F2F2");
                                RC.live = hexToRgb(cs.getPropertyValue("--color-live") || "#3DDC84");
                                RC.warn = hexToRgb(cs.getPropertyValue("--color-warn") || "#FFB84D");
                            }
                            readRadarColors();

                            // The state a first install actually reports is named versus
                            // unclaimed, not signed: signing is an Enterprise capability, and
                            // the unclaimed ones are the finding worth showing.
                            const AGENTS = [
                                { id: "agent:crm-04",    r: 178, a: 0.4, claimed: true  },
                                { id: "agent:hr-11",     r: 120, a: 1.3, claimed: false },
                                { id: "ci-runner",       r: 195, a: 2.2, claimed: false },
                                { id: "agent:support-2", r: 68,  a: 2.9, claimed: true  },
                                { id: "etl-worker",      r: 150, a: 3.8, claimed: false },
                                { id: "agent:proc-7",    r: 104, a: 4.6, claimed: false },
                                { id: "mail-drafter",    r: 186, a: 5.4, claimed: false },
                            ];

                            const blips = AGENTS.map((ag) => {
                                const x = CX + Math.cos(ag.a) * ag.r;
                                const y = CY + Math.sin(ag.a) * ag.r;
                                const dot = document.createElementNS(NS, "rect");
                                dot.setAttribute("x", String(x - 2));
                                dot.setAttribute("y", String(y - 2));
                                dot.setAttribute("width", "4");
                                dot.setAttribute("height", "4");
                                const label = document.createElementNS(NS, "text");
                                label.setAttribute("x", String(x + 9));
                                label.setAttribute("y", String(y - 7));
                                label.setAttribute("style", "font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.08em;");
                                label.textContent = ag.id;
                                const sig = document.createElementNS(NS, "text");
                                sig.setAttribute("x", String(x + 9));
                                sig.setAttribute("y", String(y + 6));
                                sig.setAttribute("style", "font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;");
                                sig.setAttribute("fill", ag.claimed ? `rgb(${RC.live})` : `rgb(${RC.warn})`);
                                sig.textContent = ag.claimed ? "✓ named" : "unclaimed · no owner";
                                blipsG.append(dot, label, sig);
                                return { ...ag, dot, label, sig, lastLit: -1e9 };
                            });

                            window.addEventListener("kyde:theme", () => {
                                readRadarColors();
                                if (radarReduced) paintStatic();
                            });

                            function paintStatic() {
                                // static frame: everything mid-bright
                                for (const b of blips) {
                                    b.dot.setAttribute("fill", `rgba(${RC.ink},0.7)`);
                                    b.label.setAttribute("fill", `rgba(${RC.ink},0.55)`);
                                    b.sig.setAttribute("fill", `rgba(${RC.live},0.6)`);
                                }
                            }

                            if (radarReduced) {
                                paintStatic();
                            } else {
                                const PERIOD = 32000; // one revolution
                                let visible = true;
                                new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(radar);

                                function frame(t: number) {
                                    if (visible) {
                                        const ang = ((t % PERIOD) / PERIOD) * Math.PI * 2 - Math.PI / 2;
                                        sweep.setAttribute("transform", `rotate(${(ang * 180) / Math.PI + 90} ${CX} ${CY})`);

                                        for (const b of blips) {
                                            // sweep just passed this blip?
                                            let diff = (ang - b.a) % (Math.PI * 2);
                                            if (diff < 0) diff += Math.PI * 2;
                                            if (diff < 0.06) b.lastLit = t;

                                            const glow = Math.exp(-(t - b.lastLit) / 2400);
                                            b.dot.setAttribute("fill", `rgba(${RC.ink},${0.12 + glow * 0.88})`);
                                            b.label.setAttribute("fill", `rgba(${RC.ink},${glow * 0.8})`);
                                            b.sig.setAttribute("fill", `rgba(${RC.live},${Math.max(glow - 0.25, 0)})`);
                                        }
                                    }
                                    requestAnimationFrame(frame);
                                }
                                requestAnimationFrame(frame);
                            }
                        }
                </script>
            </div>
        </section>


