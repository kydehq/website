            </div>
            <script>
                // FIG.1 · actions cross from the fleet to the systems through the spine.
                // The chain below grows by exactly one link per crossing, because that is
                // the claim: the record is not assembled afterwards from someone's logs,
                // it is a side effect of the traffic passing through.
                const spineFig = document.getElementById("spine-fig");
                const spineReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (spineFig) {
                    const NS = "http://www.w3.org/2000/svg";
                    const LANES = [96, 148, 200, 252, 304];
                    const START = 176, CROSS = 500, END = 824;
                    const CHAIN_Y = 372, LINK_W = 46, LINK_X0 = 60, VISIBLE = 17;

                    const actLayer = document.getElementById("spine-actions") as unknown as SVGGElement;
                    const chainLayer = document.getElementById("spine-chain") as unknown as SVGGElement;

                    // Bloom borrowed from the hero canvas: expands on an ease-out and
                    // burns down over roughly two seconds, so a contact glows like an
                    // ember rather than switching on.
                    const bloomLayer = document.getElementById("spine-blooms") as unknown as SVGGElement;
                    const blooms: { el: SVGCircleElement; r: number; a: number; max: number }[] = [];
                    const bloom = (bx: number, by: number, r0 = 8, peak = 0.85) => {
                        const c = document.createElementNS(NS, "circle") as SVGCircleElement;
                        c.setAttribute("cx", String(bx));
                        c.setAttribute("cy", String(by));
                        c.setAttribute("r", String(r0));
                        c.setAttribute("fill", "url(#spine-glow)");
                        c.setAttribute("opacity", String(peak));
                        bloomLayer.appendChild(c);
                        blooms.push({ el: c, r: r0, a: peak, max: r0 + 54 });
                    };
                    const stepBlooms = () => {
                        for (let i = blooms.length - 1; i >= 0; i--) {
                            const b = blooms[i];
                            b.r += (b.max - b.r) * 0.045;
                            b.a *= 0.972;
                            if (b.a < 0.02) { b.el.remove(); blooms.splice(i, 1); }
                            else { b.el.setAttribute("r", b.r.toFixed(1)); b.el.setAttribute("opacity", b.a.toFixed(3)); }
                        }
                    };


                    type Act = { el: SVGCircleElement; x: number; lane: number; signed: boolean };
                    type Link = { g: SVGGElement; x: number };
                    const acts: Act[] = [];
                    let links: Link[] = [];
                    // Absolute position of every link ever written. The chain never
                    // restarts: it slides continuously left while new links are appended
                    // on the right, so the ledger reads as endless rather than as a
                    // buffer that fills up and jumps.
                    let written = 0;
                    let scrollX = 0;

                    const appendLink = () => {
                        const g = document.createElementNS(NS, "g");
                        const conn = document.createElementNS(NS, "line");
                        conn.setAttribute("x1", String(-LINK_W + 26));
                        conn.setAttribute("y1", String(CHAIN_Y));
                        conn.setAttribute("x2", "0");
                        conn.setAttribute("y2", String(CHAIN_Y));
                        conn.setAttribute("stroke", "var(--color-ink-0)");
                        conn.setAttribute("stroke-opacity", "0.4");
                        conn.setAttribute("stroke-width", "1");
                        g.appendChild(conn);

                        const box = document.createElementNS(NS, "rect");
                        box.setAttribute("x", "0");
                        box.setAttribute("y", String(CHAIN_Y - 9));
                        box.setAttribute("width", "26");
                        box.setAttribute("height", "18");
                        box.setAttribute("fill", "none");
                        box.setAttribute("stroke", "var(--color-live)");
                        box.setAttribute("stroke-opacity", "0.85");
                        box.setAttribute("stroke-width", "1.5");
                        g.appendChild(box);

                        chainLayer.appendChild(g);
                        links.push({ g, x: written * LINK_W });
                        written += 1;

                        // the newest link is the bright one; everything behind it settles
                        links.forEach((l, i) => {
                            const r = l.g.children[1] as SVGRectElement;
                            const fresh = i === links.length - 1;
                            r.setAttribute("stroke", fresh ? "var(--color-live)" : "var(--color-ink-0)");
                            r.setAttribute("stroke-opacity", fresh ? "0.9" : "0.42");
                            r.setAttribute("stroke-width", fresh ? "1.5" : "1");
                        });
                    };

                    // Scroll target is derived from how many links exist, not from a fixed
                    // speed, so the chain self-corrects instead of drifting out of step
                    // with the crossings that feed it.
                    const advanceChain = () => {
                        const target = Math.max(0, (written - VISIBLE) * LINK_W);
                        scrollX += (target - scrollX) * 0.08;
                        for (let i = links.length - 1; i >= 0; i--) {
                            const screenX = LINK_X0 + links[i].x - scrollX;
                            if (screenX < -LINK_W * 2) {
                                links[i].g.remove();
                                links.splice(i, 1);
                            } else {
                                links[i].g.setAttribute("transform", `translate(${screenX},0)`);
                            }
                        }
                    };

                    const spawn = (lane: number) => {
                        const el = document.createElementNS(NS, "circle") as SVGCircleElement;
                        el.setAttribute("cx", String(START));
                        el.setAttribute("cy", String(LANES[lane]));
                        el.setAttribute("r", "4");
                        el.setAttribute("fill", "var(--color-ink-0)");
                        el.setAttribute("fill-opacity", "0.62");
                        actLayer.appendChild(el);
                        acts.push({ el, x: START, lane, signed: false });
                    };

                    const step = (a: Act) => {
                        a.x += 1.5;
                        // the crossing is the event: this is the moment a link exists
                        if (!a.signed && a.x >= CROSS) {
                            a.signed = true;
                            a.el.setAttribute("fill", "var(--color-live)");
                            a.el.setAttribute("fill-opacity", "0.9");
                            appendLink();
                            bloom(CROSS, LANES[a.lane]);
                        }
                        a.el.setAttribute("cx", String(a.x));
                        return a.x < END;
                    };

                    if (spineReduced) {
                        // Static equivalent: a settled chain and one action on each side.
                        for (let i = 0; i < VISIBLE; i++) appendLink();
                        advanceChain();
                        links.forEach((l) => l.g.setAttribute("transform", `translate(${LINK_X0 + l.x},0)`));
                        [0, 2, 4].forEach((lane) => {
                            spawn(lane);
                            const a = acts[acts.length - 1];
                            a.x = lane === 2 ? END - 120 : START + 90;
                            a.el.setAttribute("cx", String(a.x));
                        });
                    } else {
                        let visible = false;
                        let spawnAt = 0;
                        let n = 0;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(spineFig);
                        const loop = (now: number) => {
                            if (visible) {
                                if (now > spawnAt) {
                                    spawn(n % LANES.length);
                                    n += 1;
                                    spawnAt = now + 1000;
                                }
                                for (let i = acts.length - 1; i >= 0; i--) {
                                    if (!step(acts[i])) { acts[i].el.remove(); acts.splice(i, 1); }
                                }
                                advanceChain();
                                stepBlooms();
                            }
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
        </section>

        <!-- ══════════ CONSENT · THE CO-DETERMINATION PANEL ══════════ -->
        <!-- Static and deliberately unglamorous. For a German buyer this is not fine
             print at the bottom of a recording product, it is the reason the project
             is allowed to start at all, so it gets its own panel directly under the
             station it belongs to. -->
        <section class="border-b border-white/10 bg-bg-0">
            <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-white/10">
                <div class="border border-white/10 bg-white/[0.02] p-7 lg:p-9">
                    <div class="grid lg:grid-cols-[1fr_auto] gap-8 lg:gap-14 items-start">
                        <div>
                            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 mb-5">How the recording is allowed to happen</p>
                            <h3 class="text-xl md:text-2xl font-bold tracking-tight leading-tight text-white mb-4">Recording a person's work is co-determined in Germany. So it is built that way.</h3>
                            <p class="text-base text-white/55 leading-relaxed max-w-2xl mb-4">
                                The works council and data protection are in the room on day one, before anything is recorded. Settling the legal basis is theirs, not a claim we make on their behalf. What we bring to that meeting is a product built to survive it: sessions scoped and time-boxed rather than open-ended, and personal data removed locally before anything is stored, so it is not a deletion promise about data we already hold.
                            </p>
                            <p class="text-base text-white/55 leading-relaxed max-w-2xl">
                                Every session is announced and agreed before it starts, and the person recorded can review their own sessions and delete them. Nothing leaves your environment. A recording product that cannot survive a works council meeting is not a product, it is a pilot that quietly dies in March.
                            </p>
                        </div>
                        <ul class="grid gap-3 lg:w-64 shrink-0">
                            <li class="border border-white/10 px-4 py-3">
                                <span class="block font-mono text-[9px] uppercase tracking-[0.18em] text-live mb-1">Never silent</span>
                                <span class="block font-mono text-[10px] text-white/45 leading-relaxed">Announced and agreed per session</span>
                            </li>
                            <li class="border border-white/10 px-4 py-3">
                                <span class="block font-mono text-[9px] uppercase tracking-[0.18em] text-live mb-1">Session scoped</span>
                                <span class="block font-mono text-[10px] text-white/45 leading-relaxed">Not a monitoring tool left running</span>
                            </li>
                            <li class="border border-white/10 px-4 py-3">
                                <span class="block font-mono text-[9px] uppercase tracking-[0.18em] text-live mb-1">Stripped locally</span>
                                <span class="block font-mono text-[10px] text-white/45 leading-relaxed">Before storage, not after</span>
                            </li>
                            <li class="border border-white/10 px-4 py-3">
                                <span class="block font-mono text-[9px] uppercase tracking-[0.18em] text-live mb-1">Reviewable</span>
                                <span class="block font-mono text-[10px] text-white/45 leading-relaxed">By the person recorded</span>
                            </li>
                        </ul>
                    </div>
                    <p class="mt-7 font-mono text-[10px] text-white/35 leading-relaxed border-t border-white/10 pt-4">
                        Day 1 of every audit is the kick-off with the works council and data protection. It is the first line of the offer, not a clause in it.
                    </p>
                </div>
            </div>
        </section>

        <!-- ══════════ STATION 02 · EVALUATION ══════════ -->
        <section class="border-b border-white/10">
            <div class="max-w-7xl mx-auto px-6 py-20 md:py-24 md:border-x md:border-white/10">
                <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-white/10 items-stretch [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 lg:[&>*:first-child]:pr-16 lg:[&>*:last-child]:pl-16">
                    <div class="flex flex-col">
                        <div class="h-7 flex items-center justify-between border-b border-white/10">
                            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45">02 · Evaluation</span>
                            <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-white/45 border border-white/20 px-2 py-0.5">Coming soon</span>
                        </div>
                        <div class="flex flex-1 flex-col justify-center py-10">
                            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white leading-none">Evaluation</h2>
                        <p class="mt-5 text-base md:text-lg font-semibold text-white/90 leading-snug">A hundred real cases where the right answer is already known.</p>
                        <p class="mt-3 font-mono text-sm text-white/70 uppercase tracking-[0.12em]">Can an agent do this reliably today? Count what it got right.</p>
                        <p class="mt-8 text-lg text-white/55 leading-relaxed">
                            Every recorded process comes with the thing nobody ever has: real cases with a known outcome. That turns the hardest question in enterprise AI from an opinion into a measurement. The agent runs the same cases, and the answer is measured against the outcome in your system of record, not against what the person happened to click. <span class="text-white/35">Not built yet. It needs a fine-tuning partner, and we would rather say so.</span>
                        </p>
                        </div>
                    </div>
                    <!-- Figure sits between two hairlines, so the animation reads as a
                         plate and not as something floating in the column. -->
                    <div class="flex flex-col">
                        <div class="h-7 border-b border-white/10"></div>
                        <div class="flex flex-1 items-center justify-center py-10">
<svg id="replay-fig" viewBox="0 0 480 340" class="w-full max-w-md h-auto" aria-hidden="true">
                            <path d="M12 27 L12 12 L27 12" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M453 12 L468 12 L468 27" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M12 313 L12 328 L27 328" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M468 313 L468 328 L453 328" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />

                            <text x="30" y="52" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">AS RECORDED</text>
                            <text x="450" y="52" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">REPLAYED TODAY</text>

                            <line x1="40" y1="130" x2="430" y2="130" stroke="var(--color-ink-0)" stroke-opacity="0.17" stroke-width="1" stroke-dasharray="3 6" />
                            <line x1="40" y1="230" x2="430" y2="230" stroke="var(--color-ink-0)" stroke-opacity="0.17" stroke-width="1" stroke-dasharray="3 6" />
                            <text x="30" y="134" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;">A</text>
                            <text x="30" y="234" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;">B</text>

                            <!-- the divergence is one entry, not a general mismatch -->
                            <line id="rp-gap" x1="300" y1="130" x2="300" y2="266" stroke="var(--color-warn)" stroke-opacity="0" stroke-width="1" stroke-dasharray="2 3" />

                            {Array.from({ length: 8 }, (_, i) => 60 + i * 48).map((x, i) => (
                                <>
                                    <rect class="rp-top" x={x - 5} y="122" width="10" height="16" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.25" stroke-width="1.25" />
                                    <rect class="rp-bot" x={x - 5} y={i === 5 ? 258 : 222} width="10" height="16" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.25" stroke-width="1.25" />
                                </>
                            ))}

                            <defs>
                            <radialGradient id="replay-glow">
                                <stop offset="0%" stop-color="var(--color-ink-0)" stop-opacity="0.9" />
                                <stop offset="25%" stop-color="var(--color-ink-0)" stop-opacity="0.32" />
                                <stop offset="60%" stop-color="var(--color-live)" stop-opacity="0.2" />
                                <stop offset="100%" stop-color="var(--color-live)" stop-opacity="0" />
                            </radialGradient>
                        </defs>
                        <g id="replay-blooms"></g>
                        <line id="rp-head" x1="40" y1="104" x2="40" y2="284" stroke="var(--color-live)" stroke-opacity="0.65" stroke-width="1" />

                            <text id="rp-note" x="300" y="296" text-anchor="middle" fill="var(--color-warn)" fill-opacity="0" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.1em;">model changed underneath</text>
                            <text x="30" y="318" fill="var(--color-ink-0)" fill-opacity="0.42" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.12em;">same prompt · same agent · different answer</text>
                        </svg>
                        </div>
                        <div class="border-t border-white/10 pt-3">
                            <p class="font-mono text-[10px] text-white/35 leading-relaxed">Seven cases come out the way the record says they should. The eighth is the one worth finding, and only the recording makes it findable.</p>
                        </div>
                    </div>
                </div>
            </div>
<script>
                // replay-fig · a playhead runs the recorded sequence against the replayed one.
                // Entries light as the head reaches them and burn down to a resting level
                // rather than switching off. One entry sits lower than its recorded twin:
                // that is the whole point of the figure, so it is the only thing that
                // holds its color after the head has gone past.
                const rpFig = document.getElementById("replay-fig");
                const rpReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (rpFig) {
                    const DIVERGE = 5;
                    const XS = Array.from({ length: 8 }, (_, i) => 60 + i * 48);
                    const head = document.getElementById("rp-head") as unknown as SVGLineElement;
                    const gap = document.getElementById("rp-gap") as unknown as SVGLineElement;
                    const note = document.getElementById("rp-note") as unknown as SVGTextElement;
                    const tops = Array.from(rpFig.querySelectorAll(".rp-top")) as SVGRectElement[];
                    const bots = Array.from(rpFig.querySelectorAll(".rp-bot")) as SVGRectElement[];
                    const NS = "http://www.w3.org/2000/svg";

                    // Bloom borrowed from the hero canvas: expands on an ease-out and
                    // burns down over roughly two seconds, so a contact glows like an
                    // ember rather than switching on.
                    const bloomLayer = document.getElementById("replay-blooms") as unknown as SVGGElement;
                    const blooms: { el: SVGCircleElement; r: number; a: number; max: number }[] = [];
                    const bloom = (bx: number, by: number, r0 = 8, peak = 0.85) => {
                        const c = document.createElementNS(NS, "circle") as SVGCircleElement;
                        c.setAttribute("cx", String(bx));
                        c.setAttribute("cy", String(by));
                        c.setAttribute("r", String(r0));
                        c.setAttribute("fill", "url(#replay-glow)");
                        c.setAttribute("opacity", String(peak));
                        bloomLayer.appendChild(c);
                        blooms.push({ el: c, r: r0, a: peak, max: r0 + 54 });
                    };
                    const stepBlooms = () => {
                        for (let i = blooms.length - 1; i >= 0; i--) {
                            const b = blooms[i];
                            b.r += (b.max - b.r) * 0.045;
                            b.a *= 0.972;
                            if (b.a < 0.02) { b.el.remove(); blooms.splice(i, 1); }
                            else { b.el.setAttribute("r", b.r.toFixed(1)); b.el.setAttribute("opacity", b.a.toFixed(3)); }
                        }
                    };


                    const REST = 0.25;
                    let bright = XS.map(() => ({ t: REST, b: REST }));
                    let x = 40, gapO = 0, noteO = 0, holdUntil = 0;

                    const paint = () => {
                        bright.forEach((v, i) => {
                            const diverged = i === DIVERGE;
                            tops[i].setAttribute("stroke-opacity", String(v.t));
                            tops[i].setAttribute("stroke", "var(--color-ink-0)");
                            bots[i].setAttribute("stroke-opacity", String(v.b));
                            bots[i].setAttribute("stroke", diverged && v.b > REST + 0.02 ? "var(--color-warn)" : "var(--color-ink-0)");
                        });
                        gap.setAttribute("stroke-opacity", String(gapO));
                        note.setAttribute("fill-opacity", String(noteO));
                        head.setAttribute("x1", String(x));
                        head.setAttribute("x2", String(x));
                    };

                    const tick = () => {
                        if (performance.now() < holdUntil) {
                            // hold on the divergence, then let it burn down with the rest
                            gapO *= 0.994; noteO *= 0.994;
                            bright.forEach((v, i) => {
                                v.t = REST + (v.t - REST) * 0.985;
                                v.b = REST + (v.b - REST) * (i === DIVERGE ? 0.997 : 0.985);
                            });
                            paint();
                            return;
                        }
                        x += 1.05;
                        XS.forEach((xi, i) => {
                            if (x >= xi && bright[i].t <= REST + 0.01) bright[i].t = 0.95;
                            if (x >= xi + 14 && bright[i].b <= REST + 0.01) {
                                bright[i].b = 0.95;
                                if (i === DIVERGE) { gapO = 0.7; noteO = 0.9; bloom(300, 266, 7, 0.8); }
                            }
                        });
                        bright.forEach((v, i) => {
                            v.t = REST + (v.t - REST) * 0.97;
                            v.b = REST + (v.b - REST) * (i === DIVERGE ? 0.995 : 0.97);
                        });
                        gapO *= 0.997; noteO *= 0.997;
                        if (x > 430) { x = 40; holdUntil = performance.now() + 2200; }
                        stepBlooms();
                        paint();
                    };

                    if (rpReduced) {
                        bright = bright.map((_, i) => ({ t: 0.35, b: i === DIVERGE ? 0.9 : 0.35 }));
                        gapO = 0.6; noteO = 0.9; x = 430;
                        paint();
                    } else {
                        let visible = false;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(rpFig);
                        const loop = () => {
                            if (visible) tick();
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
