            <script>
                // FIG.2 · the TTL bar drains, the two granted cells go dark with it, and
                // the grant has to be re-issued. Least privilege is the still image;
                // short-lived is the part only motion can show.
                const capFig = document.getElementById("cap-fig");
                const capReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                if (capFig) {
                    const bar = document.getElementById("cap-ttl-bar")!;
                    const stamp = document.getElementById("cap-expired")!;
                    const grantedLabel = document.getElementById("cap-granted-label")!;
                    const cells = Array.from(capFig.querySelectorAll(".cap-cell")) as SVGElement[];
                    const X0 = 52, X1 = 428, CYCLE = 7000, DARK = 1400;

                    const paint = (t: number) => {
                        const p = Math.min(1, t / CYCLE);
                        bar.setAttribute("x2", String(X1 - (X1 - X0) * p));
                        const expired = p >= 1;
                        stamp.setAttribute("fill-opacity", expired ? "0.8" : "0");
                        // the legend must not still read "2 granted" while the stamp says expired
                        grantedLabel.setAttribute("fill", expired ? "var(--color-ink-0)" : "var(--color-live)");
                        grantedLabel.setAttribute("fill-opacity", expired ? "0.3" : "0.75");
                        cells.forEach((c) => {
                            c.setAttribute("stroke", expired ? "var(--color-ink-0)" : "var(--color-live)");
                            c.setAttribute("stroke-opacity", expired ? "0.12" : "0.7");
                            c.setAttribute("fill", expired ? "none" : "var(--color-live)");
                            c.setAttribute("fill-opacity", expired ? "0" : "0.18");
                        });
                    };

                    if (capReduced) {
                        paint(0);
                    } else {
                        let visible = false, start = 0;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(capFig);
                        const loop = (now: number) => {
                            if (visible) {
                                if (!start) start = now;
                                const t = (now - start) % (CYCLE + DARK);
                                paint(t);
                            }
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
