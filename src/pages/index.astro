---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// Orthographic dot-sphere for the closing ornament
const SPHERE_R = 290;
const sphereDots: { x: number; y: number; a: number }[] = [];
for (let lat = -80; lat <= 80; lat += 8) {
    for (let lon = -80; lon <= 80; lon += 8) {
        const la = (lat * Math.PI) / 180;
        const lo = (lon * Math.PI) / 180;
        sphereDots.push({
            x: 320 + SPHERE_R * Math.sin(lo) * Math.cos(la),
            y: 320 + SPHERE_R * Math.sin(la),
            a: 0.04 + 0.16 * Math.cos(lo) * Math.cos(la),
        });
    }
}

const orgSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "KYDE",
    url: "https://kyde.com",
    logo: "https://kyde.com/kyde-logo.svg",
    description: "KYDE is the behavioral system of record for autonomous work: verifiable identity, short-lived capabilities, real-time policy enforcement at the boundary, and a hash-chained, tamper-evident record of every agent action routed through it.",
};

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KYDE",
    url: "https://kyde.com",
};
---

<Base
    title="KYDE · Deploy AI Agents With Confidence"
    description="KYDE identifies the work ready for automation, builds it into AI workers you own, and runs them on top of the KYDE Zero Trust infrastructure, in your own environment. Which processes are buildable now, which are blocked and on what, and which stay with a person. Built for GDPR, EU AI Act, NIS-2, DORA."
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    </Fragment>
    <Navbar />

    <main>
        <!-- ══════════ HERO STAGE ══════════ -->
        <section class="relative overflow-hidden h-screen min-h-[600px] flex flex-col justify-center pt-20 border-b border-line-0 bg-bg-0">
            <canvas id="hero-datastream" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
            <div class="absolute inset-0 pointer-events-none hero-noise"></div>
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-bg-0 via-bg-0/45 to-transparent"></div>
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-transparent to-bg-0"></div>

            <div class="relative max-w-7xl mx-auto px-6 w-full">
                <!-- Regulation register: the one above-fold cue for why a buyer needs us.
                     Wording mirrors the design-partner line further down, so the claim is repeated, not re-opened. -->
                <p id="hero-eyebrow" class="mb-4 md:mb-5 font-mono text-[10px] md:text-[11px] text-white/55 uppercase tracking-[0.16em] md:tracking-[0.2em]" style="opacity:0;transition:opacity 0.9s ease;">
                    Built for GDPR <span class="text-white/30" aria-hidden="true">·</span> EU AI Act <span class="text-white/30" aria-hidden="true">·</span> NIS-2 <span class="text-white/30" aria-hidden="true">·</span> DORA
                </p>
                <!-- Short headline again: the widest line is ~9.5px per font-px, so 72px needs
                     686px and clears every container down to 768px. Base is 2rem rather than
                     text-4xl so it still fits one line on a 375px phone. -->
                <h1 class="hero-h1 text-[2rem] text-white uppercase tracking-tight leading-none sm:text-5xl md:text-6xl lg:text-7xl" style="opacity:0;">
                    <span id="hero-l1" style="display:block">Own Your</span>
                    <span id="hero-l2" style="display:block">Intelligence.</span>
                </h1>
                <p id="hero-sub" class="mt-5 md:mt-7 text-sm md:text-base lg:text-lg text-white uppercase tracking-[0.12em] leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease;">
                    Your processes. Your documents. Your know-how. Structured for AI and owned by you.
                </p>
                <p id="hero-explainer" class="mt-3 text-sm md:text-base text-white/70 leading-snug max-w-xs md:max-w-md lg:max-w-xl" style="opacity:0;transition:opacity 0.9s ease 0.15s;">
                    KYDE identifies the work ready for automation, builds it into AI workers you own, and runs them on top of the KYDE Zero Trust infrastructure, in your own environment.
                </p>
                <!-- Hero CTAs mirror the navbar: download is the primary goal, contact stays one click away -->
                <div id="hero-ctas" class="mt-8 flex flex-col sm:flex-row gap-4" style="opacity:0;transition:opacity 0.9s ease 0.5s;">
                    <button
                        onclick="openModal()"
                        class="inline-flex items-center gap-2 border border-white/40 text-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:border-white hover:bg-white/10 transition-all"
                    >
                        Talk to Us →
                    </button>
                    <a
                        href="/audit"
                        class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] hover:bg-cta-hover transition-all"
                    >
                        Start your audit →
                    </a>
                </div>
                <div class="mt-8 space-y-1.5" style="opacity:0;transition:opacity 0.9s ease 0.7s;" id="hero-terminal">
                    <p class="font-mono text-[10px] md:text-[11px] text-white/45 uppercase tracking-[0.18em]">On-premise <span class="text-white/20">·</span> Private cloud <span class="text-white/20">·</span> EU-hosted</p>
                    <p class="font-mono text-[10px] md:text-[11px] text-white/45 uppercase tracking-[0.18em]">Open models <span class="text-white/20">·</span> Open standards <span class="text-white/20">·</span> Your systems</p>
                </div>
            </div>

        </section>


<script>
  const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const SPEED = 0.22;

  function scrambleLine(el: HTMLElement, target: string, delay: number, onDone?: () => void) {
    let frame = 0;
    setTimeout(() => {
      el.innerText = target;
      const finalH = el.offsetHeight;
      el.style.height = finalH + "px";
      el.style.overflow = "hidden";

      function tick() {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          if (i < frame) {
            out += target[i];
          } else if (target[i] === " " || target[i] === ".") {
            out += target[i];
          } else {
            out += CHARS[Math.floor(Math.random() * CHARS.length)];
          }
        }
        el.innerText = out;
        frame += SPEED;
        if (frame < target.length) {
          requestAnimationFrame(tick);
        } else {
          el.innerText = target;
          el.style.height = "";
          el.style.overflow = "";
          if (onDone) onDone();
        }
      }
      tick();
    }, delay);
  }

  const l1 = document.getElementById("hero-l1") as HTMLElement;
  const l2 = document.getElementById("hero-l2") as HTMLElement;
  const sub = document.getElementById("hero-sub") as HTMLElement;
  const eyebrow = document.getElementById("hero-eyebrow") as HTMLElement;
  const h1 = l1?.closest("h1") as HTMLElement;
  if (h1) { h1.style.animation = "none"; h1.style.opacity = "0"; }
  const explainer = document.getElementById("hero-explainer") as HTMLElement;
  const ctas = document.getElementById("hero-ctas") as HTMLElement;
  if (l1) scrambleLine(l1, "OWN YOUR", 200);
  if (l2) scrambleLine(l2, "INTELLIGENCE.", 200, () => {
    if (eyebrow) eyebrow.style.opacity = "1";
    if (sub) sub.style.opacity = "1";
    if (explainer) explainer.style.opacity = "1";
    if (ctas) ctas.style.opacity = "1";
    const term = document.getElementById("hero-terminal");
    if (term) term.style.opacity = "1";
  });
  setTimeout(() => { if (h1) h1.style.opacity = "1"; }, 200);

  // ── Boundary-gate figure ────────────────────────────────────────
  // Geometric, not "rain": unordered agents drift on the left,
  // cross the vertical gate line, and snap into a strict lattice , 
  // ungoverned chaos becomes governed order. Rare green pulse at
  // crossing (recorded), rare red flash bouncing off (blocked).
  const canvas = document.getElementById("hero-datastream") as HTMLCanvasElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0, GATE = 0, ROW = 26;

    // Theme-aware palette: the figure is drawn from CSS tokens, not literal
    // rgb triples, so it inverts cleanly (light ink on dark, dark ink on
    // light) instead of staying a fixed dark box when the theme toggles.
    const C = { ink: "242,242,242", live: "61,220,132", alert: "255,92,92" };
    function hexToRgb(hex: string): string {
      const m = hex.trim().replace("#", "");
      const n = parseInt(m.length === 3 ? m.split("").map((c) => c + c).join("") : m, 16);
      return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`;
    }
    function readColors() {
      const cs = getComputedStyle(document.documentElement);
      C.ink = hexToRgb(cs.getPropertyValue("--color-ink-0") || "#F2F2F2");
      C.live = hexToRgb(cs.getPropertyValue("--color-live") || "#3DDC84");
      C.alert = hexToRgb(cs.getPropertyValue("--color-alert") || "#FF5C5C");
    }
    readColors();

    function hash(n: number): number {
      let t = (n + 0x6d2b79f5) | 0;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }

    type P = {
      x: number; y: number; vx: number; seed: number;
      state: "wild" | "signed" | "blocked";
      rowY: number; pulse: number;
    };
    let parts: P[] = [];

    // occasional bloom when a particle crosses the gate
    type Flare = { x: number; y: number; t0: number };
    let flares: Flare[] = [];
    let lastFlare = 0;

    function spawn(p: P, i: number, initial = false) {
      p.x = initial ? hash(i * 7 + 1) * GATE : -10 - hash(i * 13) * 60;
      p.y = 40 + hash(i * 31 + performance.now() % 9973) * (H - 80);
      p.vx = 12 + hash(i * 17) * 22;
      p.seed = i * 7919 + Math.floor(performance.now());
      p.state = "wild";
      p.pulse = 0;
    }

    // Measuring once at script time is not enough: on a reload the module can run
    // before layout has settled, and a canvas that is measured at zero keeps its
    // default 300x150 buffer while CSS stretches it to full width. Everything then
    // looks scaled up and, because the particles cross a much smaller space, far
    // too fast. Only a real window resize used to fix it.
    function resize() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (!w || !h) return;                       // not laid out yet, try again later
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (w === W && h === H && canvas.width === Math.round(w * dpr)) return;
      W = w;
      H = h;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      GATE = W * 0.68;
      parts = [];
      const n = Math.max(40, Math.floor(W / 16));
      for (let i = 0; i < n; i++) {
        const p = {} as P;
        spawn(p, i, true);
        parts.push(p);
      }
    }

    let last = 0;
    function draw(t: number) {
      const dt = Math.min((t - last) / 1000, 0.05) || 0.016;
      last = t;
      ctx.clearRect(0, 0, W, H);

      // lattice on the governed side, faint, strict
      ctx.fillStyle = `rgba(${C.ink},0.08)`;
      for (let x = GATE + ROW; x < W; x += ROW)
        for (let y = ROW; y < H; y += ROW)
          ctx.fillRect(x - 0.75, y - 0.75, 1.5, 1.5);

      // gate line, nearly invisible at the ends, a faint shimmer mid-height;
      // it reveals itself through interaction (blooms, blocks), not presence
      const gateGrad = ctx.createLinearGradient(0, 0, 0, H);
      gateGrad.addColorStop(0, `rgba(${C.ink},0)`);
      gateGrad.addColorStop(0.5, `rgba(${C.ink},0.13)`);
      gateGrad.addColorStop(1, `rgba(${C.ink},0)`);
      ctx.fillStyle = gateGrad;
      ctx.fillRect(GATE, 0, 1, H);
      for (let y = 0; y < H; y += ROW * 2) {
        const env = Math.sin((Math.PI * y) / H);
        ctx.fillStyle = `rgba(${C.ink},${0.16 * env * env})`;
        ctx.fillRect(GATE - 3, y, 7, 1);
      }

      for (const p of parts) {
        const jitterSeed = p.seed + Math.floor(t / 300);

        if (p.state === "wild") {
          // brownian drift with slow right bias
          p.x += p.vx * dt;
          p.y += (hash(jitterSeed) - 0.5) * 34 * dt * 2.2;

          if (p.x >= GATE) {
            if (hash(p.seed + 5) > 0.93) {
              p.state = "blocked";
              p.pulse = 1;
              p.vx = -18;
            } else {
              p.state = "signed";
              p.pulse = hash(p.seed + 9) > 0.7 ? 1 : 0;
              p.rowY = Math.round(p.y / ROW) * ROW;
              p.vx = 26 + hash(p.seed + 3) * 18;
              // every few seconds, one crossing blooms
              if (t - lastFlare > 2100 && hash(p.seed + 11) > 0.4) {
                flares.push({ x: GATE, y: p.rowY, t0: t });
                lastFlare = t;
              }
            }
          }
          ctx.fillStyle = `rgba(${C.ink},0.32)`;
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
        } else if (p.state === "signed") {
          p.x += p.vx * dt;
          p.y += (p.rowY - p.y) * Math.min(dt * 6, 1); // snap to lattice row

          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(${C.live},${p.pulse * 0.7})`;
            ctx.lineWidth = 1;
            ctx.strokeRect(p.x - 4, p.y - 4, 8, 8);
            p.pulse -= dt * 1.4;
          }
          ctx.fillStyle = `rgba(${C.ink},0.68)`;
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);

          if (p.x > W + 10) spawn(p, Math.floor(p.seed / 7919));
        } else {
          // blocked: red flash at the gate, drift back, fade
          p.x += p.vx * dt;
          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(${C.alert},${p.pulse * 0.8})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p.x + 4, p.y - 4); ctx.lineTo(p.x - 4, p.y + 4);
            ctx.moveTo(p.x - 4, p.y - 4); ctx.lineTo(p.x + 4, p.y + 4);
            ctx.stroke();
            p.pulse -= dt * 0.9;
          } else {
            spawn(p, Math.floor(p.seed / 7919));
          }
        }
      }

      // flares, soft light bloom at the gate, expanding and fading
      flares = flares.filter((f) => t - f.t0 < 1600);
      for (const f of flares) {
        const age = (t - f.t0) / 1600; // 0 → 1
        const ease = 1 - Math.pow(1 - age, 2);
        const r = 16 + ease * 130;
        const a = (1 - age) * 0.85;

        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, r);
        g.addColorStop(0, `rgba(${C.ink},${a})`);
        g.addColorStop(0.25, `rgba(${C.ink},${a * 0.35})`);
        g.addColorStop(0.6, `rgba(${C.live},${a * 0.22})`);
        g.addColorStop(1, `rgba(${C.live},0)`);
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(f.x, f.y, r, 0, Math.PI * 2);
        ctx.fill();

        // bright core that snuffs out quickly
        if (age < 0.35) {
          ctx.fillStyle = `rgba(${C.ink},${(1 - age / 0.35) * 0.9})`;
          ctx.fillRect(f.x - 2, f.y - 2, 4, 4);
        }

        // brief brightening of the gate line around the bloom
        const gl = ctx.createLinearGradient(f.x, f.y - r, f.x, f.y + r);
        gl.addColorStop(0, `rgba(${C.ink},0)`);
        gl.addColorStop(0.5, `rgba(${C.ink},${a * 0.8})`);
        gl.addColorStop(1, `rgba(${C.ink},0)`);
        ctx.fillStyle = gl;
        ctx.fillRect(GATE, f.y - r, 1, r * 2);
      }
    }

    resize();
    window.addEventListener("resize", resize);

    // Held in a variable on purpose: an observer with no reference of its own can
    // be collected, and then it silently stops firing. Measured that happening.
    const canvasObserver = "ResizeObserver" in window ? new ResizeObserver(() => resize()) : null;
    if (canvasObserver) canvasObserver.observe(canvas);

    // Belt and braces for the first paint. The observer covers later changes, but
    // the very first measurement can land before layout is final, and the guard
    // above makes each of these free once the size is already right.
    requestAnimationFrame(() => resize());
    window.addEventListener("load", () => resize());
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => resize());

    // Re-read the palette on theme toggle. The running rAF loop repaints
    // every frame anyway and will pick the new colors up on its own; the
    // reduced-motion path only ever draws once, so it needs an explicit nudge.
    window.addEventListener("kyde:theme", () => {
      readColors();
      if (reduced) draw(performance.now());
    });

    if (reduced) {
      draw(1);
    } else {
      let heroVisible = true;
      new IntersectionObserver((es) => { heroVisible = es[0].isIntersecting; }).observe(canvas);
      const loop = (t: number) => { if (heroVisible) draw(t); requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
  }
</script>




        <!-- ══════════ WORKERS ══════════ -->
        <!-- The product, immediately after the vision. Three steps rather than a
             capability list, because the reader is deciding whether this is a thing
             that can happen in their company, not what it is made of. The tacit
             knowledge point that used to be its own section opens it: it is the
             reason step 01 exists at all, and it did not need a whole screen. -->
        <section class="border-b border-white/10 bg-bg-0">
            <div class="max-w-7xl mx-auto px-6 py-20 md:py-28 md:border-x md:border-white/10">
                <div class="flex items-end justify-between border-b border-white/10 pb-3 mb-12">
                    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/65">Workers</span>
                </div>

                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-white mb-6 max-w-4xl">
                    KYDE turns the processes you already run into workers you own.
                </h2>
                <p class="text-lg text-white/55 leading-relaxed max-w-3xl mb-16">
                    Your best processes live in people's heads: the claim that gets assessed a certain way, the supplier document that gets checked twice, the step everyone does and nobody wrote down. Every automation project starts by guessing how the work happens and where the knowledge lives. This one starts by capturing both.
                </p>

                <div class="grid md:grid-cols-3 gap-12 md:gap-0 md:divide-x md:divide-white/10 [&>*:not(:first-child)]:md:pl-10 [&>*:not(:last-child)]:md:pr-10">
                    <div>
                        <span class="block font-mono text-[11px] tracking-[0.1em] text-gold mb-5">01</span>
                        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-white leading-tight mb-4">Find the work</h3>
                        <p class="text-base text-white/55 leading-relaxed">
                            We capture the work and the intelligence behind it: screens, decisions, tool calls, approvals, documents, rules and exceptions. Structured for AI, so workers can use what your company already knows, down to the edge cases no handbook covers. Personal data is removed locally, before anything is stored.
                        </p>
                    </div>
                    <div>
                        <span class="block font-mono text-[11px] tracking-[0.1em] text-gold mb-5">02</span>
                        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-white leading-tight mb-4">Build the worker</h3>
                        <p class="text-base text-white/55 leading-relaxed">
                            Code where the steps are fixed. An agent where judgement is needed. A person where the decision carries weight. The worker is built from how your company already works, not from an assumption about how it should, and it stops instead of guessing when it meets something it has not seen.
                        </p>
                    </div>
                    <div>
                        <span class="block font-mono text-[11px] tracking-[0.1em] text-gold mb-5">03</span>
                        <h3 class="text-xl md:text-2xl font-bold tracking-tight text-white leading-tight mb-4">Run the workforce</h3>
                        <p class="text-base text-white/55 leading-relaxed">
                            It runs in your environment, on open models, under an identity of its own. You see what it did and what it handed back. Then the next process, and the one after that.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ AUTOMATION READINESS ══════════ -->
        <!-- Not a compliance product bolted on the side: this is where the workforce
             starts. Three states rather than a percentage, because "82% automation
             potential" is a number nobody can act on and "this one is waiting on an
             MCP server for your ERP" is a date in somebody's calendar. -->
        <section id="audit" class="scroll-mt-20 border-b border-white/10">
            <div class="max-w-7xl mx-auto px-6 py-20 md:py-28 md:border-x md:border-white/10">
                <div class="flex items-end justify-between border-b border-white/10 pb-3 mb-12">
                    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/65">Automation readiness</span>
                    <span class="fig-label">FIG.1</span>
                </div>

                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-white mb-6 max-w-4xl">
                    What could be automated right now?
                </h2>
                <p class="text-lg text-white/55 leading-relaxed max-w-3xl mb-14">
                    Start with the work. We map one process area with the people who run it, and sort what can be automated into three: what an agent does, what is plain code, and what needs something that does not exist yet. Everything in the third group carries what it is waiting on and who can move it. The rest stays with your people, and we say which.
                </p>

                <div class="border border-white/10 divide-y divide-white/10 mb-16">
                    <div class="grid md:grid-cols-[220px_1fr] gap-4 md:gap-12 px-6 py-7 md:px-8 md:py-8">
                        <div>
                            <span class="inline-block font-mono text-[10px] uppercase tracking-[0.16em] text-live border border-live/30 bg-live/[0.08] px-2.5 py-1 mb-3">An agent does it</span>
                            <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-white/35">Probabilistic</p>
                        </div>
                        <p class="text-base md:text-lg text-white/55 leading-relaxed">
                            Work where the right answer depends on reading the situation: a customer's tone, a claim that does not look like the others, a supplier mail that ignores the template. An agent handles these, and we measure it against cases where your own outcome is already on record.
                        </p>
                    </div>
                    <div class="grid md:grid-cols-[220px_1fr] gap-4 md:gap-12 px-6 py-7 md:px-8 md:py-8">
                        <div>
                            <span class="inline-block font-mono text-[10px] uppercase tracking-[0.16em] text-ink-0 border border-white/25 px-2.5 py-1 mb-3">Code does it</span>
                            <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-white/35">Deterministic</p>
                        </div>
                        <p class="text-base md:text-lg text-white/55 leading-relaxed">
                            Work where the steps are fixed. Converting the document, reconciling two lists, moving the field from one system into the next. We write that code as part of the build. It runs the same way every time and costs almost nothing to run.
                        </p>
                    </div>
                    <div class="grid md:grid-cols-[220px_1fr] gap-4 md:gap-12 px-6 py-7 md:px-8 md:py-8">
                        <div>
