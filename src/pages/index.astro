---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// FIG.3 · Zero-trust ring: six verification dimensions on a circle
const ZT_CX = 280, ZT_CY = 280, ZT_R = 200;
const ztDims = [
    { label: "WHO",   sub: "identity"  },
    { label: "WHAT",  sub: "action"    },
    { label: "WHEN",  sub: "timestamp" },
    { label: "WHERE", sub: "endpoint"  },
    { label: "WHY",   sub: "context"   },
    { label: "HOW",   sub: "method"    },
].map((d, i) => {
    const ang = ((-90 + i * 60) * Math.PI) / 180;
    return {
        ...d,
        i,
        x: ZT_CX + ZT_R * Math.cos(ang),
        y: ZT_CY + ZT_R * Math.sin(ang),
        lx: ZT_CX + (ZT_R + 42) * Math.cos(ang),
        ly: ZT_CY + (ZT_R + 42) * Math.sin(ang),
    };
});

// Orthographic dot-sphere for the closing ornament
const SPHERE_R = 290;
const sphereDots: { x: number; y: number; a: number }[] = [];
for (let lat = -80; lat <= 80; lat += 8) {
    for (let lon = -80; lon <= 80; lon += 8) {
        const la = (lat * Math.PI) / 180;
        const lo = (lon * Math.PI) / 180;
        sphereDots.push({
            x: 320 + SPHERE_R * Math.sin(lo) * Math.cos(la),
            y: 320 + SPHERE_R * Math.sin(la),
            a: 0.04 + 0.16 * Math.cos(lo) * Math.cos(la),
        });
    }
}

const orgSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "KYDE",
    url: "https://kyde.com",
    logo: "https://kyde.com/kyde-logo.svg",
    description: "KYDE is the behavioral firewall between AI agents and the real world: deterministic guardrails, a cryptographically signed audit trail, and a behavioral trust score for AI agents across every LLM provider.",
};

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KYDE",
    url: "https://kyde.com",
};
