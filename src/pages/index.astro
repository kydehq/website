<script>
  const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const SPEED = 0.22;

  function scrambleLine(el: HTMLElement, target: string, delay: number, onDone?: () => void) {
    let frame = 0;
    setTimeout(() => {
      el.innerText = target;
      const finalH = el.offsetHeight;
      el.style.height = finalH + "px";
      el.style.overflow = "hidden";

      function tick() {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          if (i < frame) {
            out += target[i];
          } else if (target[i] === " " || target[i] === ".") {
            out += target[i];
          } else {
            out += CHARS[Math.floor(Math.random() * CHARS.length)];
          }
        }
        el.innerText = out;
        frame += SPEED;
        if (frame < target.length) {
          requestAnimationFrame(tick);
        } else {
          el.innerText = target;
          el.style.height = "";
          el.style.overflow = "";
          if (onDone) onDone();
        }
      }
      tick();
    }, delay);
  }

  const l1 = document.getElementById("hero-l1") as HTMLElement;
  const l2 = document.getElementById("hero-l2") as HTMLElement;
  const l3 = document.getElementById("hero-l3") as HTMLElement;
  const sub = document.getElementById("hero-sub") as HTMLElement;
  const h1 = l1?.closest("h1") as HTMLElement;
  if (h1) { h1.style.animation = "none"; h1.style.opacity = "0"; }
  const explainer = document.getElementById("hero-explainer") as HTMLElement;
  const ctas = document.getElementById("hero-ctas") as HTMLElement;
  if (l1) scrambleLine(l1, "UNDERSTAND WHAT MAKES", 200);
  if (l2) scrambleLine(l2, "YOUR COMPANY", 200);
  if (l3) scrambleLine(l3, "UNIQUE.", 200, () => {
    if (sub) sub.style.opacity = "1";
    if (explainer) explainer.style.opacity = "1";
    if (ctas) ctas.style.opacity = "1";
    const term = document.getElementById("hero-terminal");
    if (term) term.style.opacity = "1";
  });
  setTimeout(() => { if (h1) h1.style.opacity = "1"; }, 200);

  // ── The recorder ────────────────────────────────────────────────
  // The cassette runs. Reels turn, tape moves from the full reel to
  // the take-up reel, and every ~1.4s one event marker travels the
  // tape into the record: a green tick, the counter advances. Nothing
  // is ever blocked here. Observe only, on stage.
  const cassette = document.getElementById("hero-cassette");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (cassette && !reduced) {
    const NS = "http://www.w3.org/2000/svg";
    const hubL = document.getElementById("cs-hub-l")!;
    const hubR = document.getElementById("cs-hub-r")!;
    const packL = document.getElementById("cs-pack-l")!;
    const packR = document.getElementById("cs-pack-r")!;
    const rec = document.getElementById("cs-rec")!;
    const tick = document.getElementById("cs-tick")!;
    const counter = document.getElementById("cs-counter")!;
    const status = document.getElementById("cs-status")!;
    const markers = document.getElementById("cs-markers")!;

    let entries = 4211;
    const MARKER_EVERY = 1400;
    const MARKER_DUR = 1900;
    const X0 = 192, X1 = 448, Y = 332;
    let nextMarker = performance.now() + 600;
    const inflight: { el: SVGRectElement; t0: number }[] = [];

    let visible = true;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(cassette);

    let tickAt = -1e9;

    function frame(t: number) {
      if (visible) {
        // reels: take-up turns faster than the feed, like a real deck
        hubL.setAttribute("transform", `rotate(${(t * 0.028) % 360} 230 210)`);
        hubR.setAttribute("transform", `rotate(${(t * 0.046) % 360} 410 210)`);

        // tape slowly migrates from the left pack to the right one
        const drift = Math.sin(t / 24000) * 5;
        packL.setAttribute("r", String(64 - drift));
        packR.setAttribute("r", String(42 + drift));

        // REC breathes
        rec.setAttribute("fill-opacity", String(0.55 + 0.45 * Math.sin(t / 450)));

        // spawn markers
        if (t >= nextMarker) {
          const m = document.createElementNS(NS, "rect");
          m.setAttribute("y", String(Y - 3));
          m.setAttribute("width", "5");
          m.setAttribute("height", "6");
          m.setAttribute("fill", "var(--color-ink-0)");
          m.setAttribute("fill-opacity", "0.9");
          markers.appendChild(m);
          inflight.push({ el: m, t0: t });
          nextMarker = t + MARKER_EVERY;
        }

        // move markers; on arrival: tick + counter
        for (let i = inflight.length - 1; i >= 0; i--) {
          const f = inflight[i];
          const p = (t - f.t0) / MARKER_DUR;
          if (p >= 1) {
            f.el.remove();
            inflight.splice(i, 1);
            entries++;
            counter.textContent = `#${String(entries).padStart(6, "0")}`;
            status.textContent = `${entries.toLocaleString("en-US")} ENTRIES · CHAIN INTACT`;
            tickAt = t;
          } else {
            f.el.setAttribute("x", String(X0 + (X1 - X0) * p - 2.5));
            f.el.setAttribute("fill-opacity", String(0.35 + 0.55 * p));
          }
        }

        // signed tick flash
        const tp = (t - tickAt) / 700;
        if (tp >= 0 && tp <= 1) {
          tick.setAttribute("opacity", String((1 - tp) * 0.9));
          tick.setAttribute("r", String(7 + tp * 10));
        } else {
          tick.setAttribute("opacity", "0");
        }
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
</script>


