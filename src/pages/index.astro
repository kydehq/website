        <script>
          // FIG.1 · the line leaves the envelope, crosses the threshold, and is
          // cut. Drawn rather than faded in, because the argument is that the
          // deviation is gradual and the catch is not. Loops, like the ladder.
          {
            const fig = document.getElementById("drift-fig");
            if (fig) {
              const path = document.getElementById("drift-path") as unknown as SVGPathElement;
              const ghost = document.getElementById("drift-ghost-path") as unknown as SVGPathElement;
              const ghostG = document.getElementById("drift-ghost")!;
              const detect = document.getElementById("drift-detect")!;
              const stop = document.getElementById("drift-stop")!;
              const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

              const L = path.getTotalLength();
              const GL = ghost.getTotalLength();

              function paintStatic() {
                path.style.strokeDasharray = "none";
                path.style.strokeDashoffset = "0";
                ghost.style.strokeDasharray = "3 5";
                ghost.style.strokeDashoffset = "0";
                ghostG.setAttribute("opacity", "1");
                detect.setAttribute("opacity", "1");
                stop.setAttribute("opacity", "1");
              }

              if (reduced) {
                paintStatic();
              } else {
                let visible = false;
                new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(fig);

                const DRAW = 3200;   // the slow drift
                const GHOST_DRAW = 1100; // the counterfactual
                const HOLD = 2600;   // long enough to read the labels
                const CYCLE = DRAW + GHOST_DRAW + HOLD;
                let t0 = 0;

                path.style.strokeDasharray = String(L);
                ghost.style.strokeDasharray = String(GL);

                function frame(t: number) {
                  if (!t0) t0 = t;
                  if (visible) {
                    const e = (t - t0) % CYCLE;

                    // the observed line draws left to right
                    const dp = Math.min(e / DRAW, 1);
                    path.style.strokeDashoffset = String(L * (1 - dp));

                    // the threshold crossing sits at ~82% of the drawn line
                    detect.setAttribute("opacity", String(Math.max(0, Math.min((dp - 0.82) / 0.10, 1))));
                    // the cut lands as the line arrives at its end
                    stop.setAttribute("opacity", String(Math.max(0, Math.min((dp - 0.97) / 0.03, 1))));

                    // then the ghost, dashed, showing where it was going
                    const gp = Math.max(0, Math.min((e - DRAW) / GHOST_DRAW, 1));
                    ghostG.setAttribute("opacity", String(gp > 0 ? 1 : 0));
                    ghost.style.strokeDashoffset = String(GL * (1 - gp));
                  } else {
                    t0 = 0;
                  }
                  requestAnimationFrame(frame);
                }
                requestAnimationFrame(frame);
              }
            }
          }
        </script>
      </div>
    </section>

