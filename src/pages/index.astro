        <section class="relative border-b border-white/10 h-[280px] md:h-[380px] overflow-hidden" aria-hidden="true">
            <canvas id="glitch-wall" class="absolute inset-0 w-full h-full"></canvas>
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-[#050505] via-transparent to-[#050505]/60"></div>
            <!-- grid rails continue through the divider -->
            <div class="absolute inset-0 pointer-events-none">
                <div class="max-w-7xl mx-auto h-full md:border-x md:border-white/10"></div>
            </div>
        </section>
        <script>
            // Diagonal data-wall divider, flowing dash field, green-dominant
            const gw = document.getElementById("glitch-wall") as HTMLCanvasElement | null;
            const gwReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (gw) {
                const gctx = gw.getContext("2d")!;
                let gW = 0, gH = 0;

                function ghash(n: number): number {
                    let t = (n + 0x6d2b79f5) | 0;
                    t = Math.imul(t ^ (t >>> 15), t | 1);
                    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
                    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
                }

                function gResize() {
                    const dpr = Math.min(window.devicePixelRatio || 1, 2);
                    gW = gw.clientWidth;
                    gH = gw.clientHeight;
                    gw.width = gW * dpr;
                    gw.height = gH * dpr;
                    gctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                }

                const CX = 6, CY = 8; // cell size
                function gDraw(t: number) {
                    gctx.clearRect(0, 0, gW, gH);
                    const flow = t / 40;
                    for (let y = 0; y < gH; y += CY) {
                        const row = Math.floor(y / CY);
                        const rowSpeed = 0.4 + ghash(row * 71) * 1.2;
                        for (let x = 0; x < gW; x += CX) {
                            const col = Math.floor((x + flow * rowSpeed * 10) / CX);
                            // diagonal density band, sweeping slowly
                            const diag = (x / gW) * 0.6 + (1 - y / gH) * 0.4;
                            const bandC = 0.5 + 0.28 * Math.sin(t / 9000);
                            const band = Math.max(0, 1 - Math.abs(diag - bandC) * 3.2);
                            const r = ghash(col * 733 + row * 131);
                            if (r > band * 0.75 + 0.04) continue;
                            const r2 = ghash(col * 31 + row * 977);
                            const flick = 0.4 + 0.6 * ghash(col + row + Math.floor(t / 240));
                            const a = (0.06 + r2 * 0.5) * band * flick;
                            gctx.fillStyle = r2 > 0.55
                                ? `rgba(61,220,132,${a})`
                                : `rgba(242,242,242,${a * 0.7})`;
                            gctx.fillRect(x, y, 1.5 + r2 * 2.5, 1.5);
                        }
                    }
                }

                gResize();
                window.addEventListener("resize", gResize);

                if (gwReduced) {
                    gDraw(4000);
                } else {
                    let visible = false;
                    const gio = new IntersectionObserver((es) => {
                        visible = es[0].isIntersecting;
                    });
                    gio.observe(gw);
                    const gLoop = (t: number) => {
                        if (visible) gDraw(t);
                        requestAnimationFrame(gLoop);
                    };
                    requestAnimationFrame(gLoop);
                }
            }
        </script>

