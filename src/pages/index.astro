                            <text x="450" y="52" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">OUTSIDE KYDE</text>

                            <!-- the boundary is the argument: everything to the right of it
                                 happens without us, and nothing crosses back -->
                            <line x1="300" y1="66" x2="300" y2="304" stroke="var(--color-ink-0)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="2 6" />
                            <text x="294" y="86" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.42" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.14em;">KYDE ENDS HERE</text>

                            <g id="chain-blooms"></g>

                            {[
                                { h: "a4ce", a: "db.write" },
                                { h: "a4cf", a: "transfer" },
                                { h: "a4d0", a: "dlp.mask" },
                                { h: "a4d1", a: "quote.set" },
                            ].map(({ h, a }, i) => (
                                <>
                                    {i < 3 && (
                                        <line class="ch-conn" x1={30 + i * 64 + 54} y1="134" x2={30 + (i + 1) * 64} y2="134"
                                              stroke="var(--color-ink-0)" stroke-opacity="0.20" stroke-width="1.5" />
                                    )}
                                    <rect class="ch-box" x={30 + i * 64} y="112" width="54" height="44" fill="none"
                                          stroke="var(--color-ink-0)" stroke-opacity="0.26" stroke-width="1" />
                                    <text x={57 + i * 64} y="132" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.68"
                                          style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.06em;">{h}</text>
                                    <text x={57 + i * 64} y="146" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.40"
                                          style="font-family:'JetBrains Mono Variable',monospace;font-size:7px;letter-spacing:0.05em;">{a}</text>
                                </>
                            ))}

                            <!-- the export's route out; the token is driven along it -->
                            <path id="ch-route" d="M249 156 Q 292 196, 356 226" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.17" stroke-width="1" stroke-dasharray="2 5" />

                            <rect id="ch-verifier" x="330" y="214" width="110" height="58" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.30" stroke-width="1" />
                            <text x="385" y="234" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.14em;">AUDITOR</text>
                            <text id="ch-recompute" x="385" y="252" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.38" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;">recompute · check signature</text>

                            <rect id="ch-export" x="243" y="150" width="12" height="12" fill="none" stroke="var(--color-live)" stroke-opacity="0" stroke-width="1.5" />

                            <text id="ch-status" x="385" y="292" text-anchor="middle" fill="var(--color-live)" fill-opacity="0" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.14em;">HASH MATCHES</text>
                            <text x="30" y="318" fill="var(--color-ink-0)" fill-opacity="0.42" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.1em;">sha-256 chain · recomputed offline · we are not asked</text>
                        </svg>
                        </div>
                        <div class="border-t border-white/10 pt-3">
                            <p class="font-mono text-[10px] text-white/35 leading-relaxed">The export is recomputed on the other side. Everything after the boundary happens without us, and nothing comes back.</p>
                        </div>
                    </div>
                </div>
            </div>
<script>
                // chain-fig · the seal runs left to right, one entry at a time, each sealed
                // by the one before it. Then the export leaves, crosses the boundary and
                // is checked on the other side. Nothing comes back: that is the claim the
                // figure has to carry, so the motion only ever travels outward.
                const chainFig = document.getElementById("chain-fig");
                const chainReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (chainFig) {
                    const NS = "http://www.w3.org/2000/svg";
                    const boxes = Array.from(chainFig.querySelectorAll(".ch-box")) as SVGRectElement[];
                    const conns = Array.from(chainFig.querySelectorAll(".ch-conn")) as SVGLineElement[];
                    const route = document.getElementById("ch-route") as unknown as SVGPathElement;
                    const exp = document.getElementById("ch-export") as unknown as SVGRectElement;
                    const status = document.getElementById("ch-status") as unknown as SVGTextElement;
                    const recompute = document.getElementById("ch-recompute") as unknown as SVGTextElement;
                    const bloomLayer = document.getElementById("chain-blooms") as unknown as SVGGElement;
                    const routeLen = route.getTotalLength();

                    const blooms: { el: SVGCircleElement; r: number; a: number; max: number }[] = [];
                    const bloom = (bx: number, by: number, r0 = 8, peak = 0.85) => {
                        const c = document.createElementNS(NS, "circle") as SVGCircleElement;
                        c.setAttribute("cx", String(bx));
                        c.setAttribute("cy", String(by));
                        c.setAttribute("r", String(r0));
                        c.setAttribute("fill", "url(#chain-glow)");
                        c.setAttribute("opacity", String(peak));
                        bloomLayer.appendChild(c);
                        blooms.push({ el: c, r: r0, a: peak, max: r0 + 54 });
                    };
                    const stepBlooms = () => {
                        for (let i = blooms.length - 1; i >= 0; i--) {
                            const b = blooms[i];
                            b.r += (b.max - b.r) * 0.045;
                            b.a *= 0.972;
                            if (b.a < 0.02) { b.el.remove(); blooms.splice(i, 1); }
                            else { b.el.setAttribute("r", b.r.toFixed(1)); b.el.setAttribute("opacity", b.a.toFixed(3)); }
                        }
                    };

                    const REST = 0.26, SEALED = 0.6;
                    let lit = boxes.map(() => REST);
                    let connLit = conns.map(() => 0.12);
                    let phase: "seal" | "leave" | "check" | "rest" = "seal";
                    let sealX = 10, routeT = 0, statusO = 0, waitUntil = 0, sealed = -1;

                    const paint = () => {
                        boxes.forEach((b, i) => {
                            b.setAttribute("stroke-opacity", lit[i].toFixed(3));
                            b.setAttribute("stroke", lit[i] > SEALED + 0.05 ? "var(--color-live)" : "var(--color-ink-0)");
                        });
                        conns.forEach((c, i) => c.setAttribute("stroke-opacity", connLit[i].toFixed(3)));
                        status.setAttribute("fill-opacity", statusO.toFixed(3));
                        recompute.setAttribute("fill-opacity", (0.4 + statusO * 0.35).toFixed(3));
                    };

                    const reset = () => {
                        lit = boxes.map(() => REST);
                        connLit = conns.map(() => 0.12);
                        sealX = 10; routeT = 0; statusO = 0; sealed = -1;
                        exp.setAttribute("stroke-opacity", "0");
                        phase = "seal";
                    };

                    const tick = (now: number) => {
                        if (phase === "seal") {
                            sealX += 1.15;
                            const centres = boxes.map((_, i) => 57 + i * 64);
                            centres.forEach((cx, i) => {
                                if (sealX >= cx && sealed < i) {
                                    sealed = i;
                                    lit[i] = 0.95;
                                    if (i > 0) connLit[i - 1] = 0.55;
                                    bloom(cx, 134, 7, 0.8);
                                }
                            });
                            if (sealX > 300) { phase = "leave"; routeT = 0; }
                        } else if (phase === "leave") {
                            routeT += 1.5;
                            const pt = route.getPointAtLength(Math.min(routeT, routeLen));
                            exp.setAttribute("x", String(pt.x - 6));
                            exp.setAttribute("y", String(pt.y - 6));
                            exp.setAttribute("stroke-opacity", "0.8");
                            if (routeT >= routeLen) { phase = "check"; waitUntil = now + 700; }
                        } else if (phase === "check") {
                            if (now > waitUntil && statusO === 0) {
                                bloom(385, 243, 10, 0.85);
                                statusO = 0.9;
                                waitUntil = now + 2600;
                            }
                            if (statusO > 0 && now > waitUntil) { phase = "rest"; waitUntil = now + 900; }
                        } else if (now > waitUntil) {
                            reset();
                        }

                        // everything settles rather than switching: sealed entries fall back
                        // to a resting glow, the verdict fades out on its own
                        lit = lit.map((v) => SEALED + (v - SEALED) * 0.985);
                        if (phase === "rest") { statusO *= 0.94; exp.setAttribute("stroke-opacity", String(Math.max(0, statusO))); }
                        stepBlooms();
                        paint();
                    };

                    if (chainReduced) {
                        lit = boxes.map(() => SEALED);
                        connLit = conns.map(() => 0.55);
                        statusO = 0.9;
                        exp.setAttribute("x", "350"); exp.setAttribute("y", "220"); exp.setAttribute("stroke-opacity", "0.8");
                        paint();
                    } else {
                        let visible = false;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(chainFig);
                        const loop = (now: number) => {
                            if (visible) tick(now);
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
        </section>

