<script>
  const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const SPEED = 0.22;

  function scrambleLine(el: HTMLElement, target: string, delay: number, onDone?: () => void) {
    let frame = 0;
    setTimeout(() => {
      el.innerText = target;
      const finalH = el.offsetHeight;
      el.style.height = finalH + "px";
      el.style.overflow = "hidden";

      function tick() {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          if (i < frame) {
            out += target[i];
          } else if (target[i] === " " || target[i] === ".") {
            out += target[i];
          } else {
            out += CHARS[Math.floor(Math.random() * CHARS.length)];
          }
        }
        el.innerText = out;
        frame += SPEED;
        if (frame < target.length) {
          requestAnimationFrame(tick);
        } else {
          el.innerText = target;
          el.style.height = "";
          el.style.overflow = "";
          if (onDone) onDone();
        }
      }
      tick();
    }, delay);
  }

  const l1 = document.getElementById("hero-l1") as HTMLElement;
  const l2 = document.getElementById("hero-l2") as HTMLElement;
  const l3 = document.getElementById("hero-l3") as HTMLElement;
  const sub = document.getElementById("hero-sub") as HTMLElement;
  const h1 = l1?.closest("h1") as HTMLElement;
  if (h1) { h1.style.animation = "none"; h1.style.opacity = "0"; }
  const explainer = document.getElementById("hero-explainer") as HTMLElement;
  const meta = document.getElementById("hero-meta") as HTMLElement;
  const ctas = document.getElementById("hero-ctas") as HTMLElement;
  if (l1) scrambleLine(l1, "THE BEHAVIORAL", 200);
  if (l2) scrambleLine(l2, "FIREWALL", 200);
  if (l3) scrambleLine(l3, "FOR AI AGENTS.", 200, () => {
    if (sub) sub.style.opacity = "1";
    if (explainer) explainer.style.opacity = "1";
    if (meta) meta.style.opacity = "1";
    if (ctas) ctas.style.opacity = "1";
    const term = document.getElementById("hero-terminal");
    if (term) term.style.opacity = "1";
  });
  setTimeout(() => { if (h1) h1.style.opacity = "1"; }, 200);

  // ── Generative data-stream canvas ──────────────────────────────
  // Vertical event columns flowing through the boundary: mostly
  // faint white (observed), green (signed), blue (verified),
  // rare red (blocked). Occasional horizontal glitch displacement.
  const canvas = document.getElementById("hero-datastream") as HTMLCanvasElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0;

    function hash(n: number): number {
      let t = (n + 0x6d2b79f5) | 0;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }

    type Col = { x: number; w: number; speed: number; seed: number; density: number };
    let cols: Col[] = [];

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      cols = [];
      const n = Math.floor(W / 14);
      for (let i = 0; i < n; i++) {
        const r = hash(i * 131);
        // cluster columns toward the right half — the boundary funnel
        const xNorm = Math.pow(hash(i * 977), 0.6);
        cols.push({
          x: W * (0.25 + xNorm * 0.75) + (r - 0.5) * 10,
          w: r > 0.85 ? 3 : 2,
          speed: 14 + hash(i * 389) * 70,
          seed: i * 7919,
          density: 0.25 + hash(i * 557) * 0.5,
        });
      }
    }

    const CELL = 7;

    function draw(t: number) {
      ctx.clearRect(0, 0, W, H);
      for (const c of cols) {
        const offset = (t / 1000) * c.speed;
        const glitchNow = hash(c.seed + Math.floor(t / 120)) > 0.985;
        const glitchShift = glitchNow ? (hash(c.seed + 1 + Math.floor(t / 120)) - 0.5) * 16 : 0;

        for (let y = -CELL; y < H + CELL; y += CELL) {
          const k = Math.floor((y + offset) / CELL);
          const r = hash(c.seed + k);
          if (r > c.density) continue;

          const r2 = hash(c.seed + k * 31 + 7);
          const flicker = 0.5 + 0.5 * hash(c.seed + k + Math.floor(t / 260));

          let fill: string;
          if (r2 > 0.995)      fill = `rgba(255,92,92,${0.55 * flicker})`;        // blocked
          else if (r2 > 0.955) fill = `rgba(61,220,132,${0.6 * flicker})`;       // signed
          else if (r2 > 0.92)  fill = `rgba(68,114,196,${0.45 * flicker})`;     // verified
          else                 fill = `rgba(242,242,242,${(0.04 + r2 * 0.09) * flicker})`; // observed

          ctx.fillStyle = fill;
          const cellH = 2 + Math.floor(r * 4);
          ctx.fillRect(c.x + glitchShift, y - (offset % CELL), c.w, cellH);
        }
      }
    }

    resize();
    window.addEventListener("resize", resize);

    if (reduced) {
      draw(1);
    } else {
      const loop = (t: number) => { draw(t); requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
  }
</script>

        <!-- ══════════ 01 PROBLEM ══════════ -->
        <section class="border-b border-white/10 py-24 md:py-32">
