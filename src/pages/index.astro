            <script>
                // mandate-fig · every call crosses and is allowed, and each one adds to a
                // running total. Nothing looks wrong until the bar is full, at which point
                // the next call, identical to the ten before it, is held at the line. The
                // figure has to make the sum the villain, not any single action.
                const mandateFig = document.getElementById("mandate-fig");
                const mandateReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (mandateFig) {
                    const NS = "http://www.w3.org/2000/svg";
                    const LANES = [104, 150, 196];
                    const START = 120, LINE = 300, END = 440;
                    const LIMIT = 5000, BAR_W = 418;

                    const acts = document.getElementById("mandate-acts") as unknown as SVGGElement;
                    const fill = document.getElementById("mandate-fill") as unknown as SVGRectElement;
                    const count = document.getElementById("mandate-count") as unknown as SVGTextElement;
                    const held = document.getElementById("mandate-held") as unknown as SVGTextElement;
                    const line = document.getElementById("mandate-line") as unknown as SVGLineElement;
                    const bloomLayer = document.getElementById("mandate-blooms") as unknown as SVGGElement;

                    const blooms: { el: SVGCircleElement; r: number; a: number; max: number }[] = [];
                    const bloom = (bx: number, by: number, r0 = 8, peak = 0.85) => {
                        const c = document.createElementNS(NS, "circle") as SVGCircleElement;
                        c.setAttribute("cx", String(bx)); c.setAttribute("cy", String(by));
                        c.setAttribute("r", String(r0)); c.setAttribute("fill", "url(#mandate-glow)");
                        c.setAttribute("opacity", String(peak));
                        bloomLayer.appendChild(c);
                        blooms.push({ el: c, r: r0, a: peak, max: r0 + 54 });
                    };
                    const stepBlooms = () => {
                        for (let i = blooms.length - 1; i >= 0; i--) {
                            const b = blooms[i];
                            b.r += (b.max - b.r) * 0.045; b.a *= 0.972;
                            if (b.a < 0.02) { b.el.remove(); blooms.splice(i, 1); }
                            else { b.el.setAttribute("r", b.r.toFixed(1)); b.el.setAttribute("opacity", b.a.toFixed(3)); }
                        }
                    };

                    type Act = { g: SVGGElement; x: number; lane: number; amount: number; blocked: boolean; back: boolean };
                    const live: Act[] = [];
                    let used = 0, spawnAt = 0, heldO = 0, restUntil = 0, n = 0;

                    const spawn = (lane: number, amount: number) => {
                        const g = document.createElementNS(NS, "g") as SVGGElement;
                        const c = document.createElementNS(NS, "circle");
                        c.setAttribute("cx", "0"); c.setAttribute("cy", "0"); c.setAttribute("r", "4");
                        c.setAttribute("fill", "var(--color-ink-0)"); c.setAttribute("fill-opacity", "0.62");
                        const t = document.createElementNS(NS, "text");
                        t.setAttribute("x", "10"); t.setAttribute("y", "4");
                        t.setAttribute("fill", "var(--color-ink-0)"); t.setAttribute("fill-opacity", "0.42");
                        t.setAttribute("style", "font-family:'JetBrains Mono Variable',monospace;font-size:8px;");
                        t.textContent = "\u20ac" + amount;
                        g.appendChild(c); g.appendChild(t);
                        acts.appendChild(g);
                        live.push({ g, x: START, lane, amount, blocked: used + amount > LIMIT, back: false });
                    };

                    const paint = () => {
                        fill.setAttribute("width", String(Math.min(used / LIMIT, 1) * BAR_W));
                        count.textContent = "\u20ac" + used.toLocaleString("en-US") + " / \u20ac" + LIMIT.toLocaleString("en-US");
                        held.setAttribute("fill-opacity", heldO.toFixed(3));
                        line.setAttribute("stroke", heldO > 0.1 ? "var(--color-warn)" : "var(--color-ink-0)");
                    };

                    const tick = (now: number) => {
                        if (restUntil && now > restUntil) {
                            used = 0; restUntil = 0; heldO = 0;
                            live.forEach((a) => a.g.remove()); live.length = 0;
                        }
                        if (!restUntil && now > spawnAt) {
                            spawn(n % LANES.length, [400, 600, 800][n % 3]);
                            n += 1; spawnAt = now + 1100;
                        }
                        for (let i = live.length - 1; i >= 0; i--) {
                            const a = live[i];
                            if (a.back) {
                                a.x -= 2.4;
                                if (a.x < START - 20) { a.g.remove(); live.splice(i, 1); continue; }
                            } else {
                                a.x += 1.4;
                                if (a.x >= LINE) {
                                    if (a.blocked) {
                                        a.back = true; heldO = 0.95;
                                        (a.g.firstChild as SVGCircleElement).setAttribute("fill", "var(--color-warn)");
                                        restUntil = now + 3400;
                                    } else {
                                        used += a.amount;
                                        bloom(LINE, LANES[a.lane], 7, 0.8);
                                        a.blocked = false;
                                        (a.g.firstChild as SVGCircleElement).setAttribute("fill", "var(--color-live)");
                                    }
                                }
                                if (a.x > END) { a.g.remove(); live.splice(i, 1); continue; }
                            }
                            a.g.setAttribute("transform", `translate(${a.x},${LANES[a.lane]})`);
                        }
                        heldO *= 0.995;
                        stepBlooms();
                        paint();
                    };

                    if (mandateReduced) {
                        used = LIMIT; heldO = 0.9; paint();
                    } else {
                        let visible = false;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(mandateFig);
                        const loop = (now: number) => { if (visible) tick(now); requestAnimationFrame(loop); };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
