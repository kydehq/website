                            <line x1="26" y1="240" x2="454" y2="240" stroke="var(--color-ink-0)" stroke-opacity="0.12" stroke-width="1" />

                            <!-- degree ticks -->
                            {Array.from({ length: 24 }, (_, i) => {
                                const a = (i * 15 * Math.PI) / 180;
                                return (
                                    <line
                                        x1={240 + Math.cos(a) * 204}
                                        y1={240 + Math.sin(a) * 204}
                                        x2={240 + Math.cos(a) * 210}
                                        y2={240 + Math.sin(a) * 210}
                                        stroke="var(--color-ink-0)" stroke-opacity="0.45"
                                        stroke-width="1"
                                    />
                                );
                            })}

                            <!-- sweep trail + line (rotated in JS) -->
                            <g id="radar-sweep">
                                <path d="M240 240 L240 30 A210 210 0 0 0 172 41 Z" fill="var(--color-ink-0)" fill-opacity="0.04" />
                                <line x1="240" y1="240" x2="240" y2="30" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
