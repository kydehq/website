                <script>
                    // FIG.1 · the value ring. The mini recorder writes an entry,
                    // then a pulse travels one spoke outward and lights that
                    // value node: record becomes proof, insurance, evaluation,
                    // learning, in rotation. Direction matters: everything
                    // flows OUT of the record, nothing is intercepted.
                    const brReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                    const brFig = document.getElementById("br-fig");

                    if (brFig) {
                        const $br = (id: string) => document.getElementById(id)!;
                        const brNodes = [0, 1, 2, 3].map((i) => $br(`br-node-${i}`));
                        const brLabels = [0, 1, 2, 3].map((i) => $br(`br-label-${i}`));
                        const brPulses = [0, 1, 2, 3].map((i) => $br(`br-pulse-${i}`));
                        const brCounter = $br("br-counter");
                        const hubL = $br("br-hub-l");
                        const hubR = $br("br-hub-r");

                        const LIVE = "var(--color-live)";
                        const INK = "var(--color-ink-0)";
                        // spoke start/end per node (N, E, S, W)
                        const spokes = [
                            { x0: 280, y0: 233, x1: 280, y1: 112 },
                            { x0: 372, y0: 290, x1: 460, y1: 290 },
                            { x0: 280, y0: 347, x1: 280, y1: 466 },
                            { x0: 188, y0: 290, x1: 100, y1: 290 },
                        ];

                        const light = (i: number, on: boolean) => {
                            brNodes[i].setAttribute("fill", on ? LIVE : INK);
                            brNodes[i].setAttribute("fill-opacity", on ? "1" : "0.5");
                            brLabels[i].setAttribute("fill", on ? LIVE : INK);
                            brLabels[i].setAttribute("fill-opacity", on ? "1" : "0.55");
                        };

                        if (brReduced) {
                            for (let i = 0; i < 4; i++) light(i, true);
                        } else {
                            let entries = 4211;
                            let active = 0;
                            let phaseStart = performance.now() + 400;
                            const TRAVEL = 750;
                            const LIT = 1450;

                            let visible = true;
                            new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(brFig);

                            function brFrame(t: number) {
                                if (visible) {
                                    hubL.setAttribute("transform", `rotate(${(t * 0.03) % 360} 248 295)`);
                                    hubR.setAttribute("transform", `rotate(${(t * 0.05) % 360} 312 295)`);

                                    const el = t - phaseStart;
                                    const sp = spokes[active];
                                    const pulse = brPulses[active];

                                    if (el >= 0 && el < TRAVEL) {
                                        const p = el / TRAVEL;
                                        pulse.setAttribute("cx", String(sp.x0 + (sp.x1 - sp.x0) * p));
                                        pulse.setAttribute("cy", String(sp.y0 + (sp.y1 - sp.y0) * p));
                                        pulse.setAttribute("opacity", String(0.9 - p * 0.25));
                                    } else if (el >= TRAVEL && el < TRAVEL + LIT) {
                                        pulse.setAttribute("opacity", "0");
                                        light(active, true);
                                    } else if (el >= TRAVEL + LIT) {
                                        light(active, false);
                                        active = (active + 1) % 4;
                                        entries++;
                                        brCounter.textContent = `#${String(entries).padStart(6, "0")}`;
                                        phaseStart = t;
                                    }
                                }
                                requestAnimationFrame(brFrame);
                            }
                            requestAnimationFrame(brFrame);
                        }
                    }
                </script>
            </div>
        </section>

