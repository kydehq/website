                            <polygon id="vpr-arrow-1" points="0,-3.5 8,0 0,3.5" fill="var(--color-ink-0)" fill-opacity="0.85" transform="translate(260,390) rotate(180)" />
                            <polygon id="vpr-arrow-2" points="0,-3.5 8,0 0,3.5" fill="var(--color-ink-0)" fill-opacity="0.85" transform="translate(165,235) rotate(-60.6)" />

                            <!-- inner dot-grid triangle -->
                            <path id="vpr-inner" d="M260 175 L355 345 L165 345 Z" fill="url(#vpr-dots)" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
                            <text id="vpr-center" x="260" y="310" text-anchor="middle" fill="var(--color-ink-0)" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;letter-spacing:0.2em;">KYDE</text>

