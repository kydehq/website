                        <text id="lad-sub-4" x="860" y="222" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.35" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.1em;">approves payments</text>
                        <!-- evidence ticks under current step -->
                        <text id="lad-evidence" x="40" y="30" fill="var(--color-live)" fill-opacity="0" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.12em;">evidence window complete · promoted</text>
                        <!-- the agent -->
                        <rect id="lad-agent" x="126" y="201" width="8" height="8" fill="var(--color-ink-0)" />
                        <circle id="lad-pulse" r="0" fill="none" stroke="var(--color-live)" stroke-width="1" opacity="0" cx="130" cy="205" />
