                            <circle cx="240" cy="240" r="90" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.17" stroke-width="1" stroke-dasharray="2 5" />
                            <circle cx="240" cy="240" r="68" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.22" stroke-width="1" />
