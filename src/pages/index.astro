            <script>
                // FIG.4 · someone edits the second entry. It turns red, and so does every
                // link after it: that cascade is the whole property. Then it heals and
                // the loop runs again.
                const chainFig = document.getElementById("chain-fig");
                const chainReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                if (chainFig) {
                    const status = document.getElementById("chain-status")!;
                    const links = [0, 1, 2, 3].map((i) => document.getElementById(`chain-link-${i}`)!);
                    const TAMPERED = 1;

                    const setBroken = (broken: boolean) => {
                        links.forEach((g, i) => {
                            const hit = broken && i >= TAMPERED;
                            const rect = g.querySelector("rect")!;
                            const line = g.querySelector("line");
                            const seal = g.querySelectorAll("text")[2];
                            rect.setAttribute("stroke", hit ? "var(--color-alert)" : "var(--color-ink-0)");
                            rect.setAttribute("stroke-opacity", hit ? "0.75" : "0.35");
                            if (line) {
                                line.setAttribute("stroke", broken && i >= TAMPERED ? "var(--color-alert)" : "var(--color-live)");
                                line.setAttribute("stroke-opacity", "0.5");
                            }
                            seal.textContent = hit ? (i === TAMPERED ? "altered" : "broken") : "chained";
                            seal.setAttribute("fill", hit ? "var(--color-alert)" : "var(--color-live)");
                        });
                        status.textContent = broken ? "TAMPERING DETECTED · 3 LINKS BROKEN" : "CHAIN INTACT";
                        status.setAttribute("fill", broken ? "var(--color-alert)" : "var(--color-live)");
                    };

                    if (!chainReduced) {
                        let visible = false, broken = false, next = 0;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(chainFig);
                        const loop = (now: number) => {
                            if (visible && now > next) {
                                broken = !broken;
                                setBroken(broken);
                                next = now + (broken ? 3200 : 2600);
                            }
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
