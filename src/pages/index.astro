                        <div class="flex flex-1 items-center justify-center py-10">
<svg id="chain-fig" viewBox="0 0 480 340" class="w-full max-w-md h-auto" aria-hidden="true">
                            <path d="M12 27 L12 12 L27 12" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M453 12 L468 12 L468 27" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M12 313 L12 328 L27 328" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M468 313 L468 328 L453 328" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />

                            <defs>
                                <radialGradient id="chain-glow">
                                    <stop offset="0%" stop-color="var(--color-ink-0)" stop-opacity="0.9" />
                                    <stop offset="25%" stop-color="var(--color-ink-0)" stop-opacity="0.32" />
