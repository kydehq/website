---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroInstrument from '../components/home/HeroInstrument.astro';
import RunawayMeter from '../components/home/RunawayMeter.astro';
import Trajectories from '../components/home/Trajectories.astro';
import CaseGlyph from '../components/home/CaseGlyph.astro';
import Pipeline from '../components/home/Pipeline.astro';

// September 2026 rebrand. The story is the website draft (money and security
// first, drift as the mechanism underneath), in the pitch deck's design
// language: paper, ink, pink, neon, mono labels, 2px rules. The deck's 1920s
// futurism survives in the figures' motion phases and marks (corner
// brackets, the dot band, a tilted tag). Every figure pictures the product:
// the live score, the night a loop runs, the trajectories, the pipeline.
//
// Pink full-bleed sections: the hero and the close. Everything else is paper.
// One highlight mark per section at most.

// A fleet, because nobody runs one agent. Illustrative names and numbers,
// labelled as such on the panel. The row with `turns` is the one that starts
// looping.
const fleet = [
  { id: 'invoice-reconciler-07', score: 96, cost: '€0.41/h' },
  { id: 'support-triage-12',     score: 94, cost: '€0.18/h' },
  { id: 'procurement-agent-03',  score: 91, cost: '€0.66/h', turns: { score: 34, cost: '€212/h', note: 'Looping · 1,400 calls in 20 min' } },
  { id: 'contract-review-21',    score: 97, cost: '€0.22/h' },
  { id: 'crm-enrichment-44',     score: 89, cost: '€0.09/h' },
];

const wrongs = [
  { tag: '(Objective)', line: 'Its goal can be wrong from the start.' },
  { tag: '(Reward)',    line: 'A reward can teach it the wrong behavior.' },
  { tag: '(Vendor)',    line: 'A vendor can change the model underneath it.' },
  { tag: '(Memory)',    line: 'Its context and memory can change what it does.' },
  { tag: '(Attack)',    line: 'An attacker can inject instructions and hijack a legitimate task.' },
];

// Four ways it goes wrong, each with what Kyde actually does about it. The
// answers are held to what ships: enforcement is a switch (Enterprise), and
// Kyde does not claim to recognize every injection, it sees the behavior.
const cases = [
  {
    tag: '(Money)', glyph: 'money',
    name: 'Runaway execution',
    lead: 'The agent starts spending.',
    body: 'It retries. It loops. It calls tools again and again. Compute, tokens and API costs keep piling up while nobody is watching, and the invoice is the first alert anyone sees.',
    kyde: "Detects abnormal execution against the agent's own baseline and can stop the run before the cost runs away.",
  },
  {
    tag: '(Security)', glyph: 'security',
    name: 'Prompt injection',
    lead: "The agent is made to do something it wasn't supposed to.",
    body: 'A document, a website, an email or a tool response carries instructions. The agent follows them, with your credentials, inside a task that looked legitimate.',
    kyde: 'Does not have to recognize the injection. It sees what the agent does next, and enforces boundaries where actions cross into your systems.',
  },
  {
    tag: '(Drift)', glyph: 'drift',
    name: 'Behavioral drift',
    lead: 'The agent stops behaving like itself.',
    body: 'Its tools, sequences, timing or actions change, suddenly or gradually. A model update can cause it. Growing context, memory or a changed environment can too.',
    kyde: 'Detects meaningful change against a frozen behavioral baseline.',
  },
  {
    tag: '(Objective)', glyph: 'objective',
    name: 'Wrong from the start',
    lead: 'Not every failure is drift.',
    body: 'An agent can optimize the wrong objective from its very first run, and satisfy a proxy instead of the outcome you wanted. A baseline learned from that agent is a wrong baseline.',
    kyde: 'Adds task and policy boundaries to the behavioral picture: what the agent is expected to do, and what it may never do.',
  },
];

const steps = [
  { n: '01', name: 'Observe', body: 'Capture every consequential action that crosses the boundary. Gateway or SDK, no changes to the agent.' },
  { n: '02', name: 'Score',   body: 'Measure behavior against a frozen, recomputable baseline, per agent, across the whole fleet.' },
  { n: '03', name: 'Enforce', body: 'Block actions when an agent crosses a defined boundary. Humans approve the critical ones.' },
  { n: '04', name: 'Prove',   body: 'Keep a tamper-evident, hash-chained record of what happened. Your auditor recomputes it.' },
];

const compare = [
  { q: 'When is it checked?',              old: 'Once, or per request', kyde: 'Continuously' },
  { q: 'What is it judged against?',       old: 'Hand-written rules',   kyde: 'Observed behavior' },
  { q: 'Can behavior change be detected?', old: 'Limited',              kyde: 'Yes' },
  { q: 'Can actions be stopped?',          old: 'Sometimes',            kyde: 'At the boundary' },
  { q: 'Can the result be recomputed?',    old: 'Limited',              kyde: 'Yes' },
];

// Articles as the existing compliance pages cite them (AI Act 12, 14, 26), plus
// the NIS-2 and DORA articles that ask for noticing rather than for logging.
// "Built for", never "compliant": that depends on the deployment.
const regs = [
  {
    tag: '(EU AI Act)', arts: 'Art. 12 · 14 · 26',
    line: 'Logs, oversight, monitoring after go-live.',
    body: 'A record written outside the agent, a stop a human can actually pull, and monitoring that does not end on the day the system is switched on.',
  },
  {
    tag: '(NIS-2)', arts: 'Art. 21 · 23',
    line: 'An early warning within 24 hours.',
    body: 'You cannot report within a day what nobody noticed. The baseline is the noticing, and the record is what goes into the report.',
  },
  {
    tag: '(DORA)', arts: 'Art. 17 · 28',
    line: 'Incidents and third-party ICT risk.',
    body: 'When a provider changes the model underneath your agent, that is third-party risk arriving without a change request. The score shows it moved.',
  },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Kyde",
  url: "https://kyde.com",
  logo: "https://kyde.com/kyde-logo.svg",
  description: "Kyde continuously monitors how AI agents behave. Every action crosses Kyde and is scored against the agent's own baseline, so runaway execution, prompt injection and behavioral drift are caught before they become costly or dangerous, with a tamper-evident record, in the customer's own environment.",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kyde",
  url: "https://kyde.com",
};
---

<Base
  title="KYDE, Behavioral Monitoring for AI Agents"
  description="AI agents don't fail loudly, they fail expensively. Kyde continuously monitors how your agents behave and catches runaway execution, prompt injection and behavioral drift before they become costly or dangerous. On-premise, private cloud or EU-hosted. Built for EU AI Act, NIS-2 and DORA."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>
  <Navbar />

  <main class="kx">
    <!-- ══════════ HERO ══════════ -->
    <section data-surface="blush" class="surface-pink hero">
      <div class="wrap hero-inner">
        <p class="mono label">(Behavioral monitoring for AI agents)</p>
        <div class="brackets">
          <h1 class="display">
            AI agents don't fail loudly.<br />They fail <span class="hl hl-neon">expensively</span><span class="nowrap">.</span>
          </h1>
        </div>
        <div class="hero-grid">
          <div>
            <p class="lead">
              Kyde continuously monitors how your AI agents behave, detecting runaway execution, hijacking and behavioral drift before they become costly or dangerous.
            </p>
            <p class="triad">
              See what your agents are doing.<br />Know when something changes.<br />Stop it when it matters.
            </p>
            <div class="ctas">
              <button onclick="openModal()" class="btn btn-ink">Watch your agents →</button>
              <a href="#how" class="link-u mono">How it works</a>
            </div>
          </div>

          <HeroInstrument />
        </div>
      </div>

      <div class="dots-band">
        <div class="wrap band-row">
          <span class="tag tag-ink">On-premise</span>
          <span class="tag tag-ink">Private cloud</span>
          <span class="tag tag-ink">EU-hosted</span>
          <span class="band-gap"></span>
          <span class="tag tag-dark">Built for EU AI Act · NIS-2 · DORA · GDPR</span>
        </div>
      </div>
    </section>

    <!-- ══════════ NOBODY IS WATCHING ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec">
        <h2 class="h1">Your agents are acting when nobody is watching.</h2>
        <div class="meter-wrap"><RunawayMeter /></div>
        <ul class="four">
          <li><span class="mono small">(01)</span>They can spend.</li>
          <li><span class="mono small">(02)</span>They can be hijacked.</li>
          <li><span class="mono small">(03)</span>They can drift.</li>
          <li><span class="mono small">(04)</span>They can get stuck.</li>
        </ul>
        <p class="punch">
          The dangerous part is not always that they fail. It's that <span class="hl hl-pink">nobody notices</span><span class="nowrap">.</span>
        </p>
      </div>
    </section>

    <!-- ══════════ DAY ONE OR LATER ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec split">
        <div>
          <h2 class="h1">An agent can go wrong from day one. Or change later.</h2>
          <p class="subline">It does not have to slowly drift into trouble.</p>
          <Trajectories />
        </div>
        <div>
          <ol class="rule-list">
            {wrongs.map((w) => (
              <li><span class="mono label">{w.tag}</span><span>{w.line}</span></li>
            ))}
          </ol>
          <p class="strong-line">Kyde watches the behavior at the boundary, from the first action onward.</p>
        </div>
      </div>
    </section>

    <!-- ══════════ WHAT CAN GO WRONG ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec">
        <div class="kicker"><span class="num">01</span><span class="mono">What can go wrong?</span></div>
        <div class="cases">
          {cases.map((c) => (
            <article class="case">
              <p class="mono label">{c.tag}</p>
              <CaseGlyph kind={c.glyph as any} />
              <h3 class="h2">{c.name}</h3>
              <p class="col-lead">{c.lead}</p>
              <p class="body">{c.body}</p>
              <p class="kyde-does"><span class="tag tag-ink">Kyde</span> {c.kyde}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ THE SCORE ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec">
        <div class="kicker"><span class="num">02</span><span class="mono">The score</span></div>
        <div class="score-split">
          <div>
            <h2 class="h1">Every agent gets a behavioral score. Not once. Continuously.</h2>
            <p class="lead-dark">Kyde learns how an agent behaves and scores its actions against an established baseline. Not a model's opinion. Not a one-time assessment. Observed behavior.</p>
            <p class="strong-line">When the score changes, something changed.</p>
            <div class="pairs">
              <div class="col">
                <p class="mono label">(Gradual drift)</p>
                <p class="body">Behavior slowly moves away from its established baseline.</p>
              </div>
              <div class="col">
                <p class="mono label">(Abrupt change)</p>
                <p class="body">Behavior suddenly changes after an event, an input or a system change.</p>
              </div>
            </div>
            <p class="body">Different signals need different detectors. One baseline, several ways to detect the deviation.</p>
          </div>

          <!-- Every agent, because nobody runs one. One of them starts looping
               and gets restricted while the rest stay within baseline. -->
          <div class="fleet" id="fleet" role="group" aria-label="Illustrative fleet view: five agents with behavioral scores">
            <div class="fleet-head mono">
              <span>(Fleet) 214 agents</span>
              <span class="fleet-dim">*Illustrative</span>
            </div>
            <!-- every agent as one cell; the one that starts looping lights up -->
            <div class="fleet-grid" aria-hidden="true">
              {Array.from({ length: 214 }, (_, i) => (
                <i class={i === 57 ? 'hot-cell' : ['a', 'b', 'c', 'a', 'a', 'b'][(i * 7 + (i >> 3)) % 6]}></i>
              ))}
            </div>
            <div class="fleet-cols mono" aria-hidden="true">
              <span>Agent</span><span class="col-cost">Cost</span><span>Score</span>
            </div>
            <ul>
              {fleet.map((a) => (
                <li class="fleet-row" data-turns={a.turns ? JSON.stringify(a.turns) : undefined}>
                  <span class="fleet-id mono">{a.id}</span>
                  <span class="fleet-cost mono">{a.cost}</span>
                  <span class="fleet-score"><b>{a.score}</b><span class="fleet-tag mono">Trusted</span></span>
                  {a.turns && <span class="fleet-note mono" aria-hidden="true"></span>}
                </li>
              ))}
            </ul>
            <p class="fleet-foot mono" id="fleet-foot">209 more within baseline</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ HOW IT WORKS ══════════ -->
    <section class="surface-paper" id="how">
      <div class="wrap sec">
        <div class="kicker"><span class="num">03</span><span class="mono">How it works</span></div>
        <h2 class="h1">See it. Score it. Stop it. Prove it.</h2>
        <Pipeline />
        <div class="steps">
          {steps.map((s) => (
            <div class="col">
              <p class="mono label">{s.n}</p>
              <h3 class="h3">{s.name}</h3>
              <p class="body">{s.body}</p>
            </div>
          ))}
        </div>
        <div class="row-end">
          <p class="mono note">*Observe and score from day one, blocking nothing. Enforcement is a switch you flip when you are ready.</p>
          <a href="/platform" class="link-u mono">The platform in detail</a>
        </div>
      </div>
    </section>

    <!-- ══════════ WHY KYDE ══════════ -->
    <!-- The mid-page color band: the one argument that gets a full surface
         between the hero and the close. -->
    <section data-surface="blush" class="surface-pink">
      <div class="wrap sec">
        <div class="kicker"><span class="num">04</span><span class="mono">Why Kyde</span></div>
        <h2 class="h1">The problem isn't that agents make mistakes. It's that nobody sees them happening.</h2>
        <p class="subline">Traditional controls check permissions. Guardrails check requests. AI judges check outputs. Kyde checks behavior, continuously.</p>
        <div class="table-scroll">
          <table class="cmp">
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Question</span></th>
                <th scope="col" class="mono">Traditional controls</th>
                <th scope="col" class="mono">Kyde</th>
              </tr>
            </thead>
            <tbody>
              {compare.map((r) => (
                <tr>
                  <th scope="row">{r.q}</th>
                  <td>{r.old}</td>
                  <td class="k">{r.kyde}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══════════ REGULATION ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec">
        <div class="kicker"><span class="num">05</span><span class="mono">Regulation</span></div>
        <h2 class="h1">The regulators are asking the same question.</h2>
        <p class="subline">Can you show what your agents did, that a human could have stepped in, and that you would have noticed?</p>
        <div class="cols3">
          {regs.map((r) => (
            <div class="col">
              <p class="mono label">{r.tag} <span class="muted">{r.arts}</span></p>
              <h3 class="h3">{r.line}</h3>
              <p class="body">{r.body}</p>
            </div>
          ))}
        </div>
        <div class="row-end">
          <p class="mono note">*Built for these frameworks. Whether a deployment complies depends on how it is run, not on a product.</p>
          <a href="/eu-ai-act-compliance" class="link-u mono">How the record maps to the articles</a>
        </div>
      </div>
    </section>

    <!-- ══════════ YOUR ENVIRONMENT ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec split">
        <div>
          <h2 class="h1">Your AI agents already have access. Now know what they are doing with it.</h2>
        </div>
        <div>
          <p class="lead-dark">Kyde sits between your agents and the systems they can affect, continuously observing behavior, detecting change and enforcing boundaries.</p>
          <div class="deploy">
            <span class="tag tag-ink">Private cloud</span>
            <span class="tag tag-ink">On-premise</span>
            <span class="tag tag-ink">EU-hosted</span>
          </div>
          <p class="strong-line">Your data stays with you.</p>
          <p class="body">Behind the detection is research we publish: seventeen papers, seven forms of drift, and what your logs can actually show. <a href="/behavioral-drift" class="link-u mono">Read the research</a></p>
        </div>
      </div>
    </section>

    <!-- ══════════ CLOSE ══════════ -->
    <section data-surface="blush" class="surface-pink">
      <div class="wrap sec close">
        <div class="brackets">
          <h2 class="display-2">Before you give your agents more access, know how they behave.</h2>
        </div>
        <div class="close-grid">
          <p class="triad">
            See their baselines.<br />Watch what changes.<br />Stop what shouldn't happen.
          </p>
          <div>
            <div class="ctas">
              <button onclick="openModal()" class="btn btn-ink">Watch your agents →</button>
              <a href="/docs/quickstart" class="link-u mono">Run it yourself</a>
            </div>
            <p class="mono note close-note">*Start with the agents you are least sure about. Kyde is pre-seed and works closely with a small number of design partners.</p>
          </div>
        </div>
      </div>
      <div class="dots-band">
        <div class="wrap band-row">
          <span class="tag tag-dark tilt">*Watched in motion</span>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const watch = (el: Element, cb: (v: boolean) => void) =>
    new IntersectionObserver((es) => cb(es[0].isIntersecting), { threshold: 0.4 }).observe(el);

  // Fleet: one agent starts looping, its score falls, it is restricted, then
  // the loop resets. Only while visible, never under reduced motion.
  const fleet = document.getElementById('fleet');
  if (fleet && !reduced) {
    const row = fleet.querySelector<HTMLElement>('.fleet-row[data-turns]');
    const foot = document.getElementById('fleet-foot')!;
    if (row) {
      const turns = JSON.parse(row.dataset.turns!);
      const b = row.querySelector('b')!;
      const cost = row.querySelector('.fleet-cost')!;
      const tag = row.querySelector('.fleet-tag')!;
      const note = row.querySelector('.fleet-note')!;
      const orig = { score: b.textContent!, cost: cost.textContent! };
      let visible = false, bad = false;
      watch(fleet, (v) => (visible = v));
      setInterval(() => {
        if (!visible) return;
        bad = !bad;
        row.classList.toggle('bad', bad);
        fleet.querySelector('.hot-cell')?.classList.toggle('on', bad);
        b.textContent = bad ? String(turns.score) : orig.score;
        cost.textContent = bad ? turns.cost : orig.cost;
        tag.textContent = bad ? 'Restricted' : 'Trusted';
        note.textContent = bad ? turns.note : '';
        foot.textContent = bad ? '1 agent restricted · run stopped, record kept' : '209 more within baseline';
      }, 3400);
    }
  }

</script>

<style>
  /* Deck design v4, adapted to the web: slide px become fluid sizes, the
     24px floor becomes a 17px body, the rest is the deck's rules. */
  .kx {
    --pad: clamp(20px, 5.5vw, 80px);
    --gap: clamp(24px, 3.3vw, 48px);
    --rule: 2px solid var(--color-ink);
  }
  .wrap { max-width: 1440px; margin: 0 auto; padding-inline: var(--pad); }
  .sec { padding-block: clamp(72px, 9vw, 136px); }
  .surface-paper { background: var(--color-paper); color: var(--color-ink); }
  .surface-pink { background: var(--color-blush); color: var(--color-ink-pink); --color-ink: var(--color-ink-pink); }
  /* consecutive paper sections are split by an ink rule, not by a tint */
  .surface-paper + .surface-paper .sec { border-top: var(--rule); }

  /* type */
  .mono { font-family: var(--font-mono); font-weight: 500; letter-spacing: 0; }
  .display { font-size: clamp(2.7rem, 6.4vw, 7.6rem); font-weight: 500; line-height: 0.88; letter-spacing: -0.058em; }
  .display-2 { font-size: clamp(2.4rem, 5.6vw, 6.4rem); font-weight: 500; line-height: 0.9; letter-spacing: -0.052em; max-width: 18ch; }
  .h1 { font-size: clamp(2.2rem, 4.6vw, 5rem); font-weight: 500; line-height: 0.95; letter-spacing: -0.05em; max-width: 22ch; }
  .h2 { font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 500; line-height: 0.98; letter-spacing: -0.045em; margin-bottom: 0.75rem; }
  .h3 { font-size: clamp(1.5rem, 2.1vw, 2.1rem); font-weight: 500; line-height: 1; letter-spacing: -0.04em; margin-bottom: 0.6rem; }
  .lead { font-size: clamp(1.15rem, 1.55vw, 1.5rem); line-height: 1.3; letter-spacing: -0.015em; max-width: 36ch; }
  .lead-dark { font-size: clamp(1.15rem, 1.5vw, 1.45rem); line-height: 1.3; letter-spacing: -0.015em; color: var(--color-ink-1); margin-block: 1.25rem; max-width: 42ch; }
  .subline { font-size: clamp(1.2rem, 1.9vw, 1.85rem); line-height: 1.2; letter-spacing: -0.025em; color: var(--color-ink-2); margin-top: 1.25rem; max-width: 44ch; }
  .body { font-size: 1.0625rem; line-height: 1.5; color: var(--color-ink-1); margin-bottom: 0.9rem; }
  .label { font-size: 0.9375rem; margin-bottom: 0.9rem; }
  .small { font-size: 0.875rem; }
  .muted { color: var(--color-ink-2); }
  .note { font-size: 0.875rem; line-height: 1.5; color: var(--color-ink-2); max-width: 70ch; }
  .surface-pink .note { color: var(--color-ink-pink); }
  .nowrap { white-space: nowrap; }
  .strong-line { font-size: clamp(1.15rem, 1.5vw, 1.45rem); line-height: 1.3; font-weight: 600; letter-spacing: -0.015em; margin-block: 1.5rem; }
  .triad { font-size: clamp(1.15rem, 1.55vw, 1.5rem); line-height: 1.3; font-weight: 600; letter-spacing: -0.015em; margin-top: 1.5rem; }

  /* highlight mark: square, behind one phrase, once per section */
  .hl { display: inline-block; padding: 0 0.12em 0.06em; line-height: 0.95; }
  .hl-pink { background: var(--color-pink); }
  .hl-neon { background: var(--color-neon); }

  /* kicker: dark tag with a pink number, title in mono */
  .kicker { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(36px, 5vw, 72px); font-size: 0.9375rem; }
  .kicker .num { background: var(--color-card); color: var(--color-pink); font-family: var(--font-mono); font-weight: 500; padding: 2px 9px 3px; }

  /* corner brackets, left top and left bottom */
  .brackets { position: relative; padding: clamp(14px, 1.6vw, 24px) 0 clamp(14px, 1.6vw, 24px) clamp(16px, 2vw, 32px); }
  .brackets::before, .brackets::after { content: ''; position: absolute; left: 0; width: 20px; height: 20px; border-left: 2px solid currentColor; }
  .brackets::before { top: 0; border-top: 2px solid currentColor; }
  .brackets::after { bottom: 0; border-bottom: 2px solid currentColor; }

  /* tags */
  .tag { display: inline-block; font-family: var(--font-mono); font-weight: 500; font-size: 0.875rem; padding: 3px 10px 4px; line-height: 1.3; white-space: nowrap; }
  .tag-ink { background: var(--color-ink); color: var(--color-paper); }
  .tag-dark { background: var(--color-card); color: var(--color-pink); }
  .tilt { transform: rotate(-6deg); }

  /* buttons and links */
