        </section>


<script>
  const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const SPEED = 0.22;

  function scrambleLine(el: HTMLElement, target: string, delay: number, onDone?: () => void) {
    let frame = 0;
    setTimeout(() => {
      el.innerText = target;
      const finalH = el.offsetHeight;
      el.style.height = finalH + "px";
      el.style.overflow = "hidden";

      function tick() {
        let out = "";
        for (let i = 0; i < target.length; i++) {
          if (i < frame) {
            out += target[i];
          } else if (target[i] === " " || target[i] === ".") {
            out += target[i];
          } else {
            out += CHARS[Math.floor(Math.random() * CHARS.length)];
          }
        }
        el.innerText = out;
        frame += SPEED;
        if (frame < target.length) {
          requestAnimationFrame(tick);
        } else {
          el.innerText = target;
          el.style.height = "";
          el.style.overflow = "";
          if (onDone) onDone();
        }
      }
      tick();
    }, delay);
  }

  const l1 = document.getElementById("hero-l1") as HTMLElement;
  const l2 = document.getElementById("hero-l2") as HTMLElement;
  const l3 = document.getElementById("hero-l3") as HTMLElement;
  const sub = document.getElementById("hero-sub") as HTMLElement;
  const h1 = l1?.closest("h1") as HTMLElement;
  if (h1) { h1.style.animation = "none"; h1.style.opacity = "0"; }
  const explainer = document.getElementById("hero-explainer") as HTMLElement;
  const ctas = document.getElementById("hero-ctas") as HTMLElement;
  if (l1) scrambleLine(l1, "PROTECT WHAT MAKES", 200);
  if (l2) scrambleLine(l2, "YOUR COMPANY", 200);
  if (l3) scrambleLine(l3, "UNIQUE.", 200, () => {
    if (sub) sub.style.opacity = "1";
    if (explainer) explainer.style.opacity = "1";
    if (ctas) ctas.style.opacity = "1";
    const term = document.getElementById("hero-terminal");
    if (term) term.style.opacity = "1";
  });
  setTimeout(() => { if (h1) h1.style.opacity = "1"; }, 200);

  // ── Boundary-gate figure ────────────────────────────────────────
  // Geometric, not "rain": unordered agents drift on the left,
  // cross the vertical gate line, and snap into a strict lattice , 
  // ungoverned chaos becomes governed order. Rare green pulse at
  // crossing (signed), rare red flash bouncing off (blocked).
  const canvas = document.getElementById("hero-datastream") as HTMLCanvasElement | null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0, GATE = 0, ROW = 26;

    function hash(n: number): number {
      let t = (n + 0x6d2b79f5) | 0;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }

    type P = {
      x: number; y: number; vx: number; seed: number;
      state: "wild" | "signed" | "blocked";
      rowY: number; pulse: number;
    };
    let parts: P[] = [];

    // occasional bloom when a particle crosses the gate
    type Flare = { x: number; y: number; t0: number };
    let flares: Flare[] = [];
    let lastFlare = 0;

    function spawn(p: P, i: number, initial = false) {
      p.x = initial ? hash(i * 7 + 1) * GATE : -10 - hash(i * 13) * 60;
      p.y = 40 + hash(i * 31 + performance.now() % 9973) * (H - 80);
      p.vx = 12 + hash(i * 17) * 22;
      p.seed = i * 7919 + Math.floor(performance.now());
      p.state = "wild";
      p.pulse = 0;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      GATE = W * 0.68;
      parts = [];
      const n = Math.max(40, Math.floor(W / 16));
      for (let i = 0; i < n; i++) {
        const p = {} as P;
        spawn(p, i, true);
        parts.push(p);
      }
    }

    let last = 0;
    function draw(t: number) {
      const dt = Math.min((t - last) / 1000, 0.05) || 0.016;
      last = t;
      ctx.clearRect(0, 0, W, H);

      // lattice on the governed side, faint, strict
      ctx.fillStyle = "rgba(242,242,242,0.08)";
      for (let x = GATE + ROW; x < W; x += ROW)
        for (let y = ROW; y < H; y += ROW)
          ctx.fillRect(x - 0.75, y - 0.75, 1.5, 1.5);

      // gate line, nearly invisible at the ends, a faint shimmer mid-height;
      // it reveals itself through interaction (blooms, blocks), not presence
      const gateGrad = ctx.createLinearGradient(0, 0, 0, H);
      gateGrad.addColorStop(0, "rgba(242,242,242,0)");
      gateGrad.addColorStop(0.5, "rgba(242,242,242,0.13)");
      gateGrad.addColorStop(1, "rgba(242,242,242,0)");
      ctx.fillStyle = gateGrad;
      ctx.fillRect(GATE, 0, 1, H);
      for (let y = 0; y < H; y += ROW * 2) {
        const env = Math.sin((Math.PI * y) / H);
        ctx.fillStyle = `rgba(242,242,242,${0.16 * env * env})`;
        ctx.fillRect(GATE - 3, y, 7, 1);
      }

      for (const p of parts) {
        const jitterSeed = p.seed + Math.floor(t / 300);

        if (p.state === "wild") {
          // brownian drift with slow right bias
          p.x += p.vx * dt;
          p.y += (hash(jitterSeed) - 0.5) * 34 * dt * 2.2;

          if (p.x >= GATE) {
            if (hash(p.seed + 5) > 0.93) {
              p.state = "blocked";
              p.pulse = 1;
              p.vx = -18;
            } else {
              p.state = "signed";
              p.pulse = hash(p.seed + 9) > 0.7 ? 1 : 0;
              p.rowY = Math.round(p.y / ROW) * ROW;
              p.vx = 26 + hash(p.seed + 3) * 18;
              // every few seconds, one crossing blooms
              if (t - lastFlare > 2100 && hash(p.seed + 11) > 0.4) {
                flares.push({ x: GATE, y: p.rowY, t0: t });
                lastFlare = t;
              }
            }
          }
          ctx.fillStyle = "rgba(242,242,242,0.32)";
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
        } else if (p.state === "signed") {
          p.x += p.vx * dt;
          p.y += (p.rowY - p.y) * Math.min(dt * 6, 1); // snap to lattice row

          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(61,220,132,${p.pulse * 0.7})`;
            ctx.lineWidth = 1;
            ctx.strokeRect(p.x - 4, p.y - 4, 8, 8);
            p.pulse -= dt * 1.4;
          }
          ctx.fillStyle = "rgba(242,242,242,0.68)";
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);

          if (p.x > W + 10) spawn(p, Math.floor(p.seed / 7919));
        } else {
          // blocked: red flash at the gate, drift back, fade
          p.x += p.vx * dt;
          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(255,92,92,${p.pulse * 0.8})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p.x + 4, p.y - 4); ctx.lineTo(p.x - 4, p.y + 4);
            ctx.moveTo(p.x - 4, p.y - 4); ctx.lineTo(p.x + 4, p.y + 4);
            ctx.stroke();
            p.pulse -= dt * 0.9;
          } else {
            spawn(p, Math.floor(p.seed / 7919));
          }
        }
      }

      // flares, soft light bloom at the gate, expanding and fading
      flares = flares.filter((f) => t - f.t0 < 1600);
      for (const f of flares) {
        const age = (t - f.t0) / 1600; // 0 → 1
        const ease = 1 - Math.pow(1 - age, 2);
        const r = 16 + ease * 130;
        const a = (1 - age) * 0.85;

        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, r);
        g.addColorStop(0, `rgba(242,242,242,${a})`);
        g.addColorStop(0.25, `rgba(242,242,242,${a * 0.35})`);
        g.addColorStop(0.6, `rgba(61,220,132,${a * 0.22})`);
        g.addColorStop(1, "rgba(61,220,132,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(f.x, f.y, r, 0, Math.PI * 2);
        ctx.fill();

        // bright core that snuffs out quickly
        if (age < 0.35) {
          ctx.fillStyle = `rgba(255,255,255,${(1 - age / 0.35) * 0.9})`;
          ctx.fillRect(f.x - 2, f.y - 2, 4, 4);
        }

        // brief brightening of the gate line around the bloom
        const gl = ctx.createLinearGradient(f.x, f.y - r, f.x, f.y + r);
        gl.addColorStop(0, "rgba(242,242,242,0)");
        gl.addColorStop(0.5, `rgba(242,242,242,${a * 0.8})`);
        gl.addColorStop(1, "rgba(242,242,242,0)");
        ctx.fillStyle = gl;
        ctx.fillRect(GATE, f.y - r, 1, r * 2);
      }
    }

    resize();
    window.addEventListener("resize", resize);

    if (reduced) {
      draw(1);
    } else {
      let heroVisible = true;
      new IntersectionObserver((es) => { heroVisible = es[0].isIntersecting; }).observe(canvas);
      const loop = (t: number) => { if (heroVisible) draw(t); requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
  }
</script>

        <!-- ══════════ 01 PROBLEM ══════════ -->
        <section class="border-b border-white/10">
            <div class="max-w-7xl mx-auto px-6 pt-24 pb-24 md:pt-32 md:pb-0 md:border-x md:border-white/10">
                <div class="flex items-end justify-between border-b border-white/10 pb-3">
                    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/65">01 · The Problem</span>
                    <span class="fig-label">FIG.1</span>
                </div>
                <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-white/10 items-stretch pt-10 md:pt-0 [&>*]:md:pt-12 [&>*]:md:pb-28 [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 lg:[&>*:first-child]:pr-16 lg:[&>*:last-child]:pl-16 [&>*]:md:flex [&>*]:md:flex-col [&>*]:md:justify-center">
                    <div>
                        <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-white mb-8">
                            <span class="text-white">Shadow Agents Are Already Running.</span><br /><span class="text-white/40">Do You Know What They're Doing?</span>
                        </h2>
                        <p class="text-lg text-white/55 leading-relaxed mb-6">
                            Shadow AI was employees using unauthorized tools. Shadow Agents are autonomous systems calling APIs, processing data, and making decisions, outside IT and security oversight entirely.
                        </p>
                        <p class="text-lg text-white/55 leading-relaxed mb-6">
                            And while they work, every prompt, trace, and correction flows upstream. Your know-how, training someone else's model.
                        </p>
                        <p class="text-lg text-white/55 leading-relaxed mb-6">
                            Courts hold you liable for what they do. Not the vendor, not the model. Ask Air Canada.
                        </p>
                        <p class="text-lg text-white/55 leading-relaxed">
                            KYDE gives you the complete picture from the moment you deploy: every agent identity, every action, every upstream provider.
                        </p>
                    </div>
                    <div class="relative flex items-center justify-center min-h-[380px]">
                        <svg id="radar-fig" viewBox="0 0 480 480" class="w-full max-w-md h-auto" aria-hidden="true">
                            <!-- corner register marks -->
                            <path d="M12 27 L12 12 L27 12" fill="none" stroke="rgba(242,242,242,0.35)" stroke-width="1" />
                            <path d="M453 12 L468 12 L468 27" fill="none" stroke="rgba(242,242,242,0.35)" stroke-width="1" />
                            <path d="M12 453 L12 468 L27 468" fill="none" stroke="rgba(242,242,242,0.35)" stroke-width="1" />
                            <path d="M468 453 L468 468 L453 468" fill="none" stroke="rgba(242,242,242,0.35)" stroke-width="1" />

                            <!-- concentric rings + crosshair -->
                            <circle cx="240" cy="240" r="228" fill="none" stroke="rgba(242,242,242,0.05)" stroke-width="1" />
                            <circle cx="240" cy="240" r="210" fill="none" stroke="rgba(242,242,242,0.14)" stroke-width="1" />
                            <circle cx="240" cy="240" r="150" fill="none" stroke="rgba(242,242,242,0.10)" stroke-width="1" stroke-dasharray="2 5" />
                            <circle cx="240" cy="240" r="90" fill="none" stroke="rgba(242,242,242,0.10)" stroke-width="1" stroke-dasharray="2 5" />
                            <circle cx="240" cy="240" r="68" fill="none" stroke="rgba(242,242,242,0.13)" stroke-width="1" />
                            <line x1="240" y1="26" x2="240" y2="454" stroke="rgba(242,242,242,0.07)" stroke-width="1" />
                            <line x1="26" y1="240" x2="454" y2="240" stroke="rgba(242,242,242,0.07)" stroke-width="1" />

                            <!-- degree ticks -->
                            {Array.from({ length: 24 }, (_, i) => {
                                const a = (i * 15 * Math.PI) / 180;
                                return (
                                    <line
                                        x1={240 + Math.cos(a) * 204}
                                        y1={240 + Math.sin(a) * 204}
                                        x2={240 + Math.cos(a) * 210}
                                        y2={240 + Math.sin(a) * 210}
                                        stroke="rgba(242,242,242,0.3)"
                                        stroke-width="1"
                                    />
                                );
                            })}

                            <!-- sweep trail + line (rotated in JS) -->
                            <g id="radar-sweep">
                                <path d="M240 240 L240 30 A210 210 0 0 0 172 41 Z" fill="rgba(242,242,242,0.04)" />
                                <line x1="240" y1="240" x2="240" y2="30" stroke="rgba(242,242,242,0.3)" stroke-width="1" />
                            </g>

                            <!-- blips + labels (lit by the sweep, from JS) -->
                            <g id="radar-blips"></g>

                            <!-- the observer at the center -->
                            <circle cx="240" cy="240" r="4.5" fill="#F2F2F2" />
                            <text x="240" y="262" text-anchor="middle" fill="rgba(242,242,242,0.6)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.2em;">KYDE</text>
                        </svg>
                    </div>
                </div>

                <script>
                    // FIG.1 · radar. Shadow agents sit almost invisible in
                        // the field; the sweep reveals them: blip flashes, the
                        // identity label appears, a green "signed" confirms the
                        // record, then the afterglow fades until the next pass.
                        const radarReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                        const radar = document.getElementById("radar-fig");

                        if (radar) {
                            const NS = "http://www.w3.org/2000/svg";
                            const sweep = document.getElementById("radar-sweep")!;
                            const blipsG = document.getElementById("radar-blips")!;
                            const CX = 240, CY = 240;

                            const AGENTS = [
                                { id: "agent:crm-04",    r: 178, a: 0.4 },
                                { id: "agent:hr-11",     r: 120, a: 1.3 },
                                { id: "ci-runner",       r: 195, a: 2.2 },
                                { id: "agent:support-2", r: 68,  a: 2.9 },
                                { id: "etl-worker",      r: 150, a: 3.8 },
                                { id: "agent:proc-7",    r: 104, a: 4.6 },
                                { id: "mail-drafter",    r: 186, a: 5.4 },
                            ];

                            const blips = AGENTS.map((ag) => {
                                const x = CX + Math.cos(ag.a) * ag.r;
                                const y = CY + Math.sin(ag.a) * ag.r;
                                const dot = document.createElementNS(NS, "rect");
                                dot.setAttribute("x", String(x - 2));
                                dot.setAttribute("y", String(y - 2));
                                dot.setAttribute("width", "4");
                                dot.setAttribute("height", "4");
                                const label = document.createElementNS(NS, "text");
                                label.setAttribute("x", String(x + 9));
                                label.setAttribute("y", String(y - 7));
                                label.setAttribute("style", "font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.08em;");
                                label.textContent = ag.id;
                                const sig = document.createElementNS(NS, "text");
                                sig.setAttribute("x", String(x + 9));
                                sig.setAttribute("y", String(y + 6));
                                sig.setAttribute("style", "font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;");
                                sig.setAttribute("fill", "#3DDC84");
                                sig.textContent = "✓ signed";
                                blipsG.append(dot, label, sig);
                                return { ...ag, dot, label, sig, lastLit: -1e9 };
                            });

                            if (radarReduced) {
                                // static frame: everything mid-bright
                                for (const b of blips) {
                                    b.dot.setAttribute("fill", "rgba(242,242,242,0.7)");
                                    b.label.setAttribute("fill", "rgba(242,242,242,0.55)");
                                    b.sig.setAttribute("fill", "rgba(61,220,132,0.6)");
                                }
                            } else {
                                const PERIOD = 32000; // one revolution
                                let visible = true;
                                new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(radar);

                                function frame(t: number) {
                                    if (visible) {
                                        const ang = ((t % PERIOD) / PERIOD) * Math.PI * 2 - Math.PI / 2;
                                        sweep.setAttribute("transform", `rotate(${(ang * 180) / Math.PI + 90} ${CX} ${CY})`);

                                        for (const b of blips) {
                                            // sweep just passed this blip?
                                            let diff = (ang - b.a) % (Math.PI * 2);
                                            if (diff < 0) diff += Math.PI * 2;
                                            if (diff < 0.06) b.lastLit = t;

                                            const glow = Math.exp(-(t - b.lastLit) / 2400);
                                            b.dot.setAttribute("fill", `rgba(242,242,242,${0.12 + glow * 0.88})`);
                                            b.label.setAttribute("fill", `rgba(242,242,242,${glow * 0.8})`);
                                            b.sig.setAttribute("fill", `rgba(61,220,132,${Math.max(glow - 0.25, 0)})`);
                                        }
                                    }
                                    requestAnimationFrame(frame);
                                }
                                requestAnimationFrame(frame);
                            }
                        }
                </script>
            </div>
        </section>

        <!-- ══════════ 02 ARCHITECTURE ══════════ -->
        <section class="border-b border-white/10">
            <div class="max-w-7xl mx-auto px-6 py-20 md:py-28 md:border-x md:border-white/10">
            <div class="max-w-4xl mx-auto">

                <div class="mb-12 md:mb-16">
                    <div class="mb-8 flex items-end justify-between border-b border-white/10 pb-3">
                        <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/65">02 · Architecture</span>
                        <span class="fig-label">FIG.2</span>
