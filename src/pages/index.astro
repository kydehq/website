            <div class="relative max-w-7xl mx-auto px-6 w-full">
                <!-- compliance label -->
                <div class="flex items-center gap-3 mb-6">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#fcb830] shrink-0"></span>
                    <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ NIS-2 · DORA · EU AI Act · GDPR — Audit-Ready from Day One</span>
                </div>
                <!-- Headline — two separate lines so width changes never cause reflow -->
                <h1 class="hero-h1 text-6xl text-white uppercase tracking-tighter md:text-7xl lg:text-8xl" style="opacity:0;animation:heroFadeIn 0.3s ease-out 0.1s forwards;">
