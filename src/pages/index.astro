                        <div class="flex flex-1 items-center justify-center py-10">
<svg id="gate-fig" viewBox="0 0 480 340" class="w-full max-w-md h-auto" aria-hidden="true">
                            <path d="M12 27 L12 12 L27 12" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M453 12 L468 12 L468 27" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M12 313 L12 328 L27 328" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />
                            <path d="M468 313 L468 328 L453 328" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.50" stroke-width="1" />

                            <text x="30" y="52" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">AGENT ACTIONS</text>
                            <text x="450" y="52" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">YOUR SYSTEMS</text>

                            <!-- three lanes running into the policy line -->
                            {[110, 170, 230].map((y) => (
                                <line x1="30" y1={y} x2="450" y2={y} stroke="var(--color-ink-0)" stroke-opacity="0.14" stroke-width="1" stroke-dasharray="3 6" />
                            ))}

                            <!-- the policy line itself: everything crosses here or not at all -->
                            <line id="gate-line" x1="286" y1="78" x2="286" y2="262" stroke="var(--color-ink-0)" stroke-opacity="0.65" stroke-width="1.5" />
                            <text x="286" y="286" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.68" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">POLICY</text>

                            <!-- the systems boundary, drawn as a wall the blocked action never reaches -->
                            <line x1="392" y1="78" x2="392" y2="262" stroke="var(--color-ink-0)" stroke-opacity="0.26" stroke-width="1" />

                            <g id="gate-actions"></g>
                        </svg>
                        </div>
                        <div class="border-t border-white/10 pt-3">
                            <p class="font-mono text-[10px] text-white/35 leading-relaxed">The blocked action stops at the policy line, not inside your systems.</p>
                        </div>
                    </div>
                </div>
            </div>
<script>
                // gate-fig · actions travel their lane toward the policy line. Most cross and
                // continue into the systems boundary; one in four hits the line, flashes
                // red and is turned back. Nothing is "inspected afterwards" here.
                const gateFig = document.getElementById("gate-fig");
                const gateReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                if (gateFig) {
                    const layer = document.getElementById("gate-actions")!;
                    const NS = "http://www.w3.org/2000/svg";
                    const LANES = [110, 170, 230], GATE = 286, START = 40, END = 440;
                    type Act = { el: SVGCircleElement; x: number; lane: number; blocked: boolean; back: boolean };
                    const acts: Act[] = [];
                    let spawnAt = 0, n = 0;

                    const spawn = (lane: number, blocked: boolean) => {
                        const el = document.createElementNS(NS, "circle") as SVGCircleElement;
                        el.setAttribute("r", "4");
                        el.setAttribute("cy", String(LANES[lane]));
                        el.setAttribute("fill", "var(--color-ink-0)");
                        el.setAttribute("fill-opacity", "0.55");
                        layer.appendChild(el);
                        acts.push({ el, x: START, lane, blocked, back: false });
                    };

                    const step = (a: Act) => {
                        if (a.back) {
                            a.x -= 3.4;
                        } else {
                            a.x += 2.2;
                            if (a.blocked && a.x >= GATE - 6) {
                                a.back = true;
                                a.el.setAttribute("fill", "var(--color-alert)");
                                a.el.setAttribute("fill-opacity", "0.9");
                            } else if (!a.blocked && a.x >= GATE + 6) {
                                a.el.setAttribute("fill", "var(--color-live)");
                                a.el.setAttribute("fill-opacity", "0.85");
                            }
                        }
                        a.el.setAttribute("cx", String(a.x));
                        return a.back ? a.x > START - 10 : a.x < END;
                    };

                    if (gateReduced) {
                        // Static reading of the same story: two through, one turned back.
                        spawn(0, false); spawn(1, true); spawn(2, false);
                        acts.forEach((a, i) => {
                            a.x = a.blocked ? GATE - 20 : GATE + 60;
                            a.el.setAttribute("cx", String(a.x));
                            a.el.setAttribute("fill", a.blocked ? "var(--color-alert)" : "var(--color-live)");
                            a.el.setAttribute("fill-opacity", "0.85");
                        });
                    } else {
                        let visible = false;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(gateFig);
                        const loop = (now: number) => {
                            if (visible) {
                                if (now > spawnAt) {
                                    spawn(n % LANES.length, n % 4 === 2);
                                    n += 1;
                                    spawnAt = now + 900;
                                }
                                for (let i = acts.length - 1; i >= 0; i--) {
                                    if (!step(acts[i])) { acts[i].el.remove(); acts.splice(i, 1); }
                                }
                            }
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
