---
// The kyde.com home: Joerg's lab concept
// (company/04_marketing/website/2026-10-29-kyde-lab-konzept.md) merged with
// Juergen's score.kyde page (kydehq/score, deploy/landing/index.html).
// Open points: company/04_marketing/website/2026-11-03-kyde-com-score-seite-offene-punkte.md
// Live as kyde.com/ since the launch on 2026-11-05 (was /lab-draft).
//
// Design follows DESIGN.md: rosé opens and closes, white between, black
// buttons and cards, Schibsted Grotesk to read, Plex Mono for labels.
// Shrink, hide, embody: one action in the hero, the rest folds away.

// Research teaser reads src/data/research.ts; plans are on /pricing.
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import LabNav from "../components/lab/LabNav.astro";
import { labFooterLinks as footerLinks } from "../data/lab-footer";
import "../styles/lab.css";
import { studies } from "../data/research";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

const GITHUB = "https://github.com/kydehq/behavioral-drift-detection";

// The three things that set an alert off. Reason codes as the webhook sends them.
const triggers = [
  { name: "Hijack", line: "It starts doing new things.", body: "Tools it rarely or never called before. The pattern a prompt injection tends to leave.", reason: "abrupt_shift" },
  { name: "Loop", line: "It does the same thing again and again.", body: "Same tool, same parameter hash, again and again. Counted via the hash your exporter sends (kyde.args.digest): repeats are visible, the content is not.", reason: "duplicate_submission" },
  { name: "Drift", line: "It slowly stops being itself.", body: "The mix of actions moves away from the baseline, often after a model or prompt change.", reason: "gradual_drift" },
];


// What leaves the network (score.kyde, section 05).
const fields = [
  ["Timestamp", "when the call happened"],
  ["Run ID and step", "which task, which position"],
  ["Tool name", "what the agent did"],
  ["Hash of the parameters", "repeats visible, content not"],
  ["Status", "ok, error or abort"],
  ["Model and version", "coming: drift after an update"],
];

// The skill: same file at score.kyde.com/skill.md (kydehq/score) and as a
// Claude Code plugin (kydehq/kyde-score-skill). It is the source of truth
// for every command below.
const SKILL_URL = "https://score.kyde.com/skill.md";
const SKILL_REPO = "https://github.com/kydehq/kyde-score-skill";
const forAgents = "Set up score.kyde.com/skill.md";

const setupTabs = [
  { id: "agent", label: "Your agent", code: forAgents,
    note: "Paste into Claude Code, Codex, OpenCode or your own agent. It reads the skill, gets a key, sets the variables and checks that data arrives." },
  { id: "plugin", label: "Plugin", code: `claude plugin marketplace add kydehq/kyde-score-skill
claude plugin install kyde-score@kyde-score-skill`,
    note: "Installs the skill for good, so every new Claude Code session knows it. Reading a URL once installs nothing." },
  { id: "claude", label: "Claude Code", code: `# Once per machine: ~/.claude/settings.json (env block) or shell profile
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=http/json
export OTEL_EXPORTER_OTLP_ENDPOINT=https://score.kyde.com
export OTEL_EXPORTER_OTLP_HEADERS="x-kyde-key=<YOUR_KEY>"

# Per agent, at launch
env OTEL_SERVICE_NAME=<agent-name> claude`,
    note: "Never put OTEL_SERVICE_NAME in ~/.claude/settings.json: the settings env block overrides the launch environment, so every agent on the machine merges into one. Without a name, Claude Code reports as claude-code, the same trap. Project settings are ignored." },
  { id: "sdk", label: "Any OTel SDK", code: `export OTEL_EXPORTER_OTLP_ENDPOINT=https://score.kyde.com
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_HEADERS="x-kyde-key=<YOUR_KEY>"
export OTEL_SERVICE_NAME=<agent-name>`,
    note: "For framework agents (Vercel AI SDK, LangGraph, OpenAI Agents): any GenAI instrumentation that emits gen_ai tool spans. Protobuf works from every SDK, JSON from the JavaScript ones. Give every agent its own service name." },
  { id: "collector", label: "Collector", code: `processors:
  attributes/kyde:          # content never leaves
    actions:
      - { key: gen_ai.prompt, action: delete }
      - { key: gen_ai.completion, action: delete }
      - { key: gen_ai.tool.call.arguments, action: hash }
exporters:
  otlphttp/kyde:
    endpoint: https://score.kyde.com
    encoding: json
    headers: { x-kyde-key: "<YOUR_KEY>" }`,
    note: "Run it in your client's network. Strip what you like, Kyde still scores." },
  { id: "mcp", label: "MCP", code: `claude mcp add --transport http kyde-score \\
  https://score.kyde.com/mcp \\
  --header "x-kyde-key: <YOUR_KEY>"`,
    note: "Lets an agent read its own score mid-session. Tools: create_key, get_scores, set_webhook, claim_key, revoke_key." },
];

const curlByHand = `# a key, with or without a webhook
curl -X POST https://score.kyde.com/score/v0/keys \\
  -H "Content-Type: application/json" \\
  -d '{"webhook_url":"https://your.app/hooks/kyde"}'

# the scores
curl -s https://score.kyde.com/score/v0/scores \\
  -H "x-kyde-key: <YOUR_KEY>"`;

const webhookExample = `POST /hooks/kyde
x-kyde-signature: sha256=<HMAC-SHA256 of the body, keyed with your key>

{
  "event": "band_change",
  "service_name": "support-agent",
  "old_band": "normal",
  "new_band": "deviating",
  "score": 35,
  "runs_seen": 412,
  "after_rebaseline": false,
  "rebaselined_at": null
}`;

const envForKey = `OTEL_EXPORTER_OTLP_ENDPOINT=https://score.kyde.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS="x-kyde-key=kyde_…"
OTEL_SERVICE_NAME=<agent-name>`;

const faq = [
  { q: "Will it alert on every change?", a: "No. Kyde learns each agent over its first 30 runs and at least 3 days, then freezes the baseline. One alert per band change, not one per odd run. A signal for triage, not a probability that an agent was compromised." },
  { q: "Does it detect prompt injection?", a: "It detects what a hijacked agent does next: tools it does not normally use, in an order it does not normally use them. From metadata alone it cannot prove an attack." },
  { q: "How do I add an agent?", a: "Start it with the variables. Kyde knows it by its service.name and it shows up with its first data. No form, no dashboard, no registration call." },
  { q: "I run agents inside my clients' networks.", a: "That is the case it is built for. The agent exports from wherever it runs, the alert goes to you. Only call metadata leaves, and the Collector strips more if you want." },
  { q: "Does it slow my agent down?", a: "Never. Export is asynchronous. If Kyde is down, your agents run exactly as before." },
  { q: "How do I leave?", a: "DELETE /score/v0/keys with your key. The key and every record under it are gone in one request. There is no account to close." },
];


const timeline = [
  { t: "14:02:40", who: "Agent", text: "Works on a payout task." },
  { t: "14:02:41", who: "Agent", text: "Calls <code>send_payment</code> to an IBAN it has never used." },
  { t: "14:02:41", who: "Kyde", text: "Receives a salted hash of the recipient, never the IBAN." },
  { t: "14:02:42", who: "Kyde", text: "Its baseline holds 3 recipients from 412 runs. This hash is not one of them." },
  { t: "14:02:42", who: "Kyde", text: "Score drops. Reason: \"Used a recipient it never used before (iban). Possible attack.\"", hit: true },
  { t: "14:03:10", who: "Kyde", text: "The agent's next tool call carries the warning in its context." },
  { t: "14:03:11", who: "Kyde", text: "Email or webhook (Slack built in) to the key's human." },
];
---

<Base
  title="Kyde: Behavioral Scoring for AI Agents at Runtime"
  description="Behavioral scoring for AI agents at runtime. Kyde alerts you when an agent drifts, loops or starts doing things it never did. Free, via OpenTelemetry."
>
  <!-- Machine-readable alternates: the setup skill and the API reference. -->
  <link slot="head" rel="alternate" type="text/markdown" title="Kyde setup skill" href={SKILL_URL} />
  <link slot="head" rel="alternate" type="text/plain" title="llms.txt" href="https://score.kyde.com/llms.txt" />

  <LabNav />

  <main class="kx">
    <!-- ══════════ HERO: one claim, one action ══════════ -->
    <section class="surface-rose hero">
      <div class="wrap hero-grid">
        <div class="brackets hero-brackets">
          <p class="mono label">(Behavioral scoring for AI agents)</p>
          <h1 id="q" class="hero-title">See if your production agents go off task.</h1>
          <p class="hero-line">Kyde learns how each agent behaves and tells you the moment it stops behaving like itself.</p>
        </div>

        <div class="console" data-tabs>
          <div class="console-tabs mono" role="tablist" aria-label="How to start">
            <button type="button" role="tab" id="t-agent" aria-controls="p-agent" aria-selected="true">Your agent</button>
            <button type="button" role="tab" id="t-hook" aria-controls="p-hook" aria-selected="false" tabindex="-1">Webhook</button>
          </div>

          <div role="tabpanel" id="p-agent" aria-labelledby="t-agent" class="console-panel">
            <p class="mono c-label">Paste this into your agent</p>
            <pre class="code code-dark code-big"><code>{forAgents}</code></pre>
            <p class="c-note">It gets a key, sets three variables and checks that data arrives. <a href="#setup" class="link-u mono">Other ways</a></p>
          </div>

          <div role="tabpanel" id="p-hook" aria-labelledby="t-hook" class="console-panel" hidden>
            <p class="mono c-label">Where should alerts go?</p>
            <form id="watch-form" class="field" autocomplete="off" novalidate>
              <label for="watch-input" class="visually-hidden">Webhook URL, optional</label>
              <input id="watch-input" type="text" inputmode="url" spellcheck="false" placeholder="https://your.app/hooks/kyde" />
              <button type="submit" class="btn btn-paper" data-umami-event="get-key-form">Get a key →</button>
            </form>
            <p id="watch-hint" class="c-note" aria-live="polite">Kyde posts to it, signed, on every band change. Leave it empty to poll.</p>
            <div id="key-result" hidden>
              <p id="key-label" class="mono c-label">Set these where the agent runs</p>
              <pre class="code code-dark"><code id="key-code">{envForKey}</code></pre>
              <p id="key-note" class="c-note">Shown once. Store the key now, it cannot be retrieved later.</p>
            </div>
          </div>

          <p class="console-foot mono">Free · No account · Metadata only · No LLM</p>
        </div>
      </div>
      <div class="dots-band" aria-hidden="true"></div>
    </section>

    <!-- ══════════ 01 SETUP ══════════ -->
    <section class="surface-paper" id="setup">
      <div class="wrap sec">
        <div class="kicker"><span class="num">01</span><span class="mono">Setup</span></div>
        <div class="split">
          <div>
            <h2 class="h1">One line for your agent. Four for you.</h2>
            <p class="sub">No SDK, no code changes. Kyde reads the OpenTelemetry your agent can already send.</p>
          </div>
          <div class="tabbed" data-tabs>
            <div class="tabs mono" role="tablist" aria-label="Setup">
              {setupTabs.map((t, i) => (
                <button type="button" role="tab" id={`st-${t.id}`} aria-controls={`sp-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? undefined : -1}>{t.label}</button>
              ))}
            </div>
            {setupTabs.map((t, i) => (
              <div role="tabpanel" id={`sp-${t.id}`} aria-labelledby={`st-${t.id}`} hidden={i !== 0}>
                <pre class="code"><code>{t.code}</code></pre>
                <p class="note">{t.note}</p>
              </div>
            ))}
            <details class="more">
              <summary class="mono">No agent at hand? The same with curl</summary>
              <pre class="code"><code>{curlByHand}</code></pre>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ 02 HOW IT WORKS: one run as a timeline. Only what Kyde Score
         does today (public-claims 4, 5, 8, 11, 16): the call goes through, Kyde
         gets a salted hash, the score drops, the hook warns, the human gets mail.
         Footer points to the pause/block waitlist (Joerg 14.11.: say what we do, not what we cannot).
         No band named until Juergen confirms which one a new recipient sets. -->
    <section class="surface-ink" id="how-it-works">
      <div class="wrap sec">
        <div class="kicker"><span class="num">02</span><span class="mono">How it works</span></div>
        <div class="split">
          <div>
            <p class="mono label">(One run, minute by minute)</p>
            <h2 class="h1">A payment to someone this agent never paid.</h2>
          </div>
          <div>
            <ol class="tl">
              {timeline.map((r) => (
                <li class:list={["tl-row", r.who === "Agent" ? "tl-agent" : "tl-kyde", r.hit && "tl-hit"]}>
                  <p class="mono tl-meta"><time>{r.t}</time> · {r.who}</p>
                  <p class="tl-text" set:html={r.text} />
                </li>
              ))}
            </ol>
            <p class="note tl-foot">Grey: inside the agent. White: Kyde.</p>
            <p class="note tl-foot"><strong>Today Kyde warns your agent and you.</strong> Stop before the payment: <a href="/pricing/#plans" class="link-u mono" data-umami-event="timeline-waitlist">join the waitlist →</a></p>
            <p class="note tl-foot">Example run, times invented. <a href="/industries/agentic-commerce/" class="link-u mono">The recipient check →</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ 03 ALERT ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec">
        <div class="kicker"><span class="num">03</span><span class="mono">What you get</span></div>
        <div class="split">
          <div>
            <h2 class="h1">One alert when the band changes. Nothing in between.</h2>
            <p class="bands mono"><span class="band band-normal">70–100 normal</span><span class="band band-watch">40–69 watch</span><span class="band band-deviating">0–39 deviating</span></p>
          </div>
          <figure class="alert-card" aria-label="Sample alert">
            <p class="mono a-head"><span class="dot" aria-hidden="true"></span>Kyde · support-agent <span class="mono a-tag">coming soon</span></p>
            <p class="a-title">support-agent stopped behaving like itself.</p>
            <dl class="a-facts">
              <div><dt class="mono">Score</dt><dd>35, from normal to deviating</dd></div>
              <div><dt class="mono">Reason</dt><dd><code>abrupt_shift</code>: calls <code>web_search</code> where it used to call <code>refund_lookup</code></dd></div>
              <div><dt class="mono">Since</dt><dd>run 412, right after a model version change</dd></div>
            </dl>
            <details class="more">
              <summary class="mono">As JSON on your webhook, live in every plan</summary>
              <pre class="code"><code>{webhookExample}</code></pre>
            </details>
          </figure>
        </div>
        <p class="note foot">*Alerts by email, Slack and webhook are live and free during beta.</p>
        <ul class="triggers">
          {triggers.map((t) => (
            <li>
              <p class="mono label">({t.name})</p>
              <p class="t-line">{t.line}</p>
              <p class="note">{t.body}</p>
              <p class="mono reason">reason {t.reason}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ══════════ 04 RESEARCH (from src/data/research.ts) ══════════ -->
    <section class="surface-paper" id="research">
      <div class="wrap sec sec-tight">
        <div class="kicker"><span class="num">04</span><span class="mono">Kyde Research</span></div>
        <h2 class="h1">Agents change. The logs rarely say so.</h2>
        <ol class="rows">
          {studies.filter((m) => !m.hidden && ["model-switch", "trace-blind-spot", "injections"].includes(m.id)).map((m) => (
            <li class="row">
              <span class="mono no">{m.name}</span>
              <a href={`/research#${m.id}`} class="ftitle">{m.finding}</a>
              <span class="mono date">{m.corpus.split(",")[0]}</span>
            </li>
          ))}
        </ol>
        <p class="ctas"><a href="/research/" class="link-u mono">All studies →</a></p>
        <ul class="triggers method">
          <li>
            <p class="mono label">(No LLM)</p>
            <p class="t-line">An LLM watching your LLM drifts too.</p>
            <p class="note">Plain statistics against a frozen baseline: CUSUM for sudden shifts, Jensen-Shannon divergence for slow drift. No model calls, no token cost per score.</p>
          </li>
          <li>
            <p class="mono label">(Same input, same score)</p>
            <p class="t-line">A disputed score is reproduced, not argued.</p>
            <p class="note">Every score names its baseline and method version. The same records always give the same number.</p>
          </li>
          <li>
            <p class="mono label">(Metadata only)</p>
            <p class="t-line">We score call metadata.</p>
            <details class="more">
              <summary class="mono">What leaves the network</summary>
              <dl class="fields">
                {fields.map(([n, d]) => <div><dt>{n}</dt><dd class="note">{d}</dd></div>)}
              </dl>
              <p class="note">The score uses only the fields above. Anything else your exporter sends is dropped by a deny-by-default allowlist before storage. Hosted in the EU.</p>
            </details>
          </li>
        </ul>
        <p class="ctas"><a href={GITHUB} rel="noopener" class="link-u mono">Base detectors, paper and results on GitHub</a></p>
      </div>
    </section>

    <!-- ══════════ 05 QUESTIONS ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec sec-tight">
        <div class="kicker"><span class="num">05</span><span class="mono">Questions</span></div>
        <div class="qa">
          {faq.map((x) => <details><summary>{x.q}</summary><p>{x.a}</p></details>)}
        </div>
      </div>
    </section>

    <!-- ══════════ CLOSE: plans in one line each, details on the pricing page ══════════ -->
    <section class="surface-rose" id="pricing" data-surface="blush">
      <div class="wrap sec">
        <div class="brackets">
          <h2 class="display-2">Start free. Stop when you need to.</h2>
        </div>
        <ul class="plan-line">
          <li><span class="mono label">(Free)</span><span class="pl-price">€0</span><span class="note">Free during beta. Drift alerts by email, Slack and webhook, 200 agents per key, 90 days</span></li>
          <li><span class="mono label">(Pro) Planned</span><span class="pl-price">€29</span><span class="note">Pause and block, the human decides. <button type="button" onclick="openModal({ waitlist: 'stop' })" class="btn-reset waitlist-link" data-umami-event="waitlist-open-stop">Join the waitlist</button></span></li>
          <li class="pl-dark"><span class="mono label">(Enterprise) Kyde Control</span><span class="pl-price">from €990</span><span class="note">In your network. Stops the agent</span></li>
        </ul>
        <div class="ctas">
          <a href="/pricing/" class="btn btn-ink">See pricing →</a>
          <button type="button" onclick="openModal()" class="link-u mono btn-reset">Contact sales</button>
        </div>
        <p class="note foot">Nothing is billed today.</p>
      </div>
    </section>
  </main>

  <Footer
    links={footerLinks}
    tagline="Kyde learns how your agent behaves and tells you when that changes. OpenTelemetry in, score out. Hosted in the EU."
    cta={{ label: "Contact sales →", href: "/company/" }}
  />

  <script is:inline>
    // Tabs: every [data-tabs] group switches its own panels. Arrow keys move.
    document.querySelectorAll("[data-tabs]").forEach((group) => {
      const tabs = [...group.querySelectorAll('[role="tab"]')];
      const select = (t) => tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute("aria-selected", String(on));
        x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute("aria-controls")).hidden = !on;
      });
      tabs.forEach((t, i) => {
        t.addEventListener("click", () => select(t));
        t.addEventListener("keydown", (e) => {
          const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (!d) return;
          const n = tabs[(i + d + tabs.length) % tabs.length];
          select(n);
          n.focus();
        });
      });
    });

    // Copy icon on every code block.
    const ICON_COPY = '<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.3" d="M5.5 5.5h8v8h-8zM10.5 5.5v-3h-8v8h3"/></svg>';
    const ICON_OK = '<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M3 8.5l3 3 7-7"/></svg>';
    document.querySelectorAll("pre.code").forEach((pre) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "copy-ic";
      b.setAttribute("aria-label", "Copy");
      b.innerHTML = ICON_COPY;
      b.addEventListener("click", () => {
        try { navigator.clipboard.writeText(pre.querySelector("code").textContent); } catch (e) {}
        b.innerHTML = ICON_OK;
        setTimeout(() => { b.innerHTML = ICON_COPY; }, 1600);
      });
      pre.appendChild(b);
    });

    // Webhook tab: asks score.kyde.com for a key. If the browser cannot reach
    // it (no CORS for kyde.com yet, rate limit 5 keys/hour/IP, offline), it
    // shows the same request as curl instead, so the visitor is never stuck.
    const API = "https://score.kyde.com/score/v0/keys";
    const form = document.getElementById("watch-form");
    const input = document.getElementById("watch-input");
    const hint = document.getElementById("watch-hint");
    const result = document.getElementById("key-result");
    const label = document.getElementById("key-label");
    const code = document.getElementById("key-code");
    const note = document.getElementById("key-note");
    const button = form.querySelector("button");
    const HINT = hint.textContent;
    const envFor = (key) => [
      "OTEL_EXPORTER_OTLP_ENDPOINT=https://score.kyde.com",
      "OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf",
      `OTEL_EXPORTER_OTLP_HEADERS="x-kyde-key=${key}"`,
      "OTEL_SERVICE_NAME=<agent-name>",
    ].join("\n");
    const curlFor = (url) => url
      ? `curl -s ${API} \\\n  -H 'content-type: application/json' \\\n  -d '{"webhook_url": "${url}"}'`
      : `curl -s -X POST ${API}`;
    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const v = input.value.trim();
      if (v && !/^https:\/\/\S+\.\S+/.test(v)) {
        hint.classList.add("bad");
        hint.textContent = "That is not an https:// URL. Leave it empty to poll instead.";
        input.focus();
        return;
      }
      hint.classList.remove("bad");
      button.disabled = true;
      try {
        const res = await fetch(API, {
          method: "POST",
          headers: v ? { "content-type": "application/json" } : {},
          body: v ? JSON.stringify({ webhook_url: v }) : undefined,
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        if (!data.key) throw new Error("no key");
        hint.textContent = v ? "Alerts go to " + v : "Poll-only key. Add a webhook any time.";
        label.textContent = "Set these where the agent runs";
        code.textContent = envFor(data.key);
        note.textContent = "Shown once. Store the key now, it cannot be retrieved later.";
      } catch (e) {
        hint.textContent = "Run this to get your key.";
        label.textContent = "Get your key";
        code.textContent = curlFor(v);
        note.textContent = "It returns {\"key\": \"kyde_…\"}. Then set the variables from the setup section below.";
      } finally {
        button.disabled = false;
        result.hidden = false;
      }
    });
    input.addEventListener("input", () => { hint.classList.remove("bad"); if (!input.value) hint.textContent = HINT; });

  </script>
</Base>
