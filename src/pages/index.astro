        <!-- ══════════ GLITCH WALL DIVIDER ══════════ -->
        <section class="relative border-b border-white/10 h-[280px] md:h-[380px] overflow-hidden" aria-hidden="true">
            <canvas id="glitch-wall" class="absolute inset-0 w-full h-full"></canvas>
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-bg-0 via-transparent to-bg-0/60"></div>
            <!-- grid rails continue through the divider -->
