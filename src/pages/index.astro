                        <p class="mt-5 text-base md:text-lg font-semibold text-white/90 leading-snug">Models change under the same name. Policies change. Nothing announces it.</p>
                        <p class="mt-3 font-mono text-sm text-white/70 uppercase tracking-[0.12em]">Replay a recorded run against today's models and policies.</p>
                        <p class="mt-8 text-lg text-white/55 leading-relaxed">
                            A recorded run is a hundred real cases where the right answer is already known. Replay it against what would happen today and the difference is something you can point at, instead of a complaint that arrives six weeks later. The same recording is what continuous evaluation runs on: measured against the outcome in your system of record, not against what a person happened to click. <span class="text-white/35">Replay runs today. Continuous evaluation is coming soon.</span>
                        </p>
                        </div>
                    </div>
                </div>
            </div>
<script>
                // replay-fig · a playhead runs the recorded sequence against the replayed one.
                // Entries light as the head reaches them and burn down to a resting level
                // rather than switching off. One entry sits lower than its recorded twin:
                // that is the whole point of the figure, so it is the only thing that
                // holds its color after the head has gone past.
                const rpFig = document.getElementById("replay-fig");
                const rpReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (rpFig) {
                    const DIVERGE = 5;
                    const XS = Array.from({ length: 8 }, (_, i) => 60 + i * 48);
                    const head = document.getElementById("rp-head") as unknown as SVGLineElement;
                    const gap = document.getElementById("rp-gap") as unknown as SVGLineElement;
                    const note = document.getElementById("rp-note") as unknown as SVGTextElement;
                    const tops = Array.from(rpFig.querySelectorAll(".rp-top")) as SVGRectElement[];
                    const bots = Array.from(rpFig.querySelectorAll(".rp-bot")) as SVGRectElement[];
                    const NS = "http://www.w3.org/2000/svg";

                    // Bloom borrowed from the hero canvas: expands on an ease-out and
                    // burns down over roughly two seconds, so a contact glows like an
                    // ember rather than switching on.
                    const bloomLayer = document.getElementById("replay-blooms") as unknown as SVGGElement;
                    const blooms: { el: SVGCircleElement; r: number; a: number; max: number }[] = [];
                    const bloom = (bx: number, by: number, r0 = 8, peak = 0.85) => {
                        const c = document.createElementNS(NS, "circle") as SVGCircleElement;
                        c.setAttribute("cx", String(bx));
                        c.setAttribute("cy", String(by));
                        c.setAttribute("r", String(r0));
                        c.setAttribute("fill", "url(#replay-glow)");
                        c.setAttribute("opacity", String(peak));
                        bloomLayer.appendChild(c);
                        blooms.push({ el: c, r: r0, a: peak, max: r0 + 54 });
                    };
                    const stepBlooms = () => {
                        for (let i = blooms.length - 1; i >= 0; i--) {
                            const b = blooms[i];
                            b.r += (b.max - b.r) * 0.045;
                            b.a *= 0.972;
                            if (b.a < 0.02) { b.el.remove(); blooms.splice(i, 1); }
                            else { b.el.setAttribute("r", b.r.toFixed(1)); b.el.setAttribute("opacity", b.a.toFixed(3)); }
                        }
                    };


                    const REST = 0.25;
                    let bright = XS.map(() => ({ t: REST, b: REST }));
                    let x = 40, gapO = 0, noteO = 0, holdUntil = 0;

                    const paint = () => {
                        bright.forEach((v, i) => {
                            const diverged = i === DIVERGE;
                            tops[i].setAttribute("stroke-opacity", String(v.t));
                            tops[i].setAttribute("stroke", "var(--color-ink-0)");
                            bots[i].setAttribute("stroke-opacity", String(v.b));
                            bots[i].setAttribute("stroke", diverged && v.b > REST + 0.02 ? "var(--color-warn)" : "var(--color-ink-0)");
                        });
                        gap.setAttribute("stroke-opacity", String(gapO));
                        note.setAttribute("fill-opacity", String(noteO));
                        head.setAttribute("x1", String(x));
                        head.setAttribute("x2", String(x));
                    };

                    const tick = () => {
                        if (performance.now() < holdUntil) {
                            // hold on the divergence, then let it burn down with the rest
                            gapO *= 0.994; noteO *= 0.994;
                            bright.forEach((v, i) => {
                                v.t = REST + (v.t - REST) * 0.985;
                                v.b = REST + (v.b - REST) * (i === DIVERGE ? 0.997 : 0.985);
                            });
                            paint();
                            return;
                        }
                        x += 1.05;
                        XS.forEach((xi, i) => {
                            if (x >= xi && bright[i].t <= REST + 0.01) bright[i].t = 0.95;
                            if (x >= xi + 14 && bright[i].b <= REST + 0.01) {
                                bright[i].b = 0.95;
                                if (i === DIVERGE) { gapO = 0.7; noteO = 0.9; bloom(300, 266, 7, 0.8); }
                            }
                        });
                        bright.forEach((v, i) => {
                            v.t = REST + (v.t - REST) * 0.97;
                            v.b = REST + (v.b - REST) * (i === DIVERGE ? 0.995 : 0.97);
                        });
                        gapO *= 0.997; noteO *= 0.997;
                        if (x > 430) { x = 40; holdUntil = performance.now() + 2200; }
                        stepBlooms();
                        paint();
                    };

                    if (rpReduced) {
                        bright = bright.map((_, i) => ({ t: 0.35, b: i === DIVERGE ? 0.9 : 0.35 }));
                        gapO = 0.6; noteO = 0.9; x = 430;
                        paint();
                    } else {
                        let visible = false;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(rpFig);
                        const loop = () => {
                            if (visible) tick();
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
        </section>

        <!-- ══════════ 04 · EVIDENCE ══════════ -->
        <section id="prove" class="scroll-mt-20">
