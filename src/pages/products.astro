---
// Products page: Kyde Score and Kyde Control, the gateway (names: Joerg
// 2026-11-03; "gateway" next to Control: Joerg 2026-11-09). The two products
// come first, as two cards, then the side-by-side, then each product with its
// specs, the dashboard, verification and one close.
//
// The story is the one the live home tells: banks score every card swipe,
// Kyde scores every agent action. Score tells you; Control acts.
// Facts: Score from kydehq/score (README, skill, landing). Control is the Kyde
// Gateway (company/gateway README). Benchmark from the Kyde one-pager
// (kyde-drift.pdf, 2026-11).
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import LabNav from "../components/lab/LabNav.astro";
import { labFooterLinks } from "../data/lab-footer";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/lab.css";

const SKILL_URL = "https://score.kyde.com/skill.md";

const scoreSpecs = [
  ["Input", "OpenTelemetry over OTLP/HTTP, JSON or protobuf. Claude Code, Grok CLI, or any framework with GenAI tool spans."],
  ["Setup", "Three environment variables, or one line to your agent: Set up score.kyde.com/skill.md"],
  ["Baseline", "Learned per agent over its first 30 runs, then frozen and fingerprinted."],
  ["Detectors", "CUSUM for sudden shifts, Jensen-Shannon divergence for slow drift, duplicate calls for loops (needs the parameter hash kyde.args.digest). Plus a task-contract check: a tool never seen for the task. No LLM."],
  ["Score", "0 to 100 per run. 70 and up normal, 40 to 69 watch, below 40 deviating. Counts the alarms of the last 20 runs, so an agent that settles recovers."],
  ["Output", "Scores as JSON over the API and the MCP server. Signed webhook on every band change and every rebaseline."],
  ["Data", "Call metadata only. Everything else is dropped before storage. Hosted in the EU. Retention by plan."],
  ["Effect on the agent", "None. Export is asynchronous. If Kyde is down, the agent runs as before."],
];

const controlSpecs = [
  ["Position", "In the path of the agent. Drop-in, OpenAI-compatible proxy for LLM calls, and an MCP proxy for tools."],
  ["Setup", "One line in the agent: point its base URL at the gateway. Works with OpenAI, Anthropic, Gemini and local models."],
  ["Decision", "Every call is scored before it runs. Calls that do not fit the baseline are held."],
  ["Rules", "Allow and deny per tool, limits by score, data loss prevention on what goes out."],
  ["Release", "A held agent goes into quarantine. A human or a rule decides what happens next."],
  ["Record", "Every action in a hash-chained ledger. Signed with Ed25519, keys can live in an HSM."],
  ["Deployment", "Runs in your network with Docker. Your data stays with you. Built in Europe."],
  // "Measured" (AgentDojo figure) is out until Juergen confirms it (KYDE-376).
];

const compare = [
  ["Behavioral score for every agent", true, true],
  ["Alert on hijack, loops and drift", true, true],
  ["Sees what the agent did", true, true],
  ["Holds an action before it runs", false, true],
  ["Quarantine, a human releases", false, true],
  ["Rules per tool and data loss prevention", false, true],
  ["Signed, tamper-evident record", false, true],
  ["Changes to the agent", "None", "One line"],
  ["Runs", "Hosted, EU", "Your network"],
  ["Price", "From €0", "From €990 a month"],
];
---

<Base
  title="Products: Kyde Score and Kyde Control, the gateway"
  description="Behavioral scoring for AI agents at runtime. Kyde Score tells you when an agent drifts. Kyde Control, the gateway, stops it before it does damage."
>
  <LabNav active="products" />

  <main class="kx">
    <!-- ══════════ HERO: the two products, side by side ══════════ -->
    <section class="surface-rose hero">
      <div class="wrap p-hero">
        <div class="brackets hero-brackets p-hero-head">
          <p class="mono label">(Products)</p>
          <h1 class="hero-title">Two products. One behavioral score.</h1>
          <p class="hero-line">Kyde Score tells you when an agent drifts. Kyde Control, the gateway, stops it before it does damage.</p>
        </div>
        <div class="prod-cards">
          <article class="prod-card">
            <p class="mono pc-label">(Kyde Score) Hosted · tells you</p>
            <h2 class="pc-name">Kyde Score</h2>
            <p class="pc-line">Tells you when an agent stops behaving like itself.</p>
            <p class="flow mono"><span>Agent</span><span class="arr">→</span><span>OpenTelemetry</span><span class="arr">→</span><span class="hl">Score</span><span class="arr">→</span><span>Alert to you</span></p>
            <ul class="pc-list">
              <li>No change to the agent. Three environment variables.</li>
              <li>A score from 0 to 100 for every run, against the agent's own baseline.</li>
              <li>Webhook when the score changes band. Hosted in the EU.</li>
            </ul>
            <div class="pc-foot">
              <p class="pc-price">From €0</p>
              <div class="ctas">
                <a href="/#setup" class="btn btn-ink" data-umami-event="products-get-key">Get a key →</a>
                <a href="#score" class="link-u mono">Details</a>
              </div>
            </div>
          </article>
          <article class="prod-card prod-card-dark">
            <p class="mono pc-label">(Kyde Control) The gateway · stops it</p>
            <h2 class="pc-name">Kyde Control</h2>
            <p class="pc-line">Holds the next action before it runs. A human decides.</p>
            <p class="flow mono"><span>Agent</span><span class="arr">→</span><span class="hl">Gateway + Score</span><span class="arr">→</span><span>Hold</span><span class="arr">→</span><span>Human decides</span></p>
            <ul class="pc-list">
              <li>A gateway in the path of the agent. One line: its base URL.</li>
              <li>Every call scored before it runs. Rules per tool, quarantine.</li>
              <li>Signed, hash-chained record. Runs in your network.</li>
            </ul>
            <div class="pc-foot">
              <p class="pc-price">From €990 <span class="mono pc-per">a month</span></p>
              <div class="ctas">
                <button type="button" onclick="openModal()" class="btn btn-neon" data-umami-event="contact-open-control">Contact sales →</button>
                <a href="#control" class="link-u mono">Details</a>
              </div>
            </div>
          </article>
        </div>
        <p class="note p-hero-note">*Same detectors, same score in both. Start with Kyde Score, add the gateway when you want a falling score to stop something.</p>
      </div>
      <div class="dots-band" aria-hidden="true"></div>
    </section>

    <!-- ══════════ 01 COMPARE ══════════ -->
    <section class="surface-paper">
      <div class="wrap sec sec-tight">
        <div class="kicker"><span class="num">01</span><span class="mono">Side by side</span></div>
        <div class="table-wrap">
          <table class="cmp">
            <thead>
              <tr><th scope="col"><span class="visually-hidden">Feature</span></th><th scope="col">Kyde Score</th><th scope="col" class="col-dark">Kyde Control <span class="cmp-sub">(gateway)</span></th></tr>
            </thead>
            <tbody>
              {compare.map(([k, a, b]) => (
                <tr>
                  <th scope="row">{k}</th>
                  <td>{a === true ? <span class="yes"><span aria-hidden="true">●</span><span class="sr-only">Yes</span></span> : a === false ? <span class="no"><span aria-hidden="true">–</span><span class="sr-only">No</span></span> : <span class="mono">{a}</span>}</td>
                  <td class="col-dark">{b === true ? <span class="yes"><span aria-hidden="true">●</span><span class="sr-only">Yes</span></span> : <span class="mono">{b}</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══════════ 02 KYDE SCORE ══════════ -->
    <section class="surface-paper" id="score">
      <div class="wrap sec sec-tight">
        <div class="kicker"><span class="num">02</span><span class="mono">Kyde Score</span></div>
        <div class="split">
          <div>
            <h2 class="h1">Know when an agent stops behaving like itself.</h2>
            <p class="sub">Kyde learns each agent from its own telemetry and scores every run against it. When the score changes band, you hear from us.</p>
            <figure class="plate" aria-label="Kyde Score watching six agents, one deviating">
              <svg id="radar-fig" viewBox="0 0 480 400" role="img" aria-hidden="true">
                <path d="M12 27 L12 12 L27 12 M453 12 L468 12 L468 27 M12 373 L12 388 L27 388 M468 373 L468 388 L453 388" fill="none" stroke="var(--color-ink)" stroke-opacity=".5" />
                <circle cx="240" cy="200" r="180" fill="none" stroke="var(--color-ink)" stroke-opacity=".22" />
                <circle cx="240" cy="200" r="120" fill="none" stroke="var(--color-ink)" stroke-opacity=".15" stroke-dasharray="2 5" />
                <circle cx="240" cy="200" r="60" fill="none" stroke="var(--color-ink)" stroke-opacity=".2" />
                <line x1="240" y1="14" x2="240" y2="386" stroke="var(--color-ink)" stroke-opacity=".1" />
                <line x1="54" y1="200" x2="426" y2="200" stroke="var(--color-ink)" stroke-opacity=".1" />
                <g id="radar-sweep">
                  <path d="M240 200 L240 20 A180 180 0 0 0 182 29 Z" fill="var(--color-ink)" fill-opacity=".05" />
                  <line x1="240" y1="200" x2="240" y2="20" stroke="var(--color-ink)" stroke-opacity=".5" />
                </g>
                <g id="radar-blips"></g>
                <circle cx="240" cy="200" r="4" fill="var(--color-ink)" />
                <text x="240" y="220" text-anchor="middle" class="svg-mono" fill-opacity=".6">KYDE</text>
              </svg>
              <figcaption class="mono plate-cap">*Illustrative. Every agent scored against its own baseline. One left its band.</figcaption>
            </figure>
            <div class="ctas">
              <a href="/#setup" class="btn btn-ink">Set up in two minutes →</a>
              <a href={SKILL_URL} class="link-u mono">The agent skill</a>
            </div>
          </div>
          <div>
            <p class="mono label">(Specs)</p>
            <dl class="specs">
              {scoreSpecs.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ 03 KYDE CONTROL ══════════ -->
    <section class="surface-paper" id="control">
      <div class="wrap sec sec-tight">
        <div class="kicker"><span class="num">03</span><span class="mono">Kyde Control · the gateway</span></div>
        <div class="split">
          <div>
            <h2 class="h1">When the score falls, the agent stops.</h2>
            <p class="sub">The full package. Kyde sits in the path of the agent, scores every call before it runs and holds what does not fit. A human stays above the loop and decides only the exception.</p>
            <figure class="plate" aria-label="Actions crossing Kyde Control, one held">
              <svg id="gate-fig" viewBox="0 0 480 300" aria-hidden="true">
                <path d="M12 27 L12 12 L27 12 M453 12 L468 12 L468 27 M12 273 L12 288 L27 288 M468 273 L468 288 L453 288" fill="none" stroke="var(--color-ink)" stroke-opacity=".5" />
                <text x="30" y="48" class="svg-mono" fill-opacity=".6">Agent actions</text>
                <text x="450" y="48" text-anchor="end" class="svg-mono" fill-opacity=".6">Your systems</text>
                <line x1="30" y1="100" x2="450" y2="100" stroke="var(--color-ink)" stroke-opacity=".15" stroke-dasharray="3 6" />
                <line x1="30" y1="150" x2="450" y2="150" stroke="var(--color-ink)" stroke-opacity=".15" stroke-dasharray="3 6" />
                <line x1="30" y1="200" x2="450" y2="200" stroke="var(--color-ink)" stroke-opacity=".15" stroke-dasharray="3 6" />
                <line x1="286" y1="72" x2="286" y2="228" stroke="var(--color-ink)" stroke-width="1.5" />
                <text x="286" y="252" text-anchor="middle" class="svg-mono">Kyde Control</text>
                <line x1="392" y1="72" x2="392" y2="228" stroke="var(--color-ink)" stroke-opacity=".25" />
                <g id="gate-actions"></g>
              </svg>
              <figcaption class="mono plate-cap">*Illustrative. The held action stops at the line, not inside your systems.</figcaption>
            </figure>
            <ol class="steps-mini">
              <li><span class="mono">01</span>Observe every call</li>
              <li><span class="mono">02</span>Score it against the agent's own baseline</li>
              <li><span class="mono">03</span>Limit what the agent may do by its score</li>
              <li><span class="mono">04</span>Stop and quarantine, a human releases</li>
              <li><span class="mono">05</span>Prove it, in a signed record</li>
            </ol>
            <div class="ctas">
              <button type="button" onclick="openModal()" class="btn btn-ink">Contact sales →</button>
              <a href="/docs/control/" class="link-u mono">Kyde Control docs</a>
            </div>
          </div>
          <div>
            <p class="mono label">(Specs)</p>
            <dl class="specs">
              {controlSpecs.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ 04 DASHBOARD (abstract, from the gateway frontend) ══════════ -->
    <section class="surface-paper" id="dashboard">
      <div class="wrap sec sec-tight">
        <div class="kicker"><span class="num">04</span><span class="mono">The Control dashboard</span></div>
        <div class="split split-head">
          <h2 class="h1">Every agent, its score, and what is on hold.</h2>
          <p class="sub">One screen for the whole fleet. When Kyde holds an action, it lands here, and a person decides.</p>
        </div>
        <figure class="dash" aria-label="Illustration of the Kyde Control dashboard">
          <div class="dash-bar mono"><span class="dash-dots"><i></i><i></i><i></i></span><span>control.kyde · Workforce status</span><span class="dash-chain">● chain verified</span></div>
          <div class="dash-body">
            <div class="dash-side mono" aria-hidden="true">
              <p class="ds-group">Overview</p>
              <span class="on">Workforce status</span><span>Threats &amp; alerts</span><span>Audit log</span>
              <p class="ds-group">Agents</p>
              <span>Agents</span><span>Sessions</span><span>Network map</span>
              <p class="ds-group">Configuration</p>
              <span>Policies</span><span>Routing</span>
            </div>
            <div class="dash-main">
              <div class="dash-metrics">
                <div><p class="mono">Active agents</p><p class="dm-v">12</p></div>
                <div><p class="mono">Open alerts</p><p class="dm-v">2</p></div>
                <div><p class="mono">Held now</p><p class="dm-v dm-held">1</p></div>
                <div><p class="mono">Fleet score</p><p class="dm-v">84</p></div>
              </div>
              <div class="dash-held">
                <div>
                  <p class="mono dh-label"><span class="dot"></span>Held · invoice-reconciler-07 · score 38</p>
                  <p class="dh-what">Wants to call <code>payments.transfer</code> for the 4th time in one run. Baseline: once.</p>
                </div>
                <div class="dh-actions mono"><span class="dh-btn">Release</span><span class="dh-btn dh-btn-ink">Keep stopped</span></div>
              </div>
              <table class="dash-table">
                <thead><tr><th>Agent</th><th>Score, 14 days</th><th>Score</th><th>Band</th></tr></thead>
                <tbody>
                  <tr><td>support-agent</td><td><svg viewBox="0 0 120 24" class="spark"><polyline points="0,6 15,5 30,7 45,6 60,5 75,6 90,5 105,6 120,5" /></svg></td><td class="mono">92</td><td><span class="band band-normal mono">normal</span></td></tr>
                  <tr><td>claims-triage</td><td><svg viewBox="0 0 120 24" class="spark"><polyline points="0,6 15,7 30,8 45,10 60,11 75,12 90,13 105,14 120,14" /></svg></td><td class="mono">61</td><td><span class="band band-watch mono">watch</span></td></tr>
                  <tr class="tr-held"><td>invoice-reconciler-07</td><td><svg viewBox="0 0 120 24" class="spark"><polyline points="0,6 15,6 30,5 45,6 60,6 75,7 90,6 105,19 120,21" /></svg></td><td class="mono">38</td><td><span class="band band-deviating mono">deviating</span></td></tr>
                  <tr><td>crm-sync</td><td><svg viewBox="0 0 120 24" class="spark"><polyline points="0,5 15,6 30,5 45,5 60,6 75,5 90,6 105,5 120,6" /></svg></td><td class="mono">88</td><td><span class="band band-normal mono">normal</span></td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <figcaption class="mono plate-cap">*Illustrative, drawn after the Kyde Gateway dashboard.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ══════════ 05 VERIFICATION (violet, as on /platform: one per page) ══════════ -->
    <section class="surface-violet" id="verify">
      <div class="wrap sec">
        <div class="kicker kicker-violet"><span class="num">05</span><span class="mono">Independent verification</span></div>
        <h2 class="h1">Built for independent verification.</h2>
        <p class="sub">Evidence you cannot check yourself is a claim. The detectors behind the score are open, and the record is hash-chained. Both can be checked by someone outside Kyde.</p>
        <div class="verify">
          <div>
            <p class="mono label">(Kyde Score) The math</p>
            <dl class="vlist">
              <div><dt class="mono">Deterministic</dt><dd>Plain statistics, no LLM. Same records, same score.</dd></div>
              <div><dt class="mono">Frozen baseline</dt><dd>Learned once, then fingerprinted. A drifting agent never becomes its own reference.</dd></div>
              <div><dt class="mono">Method version</dt><dd>Every score names the method it was computed with.</dd></div>
              <div><dt class="mono">Open base detectors</dt><dd>CUSUM and Jensen-Shannon divergence are open source. The task-contract check is our own. <a href="https://github.com/kydehq/behavioral-drift-detection" rel="noopener">github.com/kydehq/behavioral-drift-detection →</a></dd></div>
            </dl>
          </div>
          <div>
            <p class="mono label">(Kyde Control) The record</p>
            <dl class="vlist">
              <div><dt class="mono">Hash chain</dt><dd>Each entry carries the hash of the one before. Change one, and every link after it breaks.</dd></div>
              <div><dt class="mono">Offline recomputation</dt><dd>An auditor checks the chain from the export, on their own machine, without us.</dd></div>
              <div><dt class="mono">Ed25519 signing</dt><dd>Proves who wrote each entry. Your keys, in your environment or your HSM. An Enterprise capability.</dd></div>
              <div><dt class="mono">Open-source gateway</dt><dd>The thing writing the record can be read. <a href="https://github.com/kydehq/gateway" rel="noopener">github.com/kydehq/gateway →</a></dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ CLOSE ══════════ -->
    <section class="surface-rose" data-surface="blush">
      <div class="wrap sec">
        <div class="split">
          <div class="brackets">
            <h2 class="display-2">Point your agent at Kyde.</h2>
          </div>
          <div class="close-two">
            <div>
              <p class="mono label">(Kyde Score)</p>
              <p class="body-l">Tell your agent: <code class="inline-code">Set up score.kyde.com/skill.md</code>. It sets up the whole harness, so every session is scored, not one agent.</p>
              <p class="ctas"><a href="/#setup" class="link-u mono">Or set it up by hand</a></p>
            </div>
            <div>
              <p class="mono label">(Kyde Control) The gateway</p>
              <p class="body-l">30 minutes, one of your agents. We show you what Kyde sees in its traces.</p>
              <p class="ctas"><button type="button" onclick="openModal()" class="btn btn-ink">Contact sales →</button></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer
    links={labFooterLinks}
    tagline="Kyde Score tells you when an agent stops behaving like itself. Kyde Control, the gateway, stops it. Built in Europe."
    cta={{ label: "Contact sales →", href: "/company/" }}
  />

  <script is:inline>
    // Figures after /platform (radar-fig, gate-fig), redrawn for a white page.
    // Paused off screen; one still frame under reduced motion.
    (() => {
      const NS = "http://www.w3.org/2000/svg";
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const watch = (el, onFrame) => {
        let visible = false;
        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(el);
        const loop = (now) => { if (visible) onFrame(now); requestAnimationFrame(loop); };
        requestAnimationFrame(loop);
      };
      const mk = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); parent.appendChild(e); return e; };

      // Kyde Score: the sweep lights each agent with its score; one is deviating.
      const radar = document.getElementById("radar-fig");
      if (radar) {
        const CX = 240, CY = 200;
        const AGENTS = [
          { id: "support-agent", score: 92, r: 150, a: 0.5 },
          { id: "crm-sync", score: 88, r: 95, a: 1.5 },
          { id: "claims-triage", score: 61, r: 160, a: 2.5 },
          { id: "invoice-rec-07", score: 38, r: 120, a: 3.6, bad: true },
          { id: "mail-drafter", score: 90, r: 165, a: 4.6 },
          { id: "etl-worker", score: 85, r: 80, a: 5.5 },
        ];
        const g = document.getElementById("radar-blips");
        const blips = AGENTS.map((ag) => {
          const x = CX + Math.cos(ag.a) * ag.r, y = CY + Math.sin(ag.a) * ag.r;
          const dot = mk("circle", { cx: x, cy: y, r: ag.bad ? 6 : 4, fill: ag.bad ? "var(--color-blush)" : "var(--color-neon)", stroke: "var(--color-ink)", "stroke-width": 1 }, g);
          const left = x > 330;
          const label = mk("text", { x: left ? x - 10 : x + 10, y: y - 3, "text-anchor": left ? "end" : "start", class: "svg-mono" }, g);
          label.textContent = ag.id;
          const sc = mk("text", { x: left ? x - 10 : x + 10, y: y + 11, "text-anchor": left ? "end" : "start", class: "svg-mono", "font-size": "12.5" }, g);
          sc.textContent = ag.score + (ag.bad ? " · deviating" : ag.score < 70 ? " · watch" : " · normal");
          return { ...ag, nodes: [dot, label, sc], lit: -1e9, ang: (ag.a + Math.PI / 2 + 2 * Math.PI) % (2 * Math.PI) };
        });
        const sweep = document.getElementById("radar-sweep");
        const paint = (b, alpha) => b.nodes.forEach((n) => n.setAttribute("opacity", String(b.bad ? Math.max(alpha, 0.55) : alpha)));
        if (reduced) { blips.forEach((b) => paint(b, 1)); }
        else {
          let last = 0, ang = 0;
          watch(radar, (now) => {
            const dt = last ? now - last : 16; last = now;
            const prev = ang; ang = (ang + dt * 0.0011) % (2 * Math.PI);
            sweep.setAttribute("transform", `rotate(${(ang * 180) / Math.PI} ${CX} ${CY})`);
            blips.forEach((b) => {
              const crossed = prev <= ang ? b.ang > prev && b.ang <= ang : b.ang > prev || b.ang <= ang;
              if (crossed) b.lit = now;
              paint(b, Math.max(0.12, 1 - (now - b.lit) / 3200));
            });
          });
        }
      }

      // Kyde Control: actions run to the line; one in four is held and sent back.
      const gate = document.getElementById("gate-fig");
      if (gate) {
        const layer = document.getElementById("gate-actions");
        const LANES = [100, 150, 200], GATE = 286, START = 40, END = 440;
        const acts = [];
        const spawn = (lane, held) => {
          const el = mk("circle", { r: 5, cy: LANES[lane], cx: START, fill: "var(--color-paper)", stroke: "var(--color-ink)", "stroke-width": 1.25 }, layer);
          acts.push({ el, x: START, held, back: false });
        };
        if (reduced) {
          spawn(0, false); spawn(1, true); spawn(2, false);
          acts.forEach((a) => { a.el.setAttribute("cx", a.held ? GATE - 20 : GATE + 60); a.el.setAttribute("fill", a.held ? "var(--color-blush)" : "var(--color-neon)"); });
        } else {
          let next = 0, n = 0;
          watch(gate, (now) => {
            if (now > next) { spawn(n % 3, n % 4 === 2); n++; next = now + 900; }
            for (let i = acts.length - 1; i >= 0; i--) {
              const a = acts[i];
              if (a.back) a.x -= 3.2;
              else {
                a.x += 2.2;
                if (a.held && a.x >= GATE - 7) { a.back = true; a.el.setAttribute("fill", "var(--color-blush)"); a.el.setAttribute("r", "6"); }
                else if (!a.held && a.x >= GATE + 6) a.el.setAttribute("fill", "var(--color-neon)");
              }
              a.el.setAttribute("cx", a.x);
              if (a.back ? a.x < START - 10 : a.x > END) { a.el.remove(); acts.splice(i, 1); }
            }
          });
        }
      }
    })();
  </script>

