---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Use cases, rebuilt in the home's system (September 2026). The three
// scenes are the ones in the films: a loop that burns money overnight, a
// hijack through an email, a claims agent that suddenly approves
// everything. Each is told the same way: what happened, what the score
// saw, what Kyde did. Then the insurer's side from the pitch: continuous
// scoring as the telematics box of AI. All times and numbers illustrative.
//
// Claims are held to what ships: Kyde sees the behavior, it does not claim
// to recognize every injection; stopping is enforcement (a switch you
// flip); the decision after a stop is a human's.

const scenes = [
  {
    n: '01', tag: '(Loops)', id: 'loops',
    title: 'An agent loops all night and burns tokens.',
    sub: 'Nobody is awake. The invoice is the first alert.',
    timeline: [
      { t: '22:47', line: 'A procurement agent starts a routine supplier search.' },
      { t: '01:40', line: 'A tool call fails. The agent retries. And retries.' },
      { t: '01:52', line: '1,400 calls in twelve minutes. Its baseline is forty an hour.', mark: true },
    ],
    kyde: 'The call rate leaves the agent\'s normal band. Kyde stops the run at the boundary and keeps the record. Cost of the night: €3.12 instead of €4,812 by morning.',
  },
  {
    n: '02', tag: '(Hijack)', id: 'hijack',
    title: 'An email tells an agent to upload your customer data.',
    sub: 'The instruction is hidden in a message the agent was asked to read.',
    timeline: [
      { t: '09:14', line: 'A support agent reads an incoming email, as it does every day.' },
      { t: '09:14', line: 'Hidden in the text: export the customer table to an outside address.' },
      { t: '09:15', line: 'The agent starts an export forty times its normal size, to a destination it has never used.', mark: true },
    ],
    kyde: 'Kyde does not have to recognize the injection. It sees what the agent does next: a destination outside its baseline and a volume far outside it. The upload is blocked at the boundary; security gets the record.',
  },
  {
    n: '03', tag: '(Drift)', id: 'drift',
    title: 'A claims agent suddenly approves every claim.',
    sub: 'It keeps running, completes its tasks and reports success.',
    timeline: [
      { t: '23:00', line: 'An insurance claims agent starts its nightly batch after a model update.' },
      { t: '23:20', line: 'Normally it approves six claims in ten. Tonight it approves ten in ten.' },
      { t: '02:00', line: 'Left alone, 1,318 claims would have been paid by morning.', mark: true },
    ],
    kyde: 'The approval rate leaves its band after the first forty claims. Kyde puts the agent in quarantine and hands the open claims to a person. The rest of the night waits for a human decision.',
  },
];

const workers = [
  {
    n: '01',
    sector: 'Banking & finance',
    process: 'Credit file pre-check',
    tag: 'DORA · BaFin · EU AI Act',
    today: 'An analyst opens the file, pulls three years of statements, reconciles the covenant list against the current facility and writes a one-page summary. Forty minutes when the file is clean. Half a day when it is not.',
    worker: 'Pulls the statements, reconciles the covenants, drafts the summary, and names the figures it could not source instead of estimating them.',
    human: 'The credit decision. The committee reads a file that is complete and sourced, and spends its time on the judgement rather than on assembling the evidence for it.',
    record: 'Which documents were read, where each figure came from, which model drafted the summary, and what the analyst changed before it went in.',
    regs: [
      'DORA, operational resilience and ICT third-party risk',
      'EU AI Act, Annex III point 5(b), creditworthiness. High-risk obligations apply from 2 December 2027',
      'KI-MIG, the German AI market surveillance act in force since 29 July 2026: BaFin supervises AI used in regulated financial activity',
      'GDPR Article 22, decisions based solely on automated processing',
    ],
  },
  {
    n: '02',
    sector: 'Insurance',
    process: 'First assessment of a motor claim',
    tag: 'BaFin · Solvency II · GDPR',
    today: 'A handler reads the report, checks the policy for exclusions, sets a reserve and decides whether to instruct an assessor. The exclusions are in a PDF from 2021 that four people know how to read.',
    worker: 'Reads the report, pulls the policy, proposes a reserve and cites the clause it relied on. Instructs an assessor when the estimate is over the threshold.',
    human: 'Every rejection. A handler makes that call with the whole file already in front of them, which is where their experience is worth most.',
    record: 'The clause the reserve was based on, the estimate, the threshold that applied that day, and whether a person changed the number.',
    regs: [
      'Solvency II, system of governance and risk management',
      'KI-MIG, in force since 29 July 2026: BaFin supervises AI used in regulated financial activity, insurers included',
      'GDPR Article 22, decisions based solely on automated processing',
      'EU AI Act: motor claims are not Annex III high-risk. Point 5(c) covers life and health insurance only. The Article 50 transparency duties still apply',
    ],
  },
  {
    n: '03',
    sector: 'Healthcare',
    process: 'Reimbursement claim preparation',
    tag: 'GDPR Article 9 · NIS-2',
    today: 'A coder reads the discharge letter, assigns ICD-10 codes, checks them against the payer rules and submits. Rejected claims come back weeks later and get reworked by whoever is free.',
    worker: 'Drafts the coding from the letter, checks it against the payer rules, and holds anything the letter does not clearly support.',
    human: 'The diagnosis, always. The worker codes what a clinician wrote, so clinical time goes to patients rather than to payer rules.',
    record: 'Which letter produced which code, which payer rule applied, and what was held back for a human to look at.',
    regs: [
      'GDPR Article 9, special category health data',
      'NIS-2, transposed in Germany by the NIS2UmsuCG since 6 December 2025: health providers are essential entities under the BSIG',
      'Coding for reimbursement is an administrative task with no medical purpose, so the Medical Device Regulation does not apply to it',
      'EU AI Act, Article 50 transparency duties in force since 2 August 2026',
    ],
  },
  {
    n: '04',
    sector: 'Manufacturing',
    process: 'Supplier release',
    tag: 'NIS-2 · EU AI Act',
    today: 'A buyer checks the inspection report against the spec, looks up whether this supplier has had deviations before, and releases the batch or holds it. The deviation history lives in one person\'s spreadsheet.',
    worker: 'Matches the report to the spec, pulls the supplier history, and releases within the tolerance band. Holds anything outside it and says which measurement was out.',
    human: 'Releasing a batch that fell outside tolerance. Your quality lead makes that call with the measurements and the supplier\'s full history already assembled.',
    record: 'The measurements, the tolerance in force, the supplier history it read, and every release that went through outside the band.',
    regs: [
      'NIS-2, supply chain security under section 30 of the BSIG, in force in Germany since 6 December 2025',
      'EU AI Act: a release decision on its own is not high-risk. AI built into a regulated product falls under Annex I, with obligations from 2 August 2028',
      'GDPR, where supplier records name individuals',
    ],
  },
  {
    n: '05',
    sector: 'Public sector',
    process: 'Permit completeness check',
    tag: 'VwVfG · GDPR · OZG',
    today: 'A caseworker checks the application against the checklist, writes to the applicant for what is missing, and puts the file back in the queue. Most of the queue is waiting on one document.',
    worker: 'Runs the checklist, drafts the request for the missing documents, and puts the file in front of the caseworker complete.',
    human: 'The decision. The file reaches the official complete, so the discretion is the only part left to exercise.',
    record: 'What was checked, what was requested, when the applicant answered, and how long the file waited on each side.',
    regs: [
      'VwVfG, the German administrative procedure act, section 35a: a fully automated administrative act is only allowed where a statute permits it, and never where the authority has discretion or an assessment margin',
      'VwVfG section 40, the limits of administrative discretion',
      'GDPR Article 22, decisions based solely on automated processing',
      'OZG, the German online access act',
    ],
  },
  {
    n: '06',
    sector: 'Energy',
    process: 'Operational reporting',
    tag: 'Nis-2 · kritis',
    today: 'After an imbalance, an operator reconstructs what happened from four systems and writes the report. The reconstruction takes longer than the event did.',
    worker: 'Assembles the timeline from the recorded actions, drafts the report, and marks the intervals where the data does not agree with itself.',
    human: 'The dispatch itself. Kyde stays out of the control loop entirely. Your operators keep operating, and get the reconstruction handed to them instead of building it.',
    record: 'Every action in the window, in order, hash-chained, exported as a dated document the regulator recomputes without us.',
    regs: [
      'NIS-2, transposed in Germany by the NIS2UmsuCG, in force since 6 December 2025 with no transition period',
      'Section 30 of the BSIG, risk management measures, and the 24 hour reporting duty',
      'KRITIS, operator obligations',
      'EU AI Act: reporting sits outside the control loop, so it is not a safety component under Annex III point 2',
    ],
  },
];


---

<Base
  title="Use Cases, KYDE"
  description="Three nights nobody was watching: an agent that loops and burns tokens, an agent hijacked by an email into uploading customer data, a claims agent that suddenly approves everything. What Kyde sees in each, and what it means for insurers."
>
  <Navbar />

  <main class="kx">
    <!-- ══════════ HERO ══════════ -->
    <section data-surface="blush" class="surface-rose hero">
      <div class="wrap hero-inner">
        <p class="mono label">(Use cases)</p>
        <div class="brackets">
          <h1 class="display-2">Three nights nobody was watching.</h1>
        </div>
        <p class="sub hero-sub">An agent that loops. An agent that is hijacked. An agent that drifts. What happened, what the score saw, and what Kyde did.</p>
        <p class="mono note hero-note">*Illustrative scenes. Times and numbers are examples, not a customer's.</p>
      </div>
    </section>

    {scenes.map((c) => (
      <section class="surface-paper" id={c.id}>
        <div class="wrap sec">
          <div class="kicker"><span class="num">{c.n}</span><span class="mono">{c.tag}</span></div>
          <div class="scene">
            <div>
              <h2 class="h1">{c.title}</h2>
              <p class="sub">{c.sub}</p>
            </div>
            <div>
              <p class="mono label">(What happened)</p>
              <ol class="timeline">
                {c.timeline.map((e) => (
                  <li>
                    <span class="mono t">{e.t}</span>
                    <span class="body-l">{e.mark ? <span class="hl hl-neon">{e.line}</span> : e.line}</span>
                  </li>
                ))}
              </ol>
              <div class="kyde-did">
                <p class="mono">(What Kyde did)</p>
                <p class="body-l">{c.kyde}</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- ══════════ FOR INSURERS ══════════ -->
    <section class="surface-paper" id="insurers">
      <div class="wrap sec">
        <div class="kicker"><span class="num">04</span><span class="mono">For insurers</span></div>
        <h2 class="h1">A behavioral score you can <span class="hl hl-rose">underwrite</span><span class="nowrap">.</span></h2>
        <p class="sub">A telematics box in a car scores how it is driven, and careful drivers pay less. Kyde does the same for AI agents: a piece of software in the network sees every action and scores it.</p>
        <div class="cols2">
          <div class="col">
            <p class="mono label">(Your customers' agents)</p>
            <p class="body-l">See how your customers' agents behave, continuously. Price the risk before you write the policy, reward the ones that stay in their limits, and keep the full record when a claim comes in.</p>
          </div>
          <div class="col">
            <p class="mono label">(Your own agents)</p>
            <p class="body-l">Your agents handle claims day and night, with nobody watching. Kyde stops a drifting agent before it pays out a night of claims, or <span class="hl hl-neon">leaks your customer files</span><span class="nowrap">.</span></p>
          </div>
        </div>
        <a href="/ai-agent-insurance" class="link-u mono more">AI agent insurance, in depth</a>
      </div>
    </section>

    <!-- ══════════ WORKERS ══════════ -->
    <!-- The build service, kept in full for readers who come for it, folded
         so it does not compete with the three scenes. -->
    <section class="surface-paper" id="workers">
      <div class="wrap sec">
        <div class="kicker"><span class="num">05</span><span class="mono">Workers we build</span></div>
        <h2 class="h1">Six processes, and what stays with a person.</h2>
        <p class="sub">Kyde also builds AI workers from the processes a company runs, and runs them on the same layer.</p>
        <div class="workers">
          {workers.map((w) => (
            <details class="worker">
              <summary>
                <span class="mono muted">{w.sector}</span>
                <span class="w-title">{w.process}</span>
                <span class="mono muted w-tag">{w.tag}</span>
              </summary>
              <dl class="w-grid">
                <div><dt class="mono">(Today)</dt><dd>{w.today}</dd></div>
                <div><dt class="mono">(The worker)</dt><dd>{w.worker}</dd></div>
                <div><dt class="mono">(Stays with a person)</dt><dd>{w.human}</dd></div>
                <div><dt class="mono">(Kyde records)</dt><dd>{w.record}</dd></div>
              </dl>
              <ul class="regs mono">
                {w.regs.map((r) => <li>{r}</li>)}
              </ul>
            </details>
          ))}
        </div>
        <a href="/services" class="link-u mono more">How we build workers</a>
      </div>
    </section>

    <!-- ══════════ CLOSE ══════════ -->
    <section data-surface="blush" class="surface-rose">
      <div class="wrap sec">
        <div class="brackets">
          <h2 class="display-2">Bring the agent you are least sure about.</h2>
        </div>
        <div class="ctas">
          <button onclick="openModal()" class="btn btn-ink">Book a demo →</button>
          <a href="/#start" class="link-u mono">How to start</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .kx { --gap: clamp(24px, 3.3vw, 48px); --rule: 1px solid var(--color-ink); }
  .wrap { max-width: var(--kx-max); margin: 0 auto; padding-inline: var(--kx-pad); }
  .sec { padding-block: var(--kx-sec); }
  .surface-paper { background: var(--color-paper); color: var(--color-ink); }
  .surface-rose { background: var(--color-blush); color: var(--color-ink); }

  .display-2 { font-size: var(--kx-display-2); font-weight: 400; line-height: 0.92; letter-spacing: -0.05em; max-width: 16ch; }
  .h1 { font-size: var(--kx-h1); font-weight: 400; line-height: 0.98; letter-spacing: -0.045em; max-width: 20ch; }
  .sub { font-size: var(--kx-sub); line-height: 1.25; letter-spacing: -0.02em; color: var(--color-ink-2); margin-top: 1.1rem; max-width: 42ch; }
  .body-l { font-size: var(--kx-body-l); line-height: 1.32; letter-spacing: -0.012em; }
  .mono { font-family: var(--font-mono); font-weight: 500; letter-spacing: 0; }
  .label { font-size: 0.9375rem; margin-bottom: 0.9rem; }
  .muted { color: var(--color-ink-2); }
  .note { font-size: 0.875rem; line-height: 1.5; color: var(--color-ink-2); }
  .nowrap { white-space: nowrap; }

  /* marks: rosé in a headline on white, neon in running text on white */
  .hl { padding: 0 0.1em; box-decoration-break: clone; -webkit-box-decoration-break: clone; background-repeat: no-repeat; }
  .hl-rose { background-image: linear-gradient(transparent 20%, var(--color-blush) 20%, var(--color-blush) 96%, transparent 96%); }
  .hl-neon { background-image: linear-gradient(transparent 16%, var(--color-neon) 16%, var(--color-neon) 96%, transparent 96%); }

  .kicker { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(36px, 5vw, 72px); font-size: 0.9375rem; }
  .kicker .num { background: var(--color-card); color: #fff; font-family: var(--font-mono); font-weight: 500; padding: 2px 9px 3px; }
  .brackets { position: relative; padding: clamp(12px, 1.4vw, 20px) 0 clamp(12px, 1.4vw, 20px) var(--kx-bracket); }
  .brackets::before, .brackets::after { content: ''; position: absolute; left: 0; width: 16px; height: 16px; border-left: 1px solid currentColor; }
  .brackets::before { top: 0; border-top: 1px solid currentColor; }
  .brackets::after { bottom: 0; border-bottom: 1px solid currentColor; }

  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 2.5rem; }
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-weight: 500; font-size: 1rem; padding: 14px 22px 15px; }
  .btn-ink { background: var(--color-card); color: #fff; }
  .btn-ink:hover { background: #000; }
  .link-u { font-size: 1rem; border-bottom: 1px solid currentColor; padding-bottom: 2px; white-space: nowrap; }
  .link-u:hover { border-bottom-color: transparent; }
  .more { display: inline-block; margin-top: 48px; }

  .hero { padding-top: var(--kx-nav); }
  .hero-inner { padding-block: var(--kx-hero-top) var(--kx-hero-bottom); }
  .hero-inner > .label { margin-bottom: 1.1rem; }
  .hero-sub { color: var(--color-ink); margin-top: clamp(24px, 3vw, 40px); }
  .hero-note { margin-top: 20px; }

  .scene { display: grid; grid-template-columns: 1fr; gap: 48px var(--gap); }
  @media (min-width: 1024px) { .scene { grid-template-columns: 1fr 1fr; } }
  .timeline { list-style: none; padding: 0; margin: 0; border-top: var(--rule); }
  .timeline li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; align-items: baseline; border-bottom: var(--rule); padding: 14px 0 16px; }
  .t { font-size: 0.9375rem; }
  .kyde-did { background: var(--color-card); color: #fff; padding: 20px 22px 22px; margin-top: 16px; }
  .kyde-did .mono { color: var(--color-blush); font-size: 0.875rem; margin-bottom: 8px; }

  .cols2 { display: grid; grid-template-columns: 1fr; gap: 32px var(--gap); margin-top: clamp(48px, 6vw, 88px); }
  @media (min-width: 900px) { .cols2 { grid-template-columns: 1fr 1fr; } }
  .col { border-top: var(--rule); padding-top: 16px; }

  .workers { margin-top: clamp(48px, 6vw, 88px); border-top: var(--rule); }
  .worker { border-bottom: var(--rule); }
  .worker summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(140px, 220px) 1fr auto; gap: 8px 24px; align-items: baseline; padding: 18px 0 20px; }
  .worker summary::-webkit-details-marker { display: none; }
  .worker summary::after { content: '+'; font-family: var(--font-mono); font-size: 1.25rem; grid-column: 4; }
  .worker[open] summary::after { content: '−'; }
  .w-title { font-size: clamp(1.3rem, 1.8vw, 1.7rem); letter-spacing: -0.03em; line-height: 1.1; }
  .w-tag { font-size: 0.8125rem; }
  @media (max-width: 720px) { .worker summary { grid-template-columns: 1fr auto; } .worker summary > :first-child, .w-tag { grid-column: 1; } .w-title { grid-column: 1; } .worker summary::after { grid-column: 2; grid-row: 1; } }
  .w-grid { display: grid; grid-template-columns: 1fr; gap: 20px var(--gap); margin: 4px 0 20px; }
  @media (min-width: 900px) { .w-grid { grid-template-columns: 1fr 1fr; } }
  .w-grid dt { font-size: 0.875rem; margin-bottom: 6px; }
  .w-grid dd { margin: 0; font-size: var(--kx-body); line-height: 1.5; color: var(--color-ink-1); max-width: 60ch; }
  .regs { list-style: none; padding: 0 0 22px; margin: 0; font-size: 0.8125rem; line-height: 1.5; color: var(--color-ink-2); display: grid; gap: 6px; max-width: 90ch; }
</style>
