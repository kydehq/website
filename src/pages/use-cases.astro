---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Two tabs because there are two buyers, and one diagram above them because
// there is one product. The last field of every worker entry is "what KYDE
// records", which is the quiet argument that the workers run on the trust
// platform rather than beside it.
const workers = [
  {
    n: '01',
    sector: 'Banking & finance',
    process: 'Credit file pre-check',
    tag: 'DORA · BaFin · EU AI Act',
    today: 'An analyst opens the file, pulls three years of statements, reconciles the covenant list against the current facility and writes a one-page summary. Forty minutes when the file is clean. Half a day when it is not.',
    worker: 'Pulls the statements, reconciles the covenants, drafts the summary, and names the figures it could not source instead of estimating them.',
    human: 'The credit decision. It has legal effect on the applicant, so it stays with the committee. The worker prepares the file. It does not vote.',
    record: 'Which documents were read, where each figure came from, which model drafted the summary, and what the analyst changed before it went in.',
    regs: ['DORA, operational resilience and exit', 'EU AI Act, Annex III §5 creditworthiness', 'BaFin guidance on AI in lending', 'GDPR Art. 22, automated decisions'],
  },
  {
    n: '02',
    sector: 'Insurance',
    process: 'First assessment of a motor claim',
    tag: 'EU AI Act · Solvency II · GDPR',
    today: 'A handler reads the report, checks the policy for exclusions, sets a reserve and decides whether to instruct an assessor. The exclusions are in a PDF from 2021 that four people know how to read.',
    worker: 'Reads the report, pulls the policy, proposes a reserve and cites the clause it relied on. Instructs an assessor when the estimate is over the threshold.',
    human: 'Every rejection. A refusal is something a policyholder can contest, so it goes to a person with the whole file in front of them.',
    record: 'The clause the reserve was based on, the estimate, the threshold that applied that day, and whether a person changed the number.',
    regs: ['EU AI Act, Annex III §5 insurance pricing and risk', 'Solvency II, governance and risk management', 'GDPR Art. 22, automated decision-making', 'NIS-2, operational resilience'],
  },
  {
    n: '03',
    sector: 'Healthcare',
    process: 'Reimbursement claim preparation',
    tag: 'EU AI Act · GDPR Art. 9 · MDR',
    today: 'A coder reads the discharge letter, assigns ICD-10 codes, checks them against the payer rules and submits. Rejected claims come back weeks later and get reworked by whoever is free.',
    worker: 'Drafts the coding from the letter, checks it against the payer rules, and holds anything the letter does not clearly support.',
    human: 'The diagnosis, always. The worker codes what a clinician wrote. It never decides what is wrong with a patient.',
    record: 'Which letter produced which code, which payer rule applied, and what was held back for a human to look at.',
    regs: ['EU AI Act, Annex III §5 essential services access', 'GDPR Art. 9, special category health data', 'MDR / IVDR, where diagnosis is involved', 'NIS-2, critical health infrastructure'],
  },
  {
    n: '04',
    sector: 'Manufacturing',
    process: 'Supplier release',
    tag: 'EU AI Act · NIS-2 · CSDDD',
    today: 'A buyer checks the inspection report against the spec, looks up whether this supplier has had deviations before, and releases the batch or holds it. The deviation history lives in one person\'s spreadsheet.',
    worker: 'Matches the report to the spec, pulls the supplier history, and releases within the tolerance band. Holds anything outside it and says which measurement was out.',
    human: 'Releasing a batch that failed inspection. That is a quality decision with a name attached to it, and it stays with the person whose name that is.',
    record: 'The measurements, the tolerance in force, the supplier history it read, and every release that went through outside the band.',
    regs: ['EU AI Act, high-risk in safety components', 'NIS-2, supply chain security', 'CSDDD, supply chain due diligence', 'GDPR Art. 35, DPIA at scale'],
  },
  {
    n: '05',
    sector: 'Public sector',
    process: 'Permit completeness check',
    tag: 'EU AI Act · VwVfG · GDPR',
    today: 'A caseworker checks the application against the checklist, writes to the applicant for what is missing, and puts the file back in the queue. Most of the queue is waiting on one document.',
    worker: 'Runs the checklist, drafts the request for the missing documents, and puts the file in front of the caseworker complete.',
    human: 'The decision. Where German administrative law leaves a matter to an official\'s discretion, it is not automated. The worker prepares the file and stops.',
    record: 'What was checked, what was requested, when the applicant answered, and how long the file waited on each side.',
    regs: ['EU AI Act, Annex III §5 public benefits and services', 'VwVfG, discretionary administrative decisions', 'GDPR Art. 22, automated decision-making', 'OZG, digital administration'],
  },
  {
    n: '06',
    sector: 'Energy',
    process: 'Operational reporting',
    tag: 'NIS-2 · KRITIS · EU AI Act',
    today: 'After an imbalance, an operator reconstructs what happened from four systems and writes the report. The reconstruction takes longer than the event did.',
    worker: 'Assembles the timeline from the recorded actions, drafts the report, and marks the intervals where the data does not agree with itself.',
    human: 'The dispatch itself. Nothing in the control loop is automated by KYDE. The worker documents, it does not operate.',
    record: 'Every action in the window, in order, hash-chained, exported as a dated document the regulator recomputes without us.',
    regs: ['NIS-2, in force in Germany via NIS2UmsuCG', 'KRITIS, operator obligations', 'EU AI Act, high-risk in critical infrastructure', 'Cyber Resilience Act'],
  },
];

const trustCases = [
  {
    n: '01',
    audience: 'Compliance',
    name: 'AI audit trail',
    line: 'Continuous evidence for regulated AI systems.',
    body: 'Every action is hash-chained at the boundary, before it reaches a provider, and exported as a dated document your auditor recomputes offline. Your provider\'s log lives on their infrastructure and is signed with their keys. In a dispute that involves them, it is theirs.',
    href: '/trust#evidence',
  },
  {
    n: '02',
    audience: 'Insurance',
    name: 'AI telemetry',
    line: 'Observe how AI actually behaves in production.',
    body: 'Not what a system was designed to do, and not what a questionnaire says it does. Which actions it took, against which systems, how often, and how much of that was ever recorded in the first place.',
    href: '/trust#flight-recorder',
  },
  {
    n: '03',
    audience: 'AI governance',
    name: 'Continuous evaluation',
    line: 'Measure whether AI stays reliable as models, data and workflows change.',
    body: 'A recorded run is a set of real cases where the outcome is already known. Re-run them when a model ships and the drift is a number, not an anecdote that arrives through a support ticket six weeks later.',
    href: '/trust#replay',
  },
  {
    n: '04',
    audience: 'Incident & risk',
    name: 'Replay',
    line: 'Reconstruct and rerun what happened.',
    body: 'A model swapped under the same name does not announce itself. Replaying a recorded run against today\'s models and policies turns "something changed" into a difference you can point at.',
    href: '/trust#replay',
  },
  {
    n: '05',
    audience: 'Audit & advisory',
    name: 'Independent evidence',
    line: 'Evidence your client\'s own vendor cannot edit.',
    body: 'The record is captured outside the systems being examined and verified with the public key that travels with the export. You check it without us, and without the vendor whose behavior is in question.',
    href: '/trust#evidence',
  },
];

// The four people who have to agree before a worker runs, each with the
// question they actually ask in the room.
const roles = [
  { role: 'Operations', q: 'What do I get back?', text: 'The process you own, written down properly for the first time, and then the routine part of it running on its own. You keep the exceptions, which is the part you were doing the thinking on anyway.' },
  { role: 'CIO & CTO', q: 'What am I taking on?', text: 'One layer, on-premise or in your private cloud, in front of whatever models you already use. No agent framework to standardize on and no vendor to be locked into. The workers, the processes and the record are yours.' },
  { role: 'Compliance & legal', q: 'Can I evidence this?', text: 'Every action is hash-chained at the boundary and exported as a dated document your auditor recomputes offline. Where the EU AI Act assigns deployer obligations, they stay with you. This is the apparatus for meeting them.' },
  { role: 'Works council & data protection', q: 'What happens to the people?', text: 'Recording how someone works is subject to co-determination, so you are in the room on day one, before anything is recorded. Sessions are scoped and announced, personal data is removed locally before storage.' },
];
---

<Base
  title="Use Cases, KYDE"
  description="One trust platform, two ways to use it. Build workers for real business processes, or use KYDE Trust to govern, evaluate and prove AI you already run."
>
  <Navbar />

  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-44 md:pb-20 md:border-x md:border-line-0">

        <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-12">
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">What can KYDE do for you?</span>
        </div>

        <h1 class="hero-h1 max-w-4xl text-4xl text-ink-0 uppercase tracking-tight md:text-5xl lg:text-6xl">
          One trust platform.<br />Two ways to use it.
        </h1>
        <p class="mt-8 text-lg text-ink-1 leading-relaxed max-w-3xl">
          Build workers for your business, or use KYDE Trust to govern, evaluate and prove AI you already run. Workers are built on Trust. Trust also runs on its own, underneath AI somebody else built.
        </p>

      </div>
    </section>

    <!-- ══════════ TABS ══════════ -->
    <section class="border-t border-line-0">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">

        <div class="flex mb-12 border-b border-line-0 w-fit">
          <button id="btn-workers" onclick="showTab('workers')"
            class="px-6 py-2.5 text-xs font-mono uppercase tracking-widest transition-all bg-white text-cta-ink">Workers</button>
          <button id="btn-trust" onclick="showTab('trust')"
            class="px-6 py-2.5 text-xs font-mono uppercase tracking-widest transition-all text-ink-1 hover:text-ink-0">Trust</button>
        </div>

        <!-- ── WORKERS ────────────────────────────────────── -->
        <div id="tab-workers">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-tight text-ink-0 mb-4 max-w-3xl">
            Workers for real business processes.
          </h2>
          <p class="text-lg text-ink-1 leading-relaxed max-w-3xl mb-12">
            KYDE finds the work worth automating, builds the worker and runs it inside the KYDE Trust Platform. Six processes that people do today, in houses that are regulated, each with a step nobody wrote down.
          </p>

          <div class="border border-line-0 divide-y divide-line-0">
            {workers.map(({ n, sector, process, tag, today, worker, human, record, regs }) => (
              <article class="px-6 py-8 md:px-9 md:py-10">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-3 sm:gap-6 mb-8">
                  <span class="font-mono text-[11px] tracking-[0.1em] text-gold shrink-0">{n}</span>
                  <div class="flex-1">
                    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ember mb-2">{sector}</span>
                    <h3 class="text-xl md:text-2xl font-bold text-ink-0 leading-tight">{process}</h3>
                  </div>
                  <span class="shrink-0 inline-flex items-center border border-line-0 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.1em] text-ink-2 self-start">{tag}</span>
                </div>

                <dl class="grid md:grid-cols-2 gap-x-12 gap-y-6">
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-2 mb-2">How it works today</dt>
                    <dd class="text-sm text-ink-1 leading-relaxed">{today}</dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-live/80 mb-2">What the worker does</dt>
                    <dd class="text-sm text-ink-1 leading-relaxed">{worker}</dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-ember mb-2">What stays with a person</dt>
                    <dd class="text-sm text-ink-1 leading-relaxed">{human}</dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-2 mb-2">What KYDE records</dt>
                    <dd class="text-sm text-ink-1 leading-relaxed">{record}</dd>
                  </div>
                </dl>

                <ul class="mt-8 flex flex-wrap gap-2 border-t border-line-0 pt-6">
                  {regs.map((r) => (<li class="font-mono text-[10px] text-ink-2 border border-line-0 px-2.5 py-1">{r}</li>))}
                </ul>
              </article>
            ))}
          </div>

          <!-- who has to agree before any of this starts -->
          <div class="mt-16">
            <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-10">
              <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">Four people have to agree</span>
            </div>
            <div class="border border-line-0 md:grid md:grid-cols-2">
              {roles.map(({ role, q, text }, i) => (
                <div class:list={["p-6 md:p-8 border-line-0", i % 2 === 0 ? "md:border-r" : "", i === roles.length - 1 ? "" : "border-b", i >= roles.length - 2 ? "md:border-b-0" : ""]}>
                  <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ember mb-4">{role}</span>
                  <h3 class="text-xl font-bold tracking-tight text-ink-0 leading-tight mb-4">{q}</h3>
                  <p class="text-sm text-ink-1 leading-relaxed">{text}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-16 border border-line-0 bg-white/[0.02] px-6 py-8 md:px-9 md:py-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <p class="text-lg md:text-xl text-ink-0 leading-snug max-w-2xl">Every KYDE worker runs on the same Trust Platform.</p>
            <a href="/trust" class="shrink-0 inline-flex items-center gap-2 border border-line-1 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-1 hover:border-ink-0 hover:text-ink-0 transition-all w-fit">
              Explore KYDE Trust →
            </a>
          </div>
        </div>

        <!-- ── TRUST ──────────────────────────────────────── -->
        <div id="tab-trust" class="hidden">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-tight text-ink-0 mb-4 max-w-3xl">
            Trust use cases.
          </h2>
          <p class="text-lg text-ink-1 leading-relaxed max-w-3xl mb-12">
            Use the KYDE Trust Platform with KYDE workers, or independently with AI systems you already run. Nobody searches for this layer with the same words, so here are the five ways people arrive at it.
          </p>

          <div class="border border-line-0 divide-y divide-line-0">
            {trustCases.map(({ n, audience, name, line, body, href }) => (
              <a href={href} class="group block px-6 py-8 md:px-9 md:py-10 hover:bg-bg-1 transition-colors">
                <div class="grid md:grid-cols-[40px_minmax(0,240px)_1fr] gap-4 md:gap-8 items-start">
                  <span class="font-mono text-[11px] tracking-[0.1em] text-gold">{n}</span>
                  <div>
                    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ember mb-2">{audience}</span>
                    <h3 class="text-xl md:text-2xl font-bold text-ink-0 leading-tight">{name}</h3>
                  </div>
                  <div>
                    <p class="font-mono text-xs uppercase tracking-[0.1em] text-ink-1 mb-3">{line}</p>
                    <p class="text-sm text-ink-1 leading-relaxed">{body}</p>
                    <span class="mt-4 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-2 group-hover:text-ink-0 transition-colors">Read on →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <div class="mt-16 border border-line-0 bg-white/[0.02] px-6 py-8 md:px-9 md:py-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <p class="text-lg md:text-xl text-ink-0 leading-snug max-w-2xl">The same infrastructure that governs KYDE workers can sit underneath your existing AI systems.</p>
            <a href="/trust" class="shrink-0 inline-flex items-center gap-2 border border-line-1 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-1 hover:border-ink-0 hover:text-ink-0 transition-all w-fit">
              Explore KYDE Trust →
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-line-0 bg-bg-0">
      <div class="max-w-7xl mx-auto px-6 py-20 md:py-28 md:border-x md:border-line-0">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-ink-0 mb-6">
            Find out which of yours are on this list.
          </h2>
          <p class="text-lg text-ink-1 leading-relaxed mb-10 mx-auto max-w-2xl">
            Two weeks, one process area, one dated readout: what is buildable today, what is waiting and on what, and what stays with a person.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <button onclick="openModal()" class="inline-flex items-center gap-2 bg-white px-8 py-4 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all">
              Start your audit →
            </button>
            <a href="/audit" class="inline-flex items-center gap-2 border border-line-1 px-8 py-4 text-xs font-mono uppercase tracking-[0.1em] text-ink-1 hover:border-ink-0 hover:text-ink-0 transition-all">
              How it works →
            </a>
          </div>
        </div>
      </div>
    </section>

    <script is:inline>
      function showTab(tab) {
        const on  = 'px-6 py-2.5 text-xs font-mono uppercase tracking-widest transition-all bg-white text-cta-ink';
        const off = 'px-6 py-2.5 text-xs font-mono uppercase tracking-widest transition-all text-ink-1 hover:text-ink-0';
        const isWorkers = tab === 'workers';
        document.getElementById('tab-workers').classList.toggle('hidden', !isWorkers);
        document.getElementById('tab-trust').classList.toggle('hidden', isWorkers);
        document.getElementById('btn-workers').className = isWorkers ? on : off;
        document.getElementById('btn-trust').className   = isWorkers ? off : on;
        if (history.replaceState) history.replaceState(null, '', isWorkers ? location.pathname : '#trust');
      }
      // A link that lands on #trust should open that tab, not scroll past it.
      if (location.hash === '#trust') showTab('trust');
    </script>

  </main>

  <Footer />
</Base>
