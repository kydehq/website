---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const cases = [
  {
    n: '01',
    sector: 'Financial Services & Banking',
    tag: 'DORA · BaFin · EU AI Act',
    scenario: 'A trading agent autonomously rebalances customer portfolios and accesses the trading API via an internal MCP server.',
    pillars: [
      {
        label: 'PREVENT',
        q: 'What is blocked, and at what layer?',
        text: 'No shared trading_api_keys. The agent receives a cryptographic identity ("Wealth-Agent-Alpha") with a hard-coded firebreak: max 5% of portfolio value per day, no margin trading. Any API call that exceeds these limits is blocked by KYDE in under 100ms, before it reaches the exchange. Not rate-limited. Blocked.',
      },
      {
        label: 'PROVE',
        q: 'Signed 6D fingerprint. Hash-chained record.',
        text: 'Every autonomous trade is Ed25519-signed at the point of capture as a 6D fingerprint, who, what, when, where, why, how. The record is hash-chained and stored outside the agent runtime, so altering one entry breaks every entry after it. The ledger and the exports run today, signing each entry with your own keys is an Enterprise capability. BaFin receives a chain it can recompute offline, not an editable server log.',
      },
      {
        label: 'RATE',
        q: 'Behavioral Monitoring. Trust Score™. Coming soon.',
        text: 'The agent sells 1,000 Tesla shares. KYDE traces the complete causal chain: Reuters alert received at 14:23 → customer risk profile read → decision executed at 14:24. That chain is in the record today. The behavioral scoring that would turn it into a baseline per role, and flag an agent that deviates from established trading patterns or expands its request scope, is a reading we have not built yet.',
      },
    ],
    regs: ['DORA, Digital Operational Resilience Act', 'EU AI Act, Annex III §5 Credit Scoring', 'BaFin AI Guidance', 'GDPR Art. 35, DPIA'],
  },
  {
    n: '02',
    sector: 'Industry & Supply Chain',
    tag: 'EU AI Act · NIS-2 · GDPR',
    scenario: 'A procurement agent monitors global supply chains and autonomously reorders raw materials in the ERP system when shortages are detected.',
    pillars: [
      {
        label: 'PREVENT',
        q: 'What is blocked, and at what layer?',
        text: 'The order is not triggered by an anonymous service account, but by a verified agent identity scoped exclusively for the steel procurement department. Hard budget firebreak: max €50,000 per order. If the agent attempts a €500,000 order due to a hallucination, the proxy rejects it in under 100ms, before it reaches the supplier API.',
      },
      {
        label: 'PROVE',
        q: 'Signed 6D fingerprint. Hash-chained record.',
        text: 'The complete negotiation trail with the supplier API and the final order amount are hash-chained as a 6D fingerprint. Every financial commitment routed through the gateway is on the record, written at the point of capture. Signing each entry with your own keys is an Enterprise capability. The CFO has a chain a third party can recompute, not a filtered dashboard export.',
      },
      {
        label: 'RATE',
        q: 'Behavioral Monitoring. Trust Score™. Coming soon.',
        text: 'The agent suddenly orders triple the usual steel quantity. KYDE traces the full chain: internal email about a threatened port strike received → procurement database read → order placed. That chain is in the record today. The behavioral scoring that would turn it into a baseline per role, and flag an agent that deviates from normal order volumes or reaches suppliers outside its established scope, is a reading we have not built yet.',
      },
    ],
    regs: ['EU AI Act, High-Risk AI for automated procurement', 'NIS-2, Critical supply chain infrastructure', 'GDPR Art. 35, DPIA for large-scale processing'],
  },
  {
    n: '03',
    sector: 'Healthcare & Pharma',
    tag: 'EU AI Act · GDPR Art. 9 · HIPAA',
    scenario: 'A medical billing agent scans patient records, assigns ICD-10 diagnosis codes, and submits reimbursement claims to health insurers.',
    pillars: [
      {
        label: 'PREVENT',
        q: 'What is blocked, and at what layer?',
        text: 'The billing agent operates in strict isolation from the triage agent. Role "Billing.Read" is enforced at the proxy, the agent cannot write to clinical findings or delete medical data. Scope is not a policy document. It is a hard firebreak enforced by the Behavioral Firewall on every API call.',
      },
      {
        label: 'PROVE',
        q: 'Signed 6D fingerprint. Hash-chained record.',
        text: 'In GDPR Art. 9 and HIPAA environments, the agent layer has to hold up in an audit. The record shows hospitals exactly which agent processed which patient data, when, and on what basis. Every entry is written as a 6D fingerprint at the point of capture and hash-chained, so altering one entry breaks every entry after it. Signing each entry with your own keys is an Enterprise capability.',
      },
      {
        label: 'RATE',
        q: 'Behavioral Monitoring. Trust Score™. Coming soon.',
        text: 'The agent bills for an expensive specialist treatment. KYDE traces the full causal chain: Dr. Müller\'s clinical letter read at 08:00 → ICD-10 code assigned → claim submitted. That chain is in the record today. The behavioral scoring that would turn it into a baseline per role, and flag a billing agent reaching clinical records outside its scope or submitting atypical claim volumes, is a reading we have not built yet.',
      },
    ],
    regs: ['EU AI Act, Annex III §5 Health and Safety (highest risk class)', 'GDPR Art. 9, Special category health data', 'MDR / IVDR, AI-assisted diagnostics', 'NIS-2, Critical health infrastructure'],
  },
  {
    n: '04',
    sector: 'Insurance & Claims Automation',
    tag: 'EU AI Act · Solvency II · GDPR',
    scenario: 'A claims agent evaluates uploaded photos of water damage and scopes payouts to policyholders, autonomously.',
    pillars: [
      {
        label: 'PREVENT',
        q: 'What is blocked, and at what layer?',
        text: 'Clear role boundaries enforced at the proxy, not in policy documents. The claims agent does not share rights with the underwriting agent. Hard firebreak: maximum automatic approval = €2,000. Anything above is blocked by the proxy and routed to human escalation. A hard human-in-the-loop, not a configurable soft limit.',
      },
      {
        label: 'PROVE',
        q: 'Signed 6D fingerprint. Hash-chained record.',
        text: 'When a fraud ring floods automated agents with fake images, the record shows on what data basis, at what timestamp, the agent approved each payment. Every decision is written as a 6D fingerprint at the point of capture and hash-chained, so a reordered or edited entry is visible. Signing each entry with your own keys is an Enterprise capability. Evidence for internal fraud investigators, and for the agent layer of Solvency II audits and GDPR Art. 22 challenges.',
      },
      {
        label: 'RATE',
        q: 'Behavioral Monitoring. Trust Score™. Coming soon.',
        text: 'The agent rejects a water damage claim. KYDE traces the full chain: 2021 policy PDF read (elemental damage exclusion noted) → claim evaluated → rejected. That chain is in the record today. The behavioral scoring that would turn it into a baseline per role, and flag a claims agent approving at abnormal rates or drifting into patterns consistent with adversarial manipulation, is a reading we have not built yet.',
      },
    ],
    regs: ['EU AI Act, High-Risk AI Annex III §5 Insurance', 'Solvency II, Governance and risk management', 'GDPR Art. 22, Automated decision-making rights', 'NIS-2, Operational resilience'],
  },
  {
    n: '05',
    sector: 'Energy & Critical Infrastructure',
    tag: 'NIS-2 · KRITIS · EU AI Act',
    scenario: 'A grid-balancing agent manages electricity procurement and activates local large-scale batteries to compensate for network fluctuations.',
    pillars: [
      {
        label: 'PREVENT',
        q: 'What is blocked, and at what layer?',
        text: 'In NIS-2 / KRITIS environments there is no anonymity and no shared accounts. The dispatch agent has a cryptographic identity with assigned substation scope. It cannot accidentally activate the wrong grid segment, API access is limited at the proxy layer, enforced in under 100ms, before any command reaches operational technology.',
      },
      {
        label: 'PROVE',
        q: 'Signed 6D fingerprint. Hash-chained record.',
        text: 'When an outage occurs, the Bundesnetzagentur asks what issued the command and on what basis. A vendor cloud log is the vendor\'s own account of it. KYDE captures the action at the boundary, signs it as a 6D fingerprint, and chains it, so altering one entry breaks every entry after it. What regulators receive is a chain they can recompute offline. Signing each entry with your own keys is an Enterprise capability, hardware-backed key storage (TPM/HSM) is planned, not shipped.',
      },
      {
        label: 'RATE',
        q: 'Behavioral Monitoring. Trust Score™. Coming soon.',
        text: 'The agent ramps up a local power plant. KYDE traces the full chain: grid frequency drop of 0.1 Hz detected → local weather signal read (solar production declining) → battery activation triggered. That chain is in the record today. The behavioral scoring that would turn it into a baseline per role, and flag a dispatch agent issuing commands outside its assigned grid segments or deviating from established load balancing patterns, is a reading we have not built yet.',
      },
    ],
    regs: ['NIS-2, Network and Information Security (in force · DE: NIS2UmsuCG)', 'EU AI Act, High-Risk AI for critical infrastructure', 'KRITIS, German critical infrastructure protection', 'Cyber Resilience Act'],
  },
];
---

<Base
  title="Use Cases, KYDE"
  description="The behavioral system of record for autonomous work. One hash-chained record of every agent action routed through KYDE, for any organization running AI agents in production, in any sector."
>
  <Navbar />

  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-36 md:border-x md:border-line-0">

        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">01 · Use Cases</span></div>
        </div>

        <h1 class="hero-h1 max-w-5xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl">
          Every regulated industry deploys AI agents.<br />
          <span class="gradient-text">None of them are optional to govern.</span>
        </h1>

        <div class="mt-16 border-t border-line-1 pt-10 grid md:grid-cols-[200px_1fr] gap-8 items-start">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">Coverage</p>
            <p class="mt-2 font-mono text-xs text-ink-1">[ALL SECTORS]</p>
          </div>
          <div class="space-y-6">
            <p class="text-sm uppercase tracking-wide leading-relaxed text-ink-1">
              KYDE is the behavioral system of record for autonomous work. One record of every agent action routed through it, for any organization running AI agents in production, in any sector.
            </p>
            <p class="text-sm uppercase tracking-wide leading-relaxed text-ink-1">
              The <span class="font-mono text-ink-1">EU AI Act</span>, <span class="font-mono text-ink-1">NIS-2</span>, <span class="font-mono text-ink-1">DORA</span>, and <span class="font-mono text-ink-1">GDPR</span> don't care which LLM vendor you chose. They care whether you can show what your agents did, explain why, and demonstrate that the record has not been altered since it was written.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ USE CASES ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">

        <!-- Toggle -->
        <div class="flex gap-1 mb-10 border-b border-line-1 p-0 pb-0 w-fit gap-0">
          <button
            id="btn-industry"
            onclick="showTab('industry')"
            class="px-5 py-2 text-xs font-mono uppercase tracking-widest transition-all bg-white text-cta-ink"
          >By Industry</button>
          <button
            id="btn-role"
            onclick="showTab('role')"
            class="px-5 py-2 text-xs font-mono uppercase tracking-widest transition-all text-ink-1 hover:text-ink-0"
          >By Role</button>
        </div>

        <!-- BY INDUSTRY -->
        <div id="tab-industry" class="space-y-6">
        {cases.map(({ n, sector, tag, scenario, pillars, regs }) => (
          <div class="">

            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-start gap-4 px-6 sm:px-8 py-6">
              <span class="font-mono text-2xl font-bold text-ink-1 shrink-0">{n}</span>
              <div class="flex-1">
                <h2 class="text-xl font-bold text-ink-0 mb-2">{sector}</h2>
                <p class="text-sm text-ink-1 leading-relaxed">{scenario}</p>
              </div>
              <span class="shrink-0 inline-flex items-center border border-line-0 bg-transparent px-3 py-1 text-xs font-mono text-ink-1 self-start">
                {tag}
              </span>
            </div>

            <!-- 3 Guarantees -->
            <div class="divide-y divide-line-0">
              {pillars.map(({ label, q, text }) => (
                <div class="grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-3 sm:gap-6 px-6 sm:px-8 py-5">
                  <div class="shrink-0">
                    <span class={`inline-block font-mono text-[10px] font-bold uppercase tracking-widest mb-1 ${label === 'PREVENT' ? 'text-ember' : label === 'RATE' ? 'text-live' : 'text-ink-0/70'}`}>{label}</span>
                    {label === 'OBSERVE'
                      ? <p class="font-mono text-xs mt-1 leading-relaxed"><span class="font-semibold text-ink-0">{q}</span></p>
                      : <p class="font-mono text-xs text-ink-1 mt-1 leading-relaxed">{q}</p>
                    }
                  </div>
                  <p class="text-sm leading-relaxed text-ink-1">{text}</p>
                </div>
              ))}
            </div>

            <!-- Regs -->
            <div class="px-6 sm:px-8 py-5 flex flex-wrap gap-2">
              {regs.map((r: string) => (
                <span class="border border-line-0 px-3 py-1 text-xs font-mono text-ink-1">{r}</span>
              ))}
            </div>

          </div>
        ))}
        </div>

        <!-- BY ROLE -->
        <div id="tab-role" class="hidden grid gap-6 md:grid-cols-2">
          {[
            {
              role: "CISO",
              label: "Chief Information Security Officer",
              quote: "Your vendor's log isn't an independent record.",
              bullets: [
                "A tamper-evident record signed by Anthropic's keys, stored on Anthropic's infrastructure, is a vendor report. A compromised host can rewrite it silently. KYDE's records are hash-chained at the point of capture, on your own infrastructure. Alter any entry, every subsequent link breaks. Signing each entry with your own keys is an Enterprise capability.",
                "Your audit trail is yours. Not locked to a provider console, not dependent on vendor uptime, not subject to vendor retention policies.",
                "Evidence you can hand to a regulator, a lawyer, or your own InfoSec review, written before an incident, not assembled after one.",
              ],
            },
            {
              role: "CTO",
              label: "Chief Technology Officer",
              quote: "Your governance layer shouldn't depend on your LLM choice.",
              bullets: [
                "One environment variable, or an egress rule that makes the gateway the only route to a provider, which covers agents nobody registered. No SDK dependency. No code changes. Minutes to deploy, and your agents see no difference.",
                "Models change monthly. Add a local model for sensitive data, route cheap tasks to a cheaper provider, switch frontier models entirely. Governance follows automatically. No re-integration required.",
                "No per-agent installation. No framework lock-in. Architecture that outlasts your current LLM stack, by design.",
              ],
            },
            {
              role: "Compliance & Legal",
              label: "GC · DPO · CCO",
              quote: "One framework won't be enough. One evidence trail has to cover all of them.",
              bullets: [
                "EU AI Act High-Risk logging, NIS-2, DORA, GDPR Art. 35, regulators don't coordinate their requirements around your roadmap. One hash-chained trail, built to serve as evidence for the agent layer of all of those duties from day one.",
                "Verifiable audit exports on demand, unfiltered, machine-generated, hash-chained. Not a screenshot. Not a filtered vendor report.",
                "Every challenged decision can be traced through the record: what the agent was asked, what it decided, which sources it called. The record exists before the challenge arrives.",
              ],
            },
            {
              role: "CFO & Ops",
              label: "Chief Financial Officer · Operations",
              quote: "An agent with no budget ceiling is a liability with no ceiling.",
              bullets: [
                "Hard token and cost limits per agent, per role, per day. Enforced before the call is made, not flagged after the bill arrives.",
                "Governance shouldn't force you onto expensive frontier models for every task. Route classification and low-stakes workloads to cheap local models. Reserve frontier capacity for decisions that justify it.",
                "Priority assignment means your production agents never queue behind an intern's research bot. Fleet efficiency is a governance decision.",
              ],
            },
          ].map(({ role, label, quote, bullets }) => (
            <div class="p-8">
              <div class="mb-6 pb-6 border-b border-line-1">
                <h2 class="font-mono text-2xl font-bold text-ink-0">{role}</h2>
                <p class="mt-1 text-xs text-ink-1 uppercase tracking-widest">{label}</p>
              </div>
              <p class="mb-6 font-mono text-sm text-ink-1 border-l-2 border-line-0 pl-4 leading-relaxed">"{quote}"</p>
              <ul class="space-y-4">
                {bullets.map((b: string) => (
                  <li class="flex gap-4 text-sm leading-relaxed text-ink-1">
                    <span class="font-mono text-ink-1 shrink-0 mt-0.5">→</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

      </div>
    </section>

    <script is:inline>
      function showTab(tab) {
        const industry = document.getElementById('tab-industry');
        const role = document.getElementById('tab-role');
        const btnIndustry = document.getElementById('btn-industry');
        const btnRole = document.getElementById('btn-role');
        if (tab === 'industry') {
          industry?.classList.remove('hidden');
          role?.classList.add('hidden');
          btnIndustry?.classList.add('bg-white', 'text-cta-ink');
          btnIndustry?.classList.remove('text-ink-1');
          btnRole?.classList.remove('bg-white', 'text-cta-ink');
          btnRole?.classList.add('text-ink-1');
        } else {
          role?.classList.remove('hidden');
          industry?.classList.add('hidden');
          btnRole?.classList.add('bg-white', 'text-cta-ink');
          btnRole?.classList.remove('text-ink-1');
          btnIndustry?.classList.remove('bg-white', 'text-cta-ink');
          btnIndustry?.classList.add('text-ink-1');
        }
      }
    </script>

    <!-- ══════════ CLOSING CTA ══════════ -->
    <section class="">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
        <div class="border-b border-line-1 p-12 md:p-20">
          <div class="max-w-3xl">
            <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Get started</p>
            <div class="mb-8 h-px bg-bg-1/40"></div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-ink-0 mb-4">
              Your industry. Your agents.<br />Your critical infrastructure.
            </h2>
            <p class="text-lg text-ink-1 mb-10">
              One record, across every sector, and across every provider and framework you route through KYDE. Governance isn't the brake. It's what lets you accelerate.
            </p>
            <button
              onclick="openModal()"
              class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all"
            >
              Talk to Us →
            </button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
