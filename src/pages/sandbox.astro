---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="KYDE Gateway Sandbox — Deploy in Minutes, See Your Agents for the First Time"
  description="Deploy the KYDE Gateway Sandbox via Docker Compose and one environment variable. No license required. See your agent traffic on a dashboard within minutes."
>
  <Navbar />
  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative bg-[#0C0C0C] overflow-hidden pt-32 pb-20">
      <div class="absolute inset-0 bg-grid opacity-[0.06] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-8">
            <span class="font-mono text-[10px] uppercase tracking-widest text-white/30 border border-white/15 px-3 py-1">Free</span>
            <span class="font-mono text-[10px] text-white/20">·</span>
            <span class="font-mono text-[10px] uppercase tracking-widest text-[#3DDC84]/80 border border-[#3DDC84]/30 px-3 py-1">Kyde Gateway Sandbox</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.05] mb-6">
            Your agents are acting.<br />See what they're doing.
          </h1>
          <p class="text-lg text-white/50 leading-relaxed max-w-xl mb-10">
            Deploy the KYDE Gateway via Docker Compose and one environment variable. Within minutes, every agent call in your environment appears on a dashboard — signed, attributed, and observable.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="#deploy"
              class="inline-flex items-center gap-2 bg-white text-[#0A0A0A] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#E5E5E5] transition-all"
            >
              Deploy now →
            </a>
            <button
              onclick="openModal()"
              class="inline-flex items-center gap-2 border border-white/25 text-white/60 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-white/60 hover:text-white/90 transition-all"
            >
              Talk to Us →
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ WHAT YOU'LL SEE ══════════ -->
    <section class="border-t border-[#1F1F1F] py-16 md:py-20 bg-[#0C0C0C]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-[#6B6B6B] mb-6">What you'll see</p>
            <h2 class="text-3xl md:text-4xl font-bold text-[#F2F2F2] leading-tight mb-6">
              The dashboard shows everything your agents are doing — in real time.
            </h2>
            <p class="text-base text-[#A8A8A8] leading-relaxed mb-4">
              Most organizations deploying AI agents have no consolidated view of what those agents actually do. Which endpoints they call. How often. With what data.
            </p>
            <p class="text-base text-[#A8A8A8] leading-relaxed">
              The Sandbox makes that visible. Every call intercepted by the Gateway appears in the dashboard — attributed to an agent, signed, and timestamped.
            </p>
          </div>
          <div class="space-y-4">
            {[
              { label: "Agent activity feed",    desc: "Every call, tool use and API interaction, in real time."              },
              { label: "Agent identity",         desc: "Which agent or service account performed each action."                },
              { label: "Provider breakdown",     desc: "Calls across OpenAI, Anthropic, Gemini, and local models in one view." },
              { label: "Coverage indicator",     desc: "Share of observable agent traffic passing through the Gateway."       },
              { label: "DLP alerts",             desc: "Post-hoc detection when sensitive data patterns appear in responses." },
              { label: "Signed ledger",          desc: "Ed25519-signed, append-only record of every intercepted event."      },
            ].map(({ label, desc }) => (
              <div class="flex items-start gap-4 border border-[#1F1F1F] bg-[#141414] p-4">
                <svg class="h-4 w-4 shrink-0 text-[#3DDC84] mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                <div>
                  <p class="text-sm font-semibold text-[#F2F2F2] mb-0.5">{label}</p>
                  <p class="text-xs text-[#A8A8A8]">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ DEPLOY ══════════ -->
    <section id="deploy" class="border-t border-[#1F1F1F] py-16 md:py-24 bg-[#050505]">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">01 · Deploy</span></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-16">
          {[
            {
              step: "01",
              title: "Start the Gateway",
              desc:  "Run the Docker Compose stack. The Gateway, ledger, and dashboard start together.",
            },
            {
              step: "02",
              title: "Set one environment variable",
              desc:  "Point any agent or LLM client at the Gateway. No code changes in your agents.",
            },
            {
              step: "03",
              title: "Open the dashboard",
              desc:  "Agent calls appear immediately. Coverage, identity, and signed events — visible from the first request.",
            },
          ].map(({ step, title, desc }) => (
            <div class="border border-[#1F1F1F] bg-[#0C0C0C] p-6 md:p-8">
              <span class="font-mono text-xs text-[#FFB84D] bg-[#FFB84D]/8 px-2 py-0.5 mb-4 inline-block uppercase tracking-widest">{step}</span>
              <p class="text-lg font-bold text-[#F2F2F2] mb-2">{title}</p>
              <p class="text-sm text-[#A8A8A8] leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>

        <!-- Terminal -->
        <div class="border border-[#1F1F1F] bg-[#0C0C0C] max-w-3xl">
          <div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-[#FF5C5C]/40"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#FFB84D]/40"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#3DDC84]/40"></span>
            <span class="ml-2 font-mono text-[10px] text-white/20">terminal</span>
          </div>
          <div class="p-6 font-mono text-sm leading-loose">
            <p class="text-white/25 text-xs mb-3"># Step 1 — start the Gateway</p>
            <p class="text-white/40"><span class="text-[#3DDC84]">$</span> docker compose up</p>
            <p class="text-[#3DDC84]">&#10003; Gateway started · Dashboard at http://localhost:4000</p>
            <p class="text-[#3DDC84]">&#10003; Ledger initialized</p>

            <p class="text-white/25 text-xs mt-5 mb-3"># Step 2 — point your agent at the Gateway</p>
            <p class="text-white/40"><span class="text-[#3DDC84]">$</span> export OPENAI_BASE_URL=http://localhost:4001/v1</p>
            <p class="text-white/25 text-xs mt-1"># Works with Anthropic, Gemini, and local models too</p>

            <p class="text-white/25 text-xs mt-5 mb-3"># Step 3 — run your agent as usual</p>
            <p class="text-white/40"><span class="text-[#3DDC84]">$</span> python run_agent.py</p>
            <p class="text-[#3DDC84] mt-1">&#10003; 1 new event · agent:default · crm.query · signed</p>
            <p class="text-[#3DDC84]">&#10003; 2 new events · agent:default · slack.send · signed</p>
            <p class="text-white/25 text-xs mt-1"># Open http://localhost:4000 to see the dashboard</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-4 text-xs text-[#6B6B6B]">
          <p class="font-mono">Requires: Docker · Docker Compose · An agent that calls an LLM API</p>
        </div>

      </div>
    </section>

    <!-- ══════════ SANDBOX VS ENTERPRISE ══════════ -->
    <section class="border-t border-[#1F1F1F] py-16 md:py-20 bg-[#0C0C0C]">
      <div class="max-w-7xl mx-auto px-6">

        <p class="font-mono text-xs uppercase tracking-widest text-[#6B6B6B] mb-10">Sandbox vs. Enterprise</p>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="border border-[#1F1F1F] p-6 md:p-8">
            <div class="flex items-center justify-between mb-6">
              <p class="font-mono text-xs uppercase tracking-widest text-[#F2F2F2]">Kyde Gateway Sandbox</p>
              <span class="font-mono text-[10px] text-[#3DDC84] bg-[#3DDC84]/8 px-2 py-0.5 uppercase tracking-widest">Free</span>
            </div>
            <ul class="space-y-3">
              {[
                "Dashboard — agent activity in real time",
                "Ed25519-signed ledger",
                "Coverage indicator",
                "DLP alerts (post-hoc, detect only)",
                "Compliance PDF exports",
                "All LLM providers",
                "Self-hosted — prompts and payloads stay in your network",
                "No SLA · No support commitment",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-[#A8A8A8]">
                  <svg class="h-4 w-4 shrink-0 text-[#3DDC84] mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="border border-[#1F1F1F] bg-[#141414] p-6 md:p-8">
            <div class="flex items-center justify-between mb-6">
              <p class="font-mono text-xs uppercase tracking-widest text-[#F2F2F2]">Kyde Gateway Enterprise</p>
              <span class="font-mono text-[10px] text-[#F2F2F2]/70 bg-[#F2F2F2]/8 px-2 py-0.5 uppercase tracking-widest">Paid</span>
            </div>
            <p class="text-sm text-[#A8A8A8] leading-relaxed mb-6">Everything in Sandbox, plus:</p>
            <ul class="space-y-3">
              {[
                "Inline enforcement — block out-of-policy actions before execution",
                "Agent identity and role scoping (deny-by-default)",
                "MCP per-tool policy",
                "RBAC across agents and teams",
                "Trust Score™ with Coverage Report",
                "Managed signing infrastructure and key management",
                "SLA and support",
                "Air-gapped deployment option",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-[#A8A8A8]">
                  <svg class="h-4 w-4 shrink-0 text-[#F2F2F2]/50 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <button
                onclick="openModal()"
                class="inline-flex items-center gap-2 bg-white text-[#0A0A0A] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#E5E5E5] transition-all"
              >
                Talk to Us →
              </button>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ FAQ ══════════ -->
    <section class="border-t border-[#1F1F1F] py-16 md:py-20 bg-[#050505]">
      <div class="max-w-4xl mx-auto px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-[#6B6B6B] mb-10">Common questions</p>
        <div class="space-y-px">
          {[
            {
              q: "Does the Sandbox send any data to KYDE?",
              a: "Prompts, responses and payload content remain on your infrastructure and are stored in your local ledger. The Sandbox transmits anonymized operational metadata — event types, volumes, model and endpoint identifiers — which contributes to cross-customer benchmarks and improves detection quality. A fully air-gapped deployment without telemetry is available in the Enterprise tier.",
            },
            {
              q: "Does it work with any LLM provider?",
              a: "Yes. The Gateway intercepts standard OpenAI-compatible API calls, which covers OpenAI, Anthropic, Gemini, Azure OpenAI, Mistral, and local models via Ollama, vLLM, or LMStudio. MCP-routed calls are also supported.",
            },
            {
              q: "Do my agents need to be modified?",
              a: "No. Set one environment variable pointing the agent's base URL to the Gateway. The agent continues to operate as before — the Gateway intercepts transparently.",
            },
            {
              q: "Is the Sandbox the same Gateway as Enterprise?",
              a: "The underlying Gateway is the same. The Sandbox runs the observe layer only — it records and signs, but does not block. Enforcement (blocking out-of-policy actions) requires the Enterprise tier.",
            },
            {
              q: "What happens when the Sandbox is not enough?",
              a: "Contact us. We'll discuss your use case and can provision an Enterprise trial with enforcement enabled.",
            },
          ].map(({ q, a }) => (
            <details class="group border border-[#1F1F1F] bg-[#0C0C0C]">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                <span class="text-sm font-semibold text-[#F2F2F2] pr-4">{q}</span>
                <svg class="h-4 w-4 shrink-0 text-[#6B6B6B] group-open:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-sm text-[#A8A8A8] leading-relaxed">{a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-[#1F1F1F] py-16 md:py-20 bg-[#0C0C0C]">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-[#F2F2F2] mb-4">Questions? Ready for Enterprise?</h2>
        <p class="text-base text-[#A8A8A8] mb-10 max-w-xl mx-auto">
          Whether something didn't work, you need enforcement, or you want to discuss a production deployment — we're one message away.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <button
            onclick="openModal()"
            class="inline-flex items-center gap-2 bg-white text-[#0A0A0A] px-8 py-4 text-xs font-mono uppercase tracking-[0.12em] hover:bg-[#E5E5E5] transition-all"
          >
            Talk to Us →
          </button>
          <a
            href="mailto:hello@kyde.com"
            class="inline-flex items-center gap-2 border border-[#2E2E2E] text-[#F2F2F2] px-8 py-4 text-xs font-mono uppercase tracking-[0.12em] hover:border-[#2E2E2E] transition-all"
          >
            hello@kyde.com →
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
