---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Content as ScorePrivacy } from '../legal/score-privacy.md';

const sections: { id: string; n: string; title: string; body?: string; md?: boolean }[] = [
  {
    id: 'imprint',
    n: '0.',
    title: 'Imprint',
    body: 'This website is operated by Jürgen Eckel and Jörg Radehaus, Klenzestraße 57, 80469 Munich, Germany. For legal enquiries: hello@kyde.com.',
  },
  {
    id: 'server-logs',
    n: '1.',
    title: 'Server Log Files',
    body: 'When you visit this website, the hosting provider automatically collects technical access data: IP address (anonymised where possible), date and time of access, browser type and version, operating system, requested file, and referrer URL. This data is used solely for technical monitoring, security, and error analysis. No profiling or merging with other data takes place. Legal basis: Art. 6(1)(f) GDPR.',
  },
  {
    id: 'contact',
    n: '2.',
    title: 'Contact',
    body: 'If you contact us by email, the data you provide is used solely to process your enquiry. Legal basis: Art. 6(1)(b) GDPR. Enquiries are retained for 12 months and then deleted, unless statutory retention obligations apply.',
  },
  {
    id: 'cookies',
    n: '3.',
    title: 'Cookies',
    body: 'This website sets no cookies for analytics, advertising or tracking. Reach measurement (see Analytics) works without cookies.',
  },
  {
    id: 'analytics',
    n: '4.',
    title: 'Analytics',
    body: 'We use Umami Cloud (Umami Software, Inc., 1362 42nd Ave., San Francisco, CA 94122, USA) to see which pages are read and how visitors find us. Data is stored in the EU data region. Umami sets no cookies and stores nothing in your browser. It records the page, referrer, campaign parameters (UTM), browser, operating system, device type, country, and clicks on individual buttons such as Join the waitlist or Get a key. Your IP address is not stored permanently, and no profile across websites is built. Legal basis: Art. 6(1)(f) GDPR, our legitimate interest in improving the site from anonymous usage statistics. A data processing agreement pursuant to Art. 28 GDPR is in place; transfers to the USA rely on the EU Standard Contractual Clauses.',
  },
  {
    id: 'hosting',
    n: '5.',
    title: 'Hosting',
    body: 'This website is hosted via GitHub Pages (GitHub Inc., USA). Data transfer to the USA is based on the EU–US Data Privacy Framework. Where the hosting provider processes personal data (e.g. server log files), this is governed by a data processing agreement pursuant to Art. 28 GDPR.',
  },
  {
    id: 'score',
    n: '6.',
    title: 'score.kyde.com (Kyde Score)',
    // Text verbatim from the company repo: 01_product/service-terms/privacy-notice-score-draft.md
    md: true,
  },
  {
    id: 'rights',
    n: '7.',
    title: 'Your Rights',
    body: 'Under the GDPR you have the right to access, rectification, erasure, restriction of processing, data portability, and objection. You also have the right to lodge a complaint with a supervisory authority.',
  },
  {
    id: 'changes',
    n: '8.',
    title: 'Changes',
    body: 'This privacy notice may be updated to reflect legal or technical changes.',
  },
];
---

<Base
  title="Legal & Privacy, KYDE"
  description="Imprint and privacy notice for Kyde."
>
  <Navbar />

  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-24 md:border-x md:border-line-0">
        <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-ink-0/60">Legal & Privacy</p>
        <h1 class="hero-h1 max-w-2xl text-5xl leading-tight uppercase tracking-tight text-ink-0 md:text-6xl">
          Imprint & Privacy Notice
        </h1>
      </div>
    </section>

    <!-- ══════════ SECTIONS ══════════ -->
    <section class="">
      <div class="max-w-7xl mx-auto px-6 py-8 pb-32 md:border-x md:border-line-0">
        <div class="max-w-2xl space-y-4">
          {sections.map(({ id, n, title, body, md }) => (
            <div id={id} class="border border-line-0 bg-bg-1 px-8 py-7">
              <div class="flex items-baseline gap-3 mb-3">
                <span class="font-mono text-sm text-ink-1 shrink-0">{n}</span>
                <h2 class="text-base font-bold text-ink-0">{title}</h2>
              </div>
              {md ? (
                <div class="legal-md text-sm leading-relaxed text-ink-1 pl-6"><ScorePrivacy /></div>
              ) : (
                <p class="text-sm leading-relaxed text-ink-1 pl-6">{body}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>

<style is:global>
  .legal-md p { margin: 0 0 0.75rem; }
  .legal-md p:last-child { margin-bottom: 0; }
  .legal-md ul { margin: 0 0 0.75rem; padding-left: 1.25rem; list-style: disc; }
  .legal-md li { margin: 0.25rem 0; }
  .legal-md strong { color: var(--color-ink-0); font-weight: 600; }
  .legal-md a { color: var(--color-ink-0); text-decoration: underline; text-underline-offset: 2px; }
</style>
