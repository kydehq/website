              </div>
            </div>
            <div class="border border-line-0 bg-bg-1 p-6">
              <p class="font-mono text-xs uppercase tracking-widest text-ink-1 mb-3">English</p>
              <a href="/ai-agent-insurance/" class="text-xs text-ink-1 underline underline-offset-4" hreflang="en">Read this article in English →</a>
            </div>
          </aside>

        </div>
      </div>
    </section>

