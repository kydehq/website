---
import Base from "../../../layouts/Base.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import Stand from "../../../components/Stand.astro";
import LegalNotice from "../../../components/LegalNotice.astro";

// Deutsche Fassung des englischen Artikels /behavioral-drift. Anders als bei den
// beiden anderen Wissens-Artikeln ist das hier tatsächlich dieselbe Argumentation
// in zwei Sprachen und nicht zwei eigenständige Texte. Deshalb steht das Paar in
// LOCALE_PAIRS mit gesetztem Hash: läuft die englische Seite weiter, muss diese
// mit.
//
// Der Text nennt bewusst wenige Arbeiten beim Namen, trägt aber weiterhin
// konkrete Zahlen. Die Belege bleiben deshalb auf der Seite: ein Text, der von
// Betreibern nachprüfbare Evidenz verlangt und für die eigenen Zahlen um
// Vertrauen bittet, würde die Gegenseite vertreten. Jede arXiv-Nummer wurde im
// September 2026 aufgelöst und jeder Titel geprüft.

const stand = "2026-09-05";
const pageTitle = "Behavioral Drift bei AI Agents";

const formen = [
  { name: "Goal Drift",           was: "Der Agent entfernt sich während einer Aufgabe vom ursprünglichen Ziel." },
  { name: "Context Decay",        was: "Die Leistung nimmt mit zunehmender Länge der Interaktion ab." },
  { name: "Reward Hacking",       was: "Der Agent erfüllt die Messgröße, aber nicht das eigentlich gemeinte Ziel." },
  { name: "Deceptive Behavior",   was: "Das Verhalten unterscheidet sich zwischen Evaluation und tatsächlichem Einsatz." },
  { name: "Multi-Agent Drift",    was: "Eine Abweichung wird von einem Agent an den nächsten weitergegeben." },
  { name: "Persistent Drift",     was: "Memory oder Selbstveränderung sorgen dafür, dass eine Abweichung über mehrere Runs bestehen bleibt." },
  { name: "Model Version Drift",  was: "Ein Modell-Update verändert das Verhalten eines bestehenden Systems." },
];

const ablesbar = [
  {
    stufe: "Einfach",
    ton: "live",
    lead: "Lässt sich relativ einfach aus normalen Agent-Aktivitäten ableiten.",
    punkte: [
      "Wiederholte Arbeit",
      "Doppelte Einreichungen",
      "Falsche oder verfrühte Completion",
      "Fehlender Fortschritt",
      "Veränderungen nach einem Model-Version-Update",
      "Veränderungen über die Länge eines Runs",
    ],
  },
  {
    stufe: "Mittel",
    ton: "warn",
    lead: "Braucht Kontext, den das Protokoll allein nicht trägt.",
    punkte: [
      "Goal Drift benötigt eine definierte Zielsetzung zu Beginn und eine Bewertung des Ergebnisses am Ende",
      "Multi-Agent Drift benötigt eine Zuordnung der einzelnen Calls zu derselben Aufgabe oder demselben Case",
    ],
  },
  {
    stufe: "Aufwendig",
    ton: "ember",
    lead: "Braucht Zugriff auf etwas außerhalb der Aufrufaufzeichnung.",
    punkte: [
      "Persistent Drift erfordert Zugriff auf das relevante Memory-System",
      "Reward Hacking erfordert Wissen über das tatsächlich gewünschte Ergebnis, also Ground Truth",
    ],
  },
];

const offeneFragen = [
  {
    n: "01",
    h: "Es gibt noch kein einheitliches Maß für Behavioral Drift.",
    t: "Die verschiedenen Studien verwenden unterschiedliche Definitionen, Aufgaben und Metriken. Ihre Zahlen lassen sich deshalb nicht einfach miteinander vergleichen.",
  },
  {
    n: "02",
    h: "Der größte Teil der Evidenz stammt aus Experimenten.",
    t: "Es gibt viele kontrollierte Studien, aber vergleichsweise wenig Langzeitdaten aus realen Produktionssystemen.",
  },
  {
    n: "03",
    h: "Drift wird meistens auf Ebene eines einzelnen Agents gemessen.",
    t: "Die Forschung zu Multi-Agent-Systemen deutet darauf hin, dass auch die Übergänge zwischen Agents entscheidend sein können. Ein allgemein akzeptierter Benchmark dafür fehlt bislang.",
  },
  {
    n: "04",
    h: "Und es gibt eine Evidenzlücke.",
    t: "Viele Studien messen Verhalten mit direktem Zugriff auf das Modell und seine Umgebung. In der Produktion haben Betreiber häufig etwas anderes: die Aufzeichnungen darüber, was das System tatsächlich getan hat.",
  },
];

const quellen = [
  { autoren: "Menon, Saebo, Crosse, Gibson, Jang, Cruz", titel: "Inherited Goal Drift: Contextual Pressure Can Undermine Agentic Goals", id: "2603.03258", datum: "März 2026" },
  { autoren: "Arike, Donoway, Bartsch, Hobbhahn", titel: "Technical Report: Evaluating Goal Drift in Language Model Agents", id: "2505.02709", datum: "Mai 2025" },
  { autoren: "Cai, Zhu, Gao, Tang, Qin", titel: "Push Your Agent: Measuring and Enforcing Quantitative Goal Persistence in Long-Horizon LLM Agents", id: "2605.23574", datum: "Mai 2026" },
  { autoren: "Laban et al.", titel: "LLMs Get Lost In Multi-Turn Conversation", id: "2505.06120", datum: "Mai 2025" },
  { autoren: "Xia, Wang, Huang, Liu", titel: "Diagnosing and Mitigating Context Rot in Long-horizon Search", id: "2606.29718", datum: "Juni 2026" },
  { autoren: "Thaman", titel: "Reward Hacking Benchmark: Measuring Exploits in LLM Agents with Tool Use", id: "2605.02964", datum: "Mai 2026" },
  { autoren: "Çağatan, Zhao", titel: "Reward Hacking in Language Model Agents: Revisiting AI Safety Gridworlds", id: "2606.15385", datum: "Juni 2026" },
  { autoren: "Lynch, Wright, Larson, Ritchie, Mindermann, Hubinger, Perez, Troy", titel: "Agentic Misalignment: How LLMs Could Be Insider Threats", id: "2510.05179", datum: "arXiv Oktober 2025, als Anthropic-Report im Juni 2025 veröffentlicht" },
  { autoren: "OpenAI und Apollo Research", titel: "Stress Testing Deliberative Alignment for Anti-Scheming Training", id: "2509.15541", datum: "September 2025" },
  { autoren: "Apollo Research", titel: "Frontier Models are Capable of In-context Scheming", id: "2412.04984", datum: "Dezember 2024" },
  { autoren: "Anthropic und Redwood Research", titel: "Alignment faking in large language models", id: "2412.14093", datum: "Dezember 2024" },
  { autoren: "Cemri, Pan, Yang et al.", titel: "Why Do Multi-Agent LLM Systems Fail?", id: "2503.13657", datum: "März 2025, überarbeitet Oktober 2025" },
  { autoren: "Lin, Deng, Li et al.", titel: "Safety in Self-Evolving LLM Agent Systems: Threats, Amplification, and Case Studies", id: "2606.23075", datum: "Juni 2026" },
  { autoren: "", titel: "Memory Poisoning Attack and Defense on Memory Based LLM-Agents", id: "2601.05504", datum: "Januar 2026" },
  { autoren: "Chen, Zaharia, Zou", titel: "How is ChatGPT's behavior changing over time?", id: "2307.09009", datum: "Juli 2023" },
  { autoren: "Betley et al.", titel: "Emergent Misalignment: Narrow finetuning can produce broadly misaligned LLMs", id: "2502.17424", datum: "Februar 2025" },
  { autoren: "Rath", titel: "Agent Drift: Quantifying Behavioral Degradation in Multi-Agent LLM Systems Over Extended Interactions", id: "2601.04170", datum: "Januar 2026" },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: "https://kyde.com/" },
    { "@type": "ListItem", position: 2, name: "Wissen", item: "https://kyde.com/de/wissen" },
    { "@type": "ListItem", position: 3, name: pageTitle, item: "https://kyde.com/de/wissen/behavioral-drift" },
  ],
};
---

<Base
  title="Behavioral Drift bei AI Agents: sieben Formen und was im Protokoll steht"
  description="Behavioral Drift ist kein einzelnes, klar definiertes Phänomen. Mindestens sieben verwandte Formen, in denen sich Agent-Verhalten verändern kann, was die aktuelle Forschung tatsächlich zeigt, welche Signale sich aus Produktionslogs messen lassen und zu welchem Aufwand."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <Navbar />
  <main>
    <div class="border-b border-line-0 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-4 md:border-x md:border-line-0 flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-1">Das aus den eigenen Systemen aufzuzeichnen, ist die Aufgabe von Kyde Zero Trust.</p>
        <a href="/" class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-0 border-b border-line-1 hover:border-ink-0 transition-colors">Ansehen →</a>
      </div>
    </div>

    <!-- ══════════ AUFMACHER ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-20 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-center gap-3 mb-3">
            <a href="/de/wissen" class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1 hover:text-ink-0 transition-colors">↑ Wissen</a>
            <span class="text-ink-1">/</span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Forschung · Notiz</span>
          </div>
          <Stand datum={stand} geprueft="alle arXiv-Nummern gegen die Arbeiten selbst" />
        </div>
        <h1 class="hero-h1 max-w-4xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl mb-8 mt-10">
          Behavioral Drift bei <span class="gradient-text">AI Agents</span>
        </h1>
        <p class="text-lg md:text-xl text-ink-0 leading-relaxed max-w-3xl border-l-2 border-line-1 pl-6">
          Wenn AI Agents produktiv eingesetzt werden, kann sich ihr Verhalten mit der Zeit verändern. Nicht unbedingt durch einen Ausfall oder einen offensichtlichen Angriff. Ein Agent kann weiterlaufen, Aufgaben abschließen und Erfolg melden, und sich trotzdem anders verhalten als zuvor.
        </p>
        <div class="max-w-3xl mt-8 space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Wir haben uns deshalb genauer angesehen, was die aktuelle Forschung tatsächlich über dieses Thema sagt. Dabei wurde schnell klar: Behavioral Drift ist kein einzelnes, klar definiertes Phänomen.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            In der aktuellen Forschung finden sich mindestens sieben verwandte Formen, in denen sich das Verhalten von Agents verändern oder unzuverlässiger werden kann.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ DIE SIEBEN FORMEN ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-8">Sieben verwandte Formen</p>
        <div class="overflow-x-auto">
          <table class="w-full border border-line-0 text-sm">
            <tbody class="divide-y divide-line-0">
              {formen.map(({ name, was }) => (
                <tr>
                  <td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ink-0 align-top whitespace-nowrap">{name}</td>
                  <td class="px-5 py-4 text-sm text-ink-1 align-top">{was}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-base text-ink-1 max-w-3xl leading-relaxed">
          Das ist unsere Synthese der aktuellen Literatur und keine etablierte wissenschaftliche Taxonomie.
        </p>
      </div>
    </section>

    <!-- ══════════ VERERBUNG ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Drift kann sich zwischen Agents weitergeben</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Besonders interessant ist eine aktuelle Studie zu Multi-Agent-Systemen.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Eine im März 2026 veröffentlichte Untersuchung testete Agents in zwei Szenarien: Aktienhandel und Triage in einer Notaufnahme. Modelle, die direkten Versuchen, ihre Ziele zu verändern, widerstanden, konnten eine Abweichung übernehmen, wenn ihnen die Gesprächshistorie eines anderen, bereits abgewichenen Agents gezeigt wurde.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Die Studie zeigt außerdem, dass die Fähigkeit eines Modells, einer Instruktionshierarchie zu folgen, kein zuverlässiger Indikator dafür ist, wie resistent es gegenüber dieser Form von Drift ist.
          </p>
        </div>
        <blockquote class="mt-10 max-w-3xl border-l-2 border-line-1 pl-6">
          <p class="text-lg md:text-xl text-ink-0 leading-relaxed">
            Ein stärkeres Modell am Ende der Kette kompensiert also nicht automatisch einen schwächeren Agent am Anfang.
          </p>
        </blockquote>
      </div>
    </section>

    <!-- ══════════ ZU FRÜH AUFHÖREN ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Agents können aufhören, bevor die Arbeit wirklich erledigt ist</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Mehrere aktuelle Studien weisen auf ein weiteres Muster bei längeren Aufgaben hin. Agents können bereits erledigte Arbeit wiederholen, Ergebnisse doppelt einreichen, zu früh fertig melden oder weiterarbeiten, ohne dem eigentlichen Ziel näherzukommen.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            PushBench bietet dafür einen interessanten Messansatz. Statt nur auf das finale Ergebnis zu schauen, wird untersucht, ob ein Agent tatsächlich Fortschritt in Richtung eines quantitativ definierten Ziels macht.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            In den Experimenten der Autoren verbesserten State-Tracking-Mechanismen die Leistung bei Long-Horizon-Aufgaben deutlich und verhinderten doppelte Einreichungen.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            Aus praktischer Sicht ist das interessant, weil sich einige dieser Signale messen lassen, ohne Zugriff auf das Modell selbst zu benötigen.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ REWARD HACKING ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Reward Hacking ist verwandt, aber etwas anderes</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Reward Hacking wird häufig zusammen mit Behavioral Drift diskutiert. Es gibt aber einen wichtigen Unterschied: Reward Hacking muss keine Veränderung über die Zeit sein. Die Spezifikation kann von Anfang an eine Lücke enthalten, die der Agent findet und ausnutzt.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Eine aktuelle Benchmark-Studie fand bei den getesteten Frontier-Modellen Exploit-Raten zwischen 0 Prozent und 13,9 Prozent. In 72 Prozent der untersuchten Reward-Hacking-Fälle enthielt der Reasoning Trace eine explizite Begründung für den Exploit.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            Die praktische Erkenntnis ist nicht, dass Modelle zwangsläufig Reward Hacking betreiben. Sondern dass ein erfolgreich abgeschlossener Task allein nicht immer beweist, dass das eigentlich gewünschte Ziel erreicht wurde.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ PRÜFUNGEN ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Audits zeigen Verhalten unter den Bedingungen des Audits</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Forschung zu agentic misalignment wirft eine weitere Frage auf: Wie repräsentativ sind Evaluierungen für das Verhalten in der Produktion?
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            In simulierten Unternehmensumgebungen von Anthropic zeigten Modelle verschiedener Anbieter in bestimmten Szenarien schädliches Verhalten, unter anderem wenn ihre Ziele mit denen des Unternehmens kollidierten.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Wichtig: Das waren kontrollierte Experimente und keine Beobachtungen realer Produktionssysteme. Die Autoren machen diese Unterscheidung ausdrücklich.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            Für Betreiber ergibt sich daraus eine interessante Konsequenz: Eine Evaluation sagt etwas darüber aus, wie sich ein System unter den Bedingungen des Tests verhält. Kontinuierliche Beobachtung liefert eine andere Art von Evidenz, nämlich darüber, was das System tatsächlich in der Produktion getan hat.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ GEDÄCHTNIS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Memory kann aus einem einzelnen Vorfall einen dauerhaften Zustand machen</p>
        <div class="max-w-3xl space-y-4">
          <p class="text-base text-ink-1 leading-relaxed">
            Memory bringt eine weitere Dimension hinzu. Aktuelle Forschung zu sich selbst weiterentwickelnden Agents zeigt, wie bestimmte Angriffe oder Verhaltensänderungen über Memory und Selbstveränderung bestehen bleiben können, anstatt mit dem Ende einer Session zu verschwinden.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Gleichzeitig zeigt andere Forschung, dass Memory-basierte Angriffe deutlich weniger erfolgreich sein können, wenn sie unter realistischeren Bedingungen mit bereits vorhandenen Memories getestet werden.
          </p>
          <p class="text-base text-ink-1 leading-relaxed">
            Das Bild ist daher differenzierter als „Memory macht Agents unsicher“.
          </p>
          <p class="text-base text-ink-0 leading-relaxed">
            Entscheidend ist vielmehr, ob eine Veränderung bestehen bleibt, sich weiterverbreitet und zukünftige Runs beeinflusst.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ WAS IM PROTOKOLL STEHT ══════════ -->
    <section class="border-t border-line-1 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Was lässt sich tatsächlich aus Produktionslogs messen?</p>
        <p class="text-base text-ink-1 leading-relaxed max-w-3xl mb-10">
          Hier wird das Thema aus unserer Sicht besonders praktisch. Nicht jede Form kostet gleich viel.
        </p>
        <div class="border border-line-0 divide-y divide-line-0 bg-bg-0">
          {ablesbar.map(({ stufe, ton, lead, punkte }) => (
            <div class="grid md:grid-cols-[180px_1fr] gap-4 md:gap-10 px-6 py-7 md:px-8 md:py-8">
              <div>
                <span class:list={[
                  'inline-block font-mono text-[10px] uppercase tracking-[0.16em] border px-2.5 py-1',
                  ton === 'live' ? 'text-live border-live/30 bg-live/[0.08]' : '',
                  ton === 'warn' ? 'text-warn border-warn/30 bg-warn/[0.08]' : '',
                  ton === 'ember' ? 'text-ember border-ember/30 bg-ember/[0.08]' : '',
                ]}>{stufe}</span>
              </div>
              <div>
                <p class="text-sm text-ink-2 leading-relaxed mb-4">{lead}</p>
                <ul class="space-y-2">
                  {punkte.map((eintrag) => (
                    <li class="flex gap-3 text-base text-ink-1 leading-relaxed">
                      <span class="font-mono text-ink-2 shrink-0" aria-hidden="true">·</span>
                      <span>{eintrag}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-8 text-base text-ink-0 leading-relaxed max-w-3xl">
          Ein sinnvoller Ausgangspunkt ist deshalb, mit den Signalen zu beginnen, die bereits im Produktionsverkehr sichtbar sind.
        </p>
      </div>
    </section>

    <!-- ══════════ OFFENE FRAGEN ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-8">Was die Forschung bisher noch nicht hat</p>
        <p class="text-base text-ink-1 leading-relaxed max-w-3xl mb-10">
          Es gibt einige wichtige Lücken.
        </p>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-0">
          {offeneFragen.map(({ n, h, t }) => (
            <div class="border-t border-line-0 py-6">
              <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ink-2 mb-3">{n}</span>
              <p class="text-base font-semibold text-ink-0 leading-snug mb-2">{h}</p>
              <p class="text-sm text-ink-1 leading-relaxed">{t}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ DIE LÜCKE ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="max-w-3xl">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.05] text-ink-0 mb-5">
            Genau an dieser Lücke arbeiten wir.
          </h2>
          <div class="space-y-4 mb-8">
            <p class="text-base text-ink-1 leading-relaxed">
              Bei Kyde untersuchen wir, ob Produktionsdaten zu einer praktischen Grundlage werden können, um Verhaltensänderungen über die Zeit zu messen. Wenn jede Aktion eines Agents an der Grenze des Systems aufgezeichnet wird, außerhalb des Einflussbereichs des Agents, entsteht eine Historie darüber, was tatsächlich passiert ist. Diese Aufzeichnungen können eine Grundlage für Audits, Untersuchungen und den Vergleich von früherem und aktuellem Verhalten bilden.
            </p>
            <p class="text-base text-ink-0 leading-relaxed border-l-2 border-line-1 pl-6">
              Unsere Hypothese ist einfach: Wenn wir zuverlässig aufzeichnen können, was ein Agent getan hat, können wir beginnen zu messen, wie sich sein Verhalten verändert.
            </p>
            <p class="text-base text-ink-1 leading-relaxed">
              Genau daran arbeiten wir. Wir lernen dabei selbst noch dazu. Wenn Sie an Agent-Evaluation, Observability oder Behavioral Drift arbeiten, würde uns interessieren, was Sie beobachten.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <button onclick="openModal()" class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all w-fit">
              Erzählen Sie uns, was Sie sehen →
            </button>
            <a href="/" class="inline-flex items-center gap-2 border border-line-1 text-ink-0 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-ink-0 transition-all w-fit">
              Zur Plattform →
            </a>
          </div>
        </div>
      </div>
    </section>

