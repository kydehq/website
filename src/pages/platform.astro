---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Base
    title="Platform — KYDE"
    description="The Zero-Trust AI Stack. Securing the Agentic Economy. Identity, scope, and a court-ready evidence trail for every AI agent — without touching agent code."
>
    <Navbar />

    <main>

        <!-- ══════════ HERO ══════════ -->
        <section class="relative overflow-hidden pt-36 pb-24 md:pt-48 md:pb-36">
            <div class="bg-grid absolute inset-0 pointer-events-none"></div>
            <div class="relative max-w-7xl mx-auto px-6">

                <div class="mb-10">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="h-1.5 w-1.5 rounded-full bg-zinc-500 shrink-0"></span>
                        <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ The Zero-Trust AI Stack — Platform</span>
                    </div>
                    <div class="h-px w-full bg-[#e8e9eb]"></div>
                </div>

                <h1 class="hero-h1 max-w-5xl text-5xl text-[#0d0e10] uppercase tracking-tight md:text-6xl lg:text-7xl">
                    The Zero-Trust<br />
                    <span class="gradient-text">AI Stack.</span>
                </h1>

                <div class="mt-16 border-t border-dotted border-[#0d0e10]/15 pt-10 grid md:grid-cols-[200px_1fr] gap-8 items-start">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#0d0e10]">Securing the Agentic Economy</p>
                        <p class="mt-2 font-mono text-xs text-[#666]">[KYDE]</p>
                    </div>
                    <div class="space-y-10">
                        <p class="text-sm uppercase tracking-wide leading-relaxed text-[#333]">
                            The Zero-Trust AI Stack sits between your agents and every LLM provider. Every agent gets a cryptographic identity, enforced behavioral scope, and a court-ready evidence trail — without touching a single line of agent code.
                        </p>

                        <!-- Stats -->
                        <div class="grid grid-cols-3 divide-x divide-dotted divide-[#0d0e10]/15 border border-dotted border-[#0d0e10]/15">
                            {[
                                { value: "<100ms", label: "Target latency" },
                                { value: "100%", label: "Planned provider coverage" },
                                { value: "0", label: "Code changes by design" },
                            ].map(({ value, label }) => (
                                <div class="px-6 py-5">
                                    <p class="font-mono text-2xl font-bold text-[#0d0e10]">{value}</p>
                                    <p class="mt-1 text-xs text-[#333] uppercase tracking-widest">{label}</p>
                                </div>
                            ))}
                        </div>

                        <!-- CTAs -->
                        <div class="flex flex-col sm:flex-row items-start gap-4">
                            <button
                                onclick="openModal()"
                                class="inline-flex items-center gap-2 bg-[#0d0e10] px-6 py-3.5 text-sm font-semibold text-[#f1f3f5] hover:bg-[#333] transition-all"
                            >
                                Book Demo →
                            </button>
                            <a
                                href="/resources"
                                class="inline-flex items-center gap-2 border border-dotted border-[#0d0e10]/20 px-6 py-3.5 text-sm font-semibold text-[#333] hover:border-[#0d0e10] hover:text-[#0d0e10] transition-all"
                            >
                                View Integration Docs
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ HOW IT WORKS ══════════ -->
        <section class="relative border-t border-dotted border-[#0d0e10]/12 py-24 md:py-32">
            <div class="relative max-w-7xl mx-auto px-6">

                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="h-1.5 w-1.5 rounded-full bg-zinc-600 shrink-0"></span>
                        <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ How it works</span>
                    </div>
                    <div class="h-px w-full bg-[#e8e9eb]"></div>
                </div>

                <div class="grid md:grid-cols-2 gap-16 items-start">
                    <div>
                        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0d0e10] mb-6">
                            The proxy intercepts. Signs. Chains. Forwards.
                        </h2>
                        <p class="text-[#333] leading-relaxed mb-8">
                            KYDE runs as a local or hosted HTTP proxy, fully compatible with the OpenAI API schema. Any agent that can be pointed at a base URL can be governed.
                        </p>
                        <div class="border border-dotted border-[#0d0e10]/15 bg-white rounded-sm mb-8">
                            <div class="flex items-center gap-2 border-b border-dotted border-[#0d0e10]/20 px-4 py-3">
                                <span class="h-3 w-3 rounded-full bg-red-400/60"></span>
                                <span class="h-3 w-3 rounded-full bg-[#fcb830]"></span>
                                <span class="h-3 w-3 rounded-full bg-emerald-400/60"></span>
                                <span class="ml-2 text-xs text-[#333] font-mono">terminal</span>
                            </div>
                            <div class="p-5 font-mono text-sm">
                                <p class="text-[#333]"><span class="text-[#0a7c4e]">$</span><span class="text-[#333]"> export OPENAI_BASE_URL=https://kyde.intranet/v1</span></p>
                            </div>
                        </div>
                        <p class="font-mono text-sm text-[#333]">Target deployment: one environment variable. Designed for zero code changes.</p>
                    </div>

                    <div class="space-y-px border border-dotted border-[#0d0e10]/15">
                        {[
                            { n: "01", title: "Intercept", body: "Every request from every agent routes through the proxy. The agent sees no difference." },
                            { n: "02", title: "Register", body: "The request is matched to an agent identity and role. Budget and policy checks run before the call is forwarded." },
                            { n: "03", title: "Sign & Chain", body: "An Ed25519-signed, SHA-256 hash-chained entry is written. Alter any record — every subsequent link breaks." },
                            { n: "04", title: "Forward", body: "The original request continues to the LLM provider. Target added latency: under 100ms." },
                        ].map(({ n, title, body }) => (
                            <div class="grid grid-cols-[48px_1fr] bg-white hover:bg-[#f1f3f5] transition-all">
                                <div class="flex items-start justify-center pt-6 border-r border-dotted border-[#0d0e10]/15">
                                    <span class="font-mono text-xs text-[#666]">{n}</span>
                                </div>
                                <div class="p-6">
                                    <h3 class="font-mono text-sm font-bold text-[#0d0e10] uppercase tracking-widest mb-2">{title}</h3>
                                    <p class="text-sm text-[#333] leading-relaxed">{body}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ WHAT GETS CAPTURED ══════════ -->
        <section class="relative border-t border-dotted border-[#0d0e10]/12 py-24 md:py-32">
            <div class="relative max-w-7xl mx-auto px-6">

                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="h-1.5 w-1.5 rounded-full bg-zinc-600 shrink-0"></span>
                        <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Evidence capture</span>
                    </div>
                    <div class="h-px w-full bg-[#e8e9eb]"></div>
                </div>

                <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0d0e10] mb-16">
                    Every entry answers five questions.
                </h2>

                <div class="grid md:grid-cols-2 gap-12 items-start">

                    <!-- Field table -->
                    <div class="border border-dotted border-[#0d0e10]/15 divide-y divide-dotted divide-[#0d0e10]/15">
                        {[
                            { field: "Who", desc: "Agent ID, role, machine ID, user identity" },
                            { field: "What", desc: "Prompt, model, tool calls, response" },
                            { field: "Why", desc: "Last 5 messages as causal context" },
                            { field: "When", desc: "Millisecond-precise UTC timestamp" },
                            { field: "Proof", desc: "Ed25519 signature + SHA-256 hash chain link" },
                        ].map(({ field, desc }) => (
                            <div class="grid grid-cols-[80px_1fr] divide-x divide-dotted divide-[#0d0e10]/15">
                                <div class="px-4 py-4 bg-[#f1f3f5]">
                                    <p class="font-mono text-sm font-bold text-[#0d0e10]">{field}</p>
                                </div>
                                <div class="px-4 py-4">
                                    <p class="text-sm text-[#333] leading-relaxed">{desc}</p>
                                </div>
                            </div>
                        ))}
                    </div>

                    <!-- JSON entry -->
                    <div class="rounded-sm border border-dotted border-[#0d0e10]/15 bg-white">
                        <div class="flex items-center gap-2 border-b border-dotted border-[#0d0e10]/15 px-4 py-3">
                            <span class="h-2 w-2 rounded-full bg-[#0d0e10]/20"></span>
                            <span class="h-2 w-2 rounded-full bg-[#0d0e10]/20"></span>
                            <span class="h-2 w-2 rounded-full bg-[#0d0e10]/20"></span>
                            <span class="ml-2 text-xs text-[#333] font-mono">audit_entry.json</span>
                        </div>
                        <pre class="overflow-x-auto p-5 font-mono text-xs leading-relaxed text-[#333]"><code>{`{
  `}<span class="text-[#333]">"entry_id"</span>{`: `}<span class="text-[#333]">"e_7f3a2b1c"</span>{`,
  `}<span class="text-[#333]">"sequence"</span>{`: `}<span class="text-[#0d0e10]">1847</span>{`,
  `}<span class="text-[#333]">"agent_id"</span>{`: `}<span class="text-[#333]">"sales_bot_prod"</span>{`,
  `}<span class="text-[#333]">"role"</span>{`: `}<span class="text-[#333]">"customer_facing"</span>{`,
  `}<span class="text-[#333]">"timestamp"</span>{`: `}<span class="text-[#333]">"2026-03-15T14:23:07Z"</span>{`,
  `}<span class="text-[#333]">"action"</span>{`: `}<span class="text-[#333]">"chat.completion"</span>{`,
  `}<span class="text-[#333]">"provider"</span>{`: `}<span class="text-[#333]">"openai"</span>{`,
  `}<span class="text-[#333]">"model"</span>{`: `}<span class="text-[#333]">"gpt-4o"</span>{`,
  `}<span class="text-[#333]">"tool_calls"</span>{`: [`}<span class="text-[#333]">"crm.update_deal"</span>{`, `}<span class="text-[#333]">"slack.send_message"</span>{`],
  `}<span class="text-[#333]">"input_hash"</span>{`: `}<span class="text-[#333]">"sha256:9f86d0..."</span>{`,
  `}<span class="text-[#333]">"entry_hash"</span>{`: `}<span class="text-[#333]">"sha256:7b2e4d..."</span>{`,
  `}<span class="text-[#333]">"prev_hash"</span>{`: `}<span class="text-[#333]">"sha256:1c3f8a..."</span>{`,
  `}<span class="text-[#333]">"signature"</span>{`: `}<span class="text-[#333]">"ed25519:Mk3nR9..."</span>{`
}`}</code></pre>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ FLEET MANAGEMENT ══════════ -->
        <section class="relative border-t border-dotted border-[#0d0e10]/12 py-24 md:py-32">
            <div class="relative max-w-7xl mx-auto px-6">

                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="h-1.5 w-1.5 rounded-full bg-zinc-600 shrink-0"></span>
                        <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Fleet management</span>
                    </div>
                    <div class="h-px w-full bg-[#e8e9eb]"></div>
                </div>

                <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0d0e10] mb-4">
                    Roles. Budgets. Boundaries. Per agent.
                </h2>
                <p class="text-[#333] leading-relaxed mb-16 max-w-2xl">
                    Every agent in your fleet gets a distinct identity and an assigned role. Roles determine what an agent is permitted to do — and what it costs you when it does it.
                </p>

                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {[
                        {
                            title: "Identity & Roles",
                            body: "Register every agent with a unique ID. Assign roles — infrastructure, customer_facing, internal_research, intern_sandbox. Roles carry permissions, not agents.",
                            tag: "Core",
                        },
                        {
                            title: "Priority & Resource Allocation",
                            body: "Your production infrastructure agent gets priority over your intern's research bot. When token budgets run tight, critical agents aren't the ones that queue.",
                            tag: "Fleet",
                        },
                        {
                            title: "Token & Cost Budgets",
                            body: "Set hard limits per agent, per role, or per team. Daily, weekly, monthly. No agent runs up a bill you didn't scope.",
                            tag: "Fleet",
                        },
                        {
                            title: "API Allowlists & Blocklists",
                            body: "Define which endpoints each role is permitted to reach. Your billing agent talks to the payment API. Your support agent doesn't.",
                            tag: "Policy",
                        },
                        {
                            title: "Behavioral Baselines & Anomaly Detection",
                            body: "Kyde learns what normal looks like for each role. When an agent deviates — unusual call volume, unexpected endpoints, out-of-pattern tool usage — you get alerted before it becomes an incident.",
                            tag: "Coming Soon",
                        },
                    ].map(({ title, body, tag }) => (
                        <div class="rounded-sm border border-dotted border-[#0d0e10]/15 bg-white p-6 hover:bg-[#eee] transition-all">
                            <div class="mb-4 flex items-center justify-between">
                                <span class="font-mono text-xs uppercase tracking-widest text-[#666]">{tag}</span>
                            </div>
                            <h3 class="mb-3 text-base font-semibold text-[#0d0e10]">{title}</h3>
                            <p class="text-sm leading-relaxed text-[#333]">{body}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- ══════════ ARCHITECTURE ══════════ -->
        <section class="relative border-t border-dotted border-[#0d0e10]/12 py-24 md:py-32">
            <div class="relative max-w-7xl mx-auto px-6">

                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="h-1.5 w-1.5 rounded-full bg-zinc-600 shrink-0"></span>
                        <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Architecture</span>
                    </div>
                    <div class="h-px w-full bg-[#e8e9eb]"></div>
                </div>

                <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0d0e10] mb-16">
                    Gateway, not endpoint.
                </h2>

                <div class="grid md:grid-cols-2 gap-8">

                    <!-- Gateway model -->
                    <div class="border border-dotted border-[#0d0e10]/20 bg-white p-8">
                        <p class="font-mono text-xs uppercase tracking-widest text-[#333] mb-6">KYDE — Gateway Model</p>
                        <div class="font-mono text-sm text-[#333] space-y-1 mb-8">
                            <p><span class="text-[#333]">Agent A</span> ──┐</p>
                            <p><span class="text-[#333]">Agent B</span> ──┼──► <span class="text-[#333]">KYDE</span> ──► <span class="text-[#333]">LLM API</span></p>
                            <p><span class="text-[#333]">Agent C</span> ──┘</p>
                            <p class="mt-4 text-[#666]">               ↓</p>
                            <p class="text-[#333]">        Central DB · One record</p>
                        </div>
                        <ul class="space-y-2">
                            {[
                                "One deployment covers the entire fleet",
                                "Built to support every agent, framework, and LLM",
                                "Central visibility — no aggregation required",
                                "No per-agent installation or configuration",
                            ].map((item) => (
                                <li class="flex items-center gap-3 text-sm text-[#333]">
                                    <svg class="h-4 w-4 shrink-0 text-[#0a7c4e]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>

                    <!-- Endpoint model -->
                    <div class="border border-dotted border-[#0d0e10]/15 bg-[#f1f3f5] p-8">
                        <p class="font-mono text-xs uppercase tracking-widest text-[#666] mb-6">Endpoint / Runtime Solutions</p>
                        <div class="font-mono text-sm text-[#666] space-y-1 mb-8">
                            <p>Agent A + Runtime ──► LLM API &nbsp; ↓ Log A</p>
                            <p>Agent B + Runtime ──► LLM API &nbsp; ↓ Log B</p>
                            <p>Agent C + Runtime ──► LLM API &nbsp; ↓ Log C</p>
                        </div>
                        <ul class="space-y-2">
                            {[
                                "Install on every agent separately",
                                "Framework- and runtime-specific",
                                "Fragmented logs — difficult to aggregate",
                            ].map((item) => (
                                <li class="flex items-center gap-3 text-sm text-[#666]">
                                    <svg class="h-4 w-4 shrink-0 text-[#333]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 12H6" /></svg>
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>

                <!-- Comparison table -->
                <div class="mt-8 border border-dotted border-[#0d0e10]/15 divide-y divide-dotted divide-[#0d0e10]/15">
                    <div class="grid grid-cols-3 divide-x divide-dotted divide-[#0d0e10]/15 bg-[#f1f3f5]">
                        <div class="px-6 py-3"><p class="font-mono text-xs uppercase tracking-widest text-[#333]">Property</p></div>
                        <div class="px-6 py-3"><p class="font-mono text-xs uppercase tracking-widest text-[#0d0e10]">KYDE</p></div>
                        <div class="px-6 py-3"><p class="font-mono text-xs uppercase tracking-widest text-[#666]">Endpoint Solutions</p></div>
                    </div>
                    {[
                        { prop: "Deployment effort", kyde: "One ENV variable", other: "Per-agent installation" },
                        { prop: "Agent coverage", kyde: "All agents, automatically", other: "Each agent separately" },
                        { prop: "Fleet management", kyde: "Central roles, budgets, policies", other: "Per-agent configuration" },
                        { prop: "Audit trail", kyde: "Single, tamper-evident record", other: "Fragmented per agent" },
                        { prop: "Code changes needed", kyde: "None", other: "Typically required" },
                    ].map(({ prop, kyde, other }) => (
                        <div class="grid grid-cols-3 divide-x divide-dotted divide-[#0d0e10]/15">
                            <div class="px-6 py-4"><p class="text-sm text-[#333]">{prop}</p></div>
                            <div class="px-6 py-4"><p class="text-sm text-[#333]">{kyde}</p></div>
                            <div class="px-6 py-4"><p class="text-sm text-[#666]">{other}</p></div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- ══════════ SIGNING LAYER ══════════ -->
        <section class="relative border-t border-dotted border-[#0d0e10]/12 py-24 md:py-32">
            <div class="relative max-w-7xl mx-auto px-6">

                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="h-1.5 w-1.5 rounded-full bg-zinc-600 shrink-0"></span>
                        <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Root of trust</span>
                    </div>
                    <div class="h-px w-full bg-[#e8e9eb]"></div>
                </div>

                <div class="grid md:grid-cols-2 gap-16 items-start">
                    <div>
                        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0d0e10] mb-6">
                            Root of trust.<br />From software to silicon.
                        </h2>
                        <p class="text-[#333] leading-relaxed mb-6">
                            Each entry is signed with an Ed25519 keypair generated locally on first initialization. The hash chain ensures sequential integrity — tamper with any single entry, and every subsequent link breaks.
                        </p>
                        <p class="text-[#333] leading-relaxed mb-10">
                            For environments where software-only signing isn't enough, Kyde's architecture is built for hardware-rooted attestation from day one.
                        </p>
                        <p class="font-mono text-sm text-[#333] border-l-2 border-dotted border-[#0d0e10]/20 pl-4 leading-relaxed">
                            No re-architecture required between levels. Same API. Same data format. Same evidence chain. The root of trust gets deeper — the interface stays the same.
                        </p>
                    </div>

                    <div class="border border-dotted border-[#0d0e10]/15 divide-y divide-dotted divide-[#0d0e10]/15">
                        <div class="grid grid-cols-[140px_1fr_90px] divide-x divide-dotted divide-[#0d0e10]/15 bg-[#f1f3f5]">
                            <div class="px-4 py-3"><p class="font-mono text-xs text-[#666] uppercase tracking-widest">Level</p></div>
                            <div class="px-4 py-3"><p class="font-mono text-xs text-[#666] uppercase tracking-widest">Mechanism</p></div>
                            <div class="px-4 py-3"><p class="font-mono text-xs text-[#666] uppercase tracking-widest">Status</p></div>
                        </div>
                        {[
                            { level: "Ed25519 Signed", desc: "Cryptographic signing at the point of capture — core to the current development phase.", status: "IN DEVELOPMENT", live: true, available: false },
                            { level: "TPM / HSM", desc: "Military-grade hardware isolation. Signing keys never exposed to host OS.", status: "PLANNED", live: false, available: true },
                            { level: "TEE (TDX/SEV-SNP)", desc: "Trusted Execution Environment attestation for maximum integrity.", status: "PLANNED", live: false, available: true },
                            { level: "FIPS 140-3", desc: "Architecture designed for FIPS-validated cryptographic modules.", status: "TARGET ARCHITECTURE", live: false, available: true },
                        ].map(({ level, desc, status, live, available }) => (
                            <div class="grid grid-cols-[140px_1fr_90px] divide-x divide-dotted divide-[#0d0e10]/15">
                                <div class="px-4 py-4"><p class="font-mono text-sm text-[#0d0e10]">{level}</p></div>
                                <div class="px-4 py-4"><p class="text-sm text-[#333]">{desc}</p></div>
                                <div class="px-4 py-4">
                                    <span class={`font-mono text-[10px] tracking-widest ${live ? "text-[#0a7c4e]" : available ? "text-[#4472c4]" : "text-[#666]"}`}>{status}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ THREE GUARANTEES ══════════ -->
        <section class="relative border-t border-dotted border-[#0d0e10]/12 py-24 md:py-32">
            <div class="max-w-7xl mx-auto px-6">

                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="h-1.5 w-1.5 rounded-full bg-[#0d0e10]/20 shrink-0"></span>
                        <span class="font-mono text-xs uppercase tracking-[0.2em] bg-[#dae4e5] text-[#0d0e10] px-1.5 py-0.5">↳ Product Core</span>
                    </div>
                    <div class="h-px w-full bg-[#e8e9eb]"></div>
                </div>

                <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0d0e10] mb-4">
                    Three guarantees. One stack.
                </h2>
                <p class="text-[#333] leading-relaxed mb-16 max-w-2xl">Not a roadmap. A complete infrastructure layer that ships as a unit — covering every agent from day one.</p>

                <div class="grid gap-8 lg:grid-cols-3">
                    <!-- SCOPE -->
                    <div class="rounded-sm border border-dotted border-[#0d0e10]/15 bg-white p-8">
                        <div class="mb-6">
                            <span class="font-mono text-xs text-[#666]">01</span>
                        </div>
