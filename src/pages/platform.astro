---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FleetStatusMock from "../components/FleetStatusMock.astro";
---

<Base
    title="Platform, KYDE"
    description="KYDE, Prevent · Prove · Rate. The behavioral system of record between AI agents and the real world. Prevent what must not happen. Prove what did. Rate agent behavior across every provider. Without touching agent code."
>
    <Navbar />

    <main>

        <!-- ══════════ HERO ══════════ -->
        <section class="relative overflow-hidden">
            <div class="bg-grid absolute inset-0 pointer-events-none"></div>
            <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-36 md:border-x md:border-line-0">

                <div class="mb-10">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">01 · The Behavioral System of Record · Platform</span></div>
                </div>

                <h1 class="hero-h1 max-w-5xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl">
                    The Behavioral System of<br />
                    <span class="gradient-text">Record.</span>
                </h1>

                <div class="mt-16 border-t border-line-0 pt-10 grid md:grid-cols-[200px_1fr] gap-8 items-start">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">Securing the Agentic Economy</p>
                        <p class="mt-2 font-mono text-xs text-ink-1">[KYDE]</p>
                    </div>
                    <div class="space-y-10">
                        <p class="text-sm uppercase tracking-wide leading-relaxed text-ink-1">
                            The Behavioral System of Record sits between your agents and every LLM provider. Every agent gets a cryptographic identity, enforced behavioral scope, and an evidence trail anyone can verify without us, without touching a single line of agent code.
                        </p>

                        <!-- Stats -->
                        <div class="grid grid-cols-3 divide-x divide-line-0 border border-line-0">
                            {[
                                { value: "<100ms", label: "Target latency" },
                                { value: "100%", label: "Planned provider coverage" },
                                { value: "0", label: "Code changes by design" },
                            ].map(({ value, label }) => (
                                <div class="px-6 py-5">
                                    <p class="font-mono text-2xl font-bold text-ink-0">{value}</p>
                                    <p class="mt-1 text-xs text-ink-1 uppercase tracking-widest">{label}</p>
                                </div>
                            ))}
                        </div>

                        <!-- CTAs -->
                        <div class="flex flex-col sm:flex-row items-start gap-4">
                            <button
                                onclick="openModal()"
                                class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-sm font-semibold text-cta-ink hover:bg-cta-hover transition-all"
                            >
                                Talk to Us →
                            </button>
                            <a
                                href="/resources"
                                class="inline-flex items-center gap-2 border border-line-0 px-6 py-3.5 font-mono text-xs uppercase tracking-[0.1em] text-ink-1 hover:border-line-1 hover:text-ink-0 transition-all"
                            >
                                View Integration Docs →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ PROBLEM ══════════ -->
        <section class="relative border-t border-line-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">02 · The operational gap</span></div>
                </div>

                <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight text-ink-0 uppercase mb-16">
                    Questions most enterprises<br />can't answer.
                </h2>

                <div class="grid gap-6 md:grid-cols-2">
                    {[
                        {
                            q: "Who acted?",
                            body: "Agents share service accounts with broad permissions. No traceable identity. No role boundaries. A support agent scoped for €500 refunds issues €5,000 because nobody scoped its authority.",
                            label: "Identity",
                        },
                        {
                            q: "Why did it decide that?",
                            body: "An HR agent retrieves a policy document from 2022 and uses it to guide a termination. The current policy says something different. Nobody logged which source it relied on.",
                            label: "Causal Context",
                        },
                        {
                            q: "What are the boundaries?",
                            body: "Token budgets don't exist. API access is unrestricted. An intern's research agent burns through your entire monthly token allocation while your production agents queue.",
                            label: "Scope & Budget",
                        },
                        {
                            q: "What happened?",
                            body: "A procurement agent posts confidential contract terms in Slack. Leadership needs the full evidence trail. The logs are vendor-provided, self-reported, software-only. A compromised host can rewrite them silently.",
                            label: "Tamper-Evidence",
                        },
                    ].map(({ q, body, label }) => (
                        <div class="border border-line-0 p-8 bg-bg-1 transition-all hover:border-line-1">
                            <div class="mb-4 flex items-center justify-between">
                                <span class="font-mono text-xs uppercase tracking-widest text-ink-1">{label}</span>
                                <span class="h-1.5 w-1.5 rounded-full bg-ember/60"></span>
                            </div>
                            <h3 class="mb-4 text-xl font-bold text-ink-0">{q}</h3>
                            <p class="leading-relaxed text-ink-1 text-sm">{body}</p>
                        </div>
                    ))}
                </div>

                <div class="flex items-center gap-4 my-6">
                    <div class="flex-1 border-t border-line-0"></div>
                    <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1">And the question nobody asks until it's too late</span>
                    <div class="flex-1 border-t border-line-0"></div>
                </div>

                <div class="border border-line-0 p-8 bg-bg-1 transition-all hover:border-line-1">
                    <div class="mb-4 flex items-center justify-between">
                        <span class="font-mono text-xs uppercase tracking-widest text-ink-1">Cross-System Governance</span>
                        <span class="h-1.5 w-1.5 rounded-full bg-ember/60"></span>
                    </div>
                    <h3 class="mb-4 text-xl font-bold text-ink-0">Who governs the chain?</h3>
                    <p class="leading-relaxed text-ink-1 text-sm max-w-3xl">An agent raises a price in Salesforce, triggers a payment in Stripe, and updates inventory in SAP. Each vendor logs their own system. Nobody logs the complete workflow. When the chain breaks, you have fragmented logs across ten consoles, and zero cross-system governance.</p>
                </div>

                <div class="mt-12 px-6 py-16 text-center">
                    <p class="font-mono text-xl md:text-2xl font-normal uppercase tracking-[0.05em] text-ink-0 mx-auto leading-tight">
                        Resilient organizations don't just detect these failures.<br />They architect systems that prevent them.
                    </p>
                </div>

            </div>
        </section>

        <!-- ══════════ PREVENT · PROVE · RATE ══════════ -->
        <section class="relative border-t border-line-0">
            <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">03 · Prevent · Prove · Rate</span></div>
                </div>

                <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-ink-0 mb-4">
                    Three functions. One layer.
                </h2>
                <p class="text-ink-1 leading-relaxed mb-16 max-w-2xl">Deployed between your agents and the real world, covering every provider, every framework, from day one.</p>

                <div class="grid gap-8 lg:grid-cols-3">
                    <!-- PREVENT -->
                    <div class="border border-line-0 bg-bg-1 p-8">
                        <div class="mb-6">
                            <span class="font-mono text-xs text-ink-1">01</span>
                        </div>
                        <h3 class="mb-1 font-mono text-2xl font-bold text-ink-0">PREVENT</h3>
                        <p class="mb-2 text-sm font-medium text-ink-1">Before the damage. Deny-by-default.</p>
                        <p class="mb-6 text-sm leading-relaxed text-ink-1">The enforcement layer is the Behavioral Firewall. Deterministic guardrails at the boundary. The catastrophic action can't execute if it never reaches the system.</p>
                        <ul class="space-y-2">
                            {[
                                "Deny-by-default at the boundary",
                                "API allowlists per agent role, enforced, not advisory",
                                "Token & cost budgets enforced pre-call",
                                "Hard circuit breakers before external systems",
                                "Agent identity & role scoping, no shared service accounts",
                                "Provider-agnostic, every model, every provider",
                                "Covers the agent layer of your NIS-2 and DORA duties",
                            ].map((f) => (
                                <li class="flex items-center gap-3 text-sm">
                                    <svg class="h-4 w-4 shrink-0 text-live" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                                    <span class="text-ink-1">{f}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <!-- PROVE -->
                    <div class="border border-line-0 bg-bg-1 p-8">
                        <div class="mb-6">
                            <span class="font-mono text-xs text-ink-1">02</span>
                        </div>
                        <h3 class="mb-1 font-mono text-2xl font-bold text-ink-0">PROVE</h3>
                        <p class="mb-2 text-sm font-medium text-ink-1">The suspect can't write the police report.</p>
                        <p class="mb-6 text-sm leading-relaxed text-ink-1">Every agent action signed as a tamper-evident 6D fingerprint. Stored outside the runtime, architecturally independent of every LLM provider. What vendors log is self-reported. Ours isn't.</p>
                        <ul class="space-y-2">
                            {[
                                "Unique agent ID per session",
                                "6D fingerprint, who / what / when / where / why / how",
                                "Ed25519-signed append-only ledger",
                                "Tamper-evident hash chain, alter any entry, every link breaks",
                                "SHA-256 chaining, the technique the EU prescribes for qualified electronic ledgers",
                                "Offline verification: the recipient recomputes the chain without asking us",
                                "Architecturally independent of every LLM provider",
                                "Evidence for the agent layer of NIS-2, DORA and EU AI Act duties",
                            ].map((f) => (
                                <li class="flex items-center gap-3 text-sm">
                                    <svg class="h-4 w-4 shrink-0 text-live" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                                    <span class="text-ink-1">{f}</span>
                                </li>
                            ))}
                        </ul>
                        <div class="mt-6 border-t border-line-0 pt-4">
                            <p class="font-mono text-xs text-ink-0/60 uppercase tracking-widest mb-1">Optional High-Security Layer</p>
                            <p class="text-xs text-ink-1 leading-relaxed">Hardware-isolated signing via TPM or HSM. Signing keys never exposed to the host OS. For regulated environments where software-only signing isn't enough.</p>
                        </div>
                    </div>

                    <!-- RATE -->
                    <div class="border border-line-0 bg-bg-1 p-8">
                        <div class="mb-6">
                            <span class="font-mono text-xs text-ink-1">03</span>
                        </div>
                        <h3 class="mb-1 font-mono text-2xl font-bold text-ink-0">RATE</h3>
                        <p class="mb-2 text-sm font-medium text-ink-1">Behavior scored across every provider, in one currency.</p>
                        <p class="mb-6 text-sm leading-relaxed text-ink-1">The KYDE Trust Score™, behavioral baselines, anomaly detection, and cross-provider scoring. Vendors grade their own homework. We grade behavior.</p>
                        <ul class="space-y-2">
                            {[
                                "KYDE Trust Score™, normalized across all providers",
                                "Behavioral baseline per agent and role",
                                "Continuous drift & anomaly detection",
                                "Industry-benchmarked scoring model",
                                "Cross-provider behavioral comparison in one currency",
                                "Foundation for insurance underwriting and compliance rating",
                            ].map((f) => (
                                <li class="flex items-center gap-3 text-sm">
                                    <svg class="h-4 w-4 shrink-0 text-live" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                                    <span class="text-ink-1">{f}</span>
                                </li>
                            ))}
                        </ul>
                        <div class="mt-6 border-t border-line-0 pt-4">
                            <a href="/trust-score" class="font-mono text-xs text-ink-0/60 uppercase tracking-widest hover:underline">→ KYDE Trust Score™</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ HOW IT WORKS ══════════ -->
        <section class="relative border-t border-line-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">04 · How it works</span></div>
                </div>

                <div class="grid md:grid-cols-2 gap-16 md:gap-0 md:divide-x md:divide-line-0 [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-center mb-16">
                    <div>
                        <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-6">
                            <span class="text-ink-0">The proxy intercepts.</span> <span class="text-ink-2">Signs. Chains. Forwards.</span>
                        </h2>
                        <p class="text-ink-1 leading-relaxed mb-8">
                            KYDE runs as a local or hosted HTTP proxy, fully compatible with the OpenAI API schema. Any agent that can be pointed at a base URL can be governed.
                        </p>
                        <div class="dark-island border border-line-0 bg-bg-1 mb-8">
                            <div class="flex items-center gap-2 border-b border-line-0 px-4 py-3">
                                <span class="h-2.5 w-2.5 rounded-full bg-alert/40"></span>
                                <span class="h-2.5 w-2.5 rounded-full bg-warn/40"></span>
                                <span class="h-2.5 w-2.5 rounded-full bg-live/40"></span>
                                <span class="ml-2 text-xs text-ink-2 font-mono">terminal</span>
                                <button
                                    class="ml-auto font-mono text-[10px] tracking-[0.15em] text-ink-2 hover:text-ink-0 transition-colors"
                                    onclick="navigator.clipboard.writeText('export OPENAI_BASE_URL=https://kyde.intranet/v1');this.textContent='COPIED';setTimeout(()=>this.textContent='COPY',1400)"
                                >COPY</button>
                            </div>
                            <div class="p-5 font-mono text-sm overflow-x-auto">
                                <p class="text-ink-1 whitespace-nowrap"><span class="text-live">$</span><span class="text-ink-1"> export OPENAI_BASE_URL=https://kyde.intranet/v1</span></p>
                            </div>
                        </div>
                        <p class="font-mono text-sm text-ink-1">Target deployment: one environment variable. Designed for zero code changes.</p>
                    </div>

                    <!-- FIG.2 · the interception cycle -->
                    <div class="relative flex items-center justify-center min-h-[380px]">
                        <span class="fig-label absolute top-0 right-0">FIG.2</span>
                        <svg viewBox="-30 0 660 560" class="w-full max-w-md h-auto" aria-hidden="true">
                            <circle cx="280" cy="110" r="88" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.07" stroke-width="1" />
                            <circle cx="450" cy="280" r="88" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.07" stroke-width="1" />
                            <circle cx="280" cy="450" r="88" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.07" stroke-width="1" />
                            <circle cx="110" cy="280" r="88" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.07" stroke-width="1" />

                            <path class="draw" pathLength="1" d="M280 110 L450 280 L280 450 L110 280 Z" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.4" stroke-width="1" />

                            <path d="M262 262 L298 298 M298 262 L262 298" stroke="var(--color-ink-0)" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="2 3" />

                            <circle cx="280" cy="110" r="8" fill="var(--color-bg-0)" stroke="var(--color-ink-0)" stroke-width="1.25" />
                            <circle cx="450" cy="280" r="8" fill="var(--color-bg-0)" stroke="var(--color-ink-0)" stroke-width="1.25" />
                            <circle cx="280" cy="450" r="8" fill="var(--color-bg-0)" stroke="var(--color-ink-0)" stroke-width="1.25" />
                            <circle cx="110" cy="280" r="8" fill="var(--color-bg-0)" stroke="var(--color-ink-0)" stroke-width="1.25" />

                            <text x="280" y="72" text-anchor="middle" fill="var(--color-ink-0)" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">INTERCEPT</text>
                            <text x="280" y="92" text-anchor="middle" fill="var(--color-live)" fill-opacity="0.8" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">$ all agent traffic</text>

                            <text x="472" y="270" text-anchor="start" fill="var(--color-ink-0)" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">REGISTER</text>
                            <text x="472" y="290" text-anchor="start" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">identity · role · budget</text>

                            <text x="280" y="492" text-anchor="middle" fill="var(--color-ink-0)" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">SIGN &amp; CHAIN</text>
                            <text x="280" y="512" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">ed25519 · sha-256</text>

                            <text x="88" y="270" text-anchor="end" fill="var(--color-ink-0)" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">FORWARD</text>
                            <text x="88" y="290" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">&lt;100ms to provider</text>
                        </svg>
                    </div>
                </div>

                <!-- the four steps, datasheet register -->
                <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-0 border border-line-0 divide-y xl:divide-y-0 xl:divide-x divide-line-0">
                    {[
                        { n: "4.1", title: "Intercept", body: "Every request from every agent routes through the proxy. The agent sees no difference." },
                        { n: "4.2", title: "Register", body: "The request is matched to an agent identity and role. Budget and policy checks run before the call is forwarded." },
                        { n: "4.3", title: "Sign & Chain", body: "An Ed25519-signed, SHA-256 hash-chained entry is written. Alter any record and every subsequent link breaks." },
                        { n: "4.4", title: "Forward", body: "The original request continues to the LLM provider. Target added latency: under 100ms." },
                    ].map(({ n, title, body }) => (
                        <div class="p-6 bg-bg-1 hover:bg-bg-2 transition-colors">
                            <div class="flex items-baseline gap-3 mb-3">
                                <span class="font-mono text-[10px] text-gold">{n}</span>
                                <h3 class="font-mono text-sm font-bold text-ink-0 uppercase tracking-widest">{title}</h3>
                            </div>
                            <p class="text-sm text-ink-1 leading-relaxed">{body}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- ══════════ DASHBOARD ══════════ -->
        <section class="relative border-t border-line-0 bg-bg-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">05 · Audit Dashboard</span></div>
                </div>

                <div class="mb-10">
                    <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-ink-0 mb-3">
                        Full fleet visibility.
                    </h2>
                    <p class="text-ink-1 leading-relaxed max-w-2xl">
                        Every agent, session, and action across your infrastructure, mapped, logged, and auditable from a single dashboard.
                    </p>
                </div>

                <FleetStatusMock />

                <div class="h-6" aria-hidden="true"></div>

                <!-- Dashboard mock -->
                <div class="border border-line-0 bg-bg-1 overflow-hidden">
                    <!-- Browser chrome -->
                    <div class="flex items-center gap-2 border-b border-line-0 px-4 py-2.5 bg-bg-2">
                        <span class="h-2.5 w-2.5 rounded-full bg-alert/40"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-warn/60"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-live/40"></span>
                        <span class="ml-3 font-mono text-[10px] text-ink-0/35 bg-bg-1 px-3 py-0.5 border border-line-0 flex-1 max-w-xs">kyde.intranet/dashboard/topology</span>
                    </div>
                    <!-- App -->
                    <div class="flex overflow-x-auto" style="min-height:420px">
                        <!-- Sidebar (hidden on mobile so the main panel gets the full width) -->
                        <div class="hidden md:block w-44 shrink-0 border-r border-line-0 bg-bg-2 p-4">
                            <div class="mb-4">
                                <img src="/kyde-logo.svg" alt="KYDE" class="logo-mark h-3 w-auto mb-4" />
                                <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-live border border-live/30 px-1.5 py-0.5">Data Integrity</span>
                            </div>
                            <p class="font-mono text-[10px] font-bold text-ink-0 mt-4 mb-0.5">Audit Dashboard</p>
                            <p class="font-mono text-[9px] text-ink-0/35 uppercase tracking-[0.08em] mb-5">Agent Behavioral Ledger</p>
                            <ul class="space-y-0.5">
                                {["Overview", "Data Integrity", "Entry Timeline", "Sessions", "Token Analysis"].map((item) => (
                                    <li class="font-mono text-[10px] text-ink-0/45 py-1 px-2">
                                        {item}
                                    </li>
                                ))}
                                <li class="font-mono text-[10px] text-ink-0 font-semibold py-1 px-2 bg-bg-3/50">
                                    Agent Topology
                                </li>
                                {["DLP Alerts", "DLP Rules", "Users", "Settings"].map((item) => (
                                    <li class="font-mono text-[10px] text-ink-0/45 py-1 px-2">
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <!-- Main -->
                        <div class="flex-1 min-w-0 md:min-w-[480px] p-4 md:p-6">
                            <div class="flex items-start justify-between mb-5">
                                <div>
                                    <h3 class="font-mono text-sm font-bold text-ink-0">192.168.68.0/24</h3>
                                    <p class="font-mono text-[10px] text-ink-0/35 mt-0.5">RFC1918 (corporate private) · activity in the last 24 hours</p>
                                </div>
                                <span class="font-mono text-[10px] text-ink-0/40 border border-line-0 px-2 py-1">Last 24 hours ↓</span>
                            </div>

                            <!-- Agents -->
                            <div class="border border-line-0 mb-3">
                                <div class="px-4 py-2 bg-bg-2 border-b border-line-0">
                                    <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-0/50">Agents (3)</p>
                                </div>
                                <div class="grid px-4 py-1.5 border-b border-line-0" style="grid-template-columns: 2fr 1.2fr 1fr 60px 90px">
                                    {["Agent", "Role", "Upstreams", "Req.", "Last seen"].map((h) => (
                                        <p class="font-mono text-[9px] uppercase tracking-[0.1em] text-ink-0/35">{h}</p>
                                    ))}
                                </div>
                                {[
