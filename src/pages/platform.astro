---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Base
    title="Platform — KYDE"
    description="KYDE — Prevent · Prove · Rate. The behavioral firewall between AI agents and the real world. Prevent what must not happen. Prove what did. Rate agent behavior across every provider. Without touching agent code."
>
    <Navbar />

    <main>

        <!-- ══════════ HERO ══════════ -->
        <section class="relative overflow-hidden">
            <div class="bg-grid absolute inset-0 pointer-events-none"></div>
            <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-36 md:border-x md:border-[#1F1F1F]">

                <div class="mb-10">
                    <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">01 · The Behavioral Firewall — Platform</span></div>
                </div>

                <h1 class="hero-h1 max-w-5xl text-5xl text-[#F2F2F2] uppercase tracking-tight md:text-6xl lg:text-7xl">
                    The Behavioral<br />
                    <span class="gradient-text">Firewall.</span>
                </h1>

                <div class="mt-16 border-t border-[#1F1F1F] pt-10 grid md:grid-cols-[200px_1fr] gap-8 items-start">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#F2F2F2]">Securing the Agentic Economy</p>
                        <p class="mt-2 font-mono text-xs text-[#A8A8A8]">[KYDE]</p>
                    </div>
                    <div class="space-y-10">
                        <p class="text-sm uppercase tracking-wide leading-relaxed text-[#A8A8A8]">
                            The Behavioral Firewall sits between your agents and every LLM provider. Every agent gets a cryptographic identity, enforced behavioral scope, and a court-ready evidence trail — without touching a single line of agent code.
                        </p>

                        <!-- Stats -->
                        <div class="grid grid-cols-3 divide-x divide-[#1F1F1F] border border-[#1F1F1F]">
                            {[
                                { value: "<100ms", label: "Target latency" },
                                { value: "100%", label: "Planned provider coverage" },
                                { value: "0", label: "Code changes by design" },
                            ].map(({ value, label }) => (
                                <div class="px-6 py-5">
                                    <p class="font-mono text-2xl font-bold text-[#F2F2F2]">{value}</p>
                                    <p class="mt-1 text-xs text-[#A8A8A8] uppercase tracking-widest">{label}</p>
                                </div>
                            ))}
                        </div>

                        <!-- CTAs -->
                        <div class="flex flex-col sm:flex-row items-start gap-4">
                            <button
                                onclick="openModal()"
                                class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-sm font-semibold text-[#0A0A0A] hover:bg-[#E5E5E5] transition-all"
                            >
                                Talk to Us →
                            </button>
                            <a
                                href="/resources"
                                class="inline-flex items-center gap-2 border border-[#1F1F1F] px-6 py-3.5 text-sm font-semibold text-[#A8A8A8] hover:border-[#2E2E2E] hover:text-[#F2F2F2] transition-all"
                            >
                                View Integration Docs
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ PROBLEM ══════════ -->
        <section class="relative border-t border-[#1F1F1F]">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-[#1F1F1F]">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">02 · The operational gap</span></div>
                </div>

                <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight text-[#F2F2F2] uppercase mb-16">
                    Questions most enterprises<br />can't answer.
                </h2>

                <div class="grid gap-6 md:grid-cols-2">
                    {[
                        {
                            q: "Who acted?",
                            body: "Agents share service accounts with broad permissions. No traceable identity. No role boundaries. A support agent scoped for €500 refunds issues €5,000 because nobody scoped its authority.",
                            label: "Identity",
                        },
                        {
                            q: "Why did it decide that?",
                            body: "An HR agent retrieves a policy document from 2022 and uses it to guide a termination. The current policy says something different. Nobody logged which source it relied on.",
                            label: "Causal Context",
                        },
                        {
                            q: "What are the boundaries?",
                            body: "Token budgets don't exist. API access is unrestricted. An intern's research agent burns through your entire monthly token allocation while your production agents queue.",
                            label: "Scope & Budget",
                        },
                        {
                            q: "What happened?",
                            body: "A procurement agent posts confidential contract terms in Slack. Leadership needs the full evidence trail. The logs are vendor-provided, self-reported, software-only. A compromised host can rewrite them silently.",
                            label: "Tamper-Evidence",
                        },
                    ].map(({ q, body, label }) => (
                        <div class="border border-[#1F1F1F] p-8 bg-[#0C0C0C] transition-all hover:border-[#2E2E2E]">
                            <div class="mb-4 flex items-center justify-between">
                                <span class="font-mono text-xs uppercase tracking-widest text-[#A8A8A8]">{label}</span>
                                <span class="h-1.5 w-1.5 rounded-full bg-[#FF5C5C]/50"></span>
                            </div>
                            <h3 class="mb-4 text-xl font-bold text-[#F2F2F2]">{q}</h3>
                            <p class="leading-relaxed text-[#A8A8A8] text-sm">{body}</p>
                        </div>
                    ))}
                </div>

                <div class="flex items-center gap-4 my-6">
                    <div class="flex-1 border-t border-[#1F1F1F]"></div>
                    <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#A8A8A8]">And the question nobody asks until it's too late</span>
                    <div class="flex-1 border-t border-[#1F1F1F]"></div>
                </div>

                <div class="border border-[#1F1F1F] p-8 bg-[#0C0C0C] transition-all hover:border-[#2E2E2E]">
                    <div class="mb-4 flex items-center justify-between">
                        <span class="font-mono text-xs uppercase tracking-widest text-[#A8A8A8]">Cross-System Governance</span>
                        <span class="h-1.5 w-1.5 rounded-full bg-[#FF5C5C]/50"></span>
                    </div>
                    <h3 class="mb-4 text-xl font-bold text-[#F2F2F2]">Who governs the chain?</h3>
                    <p class="leading-relaxed text-[#A8A8A8] text-sm max-w-3xl">An agent raises a price in Salesforce, triggers a payment in Stripe, and updates inventory in SAP. Each vendor logs their own system. Nobody logs the complete workflow. When the chain breaks, you have fragmented logs across ten consoles — and zero cross-system governance.</p>
                </div>

                <div class="mt-12 px-6 py-16 text-center">
                    <p class="font-mono text-xl md:text-2xl font-normal uppercase tracking-[0.05em] text-[#F2F2F2] mx-auto leading-tight">
                        Resilient organizations don't just detect these failures.<br />They architect systems that prevent them.
                    </p>
                </div>

            </div>
        </section>

        <!-- ══════════ HOW IT WORKS ══════════ -->
        <section class="relative border-t border-[#1F1F1F]">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-[#1F1F1F]">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">03 · How it works</span></div>
                </div>

                <div class="grid md:grid-cols-2 gap-16 md:gap-0 md:divide-x md:divide-[#1F1F1F] [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-center mb-16">
                    <div>
                        <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-6">
                            <span class="text-[#F2F2F2]">The proxy intercepts.</span> <span class="text-[#6B6B6B]">Signs. Chains. Forwards.</span>
                        </h2>
                        <p class="text-[#A8A8A8] leading-relaxed mb-8">
                            KYDE runs as a local or hosted HTTP proxy, fully compatible with the OpenAI API schema. Any agent that can be pointed at a base URL can be governed.
                        </p>
                        <div class="border border-[#1F1F1F] bg-[#0C0C0C] mb-8">
                            <div class="flex items-center gap-2 border-b border-[#1F1F1F] px-4 py-3">
                                <span class="h-2.5 w-2.5 rounded-full bg-[#FF5C5C]/40"></span>
                                <span class="h-2.5 w-2.5 rounded-full bg-[#FFB84D]/40"></span>
                                <span class="h-2.5 w-2.5 rounded-full bg-[#3DDC84]/40"></span>
                                <span class="ml-2 text-xs text-[#6B6B6B] font-mono">terminal</span>
                                <button
                                    class="ml-auto font-mono text-[10px] tracking-[0.15em] text-[#6B6B6B] hover:text-[#F2F2F2] transition-colors"
                                    onclick="navigator.clipboard.writeText('export OPENAI_BASE_URL=https://kyde.intranet/v1');this.textContent='COPIED';setTimeout(()=>this.textContent='COPY',1400)"
                                >COPY</button>
                            </div>
                            <div class="p-5 font-mono text-sm">
                                <p class="text-[#A8A8A8]"><span class="text-[#3DDC84]">$</span><span class="text-[#A8A8A8]"> export OPENAI_BASE_URL=https://kyde.intranet/v1</span></p>
                            </div>
                        </div>
                        <p class="font-mono text-sm text-[#A8A8A8]">Target deployment: one environment variable. Designed for zero code changes.</p>
                    </div>

                    <!-- FIG.2 — the interception cycle -->
                    <div class="relative flex items-center justify-center min-h-[380px]">
                        <span class="fig-label absolute top-0 right-0">FIG.2</span>
                        <svg viewBox="0 0 560 560" class="w-full max-w-md h-auto" aria-hidden="true">
                            <circle cx="280" cy="110" r="88" fill="none" stroke="rgba(242,242,242,0.07)" stroke-width="1" />
                            <circle cx="450" cy="280" r="88" fill="none" stroke="rgba(242,242,242,0.07)" stroke-width="1" />
                            <circle cx="280" cy="450" r="88" fill="none" stroke="rgba(242,242,242,0.07)" stroke-width="1" />
                            <circle cx="110" cy="280" r="88" fill="none" stroke="rgba(242,242,242,0.07)" stroke-width="1" />

                            <path class="draw" pathLength="1" d="M280 110 L450 280 L280 450 L110 280 Z" fill="none" stroke="rgba(242,242,242,0.4)" stroke-width="1" />

                            <path d="M262 262 L298 298 M298 262 L262 298" stroke="rgba(242,242,242,0.3)" stroke-width="1" stroke-dasharray="2 3" />

                            <circle cx="280" cy="110" r="8" fill="#050505" stroke="#F2F2F2" stroke-width="1.25" />
                            <circle cx="450" cy="280" r="8" fill="#050505" stroke="#F2F2F2" stroke-width="1.25" />
                            <circle cx="280" cy="450" r="8" fill="#050505" stroke="#F2F2F2" stroke-width="1.25" />
                            <circle cx="110" cy="280" r="8" fill="#050505" stroke="#F2F2F2" stroke-width="1.25" />

                            <text x="280" y="72" text-anchor="middle" fill="#F2F2F2" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">INTERCEPT</text>
                            <text x="280" y="92" text-anchor="middle" fill="rgba(61,220,132,0.8)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">$ all agent traffic</text>

                            <text x="472" y="270" text-anchor="start" fill="#F2F2F2" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">REGISTER</text>
                            <text x="472" y="290" text-anchor="start" fill="rgba(242,242,242,0.45)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">identity · role · budget</text>

                            <text x="280" y="492" text-anchor="middle" fill="#F2F2F2" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">SIGN &amp; CHAIN</text>
                            <text x="280" y="512" text-anchor="middle" fill="rgba(242,242,242,0.45)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">ed25519 · sha-256</text>

                            <text x="88" y="270" text-anchor="end" fill="#F2F2F2" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;font-weight:700;letter-spacing:0.12em;">FORWARD</text>
                            <text x="88" y="290" text-anchor="end" fill="rgba(242,242,242,0.45)" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;">&lt;100ms to provider</text>
                        </svg>
                    </div>
                </div>

                <!-- the four steps, datasheet register -->
                <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-0 border border-[#1F1F1F] divide-y xl:divide-y-0 xl:divide-x divide-[#1F1F1F]">
                    {[
                        { n: "3.1", title: "Intercept", body: "Every request from every agent routes through the proxy. The agent sees no difference." },
                        { n: "3.2", title: "Register", body: "The request is matched to an agent identity and role. Budget and policy checks run before the call is forwarded." },
                        { n: "3.3", title: "Sign & Chain", body: "An Ed25519-signed, SHA-256 hash-chained entry is written. Alter any record — every subsequent link breaks." },
                        { n: "3.4", title: "Forward", body: "The original request continues to the LLM provider. Target added latency: under 100ms." },
                    ].map(({ n, title, body }) => (
                        <div class="p-6 bg-[#0C0C0C] hover:bg-[#141414] transition-colors">
                            <div class="flex items-baseline gap-3 mb-3">
                                <span class="font-mono text-[10px] text-[#6B6B6B]">{n}</span>
                                <h3 class="font-mono text-sm font-bold text-[#F2F2F2] uppercase tracking-widest">{title}</h3>
                            </div>
                            <p class="text-sm text-[#A8A8A8] leading-relaxed">{body}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- ══════════ DASHBOARD ══════════ -->
        <section class="relative border-t border-[#1F1F1F] bg-[#050505]">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-[#1F1F1F]">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">04 · Audit Dashboard</span></div>
                </div>

                <div class="mb-10">
                    <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-[#F2F2F2] mb-3">
                        Full fleet visibility. One view.
                    </h2>
                    <p class="text-[#A8A8A8] leading-relaxed max-w-2xl">
                        Every agent, session, and action across your infrastructure — mapped, logged, and auditable from a single dashboard.
                    </p>
                </div>

                <!-- Dashboard mock -->
                <div class="border border-[#1F1F1F] bg-[#0C0C0C] overflow-hidden">
                    <!-- Browser chrome -->
                    <div class="flex items-center gap-2 border-b border-[#1F1F1F] px-4 py-2.5 bg-[#141414]">
                        <span class="h-2.5 w-2.5 rounded-full bg-[#FF5C5C]/40"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-[#FFB84D]/60"></span>
                        <span class="h-2.5 w-2.5 rounded-full bg-[#3DDC84]/40"></span>
                        <span class="ml-3 font-mono text-[10px] text-[#F2F2F2]/35 bg-[#0C0C0C] px-3 py-0.5 border border-[#1F1F1F] flex-1 max-w-xs">kyde.intranet/dashboard/topology</span>
                    </div>
                    <!-- App -->
                    <div class="flex" style="min-height:420px">
                        <!-- Sidebar -->
                        <div class="w-44 shrink-0 border-r border-[#1F1F1F] bg-[#141414] p-4">
                            <div class="mb-4">
                                <img src="/kyde-logo.svg" alt="KYDE" class="h-3 w-auto mb-4" />
                                <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-[#3DDC84] border border-[#3DDC84]/30 px-1.5 py-0.5">Data Integrity</span>
                            </div>
                            <p class="font-mono text-[10px] font-bold text-[#F2F2F2] mt-4 mb-0.5">Audit Dashboard</p>
                            <p class="font-mono text-[9px] text-[#F2F2F2]/35 uppercase tracking-[0.08em] mb-5">Agent Behavioral Ledger</p>
                            <ul class="space-y-0.5">
                                {["Overview", "Data Integrity", "Entry Timeline", "Sessions", "Token Analysis"].map((item) => (
                                    <li class="font-mono text-[10px] text-[#F2F2F2]/45 py-1 px-2">
                                        {item}
                                    </li>
                                ))}
                                <li class="font-mono text-[10px] text-[#F2F2F2] font-semibold py-1 px-2 bg-[#1C1C1C]/50">
                                    Agent Topology
                                </li>
                                {["DLP Alerts", "DLP Rules", "Users", "Settings"].map((item) => (
                                    <li class="font-mono text-[10px] text-[#F2F2F2]/45 py-1 px-2">
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <!-- Main -->
                        <div class="flex-1 p-6">
                            <div class="flex items-start justify-between mb-5">
                                <div>
                                    <h3 class="font-mono text-sm font-bold text-[#F2F2F2]">192.168.68.0/24</h3>
                                    <p class="font-mono text-[10px] text-[#F2F2F2]/35 mt-0.5">RFC1918 (corporate private) — activity in the last 24 hours</p>
                                </div>
                                <span class="font-mono text-[10px] text-[#F2F2F2]/40 border border-[#1F1F1F] px-2 py-1">Last 24 hours ↓</span>
                            </div>

                            <!-- Agents -->
                            <div class="border border-[#1F1F1F] mb-3">
                                <div class="px-4 py-2 bg-[#141414] border-b border-[#1F1F1F]">
                                    <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-[#F2F2F2]/50">Agents (3)</p>
                                </div>
                                <div class="grid px-4 py-1.5 border-b border-[#1F1F1F]" style="grid-template-columns: 2fr 1.2fr 1fr 60px 90px">
                                    {["Agent", "Role", "Upstreams", "Req.", "Last seen"].map((h) => (
                                        <p class="font-mono text-[9px] uppercase tracking-[0.1em] text-[#F2F2F2]/35">{h}</p>
                                    ))}
                                </div>
                                {[
                                    { id: "agent:b6068d94edf0", role: "customer_facing", up: "anthropic", req: "6", time: "12:45:53" },
                                    { id: "agent:a2f1c8b3d7e9", role: "infrastructure", up: "openai", req: "24", time: "12:44:11" },
                                    { id: "agent:9e4d2c1f6a8b", role: "intern_sandbox", up: "openai", req: "3", time: "12:39:07" },
                                ].map(({ id, role, up, req, time }) => (
                                    <div class="grid px-4 py-2 border-b border-[#1F1F1F] hover:bg-[#1C1C1C]" style="grid-template-columns: 2fr 1.2fr 1fr 60px 90px">
                                        <p class="font-mono text-[10px] text-[#F2F2F2]">{id}</p>
                                        <p class="font-mono text-[10px] text-[#F2F2F2]/55">{role}</p>
                                        <p class="font-mono text-[10px] text-[#F2F2F2]/55">{up}</p>
                                        <p class="font-mono text-[10px] text-[#F2F2F2]">{req}</p>
                                        <p class="font-mono text-[10px] text-[#F2F2F2]/40">{time}</p>
                                    </div>
                                ))}
                            </div>

                            <!-- Sessions -->
                            <div class="border border-[#1F1F1F]">
                                <div class="px-4 py-2 bg-[#141414] border-b border-[#1F1F1F]">
                                    <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-[#F2F2F2]/50">Recent Sessions (3)</p>
                                </div>
                                <div class="grid px-4 py-1.5 border-b border-[#1F1F1F]" style="grid-template-columns: 2fr 2fr 60px 90px">
                                    {["Session", "Model", "Req.", "Last seen"].map((h) => (
                                        <p class="font-mono text-[9px] uppercase tracking-[0.1em] text-[#F2F2F2]/35">{h}</p>
                                    ))}
                                </div>
                                {[
                                    { id: "s-5944d14b2406", model: "claude-sonnet-4-6", req: "4", time: "12:45:53" },
                                    { id: "s-3c1700ddb97e", model: "claude-haiku-4-5", req: "1", time: "12:45:34" },
                                    { id: "session:b878a6801d9a9e68", model: "gpt-4o", req: "1", time: "12:39:07" },
                                ].map(({ id, model, req, time }) => (
                                    <div class="grid px-4 py-2 border-b border-[#1F1F1F] hover:bg-[#1C1C1C]" style="grid-template-columns: 2fr 2fr 60px 90px">
                                        <p class="font-mono text-[10px] text-[#F2F2F2]">{id}</p>
                                        <p class="font-mono text-[10px] text-[#F2F2F2]/55">{model}</p>
                                        <p class="font-mono text-[10px] text-[#F2F2F2]">{req}</p>
                                        <p class="font-mono text-[10px] text-[#F2F2F2]/40">{time}</p>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ══════════ WHAT GETS CAPTURED ══════════ -->
        <section class="relative border-t border-[#1F1F1F]">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-[#1F1F1F]">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#6B6B6B]">05 · Evidence capture</span></div>
                </div>

                <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-[#F2F2F2] mb-16">
                    Every entry answers five questions.
                </h2>

                <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-[#1F1F1F] [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-start">

                    <!-- Field table -->
                    <div class="border border-[#1F1F1F] divide-y divide-[#1F1F1F]">
                        {[
                            { field: "Who", desc: "Agent ID, role, machine ID, user identity" },
                            { field: "What", desc: "Prompt, model, tool calls, response" },
                            { field: "Why", desc: "Last 5 messages as causal context" },
                            { field: "When", desc: "Millisecond-precise UTC timestamp" },
                            { field: "Proof", desc: "Ed25519 signature + SHA-256 hash chain link" },
                        ].map(({ field, desc }) => (
                            <div class="grid grid-cols-[80px_1fr] divide-x divide-[#1F1F1F]">
                                <div class="px-4 py-4 bg-[#050505]">
