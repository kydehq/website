---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ARTICLES, GUIDES } from "../data/content-index";

const regulations = [
    {
        name: "EU AI Act",
        desc: "Risk-based framework for AI systems. High-Risk AI System logging requirements.",
        deadline: "Enforcement: Dec 2, 2027",
        urgency: true,
    },
    {
        name: "NIS-2 Directive",
        desc: "Network and Information Security for essential and important entities.",
        deadline: "In force: December 2025",
        urgency: false,
    },
    {
        name: "DORA",
        desc: "Digital Operational Resilience Act for financial sector entities.",
        deadline: "In force: January 2025",
        urgency: false,
    },
    {
        name: "GDPR",
        desc: "Art. 22 covers automated decision-making. Art. 35 requires DPIA for high-risk processing.",
        deadline: "In force",
        urgency: false,
    },
    {
        name: "eIDAS, Qualified Electronic Ledgers",
        desc: "Arts. 45k and 45l, with technical rules in Implementing Regulation (EU) 2025/2531. Nobody is obliged to use one, but it is where the EU wrote down what a defensible record looks like.",
        deadline: "In force: January 6, 2026",
        urgency: false,
        href: "/qualified-electronic-ledger",
    },
];

const articles = ARTICLES;

const guides = GUIDES;


const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://kyde.com/" },
        { "@type": "ListItem", position: 2, name: "Resources", item: "https://kyde.com/resources" },
    ],
};
---

<Base
    title="Resources, KYDE"
    description="Documentation, regulatory analysis, and technical guides for enterprises deploying AI agents in production."
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    </Fragment>
    <Navbar />

    <main>

        <!-- ══════════ HERO ══════════ -->
        <section class="relative overflow-hidden">
            <div class="bg-grid absolute inset-0 pointer-events-none"></div>
            <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-36 md:border-x md:border-line-0">

                <div class="mb-10">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">01 · Resources</span></div>
                </div>

                <h1 class="hero-h1 max-w-4xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl">
                    Documentation, Guides,<br />
                    <span class="gradient-text">and Research.</span>
                </h1>

            </div>
        </section>

        <!-- ══════════ DOCUMENTATION ══════════ -->
        <section class="border-t border-line-1">
            <div class="max-w-7xl mx-auto px-6 pb-16 md:border-x md:border-line-0">
                <div class="p-10 max-w-2xl">
                    <div class="mb-4 inline-flex items-center gap-2 border border-live/30 px-3 py-1">
                        <span class="h-1.5 w-1.5 rounded-full bg-live animate-pulse"></span>
                        <span class="text-xs font-mono text-live">Live</span>
                    </div>
                    <h2 class="text-xl font-bold text-ink-0 uppercase tracking-tight mb-3">Documentation</h2>
                    <p class="text-sm text-ink-1 leading-relaxed mb-2">
                        Deployment guide, provider and MCP routing reference, and the CLI live in the open-source Kyde Gateway repository. Standalone quickstart and migration guides on this site are rolling out.
                    </p>
                    <div class="mt-6 flex flex-col sm:flex-row gap-3">
                        <a
                            href="/audit"
                            class="inline-flex items-center gap-2 bg-white px-5 py-2.5 text-sm font-semibold text-cta-ink hover:bg-cta-hover transition-all"
                        >
                            Deploy the Gateway →
                        </a>
                        <a
                            href="https://github.com/kydehq/gateway"
                            target="_blank"
                            rel="noopener"
                            class="inline-flex items-center gap-2 border border-line-0 px-5 py-2.5 text-sm font-semibold text-ink-1 hover:border-line-1 hover:text-ink-0 transition-all"
                        >
                            View Docs on GitHub →
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════ TECHNICAL GUIDES ══════════ -->
        <section class="border-t border-line-1">
            <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-6"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">02 · Technical Guides</span></div>
                    <div class="max-w-2xl">
                        <p class="text-sm text-ink-1 leading-relaxed mb-4">
                            <strong>The Shadow AI Trilogy.</strong> Three interconnected guides that form the complete playbook for discovering, classifying, and governing unscoped AI systems.
                        </p>
                        <a href="/shadow-ai-trilogy" class="inline-flex items-center gap-2 text-sm font-semibold text-ink-1 hover:text-ink-0 transition-colors">
                            View Trilogy Overview →
                        </a>
                    </div>
                </div>

                <div class="space-y-4">
                    {guides.map(({ category, title, summary, href, readTime, tags }) => (
                        <a
                            href={href}
                            class="group block border-b border-line-1 transition-all hover:bg-bg-1/[0.02] p-8"
                        >
                            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-3">
                                        <span class="font-mono text-xs uppercase tracking-widest text-ink-1">{category}</span>
                                        <span class="text-ink-1">·</span>
                                        <span class="font-mono text-xs text-ink-1">{readTime}</span>
                                    </div>
                                    <h3 class="text-lg font-bold text-ink-0 mb-2 group-hover:text-ink-0 leading-snug">{title}</h3>
                                    <p class="text-sm text-ink-1 leading-relaxed mb-3">{summary}</p>
                                    <div class="flex flex-wrap gap-2">
                                        {tags.map((tag) => (
                                            <span class="inline-flex items-center border border-line-0 bg-bg-0 px-2 py-1 text-xs font-mono text-ink-1">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                                <span class="font-mono text-ink-1 text-sm shrink-0 mt-1 group-hover:translate-x-1 transition-transform">→</span>
                            </div>
                        </a>
                    ))}
                </div>

            </div>
        </section>

        <!-- ══════════ BLOG & INSIGHTS ══════════ -->
        <section class="border-t border-line-1">
            <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">

                <div class="mb-12">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-6"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">03 · Blog & Insights</span></div>
                    <p class="text-sm text-ink-1 max-w-2xl leading-relaxed">
                        Regulatory analysis, technical deep-dives, and operational guidance for enterprises deploying AI agents at scale.
                    </p>
                </div>

                <!-- Published articles, hub-card pattern -->
                <div class="grid md:grid-cols-2 gap-px mb-12">
                    {articles.map(({ category, title, summary, href, readTime }) => (
                        <a
                            href={href}
                            class="group flex flex-col border border-line-0 bg-bg-1 hover:bg-bg-2 hover:border-line-1 transition-all p-6"
                        >
                            <div class="flex items-center justify-between mb-4">
                                <span class="font-mono text-[10px] text-ink-2">◆ kyde/blog</span>
                                <span class="font-mono text-[10px] text-ink-2">{readTime}</span>
                            </div>
                            <h3 class="text-lg font-bold text-ink-0 mb-2 leading-snug">{title}</h3>
                            <p class="text-sm text-ink-1 leading-relaxed line-clamp-2 mb-5">{summary}</p>
                            <div class="mt-auto flex items-center justify-between border-t border-line-0 pt-3">
                                <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-ink-2">
                                    <span class="text-live">&#10003;</span>{category}
                                </span>
                                <span class="font-mono text-ink-2 text-sm group-hover:translate-x-1 group-hover:text-ink-0 transition-all">→</span>
                            </div>
                        </a>
                    ))}
                </div>

            </div>
        </section>

        <!-- ══════════ REGULATORY CONTEXT ══════════ -->
        <section class="border-t border-line-1">
            <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">

                <div class="mb-10">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-6"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">04 · Regulatory Context</span></div>
                    <p class="text-sm text-ink-1 max-w-2xl leading-relaxed">
                        The frameworks whose agent-layer duties Kyde is built to evidence.
                    </p>
                </div>

                <div class="max-w-3xl space-y-3">
                    {regulations.map(({ name, desc, deadline, urgency, href }) => {
                        const Card = href ? "a" : "div";
                        return (
                        <Card href={href} class={`block border p-6 transition-colors ${urgency ? "border-alert/30 bg-alert/5 hover:border-alert/40" : "border-line-0 bg-bg-1 hover:border-line-1"}`}>
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <h3 class="font-mono text-base font-bold text-ink-0">{name}</h3>
                                    <p class="mt-1 text-sm text-ink-1 leading-relaxed">{desc}</p>
                                </div>
                                {urgency && (
                                    <span class="shrink-0 border border-alert/40 bg-alert/10 px-2.5 py-1 text-xs font-mono text-alert">
                                        Urgent
                                    </span>
                                )}
                            </div>
                            <p class={`mt-3 font-mono text-xs ${deadline.includes('In force') ? 'text-live' : 'text-ink-1'}`}>{deadline}</p>
                        </Card>
                    );
                    })}
                </div>

            </div>
        </section>

        <!-- ══════════ COMPARE & ANSWERS ══════════ -->
        <section class="border-t border-line-1">
            <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">

                <div class="mb-10">
                    <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-6"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">05 · Compare & Answers</span></div>
                    <p class="text-sm text-ink-1 max-w-2xl leading-relaxed">
                        Self-qualification, honest vendor comparisons, and the questions security and compliance teams ask before they deploy.
                    </p>
                </div>

                <div class="grid md:grid-cols-3 gap-4">
                    {[
                        { title: "Zero Trust for AI Agents", summary: "Never trust, always verify, per action: the six dimensions and how to enforce them.", href: "/zero-trust-for-ai-agents" },
                        { title: "Glossary",              summary: "The vocabulary of agent governance, defined precisely: firewall, attestation, egress, and more.", href: "/glossary" },
                        { title: "Kyde vs WitnessAI",     summary: "Enforcement vs inference: an honest, named comparison for 2026.", href: "/compare/kyde-vs-witnessai" },
                        { title: "Kyde vs Alinia AI",     summary: "SDK guardrails vs a network boundary that covers agents nobody wrapped.", href: "/compare/kyde-vs-alinia" },
                        { title: "Kyde vs Geordie AI",    summary: "Context engineering vs deterministic enforcement outside the agent's reach.", href: "/compare/kyde-vs-geordie" },
                        { title: "Kyde vs Kyvvu",         summary: "In-process security kernel vs a boundary no agent can opt out of.", href: "/compare/kyde-vs-kyvvu" },
                        { title: "Kyde vs Lakera",        summary: "Detection at Check Point scale vs governance with a hash-chained ledger.", href: "/compare/kyde-vs-lakera" },
                        { title: "Kyde vs Microsoft Agent 365", summary: "Opt-in control plane vs structural coverage for agents that never registered.", href: "/compare/kyde-vs-microsoft-agent-365" },
                        { title: "Kyde vs Zenity",        summary: "Estate-by-estate platform connectors vs one unavoidable network boundary.", href: "/compare/kyde-vs-zenity" },
                        { title: "Kyde vs Noma Security", summary: "AI security lifecycle platform vs deterministic mandates with boundary proof.", href: "/compare/kyde-vs-noma-security" },
                        { title: "Kyde vs Vanta",         summary: "Program-level compliance automation vs runtime enforcement and action evidence.", href: "/compare/kyde-vs-vanta" },
                        { title: "FAQ",                   summary: "Latency, data privacy, audit evidence, and how Kyde compares to a SIEM or API gateway.", href: "/faq" },
                    ].map(({ title, summary, href }) => (
                        <a
                            href={href}
                            class="group flex flex-col border border-line-0 bg-bg-1 hover:bg-bg-2 hover:border-line-1 transition-all p-6"
                        >
                            <h3 class="text-lg font-bold text-ink-0 mb-2 leading-snug">{title}</h3>
                            <p class="text-sm text-ink-1 leading-relaxed flex-1">{summary}</p>
                            <span class="mt-4 font-mono text-xs text-ink-2 group-hover:translate-x-1 group-hover:text-ink-0 transition-all">Read →</span>
                        </a>
                    ))}
                </div>

            </div>
        </section>

        <!-- ══════════ CTA ══════════ -->
        <section class="border-t border-line-1">
            <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
                <div class="border-b border-line-1 p-12 md:p-20 max-w-2xl">
                    <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Questions?</p>
                    <div class="mb-6 h-px bg-bg-1/40"></div>
                    <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.03] text-ink-0 mb-3">
                        Questions before the docs arrive?
                    </h2>
                    <p class="text-ink-1 mb-6 text-sm leading-relaxed">We respond to every message.</p>
                    <a
                        href="mailto:hello@kyde.com"
                        class="inline-flex items-center gap-2 border border-line-0 px-6 py-3 text-sm font-semibold text-ink-1 hover:border-line-1 hover:text-ink-0 transition-all"
                    >
                        hello@kyde.com →
                    </a>
                </div>
            </div>
        </section>

    </main>

    <Footer />
</Base>
