---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// The product-intent page for drift. /behavioral-drift/ is the research text
// and ranks around position 12 for "behavioral drift"; searches with buying
// intent ("agent drift detection", "ai agent drift monitoring") sat near
// position 70 because no page answered them. This one does, and hands over
// to /score/. Every product claim here is backed by kydehq/score as of
// November 2026: 30-run baseline, CUSUM, windowed JSD, task contract,
// HMAC-signed webhook on band change, no LLM in the verdict.

const faqs = [
    {
        q: "What is AI agent drift?",
        a: "AI agent drift is a change in how an agent behaves compared with how it behaved before, without anyone deciding that it should change. It can come from a model update, a changed prompt or tool, content the agent read during a task, or a loop. In production it shows up in the agent's actions: which tools it calls, in what order, how often and against which targets.",
    },
    {
        q: "How do you detect drift in an AI agent?",
        a: "Record the agent's actions, learn what normal looks like for that specific agent, and compare every new run against it. Kyde Score learns from the first 30 runs over at least 3 days, then runs three deterministic detectors on every later run: one for abrupt shifts, one for gradual drift, and a task contract that flags tools the agent has never used for that task.",
    },
    {
        q: "Can drift detection catch prompt injection?",
        a: "Not the injected text itself. Kyde Score never sees prompts or page content. What it can catch is the change in behavior that a successful injection usually causes, such as an agent calling a tool it has never used for that task or suddenly making far more calls than usual.",
    },
    {
        q: "Do I need an SDK?",
        a: "No. Kyde Score reads OpenTelemetry. Harnesses with built-in telemetry, such as Claude Code, Codex and OpenCode, only need a few environment variables. For your own agent, any OpenTelemetry exporter works.",
    },
    {
        q: "Why not use an LLM to judge whether an agent drifted?",
        a: "An LLM judge is itself a model that can change between versions, and it reads the same content that may have misled the agent. We think the verdict should come from statistics that give the same result for the same log every time, so that anyone can recompute it.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://kyde.com/" },
        { "@type": "ListItem", position: 2, name: "AI Agent Drift Detection", item: "https://kyde.com/agent-drift-detection/" },
    ],
};

const signals = [
    {
        label: "Hijacked",
        title: "The agent read something and changed course",
        body: "A coding or support agent reads a prepared web page, email, issue or file and then does something it was not asked to do. The instruction is hidden in the content, so nothing looks wrong in the prompt. What changes is the behavior: a tool the agent does not normally use for this task, a new target, an unusual sequence of calls.",
        href: "/agent-prompt-injection-detection/",
        link: "Detecting indirect prompt injection in AI agents",
    },
    {
        label: "Looping",
        title: "The agent repeats itself and burns money",
        body: "An agent retries the same call, re-plans the same step or calls itself through another agent. Each step looks valid on its own. Taken together, the run makes the identical call again and again, and the cost follows.",
        href: "/agent-loop-detection/",
        link: "Detecting AI agents stuck in a loop",
    },
    {
        label: "Silent change",
        title: "The agent behaves differently after an update",
        body: "A model version changes, a system prompt is edited or a tool description is updated. Nothing fails, but the agent's mix of tools and the order in which it uses them shift over days. This is the kind of drift that rarely produces an error and often surfaces first as a complaint or an invoice.",
    },
];

const detectors = [
    {
        name: "Abrupt shift",
        method: "CUSUM",
        body: "Accumulates small deviations from the baseline and fires when they add up to a real break. Catches the run where an agent suddenly starts behaving differently.",
    },
    {
        name: "Gradual drift",
        method: "Windowed Jensen-Shannon divergence",
        body: "Compares the distribution of recent behavior with the baseline distribution. Catches a clear slow shift after a model or prompt change that no single run would reveal. Small changes it does not reliably see.",
    },
    {
        name: "Task contract",
        method: "Strict rule per task",
        body: "Records which tools an agent used for each kind of task during the baseline. A tool that never appeared for that task is flagged on first use. With the optional customer-side collector profile, new targets such as merchants or recipients are covered too, as salted hashes.",
    },
];
---

<Base
    title="AI Agent Drift Detection: Know When an Agent Stops Behaving Like Itself | KYDE"
    description="How to detect drift in AI agents in production: hijacked agents, loops and silent changes after updates. Kyde Score learns each agent's baseline from OpenTelemetry and alerts on change with deterministic detectors. Free hosted tier."
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    </Fragment>
    <Navbar />

    <main>

        <!-- ══════════ HERO ══════════ -->
        <section data-surface="blush" class="page-hero relative overflow-hidden">
            <div class="bg-grid absolute inset-0 pointer-events-none"></div>
            <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-32 md:border-x md:border-line-0">

                <p class="hero-label">(drift detection)</p>

                <h1 class="hero-h1 max-w-4xl text-4xl font-bold text-ink-0 uppercase tracking-tight md:text-5xl lg:text-6xl">
                    AI agent drift detection
                </h1>
                <p class="mt-8 text-lg text-ink-1 leading-relaxed max-w-2xl">
                    If you run agents with access to tools, the costly failures rarely come with an error message. An agent gets steered by content it read, gets stuck in a loop, or starts behaving differently after an update, and the first sign is often a bill or a leak. Drift detection compares every run of an agent with how that same agent normally behaves, and tells you when the difference becomes real.
                </p>

                <div class="mt-10 flex flex-col sm:flex-row gap-3">
                    <a
                        href="https://score.kyde.com"
                        class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all w-fit"
                    >
                        Start free at score.kyde.com &rarr;
                    </a>
                    <a
                        href="/score/"
                        class="inline-flex items-center gap-2 border border-line-0 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-1 hover:border-line-1 hover:text-ink-0 transition-all w-fit"
                    >
                        How Kyde Score works
                    </a>
                </div>

            </div>
        </section>

        <!-- ══════════ WHAT DRIFT LOOKS LIKE ══════════ -->
        <section class="relative">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
                <div class="grid md:grid-cols-[200px_1fr] gap-8 items-start">

                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">In production</p>
                        <p class="mt-2 font-mono text-xs text-ink-1">[3 patterns]</p>
                    </div>

                    <div class="max-w-2xl">
                        <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.1] text-ink-0 mb-6">
                            What agent drift looks like in production
                        </h2>
                        <p class="text-lg leading-relaxed text-ink-1 mb-10">
                            The research on behavioral drift describes at least seven related forms, which we cover in <a href="/behavioral-drift/" class="underline underline-offset-4 hover:text-ink-0">Behavioral Drift in AI Agents</a>. For teams running agents today, three patterns account for most of the practical risk.
                        </p>
                        <div class="space-y-10">
                            {signals.map(({ label, title, body, href, link }) => (
                                <div class="border-l-2 border-line-1 pl-6">
                                    <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ember mb-2">{label}</p>
                                    <h3 class="text-lg font-bold text-ink-0 mb-2">{title}</h3>
                                    <p class="text-base leading-relaxed text-ink-1">{body}</p>
                                    {href && (
                                        <a href={href} class="mt-3 inline-block text-sm text-ink-1 underline underline-offset-4 hover:text-ink-0">{link} &rarr;</a>
                                    )}
                                </div>
                            ))}
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════ HOW IT WORKS ══════════ -->
        <section class="relative border-t border-line-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
                <div class="grid md:grid-cols-[200px_1fr] gap-8 items-start">

                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">Method</p>
                        <p class="mt-2 font-mono text-xs text-ink-1">[deterministic]</p>
                    </div>

                    <div class="max-w-2xl">
                        <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.1] text-ink-0 mb-6">
                            How drift detection works in Kyde Score
                        </h2>
                        <p class="text-lg leading-relaxed text-ink-1 mb-6">
                            Kyde Score reads the OpenTelemetry your agent already emits: which tool was called, when, in which step and with what result. It does not store prompts or payloads. Each agent learns from its first 30 runs over at least 3 days, and that baseline is then frozen and fingerprinted, so later runs are always measured against the same reference.
                        </p>
                        <p class="text-lg leading-relaxed text-ink-1 mb-10">
                            Every run after that passes three detectors. Their results combine into a score from 0 to 100: 70 to 100 is normal, 40 to 69 is worth watching, and below 40 the agent is deviating from its own baseline. When the score changes band, Kyde sends a webhook signed with HMAC-SHA256 to the URL you choose.
                        </p>
                        <div class="grid gap-px bg-line-0 border border-line-0">
                            {detectors.map(({ name, method, body }) => (
                                <div class="bg-bg-0 px-6 py-6">
                                    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                                        <h3 class="text-base font-bold text-ink-0">{name}</h3>
                                        <span class="font-mono text-[11px] text-ink-1">{method}</span>
                                    </div>
                                    <p class="text-base leading-relaxed text-ink-1">{body}</p>
                                </div>
                            ))}
                        </div>
                        <p class="mt-6 text-base leading-relaxed text-ink-1">
                            The detection math is open source in <a href="https://github.com/kydehq/behavioral-drift-detection" target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-ink-0">kydehq/behavioral-drift-detection</a>.
                        </p>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════ WHY DETERMINISTIC ══════════ -->
        <section class="relative border-t border-line-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
                <div class="grid md:grid-cols-[200px_1fr] gap-8 items-start">

                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">Why statistics</p>
                        <p class="mt-2 font-mono text-xs text-ink-1">[no LLM judge]</p>
                    </div>

                    <div class="max-w-2xl space-y-6">
                        <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.1] text-ink-0">
                            Why the verdict comes from statistics, not from another model
                        </h2>
                        <p class="text-lg leading-relaxed text-ink-1">
                            A common way to monitor agents is to ask a second language model whether the first one behaved well. That can be useful for reviewing quality, but it has two weaknesses for drift. The judge is itself a model that may change between versions, and it reads the same content that may have misled the agent in the first place.
                        </p>
                        <p class="text-lg leading-relaxed text-ink-1">
                            Kyde Score keeps language models out of the verdict. The same log always produces the same score, and every score names the baseline and method version it was computed against. In practice, that means an alert can be checked by someone who does not trust Kyde: replay the log and the number comes out the same.
                        </p>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════ LIMITS ══════════ -->
        <section class="relative border-t border-line-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
                <div class="grid md:grid-cols-[200px_1fr] gap-8 items-start">

                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">Limits</p>
                        <p class="mt-2 font-mono text-xs text-ink-1">[what it is not]</p>
                    </div>

                    <div class="max-w-2xl space-y-6">
                        <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.1] text-ink-0">
                            What drift detection does not do
                        </h2>
                        <p class="text-lg leading-relaxed text-ink-1">
                            Kyde Score does not read prompts, so it cannot tell you that a page contained an injection. It tells you that the agent's behavior changed afterwards, which is often the more useful signal because it holds regardless of how the injection was phrased. The drift score also needs a baseline: during its first 30 runs and at least 3 days, an agent is learning and has no score. Loop detection is the exception. Three identical calls in a row raise an alarm from the first run, provided the agent sends a parameter digest with each tool call.
                        </p>
                        <p class="text-lg leading-relaxed text-ink-1">
                            The hosted service alerts and does not block. If you need an agent stopped, quarantined or held to a policy inside your own network, that is Kyde Control, described in the <a href="/docs/" class="underline underline-offset-4 hover:text-ink-0">documentation</a>.
                        </p>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════ FAQ ══════════ -->
        <section class="relative border-t border-line-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
                <div class="grid md:grid-cols-[200px_1fr] gap-8 items-start">

                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">FAQ</p>
                        <p class="mt-2 font-mono text-xs text-ink-1">[{faqs.length} questions]</p>
                    </div>

                    <div class="max-w-2xl divide-y divide-line-0 border-y border-line-0">
                        {faqs.map(({ q, a }) => (
                            <div class="py-6">
                                <h2 class="text-lg font-bold text-ink-0 mb-2">{q}</h2>
                                <p class="text-base leading-relaxed text-ink-1">{a}</p>
                            </div>
                        ))}
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════ CLOSE ══════════ -->
        <section data-surface="blush" class="page-close relative border-t border-line-0">
            <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-28 md:border-x md:border-line-0">
                <div class="max-w-2xl">
                    <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-[1.1] text-ink-0 mb-6">
                        Try it on one agent
                    </h2>
                    <p class="text-lg leading-relaxed text-ink-1 mb-8">
                        Kyde Score is free to start. Create a key, set three environment variables and let the agent run. After 30 runs over at least 3 days it has a baseline, and from then on you get a score per run and a webhook when it changes band.
                    </p>
                    <a
                        href="https://score.kyde.com"
                        class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all w-fit"
                    >
                        Start free at score.kyde.com &rarr;
                    </a>
                </div>
            </div>
        </section>

    </main>

    <Footer />
</Base>
