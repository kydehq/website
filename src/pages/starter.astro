---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FleetStatusMock from '../components/FleetStatusMock.astro';
---

<Base
  title="KYDE Gateway Starter, Deploy in Minutes, See Your Agents for the First Time"
  description="Deploy the free KYDE Gateway Starter edition via Docker Compose and one environment variable. No license required. See your agent traffic on a dashboard within minutes."
>
  <Navbar />
  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative bg-bg-1 overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-[0.06] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-32 pb-20 md:border-x md:border-line-0">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-8">
            <span class="font-mono text-[10px] uppercase tracking-widest text-white/30 border border-white/15 px-3 py-1">Free</span>
            <span class="font-mono text-[10px] text-white/20">·</span>
            <span class="font-mono text-[10px] uppercase tracking-widest text-live/80 border border-live/30 px-3 py-1">Kyde Gateway Starter</span>
          </div>
          <h1 class="hero-h1 text-4xl md:text-5xl lg:text-6xl text-white uppercase tracking-tight leading-[1.05] mb-6">
            <span class="text-white">Your agents are acting.</span><br /><span class="text-white/40">See what they're doing.</span>
          </h1>
          <p class="text-lg text-white/50 leading-relaxed max-w-xl mb-10">
            Deploy the KYDE Gateway via Docker Compose, then point your agent at it with one environment variable. Within minutes, every agent call in your environment appears on a dashboard, attributed, hash-chained, and observable. An independent witness for every agent action.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="#deploy"
              class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all"
            >
              Deploy now →
            </a>
            <a
              href="https://github.com/kydehq/gateway"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 border border-white/25 text-white/60 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-white/60 hover:text-white/90 transition-all"
            >
              View on GitHub →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ DASHBOARD PREVIEW ══════════ -->
    <section class="border-t border-line-0 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-6">
          <span class="fig-label">FIG.0 · What you download</span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-white/30">The dashboard · Fleet Status view</span>
        </div>
        <FleetStatusMock />
        <p class="mt-4 text-sm text-ink-1 max-w-2xl">
          The Fleet Status view of the dashboard that ships in the box: one health score across your fleet, every agent, alert, and incident in one place.
        </p>
      </div>
    </section>

    <!-- ══════════ WHAT YOU'LL SEE ══════════ -->
    <section class="border-t border-line-0 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="grid md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-line-0 [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 items-start">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-6">What you'll see</p>
            <h2 class="text-3xl md:text-4xl font-bold text-ink-0 leading-tight mb-6">
              The dashboard shows everything your agents are doing, in real time.
            </h2>
            <p class="text-base text-ink-1 leading-relaxed mb-4">
              Most organizations deploying AI agents have no consolidated view of what those agents actually do. Which endpoints they call. How often. With what data.
            </p>
            <p class="text-base text-ink-1 leading-relaxed">
              The Starter edition makes that visible. Every call intercepted by the Gateway appears in the dashboard, attributed to an agent, hash-chained, and timestamped.
            </p>
          </div>
          <div class="space-y-4">
            {[
              { label: "Agent activity feed",    desc: "Every call, tool use and API interaction, in real time."              },
              { label: "Agent identity",         desc: "Which agent or service account performed each action."                },
              { label: "Provider breakdown",     desc: "Calls across OpenAI, Anthropic, Gemini, and local models in one view." },
              { label: "Coverage indicator",     desc: "Share of observable agent traffic passing through the Gateway."       },
              { label: "DLP alerts",             desc: "Post-hoc detection when sensitive data patterns appear in responses." },
              { label: "Hash-chained ledger",    desc: "Append-only record; tampering with any entry breaks every hash after it." },
            ].map(({ label, desc }) => (
              <div class="flex items-start gap-4 border border-line-0 bg-bg-2 p-4">
                <svg class="h-4 w-4 shrink-0 text-live mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                <div>
                  <p class="text-sm font-semibold text-ink-0 mb-0.5">{label}</p>
                  <p class="text-xs text-ink-1">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- FIG.1 · fleet view -->
        <div class="relative mt-16 border border-line-0 bg-bg-0 h-[420px] md:h-[460px] overflow-hidden">
          <span class="fig-label absolute top-4 left-5 z-10">FIG.1 · Fleet view</span>
          <!-- dot field -->
          <div class="absolute inset-0" style="background-image: radial-gradient(circle, color-mix(in srgb, var(--color-ink-0) 9%, transparent) 1px, transparent 1px); background-size: 26px 26px;"></div>

          <!-- agent pins -->
          {[
            { x: 12, y: 30 }, { x: 22, y: 62 }, { x: 30, y: 18 },
            { x: 41, y: 74 }, { x: 47, y: 38 }, { x: 63, y: 80 },
            { x: 71, y: 22 }, { x: 84, y: 55 }, { x: 90, y: 30 },
          ].map(({ x, y }) => (
            <span
              class="absolute h-2 w-2 border border-white/40 bg-bg-1"
              style={`left:${x}%;top:${y}%`}
            ></span>
          ))}
          <!-- active pin -->
          <span class="absolute h-2.5 w-2.5 bg-alert animate-pulse" style="left:34%;top:48%"></span>
          <span class="absolute font-mono text-[10px] text-white/50 tracking-widest" style="left:36.5%;top:47%">crm-sales-04</span>

          <!-- floating detail card -->
          <div class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 float-card w-[min(320px,80%)] border border-line-1 bg-bg-2/95 backdrop-blur-sm">
            <div class="flex items-center justify-between border-b border-line-0 px-4 py-3">
              <span class="flex items-center gap-2 font-mono text-xs text-ink-0">
                <span class="h-1.5 w-1.5 rounded-full bg-alert"></span>
                agent:crm-sales-04
              </span>
              <span class="font-mono text-[9px] uppercase tracking-widest text-alert border border-alert/40 px-1.5 py-0.5">Flagged</span>
            </div>
            <div class="px-4 py-4 space-y-2.5 font-mono text-xs">
              <div class="grid grid-cols-[88px_1fr] gap-2">
                <span class="text-ink-2">Action</span>
                <span class="text-ink-1">export:all_contacts</span>
              </div>
              <div class="grid grid-cols-[88px_1fr] gap-2">
                <span class="text-ink-2">Policy</span>
                <span class="text-ink-1">dlp-standard · detect</span>
              </div>
              <div class="grid grid-cols-[88px_1fr] gap-2">
                <span class="text-ink-2">Ledger</span>
                <span class="text-ink-1">#a4d1…9f2c · <span class="text-live">chained</span></span>
              </div>
            </div>
            <div class="border-t border-line-0 px-4 py-3">
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/50">View in ledger →</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ DEPLOY ══════════ -->
    <section id="deploy" class="border-t border-line-0 py-16 md:py-24 bg-bg-0">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">01 · Deploy</span></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-16">
          {[
            {
              step: "01",
              title: "Clone and start the Gateway",
              desc:  "Clone the repo, set one password, run Docker Compose. The Gateway, ledger, and dashboard start together.",
            },
            {
              step: "02",
              title: "Set one environment variable",
              desc:  "Point any agent or LLM client at the Gateway. Works with OpenAI- and Anthropic-style clients. No code changes in your agents.",
            },
            {
              step: "03",
              title: "Open the dashboard",
              desc:  "Agent calls appear immediately. Coverage, identity, and hash-chained events, visible from the first request.",
            },
          ].map(({ step, title, desc }) => (
            <div class="border border-line-0 bg-bg-1 p-6 md:p-8">
              <span class="font-mono text-xs text-gold mb-4 inline-block uppercase tracking-widest">{step}</span>
              <p class="text-lg font-bold text-ink-0 mb-2">{title}</p>
              <p class="text-sm text-ink-1 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>

        <!-- Terminal -->
        <div class="dark-island border border-line-0 bg-bg-1 max-w-3xl">
          <div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-alert/40"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-warn/40"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-live/40"></span>
            <span class="ml-2 font-mono text-[10px] text-white/20">terminal</span>
            <button
              class="ml-auto font-mono text-[10px] tracking-[0.15em] text-white/25 hover:text-white transition-colors"
              onclick="navigator.clipboard.writeText('git clone https://github.com/kydehq/gateway.git && cd gateway\ncp .env.sandbox.example .env.sandbox\ndocker compose --env-file .env.sandbox -f docker-compose.yml -f docker-compose.prod.yml up -d\nexport OPENAI_BASE_URL=http://localhost:4000/v1');this.textContent='COPIED';setTimeout(()=>this.textContent='COPY',1400)"
            >COPY</button>
          </div>
          <div class="p-6 font-mono text-sm leading-loose">
            <p class="text-white/25 text-xs mb-3"># Step 1, clone and start the Gateway</p>
            <p class="text-white/40"><span class="text-live">$</span> git clone https://github.com/kydehq/gateway.git &amp;&amp; cd gateway</p>
            <p class="text-white/40"><span class="text-live">$</span> cp .env.sandbox.example .env.sandbox <span class="text-white/25"># set POSTGRES_PASSWORD</span></p>
            <p class="text-white/40"><span class="text-live">$</span> docker compose --env-file .env.sandbox \</p>
            <p class="text-white/40 pl-6">-f docker-compose.yml -f docker-compose.prod.yml up -d</p>
            <p class="text-live">&#10003; Gateway healthy · Proxy at http://localhost:4000</p>
            <p class="text-live">&#10003; Ledger initialized · Dashboard at http://localhost:8080</p>

            <p class="text-white/25 text-xs mt-5 mb-3"># Step 2, point your agent at the Gateway</p>
            <p class="text-white/40"><span class="text-live">$</span> export OPENAI_BASE_URL=http://localhost:4000/v1</p>
            <p class="text-white/25 text-xs mt-1"># Anthropic-style clients: export ANTHROPIC_BASE_URL=http://localhost:4000</p>

            <p class="text-white/25 text-xs mt-5 mb-3"># Step 3, run your agent as usual</p>
            <p class="text-white/40"><span class="text-live">$</span> python run_agent.py</p>
            <p class="text-live mt-1">&#10003; 1 new event · agent:default · crm.query · chained</p>
            <p class="text-live">&#10003; 2 new events · agent:default · slack.send · chained</p>
            <p class="text-white/25 text-xs mt-1"># Open http://localhost:8080 to see the dashboard</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-ink-2">
          <p class="font-mono">Requires: Docker · Docker Compose · An agent that calls an LLM API</p>
          <a
            href="https://github.com/kydehq/gateway"
            target="_blank"
            rel="noopener"
            class="font-mono uppercase tracking-[0.12em] text-white/50 hover:text-white transition-colors"
          >
            Full quickstart and docs on GitHub →
          </a>
        </div>

      </div>
    </section>

    <!-- ══════════ STARTER VS ENTERPRISE ══════════ -->
    <section class="border-t border-line-0 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">

        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-10">Starter vs. Enterprise</p>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="border border-line-0 p-6 md:p-8">
            <div class="flex items-center justify-between mb-6">
              <p class="font-mono text-xs uppercase tracking-widest text-ink-0">Kyde Gateway Starter</p>
              <span class="font-mono text-[10px] text-live bg-live/8 px-2 py-0.5 uppercase tracking-widest">Free</span>
            </div>
            <p class="text-sm text-ink-1 leading-relaxed mb-6">An independent witness for every agent action:</p>
            <ul class="space-y-3">
              {[
                "Dashboard, agent activity in real time",
                "Hash-chained, append-only ledger",
                "Coverage indicator",
                "DLP alerts (post-hoc, detect only)",
                "Compliance PDF exports",
                "All LLM providers",
                "Self-hosted, prompts and payloads stay in your network",
                "No SLA · No support commitment",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-ink-1">
                  <svg class="h-4 w-4 shrink-0 text-live mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="border border-line-0 bg-bg-2 p-6 md:p-8">
            <div class="flex items-center justify-between mb-6">
              <p class="font-mono text-xs uppercase tracking-widest text-ink-0">Kyde Gateway Enterprise</p>
              <span class="font-mono text-[10px] text-ink-0/70 bg-ink-0/8 px-2 py-0.5 uppercase tracking-widest">Paid</span>
            </div>
            <p class="text-sm text-ink-1 leading-relaxed mb-6">Everything in Starter, plus the guard that blocks what must not happen:</p>
            <ul class="space-y-3">
              {[
                "Inline enforcement, block out-of-policy actions before execution",
                "Ed25519-signed ledger, hardware-rootable keys (PKCS#11 / HSM)",
                "Agent identity and role scoping (deny-by-default)",
                "MCP per-tool policy",
                "RBAC across agents and teams",
                "Trust Score™ with Coverage Report",
                "Managed signing infrastructure and key management",
                "SLA and support",
                "Air-gapped deployment option",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-ink-1">
                  <svg class="h-4 w-4 shrink-0 text-ink-0/50 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <button
                onclick="openModal()"
                class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all"
              >
                Talk to Us →
              </button>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ FAQ ══════════ -->
    <section class="border-t border-line-0 py-16 md:py-20 bg-bg-0">
      <div class="max-w-4xl mx-auto px-6">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-10">Common questions</p>
        <div class="space-y-px">
          {[
            {
              q: "Does the Starter edition send any data to KYDE?",
              a: "No, not unless you turn it on. Prompts, responses and payload content always remain on your infrastructure, stored in your local ledger. Telemetry is opt-in and disabled by default; when enabled, it transmits only pseudonymized aggregate counts (event volumes, model and endpoint categories), never message content. A fully air-gapped deployment is available in the Enterprise tier.",
            },
            {
              q: "Does it work with any LLM provider?",
              a: "Yes. One Gateway instance proxies all supported providers simultaneously: OpenAI, Anthropic, Gemini, Copilot, Azure OpenAI, Mistral, and local models via Ollama, vLLM, or LMStudio. The upstream is auto-detected from the request path; auth headers pass through untouched. MCP-routed calls are also supported.",
            },
            {
              q: "Do my agents need to be modified?",
              a: "No. Set one environment variable pointing the agent's base URL to the Gateway. The agent continues to operate as before, the Gateway intercepts transparently.",
            },
            {
              q: "Is Starter the same Gateway as Enterprise?",
              a: "The underlying Gateway is the same. The Starter edition runs the observe layer only, it records every event into a hash-chained ledger, but does not block. Ed25519 signing and enforcement (blocking out-of-policy actions) require the Enterprise tier.",
            },
            {
              q: "What happens when Starter is not enough?",
              a: "Contact us. We'll discuss your use case and can provision an Enterprise trial with enforcement enabled.",
            },
          ].map(({ q, a }) => (
            <details class="group border border-line-0 bg-bg-1">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                <span class="text-sm font-semibold text-ink-0 pr-4">{q}</span>
                <svg class="h-4 w-4 shrink-0 text-ink-2 group-open:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-sm text-ink-1 leading-relaxed">{a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-line-0 bg-bg-1">
      <div class="max-w-7xl mx-auto px-6 text-center py-16 md:py-20 md:border-x md:border-line-0">
        <h2 class="text-3xl md:text-4xl font-bold text-ink-0 mb-4">Questions? Ready for Enterprise?</h2>
        <p class="text-base text-ink-1 mb-10 max-w-xl mx-auto">
          Whether something didn't work, you need enforcement, or you want to discuss a production deployment, we're one message away.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <button
            onclick="openModal()"
            class="inline-flex items-center gap-2 bg-white text-cta-ink px-8 py-4 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all"
          >
            Talk to Us →
          </button>
          <a
            href="mailto:hello@kyde.com"
            class="inline-flex items-center gap-2 border border-line-1 text-ink-0 px-8 py-4 text-xs font-mono uppercase tracking-[0.12em] hover:border-line-1 transition-all"
          >
            hello@kyde.com →
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
