---
// KYDE SaaS Revenue Model & Financial Dashboard
// Internal use only — not linked publicly
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KYDE — Revenue Model</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:   #f1f3f5;
      --bg1:  #ffffff;
      --bg2:  #dde1e6;
      --bd:   #c8cdd4;
      --z3:   #0d0e10;
      --z4:   #1e2128;
      --z5:   #3d4350;
      --z6:   #767d8a;
      --am:   #fcb830;
      --am2:  #e8a520;
      --em:   #0a7c4e;
      --re:   #c62828;
      --bl:   #1d52c4;
      --wh:   #0d0e10;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: var(--bg); font-size: 13px; }
    body {
      background: var(--bg);
      color: var(--wh);
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
      line-height: 1.25;
      display: flex;
      min-height: 100vh;
    }

    /* ── SIDEBAR ── */
    #sidebar {
      width: 280px;
      min-width: 280px;
      background: var(--bg1);
      border-right: 1px solid var(--bg2);
      height: 100vh;
      overflow-y: auto;
      position: sticky;
      top: 0;
      padding: 24px 0 48px;
      scrollbar-width: thin;
      scrollbar-color: var(--bg2) transparent;
    }
    .sb-header {
      padding: 0 20px 20px;
      border-bottom: 1px solid var(--bg2);
      margin-bottom: 4px;
    }
    .sb-title { font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 9px; letter-spacing: .25em; color: var(--z6); text-transform: uppercase; margin-bottom: 6px; }
    .sb-brand { font-size: 15px; font-weight: 800; letter-spacing: -.01em; color: var(--wh); }
    .sb-brand span { color: var(--wh); }

    .sb-group { padding: 16px 20px 8px; }
    .sb-group-label {
      font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace;
      font-size: 9px; letter-spacing: .22em; text-transform: uppercase;
      color: var(--z5); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
    }
    .sb-group-label::after { content:''; flex:1; height:1px; background: var(--bg2); }

    .input-row { margin-bottom: 12px; }
    .input-label {
      display: flex; justify-content: space-between; align-items: baseline;
      margin-bottom: 4px;
    }
    .input-label span { font-size: 11px; font-weight: 500; color: var(--z4); }
    .input-label .val {
      font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace;
      font-size: 11px; color: var(--z3);
      background: var(--bg1);
      border: 1px solid var(--bd);
      padding: 1px 6px;
      min-width: 54px; text-align: right;
      font-weight: 700;
    }
    input[type=range] {
      width: 100%; height: 2px;
      -webkit-appearance: none;
      background: var(--bg2);
      border-radius: 1px; cursor: pointer;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 11px; height: 11px; border-radius: 50%;
      background: var(--z3); cursor: pointer;
      border: 2px solid var(--bg1);
      box-shadow: 0 0 0 1px var(--bd);
    }
    input[type=range]::-webkit-slider-thumb:hover { background: var(--z5); }

    .sub-note { font-size: 10px; color: var(--z6); margin-top: 3px; line-height: 1.3; }

    /* ── MAIN ── */
    #main {
      flex: 1;
      padding: 28px 32px 60px;
      overflow-y: auto;
      min-width: 0;
    }

    .page-header { margin-bottom: 24px; border-bottom: 2px solid var(--wh); padding-bottom: 16px; }
    .page-title { font-size: 20px; font-weight: 800; letter-spacing: -.02em; color: var(--wh); margin-bottom: 3px; text-transform: uppercase; }
    .page-sub { font-size: 10px; color: var(--z6); font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }

    /* KPI Cards */
    .kpi-group { margin-bottom: 2px; }
    .kpi-group-label { font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 8px; letter-spacing: .28em; text-transform: uppercase; color: var(--z6); padding: 6px 0 4px; margin-bottom: 1px; }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--bg2); margin-bottom: 2px; }
    .kpi {
      background: var(--bg1);
      padding: 16px 18px;
    }
    .kpi-label { font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 8px; letter-spacing: .22em; color: var(--z6); text-transform: uppercase; margin-bottom: 6px; }
    .kpi-value { font-size: 24px; font-weight: 800; letter-spacing: -.03em; line-height: 1; margin-bottom: 3px; }
    .kpi-sub { font-size: 9.5px; color: var(--z6); font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; }
    .kpi-good    { color: var(--em); }
    .kpi-warn    { color: #c47a00; }
    .kpi-bad     { color: var(--re); }
    .kpi-neutral { color: var(--wh); }

    /* Chart sections */
    .section { margin-bottom: 28px; }
    .section-label {
      font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace;
      font-size: 9px; letter-spacing: .25em; text-transform: uppercase;
      color: var(--z5); display: flex; align-items: center; gap: 10px;
      margin-bottom: 14px; font-weight: 600;
    }
    .section-label::after { content:''; flex:1; height:1px; background: var(--bg2); }

    .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .chart-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
    .chart-grid-1 { display: grid; grid-template-columns: 1fr; gap: 12px; }

    .chart-card {
      background: var(--bg1);
      border: 1px solid var(--bg2);
      padding: 18px 20px;
    }
    .chart-title { font-size: 11px; font-weight: 700; color: var(--z3); margin-bottom: 3px; text-transform: uppercase; letter-spacing: .02em; }
    .chart-desc { font-size: 9.5px; color: var(--z6); margin-bottom: 14px; font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; }
    .chart-wrap { position: relative; height: 200px; }
    .chart-wrap-tall { position: relative; height: 260px; }

    /* VC Soundbite */
    .soundbite {
      border-left: 2px solid var(--bd);
      padding: 8px 14px;
      margin: 10px 0 0;
      background: transparent;
    }
    .soundbite p { font-size: 11px; color: var(--z6); line-height: 1.5; font-style: italic; }

    /* Table */
    .data-table { width: 100%; border-collapse: collapse; font-size: 11px; }
    .data-table th {
      font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace;
      font-size: 8px; letter-spacing: .18em; text-transform: uppercase;
      color: var(--z6); padding: 8px 12px;
      border-bottom: 1px solid var(--bg2); text-align: left; font-weight: 600;
    }
    .data-table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--bg2);
      color: var(--z4);
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table .num { text-align: right; font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; color: var(--wh); font-weight: 600; }
    .data-table .am { color: #c47a00; font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; text-align: right; font-weight: 700; }
    .data-table .em { color: var(--em); font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; text-align: right; }
    .data-table .re { color: var(--re); font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; text-align: right; }
    .data-table .dim { color: var(--z6); font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 10px; }

    /* Rule of 40 gauge */
    .rule40 { display: flex; align-items: center; gap: 16px; }
    .r40-val { font-size: 40px; font-weight: 800; letter-spacing: -.04em; }
    .r40-bar-wrap { flex: 1; }
    .r40-bar-bg { height: 6px; background: var(--bg2); border-radius: 3px; position: relative; overflow: visible; }
    .r40-bar-fill { height: 6px; border-radius: 3px; transition: width .4s; position: relative; }
    .r40-marker { position: absolute; top: -4px; width: 2px; height: 14px; background: var(--z5); }
    .r40-labels { display: flex; justify-content: space-between; margin-top: 5px; }
    .r40-label { font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 9px; color: var(--z6); }

    .tag {
      display: inline-flex; align-items: center; gap: 4px;
      font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 9px; letter-spacing: .1em;
      padding: 2px 7px; border: 1px solid; text-transform: uppercase;
    }
    .tag-good  { border-color: rgba(10,124,78,.4);   color: var(--em); background: rgba(10,124,78,.05); }
    .tag-warn  { border-color: var(--bd);             color: var(--z5); background: var(--bg); }
    .tag-bad   { border-color: rgba(198,40,40,.35);  color: var(--re); background: rgba(198,40,40,.04); }

    /* Pricing table amber highlight rows */
    .price-row td { background: var(--am); color: #0d0e10 !important; font-weight: 800; font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 13px; letter-spacing: .05em; border-bottom: none !important; }
    .price-row td:first-child { letter-spacing: .15em; font-size: 10px; }

    /* Tab bar */
    .tab-bar { display: flex; gap: 1px; background: var(--bg2); margin-bottom: 0; }
    .tab-btn {
      background: var(--bg1); padding: 9px 18px; border: none; cursor: pointer;
      font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace;
      font-size: 9px; letter-spacing: .22em; text-transform: uppercase;
      color: var(--z6); transition: background .15s, color .15s;
    }
    .tab-btn:hover { background: var(--bg); color: var(--z4); }
    .tab-btn.active { background: var(--wh); color: var(--bg1); font-weight: 700; }

    .tab-section { display: none; }
    .tab-section.active { display: block; }

    /* Raise calculator */
    .raise-headline { font-size: 52px; font-weight: 800; letter-spacing: -.04em; line-height: 1; color: var(--wh); }
    .raise-sub { font-size: 11px; color: var(--z6); font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; margin-top: 4px; }
    .matrix-table { width: 100%; border-collapse: collapse; font-size: 11px; }
    .matrix-table th { font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 8px; letter-spacing: .18em; text-transform: uppercase; color: var(--z6); padding: 8px 14px; border-bottom: 1px solid var(--bg2); text-align: center; }
    .matrix-table th:first-child { text-align: left; }
    .matrix-table td { padding: 10px 14px; border-bottom: 1px solid var(--bg2); text-align: center; font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; color: var(--z4); }
    .matrix-table td:first-child { text-align: left; font-weight: 700; color: var(--wh); font-size: 12px; }
    .matrix-table tr:last-child td { border-bottom: none; }
    .matrix-table .highlight-col { background: var(--am); color: #0d0e10 !important; font-weight: 800; }
    .matrix-table .raise-cell { font-size: 14px; font-weight: 800; color: var(--wh); }
    .onetime-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--bg2); }
    .onetime-row:last-child { border-bottom: none; }
    .onetime-label { font-size: 11px; color: var(--z5); }
    .onetime-val { font-family: 'Andale Mono', 'Courier New', ui-monospace, monospace; font-size: 11px; color: var(--z3); font-weight: 700; }

    /* Scrollbar */
    #main::-webkit-scrollbar { width: 4px; }
    #main::-webkit-scrollbar-track { background: transparent; }
    #main::-webkit-scrollbar-thumb { background: var(--bg2); border-radius: 2px; }
  </style>
</head>
<body>

<!-- ══════════ SIDEBAR ══════════ -->
<aside id="sidebar">
  <div class="sb-header">
    <p class="sb-title">Internal Model · Confidential</p>
    <p class="sb-brand"><span>KYDE</span> Revenue Engine</p>
    <div class="tab-bar" style="margin-top:12px">
      <button class="tab-btn active" id="sb-tab-model" onclick="switchTab('model')">Model</button>
      <button class="tab-btn" id="sb-tab-raise" onclick="switchTab('raise')">Raise</button>
    </div>
  </div>

  <!-- ══ MODEL SIDEBAR ══ -->
  <div class="tab-section active" id="model-sidebar">

  <!-- PRICING TIERS — Fixed rates -->
  <div class="sb-group">
    <div class="sb-group-label">↳ Pricing Tiers</div>
    <div style="display:flex;flex-direction:column;gap:1px;background:var(--bg2);margin-bottom:4px">
      <div style="background:var(--bg);padding:9px 12px">
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:9px;letter-spacing:.15em;color:var(--z6);margin-bottom:3px">STARTER</p>
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:11px;color:var(--z4)">€0/mo + €0/agent · ≤5 agents</p>
      </div>
      <div style="background:var(--bg);padding:9px 12px">
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:9px;letter-spacing:.15em;color:var(--z6);margin-bottom:3px">STARTER</p>
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:11px;color:var(--z4)">€999/mo + €9/agent · ≤25 agents</p>
      </div>
      <div style="background:var(--bg);padding:9px 12px">
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:9px;letter-spacing:.15em;color:var(--z6);margin-bottom:3px">BUSINESS</p>
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:11px;color:var(--z4)">€2.9k/mo + €7/agent · ≤250 agents</p>
      </div>
      <div style="background:var(--bg);padding:9px 12px">
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:9px;letter-spacing:.15em;color:var(--z6);margin-bottom:3px">ENTERPRISE/DEFENSE</p>
        <p style="font-family:'Andale Mono','Courier New',monospace;font-size:11px;color:var(--z4)">€custom/mo + €5/agent · unlimited</p>
      </div>
    </div>
  </div>

  <!-- REQUEST VOLUME -->
  <div class="sb-group">
    <div class="sb-group-label">↳ Request Volume</div>

    <div class="input-row">
      <div class="input-label"><span>Starter req/agent/day</span><span class="val" id="v-starter-req">100</span></div>
      <input type="range" id="starter-req" min="10" max="500" step="10" value="100" />
      <p class="sub-note">→ total req/mo per customer</p>
    </div>

    <div class="input-row">
      <div class="input-label"><span>Business req/agent/day</span><span class="val" id="v-business-req">200</span></div>
      <input type="range" id="business-req" min="10" max="1000" step="10" value="200" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Enterprise req/agent/day</span><span class="val" id="v-enterprise-req">500</span></div>
      <input type="range" id="enterprise-req" min="50" max="5000" step="50" value="500" />
      <p class="sub-note">Unlimited incl. — volume for display only</p>
    </div>

    <div class="input-row">
      <div class="input-label"><span>Starter incl. req/mo (K)</span><span class="val" id="v-starter-incl">100K</span></div>
      <input type="range" id="starter-incl" min="50" max="500" step="25" value="100" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Business incl. req/mo (K)</span><span class="val" id="v-business-incl">250K</span></div>
      <input type="range" id="business-incl" min="100" max="2000" step="50" value="250" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Overage rate (€/1K req)</span><span class="val" id="v-overage-rate">€10</span></div>
      <input type="range" id="overage-rate" min="1" max="50" step="1" value="10" />
      <p class="sub-note">= €0.01/req at default</p>
    </div>
  </div>

  <!-- TIER MIX -->
  <div class="sb-group">
    <div class="sb-group-label">↳ Tier Mix</div>

    <div class="input-row">
      <div class="input-label"><span>Starter %</span><span class="val" id="v-starter-pct">60%</span></div>
      <input type="range" id="starter-pct" min="0" max="90" step="5" value="60" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Business %</span><span class="val" id="v-business-pct">30%</span></div>
      <input type="range" id="business-pct" min="0" max="90" step="5" value="30" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Enterprise %</span><span class="val" id="v-enterprise-pct">10%</span></div>
      <p class="sub-note">Auto: 100% − Starter% − Business%</p>
    </div>

    <div class="input-row">
      <div class="input-label"><span>Starter avg agents</span><span class="val" id="v-starter-agents">30</span></div>
      <input type="range" id="starter-agents" min="5" max="30" step="1" value="30" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Business avg agents</span><span class="val" id="v-business-agents">300</span></div>
      <input type="range" id="business-agents" min="10" max="300" step="10" value="300" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Enterprise avg agents</span><span class="val" id="v-enterprise-agents">600</span></div>
      <input type="range" id="enterprise-agents" min="100" max="5000" step="100" value="600" />
    </div>
  </div>

  <!-- GROWTH -->
  <div class="sb-group">
    <div class="sb-group-label">↳ Growth</div>

    <div class="input-row">
      <div class="input-label"><span>Customers Year 1</span><span class="val" id="v-c1">5</span></div>
      <input type="range" id="c1" min="1" max="50" step="1" value="5" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Customers Year 2</span><span class="val" id="v-c2">20</span></div>
      <input type="range" id="c2" min="5" max="150" step="5" value="20" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Customers Year 3</span><span class="val" id="v-c3">60</span></div>
      <input type="range" id="c3" min="10" max="300" step="10" value="60" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Agent Growth (×/year)</span><span class="val" id="v-agent-growth">3×</span></div>
      <input type="range" id="agent-growth" min="1.2" max="6" step="0.1" value="3" />
      <p class="sub-note">NRR driver — agents proliferate</p>
    </div>

    <div class="input-row">
      <div class="input-label"><span>Annual Logo Churn</span><span class="val" id="v-churn">5%</span></div>
      <input type="range" id="churn" min="0" max="30" step="1" value="5" />
    </div>
  </div>

  <!-- COSTS -->
  <div class="sb-group">
    <div class="sb-group-label">↳ Costs</div>

    <div class="input-row">
      <div class="input-label"><span>CAC (blended)</span><span class="val" id="v-cac">€15k</span></div>
      <input type="range" id="cac" min="2000" max="80000" step="1000" value="15000" />
      <p class="sub-note">Sales + onboarding per new logo</p>
    </div>

    <div class="input-row">
      <div class="input-label"><span>COGS % of Revenue</span><span class="val" id="v-cogs">12%</span></div>
      <input type="range" id="cogs" min="3" max="30" step="1" value="12" />
      <p class="sub-note">Infra, signing, storage</p>
    </div>

    <div class="input-row">
      <div class="input-label"><span>Headcount Y1 (FTEs)</span><span class="val" id="v-hc">4</span></div>
      <input type="range" id="hc" min="1" max="30" step="1" value="4" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Team Growth / yr</span><span class="val" id="v-hc-growth">1.5×</span></div>
      <input type="range" id="hc-growth" min="1.0" max="3.0" step="0.1" value="1.5" />
      <p class="sub-note">HC + marketing scale factor per year</p>
    </div>

    <div class="input-row">
      <div class="input-label"><span>Avg Total Comp (€k)</span><span class="val" id="v-comp">€120k</span></div>
      <input type="range" id="comp" min="60" max="250" step="10" value="120" />
    </div>

    <div class="input-row">
      <div class="input-label"><span>Marketing / mo (Y1)</span><span class="val" id="v-mkt">€10k</span></div>
      <input type="range" id="mkt" min="0" max="100000" step="2500" value="10000" />
      <p class="sub-note">SEO, content, events, paid</p>
    </div>
  </div>

  </div><!-- end model-sidebar -->

  <!-- ══ RAISE CALCULATOR SIDEBAR ══ -->
  <div class="tab-section" id="raise-sidebar">

    <div class="sb-group">
      <div class="sb-group-label">↳ Raise Parameters</div>
      <div class="input-row">
        <div class="input-label"><span>Target Runway</span><span class="val" id="v-runway">18 mo</span></div>
        <input type="range" id="runway" min="6" max="36" step="1" value="18" />
        <p class="sub-note">Months of operation to fund</p>
      </div>
      <div class="input-row">
        <div class="input-label"><span>Buffer %</span><span class="val" id="v-buffer">25%</span></div>
        <input type="range" id="buffer" min="0" max="50" step="5" value="25" />
