  function calcRaise(r) {
    const founderMonthlyCost = r.founders * r.founderSal;
    const hireMonthlyCost    = r.newHires * r.hireComp / 12;
    const opsMonthlyCost     = r.opsAws + r.opsTools + r.opsMisc;
    const totalMonthlyBurn   = founderMonthlyCost + hireMonthlyCost + opsMonthlyCost;
    const oneTimeCosts       = r.otBsi + r.otCyber + r.otDo + r.otLegal + r.otAws;
    const operationalNeed    = totalMonthlyBurn * r.runway;
    const raiseBase          = operationalNeed + oneTimeCosts;
    const raiseAmount        = raiseBase * (1 + r.bufferPct);
    const postMoney          = raiseAmount / r.dilutionPct;
    const preMoney           = postMoney - raiseAmount;

    // Burndown: iterative with revenue offset
    let cash = raiseAmount;
    const burndown = [cash];
    const mrrCurve = [0];
    for (let m = 1; m <= r.runway; m++) {
      const oneTime = m === 1 ? oneTimeCosts : 0;
      const mrr     = (r.offsetMrr > 0 && m >= r.offsetMonth) ? r.offsetMrr : 0;
      cash = Math.max(0, cash - totalMonthlyBurn - oneTime + mrr);
      burndown.push(cash);
      mrrCurve.push(mrr);
    }
    // Series A readiness: first month where MRR >= target
    const seriesAMonth = mrrCurve.findIndex(m => m >= r.seriesAMrr);

    // Negotiation matrix: 12 / 15 / 18 months
    const runwayScenarios  = [12, 15, 18, 24];
    const premoneySzens    = [4e6, 6e6, 8e6, 10e6];

    const matrixRows = runwayScenarios.map(mo => {
      const op  = totalMonthlyBurn * mo + oneTimeCosts;
      const ra  = op * (1 + r.bufferPct);
      return { months: mo, raise: ra, dilutions: premoneySzens.map(pre => ra / (pre + ra) * 100) };
    });

    const valuationRows = premoneySzens.map(pre => {
      const post = pre + raiseAmount;
      const dil  = raiseAmount / post * 100;
      return { pre, post, dil };
    });

    return { totalMonthlyBurn, founderCost: founderMonthlyCost, hireCost: hireMonthlyCost, opsCost: opsMonthlyCost, oneTimeCosts, raiseBase, raiseAmount, preMoney, postMoney, burndown, mrrCurve, seriesAMonth, matrixRows, valuationRows };
  }

  function renderRaise() {
    const r = getRaiseInputs();
    const d = calcRaise(r);

    document.getElementById('lbl-dilution').textContent = Math.round(r.dilutionPct * 100);
    document.getElementById('raise-amount').textContent  = fmt(d.raiseAmount);
    const burnBreakdown = `${r.founders} founders + ${r.newHires} hires + ops`;
    document.getElementById('raise-sub').textContent =
      `${r.runway} mo · ${Math.round(r.bufferPct*100)}% buffer · ${fmt(d.totalMonthlyBurn)}/mo (${burnBreakdown}) · ${fmt(d.oneTimeCosts)} one-time`;
    document.getElementById('raise-premoney').textContent = fmt(d.preMoney);
    document.getElementById('raise-burn').textContent     = fmt(d.totalMonthlyBurn) + '/mo';
    document.getElementById('raise-burn-sub').textContent = `${fmt(d.founderCost)} founders · ${fmt(d.hireCost)} hires · ${fmt(d.opsCost)} ops`;
    document.getElementById('raise-onetime').textContent = fmt(d.oneTimeCosts);

    // Burndown chart
    const months = Array.from({length: r.runway + 1}, (_, i) => 'M' + i);
    const dangerLine = d.totalMonthlyBurn * 3;
    const milestones = [
      { month: r.ms1, label: 'MVP' },
      { month: r.ms2, label: 'Pilots' },
      { month: r.ms3, label: 'Certified' },
    ].filter(m => m.month <= r.runway);

    // Inline plugin for milestone vertical lines + Series A marker
    const milestonesPlugin = {
      id: 'milestones',
      afterDraw(chart) {
        const ctx  = chart.ctx;
        const meta = chart.getDatasetMeta(0);
        if (!meta.data.length) return;
        milestones.forEach(ms => {
          if (ms.month >= meta.data.length) return;
          const x = meta.data[ms.month].x;
          ctx.save();
          ctx.strokeStyle = Z5;
          ctx.lineWidth = 1;
          ctx.setLineDash([4, 3]);
          ctx.beginPath();
          ctx.moveTo(x, chart.chartArea.top);
          ctx.lineTo(x, chart.chartArea.bottom);
          ctx.stroke();
          ctx.fillStyle = Z5;
          ctx.font = "bold 8px 'Andale Mono','Courier New',monospace";
          ctx.fillText(ms.label, x + 3, chart.chartArea.top + 10);
          ctx.restore();
        });
        // Series A marker
        if (d.seriesAMonth > 0 && d.seriesAMonth < meta.data.length) {
          const x = meta.data[d.seriesAMonth].x;
          ctx.save();
          ctx.strokeStyle = EM;
          ctx.lineWidth = 1.5;
          ctx.setLineDash([6, 3]);
          ctx.beginPath();
          ctx.moveTo(x, chart.chartArea.top);
          ctx.lineTo(x, chart.chartArea.bottom);
          ctx.stroke();
          ctx.fillStyle = EM;
          ctx.font = "bold 8px 'Andale Mono','Courier New',monospace";
          ctx.fillText('Series A ready', x + 3, chart.chartArea.top + 22);
          ctx.restore();
        }
      }
    };

    const chartDatasets = [
      { label: 'Cash Remaining', data: d.burndown, borderColor: Z4, backgroundColor: 'rgba(0,0,0,.04)', fill: true, tension: 0.1, pointRadius: 0, yAxisID: 'y' },
      { label: '3-Month Warning', data: Array(r.runway + 1).fill(dangerLine), borderColor: RE, borderDash: [4,4], pointRadius: 0, borderWidth: 1, yAxisID: 'y' },
    ];
    if (r.offsetMrr > 0) {
      chartDatasets.push({ label: 'Pilot MRR', data: d.mrrCurve, borderColor: EM, backgroundColor: 'rgba(10,124,78,.06)', fill: true, tension: 0.1, pointRadius: 0, yAxisID: 'y2', borderDash: [2,2] });
    }

    mkChart('chart-burndown', {
      type: 'line',
      data: { labels: months, datasets: chartDatasets },
      options: { ...CHART_DEFAULTS, responsive: true, maintainAspectRatio: false,
        plugins: { ...CHART_DEFAULTS.plugins,
          tooltip: { ...CHART_DEFAULTS.plugins.tooltip, callbacks: { label: ctx => ' ' + ctx.dataset.label + ': ' + fmt(ctx.raw) } }
        },
        scales: {
          ...CHART_DEFAULTS.scales,
          y:  { ...CHART_DEFAULTS.scales.y, ticks: { ...CHART_DEFAULTS.scales.y.ticks, callback: v => fmt(v) } },
          y2: { position: 'right', grid: { drawOnChartArea: false }, ticks: { color: EM, font: { size: 10 }, callback: v => fmt(v) }, display: r.offsetMrr > 0 },
        }
      },
      plugins: [milestonesPlugin],
    });

    const beMo = d.burndown.findIndex(v => v <= 0);
    const revenueNote = r.offsetMrr > 0 ? ` Revenue offset of ${fmt(r.offsetMrr)}/mo from M${r.offsetMonth} extends runway.` : ' No revenue offset — conservative model.';
    const seriesANote = d.seriesAMonth > 0 ? ` Series A readiness at M${d.seriesAMonth} when MRR hits ${fmt(r.seriesAMrr)}.` : '';
    document.getElementById('sb-burndown').textContent =
      (beMo > 0 ? `Cash hits zero at M${beMo}.` : `Full ${r.runway}-month runway funded.`) + revenueNote + seriesANote;

    // Negotiation matrix
    const highlight = r.runway; // highlight row matching current target runway
    document.getElementById('matrix-tbody').innerHTML = d.matrixRows.map(row => {
      const isHL = row.months === highlight;
      return `<tr>
        <td style="${isHL ? 'background:var(--am);color:#0d0e10;font-weight:800' : ''}">${row.months} months</td>
        <td class="raise-cell" style="${isHL ? 'background:var(--am);color:#0d0e10' : ''}">${fmt(row.raise)}</td>
        ${row.dilutions.map(d => `<td style="${isHL ? 'background:var(--am);color:#0d0e10' : ''}">${d.toFixed(1)}%</td>`).join('')}
      </tr>`;
    }).join('');

    // Valuation rows
    const currentDil = r.dilutionPct * 100;
    document.getElementById('valuation-tbody').innerHTML = d.valuationRows.map(row => {
      const isTarget = Math.abs(row.dil - currentDil) < 3;
      return `<tr>
        <td>${fmt(row.pre)}</td>
        <td style="font-family:'Andale Mono','Courier New',monospace">${fmt(row.post)}</td>
        <td style="font-weight:700;color:${isTarget ? 'var(--em)' : row.dil > 25 ? 'var(--re)' : 'var(--z4)'}">${row.dil.toFixed(1)}%</td>
        <td style="font-family:'Andale Mono','Courier New',monospace">${(d.raiseAmount / row.post * 100).toFixed(1)}%</td>
        <td><span class="tag ${row.dil < 15 ? 'tag-good' : row.dil < 22 ? 'tag-warn' : 'tag-bad'}">${row.dil < 15 ? '↑ Founder-friendly' : row.dil < 22 ? '✓ Standard' : '↓ Dilutive'}</span></td>
      </tr>`;
    }).join('');

    // One-time breakdown
    const items = [
      { label: 'BSI / ISO 27001', val: r.otBsi },
      { label: 'Cyber Liability Insurance', val: r.otCyber },
      { label: 'D&amp;O Insurance', val: r.otDo },
      { label: 'Legal / Notar GmbH', val: r.otLegal },
      { label: 'AWS / Infra Setup', val: r.otAws },
    ];
    document.getElementById('onetime-breakdown').innerHTML = items.map(it => `
      <div class="onetime-row">
        <span class="onetime-label">${it.label}</span>
        <span class="onetime-val">${fmt(it.val)}</span>
      </div>
    `).join('') + `<div class="onetime-row" style="border-top:2px solid var(--wh);margin-top:4px;padding-top:8px">
      <span style="font-weight:700;color:var(--wh)">Total Setup</span>
      <span style="font-family:'Andale Mono','Courier New',monospace;font-weight:800;font-size:14px;color:var(--wh)">${fmt(d.oneTimeCosts)}</span>
    </div>`;
  }

  // ── INIT ──
  render();
</script>

</body>
</html>
