</main>

<script is:inline>
  // ── CHART INSTANCES ──
  const charts = {};

  // ── HELPERS ──
  function fmt(n, prefix='€', decimals=0) {
    if (n >= 1e6) return prefix + (n/1e6).toFixed(1) + 'M';
    if (n >= 1e3) return prefix + (n/1e3).toFixed(0) + 'k';
    return prefix + n.toFixed(decimals);
  }
  function pct(n) { return n.toFixed(1) + '%'; }

  const AM  = '#fcb830';
  const EM  = '#0a7c4e';
  const RE  = '#c62828';
  const BL  = '#1d52c4';
  const Z4  = '#1e2128';
  const Z5  = '#3d4350';
  const Z6  = '#767d8a';
  const BG1 = '#ffffff';
  const BG2 = '#dde1e6';
  const MONO = "'Andale Mono', 'Courier New', ui-monospace, monospace";

  const CHART_DEFAULTS = {
    plugins: { legend: { labels: { color: Z5, font: { size: 10, family: MONO } } }, tooltip: { backgroundColor: '#0d0e10', borderColor: BG2, borderWidth: 1, titleColor: '#f1f3f5', bodyColor: '#c8cdd4' } },
    scales: {
      x: { grid: { color: 'rgba(0,0,0,.06)' }, ticks: { color: Z6, font: { size: 10 } } },
      y: { grid: { color: 'rgba(0,0,0,.06)' }, ticks: { color: Z6, font: { size: 10 } } }
    }
  };

  function mkChart(id, config) {
    if (charts[id]) charts[id].destroy();
    const ctx = document.getElementById(id).getContext('2d');
    charts[id] = new Chart(ctx, config);
    return charts[id];
  }

  // ── INPUT BINDINGS ──
  const inputs = {
    starterPct:       { el: 'starter-pct',      fmt: v => v+'%',                              out: 'v-starter-pct' },
    businessPct:      { el: 'business-pct',     fmt: v => v+'%',                              out: 'v-business-pct' },
    starterAgents:    { el: 'starter-agents',   fmt: v => v,                                  out: 'v-starter-agents' },
    businessAgents:   { el: 'business-agents',  fmt: v => v,                                  out: 'v-business-agents' },
    enterpriseAgents: { el: 'enterprise-agents',fmt: v => v,                                  out: 'v-enterprise-agents' },
    c1:               { el: 'c1',               fmt: v => v,                                  out: 'v-c1' },
    c2:               { el: 'c2',               fmt: v => v,                                  out: 'v-c2' },
    c3:               { el: 'c3',               fmt: v => v,                                  out: 'v-c3' },
    agentGrowth:      { el: 'agent-growth',     fmt: v => parseFloat(v).toFixed(1)+'×',       out: 'v-agent-growth' },
    churn:            { el: 'churn',            fmt: v => v+'%',                              out: 'v-churn' },
    cac:              { el: 'cac',              fmt: v => '€'+Math.round(v/1000)+'k',         out: 'v-cac' },
    cogs:             { el: 'cogs',             fmt: v => v+'%',                              out: 'v-cogs' },
    hc:               { el: 'hc',              fmt: v => v,                                  out: 'v-hc' },
    hcGrowth:         { el: 'hc-growth',       fmt: v => parseFloat(v).toFixed(1)+'×',       out: 'v-hc-growth' },
    comp:             { el: 'comp',             fmt: v => '€'+v+'k',                          out: 'v-comp' },
    mkt:              { el: 'mkt',              fmt: v => '€'+Math.round(v/1000)+'k',         out: 'v-mkt' },
    starterReq:       { el: 'starter-req',      fmt: v => v,                                  out: 'v-starter-req' },
    businessReq:      { el: 'business-req',     fmt: v => v,                                  out: 'v-business-req' },
    enterpriseReq:    { el: 'enterprise-req',   fmt: v => v,                                  out: 'v-enterprise-req' },
    starterIncl:      { el: 'starter-incl',     fmt: v => v+'K',                              out: 'v-starter-incl' },
    businessIncl:     { el: 'business-incl',    fmt: v => v+'K',                              out: 'v-business-incl' },
    overageRate:      { el: 'overage-rate',     fmt: v => '€'+v,                              out: 'v-overage-rate' },
  };

  // Update enterprise % display automatically
  function updateEnterprisePct() {
    const s = +document.getElementById('starter-pct').value;
    const b = +document.getElementById('business-pct').value;
    document.getElementById('v-enterprise-pct').textContent = Math.max(0, 100 - s - b) + '%';
  }
  document.getElementById('starter-pct').addEventListener('input', updateEnterprisePct);
  document.getElementById('business-pct').addEventListener('input', updateEnterprisePct);

  function getInputs() {
    const starterPct  = +document.getElementById('starter-pct').value / 100;
    const businessPct = +document.getElementById('business-pct').value / 100;
    const enterprisePct = Math.max(0, 1 - starterPct - businessPct);
    return {
      // Fixed tier pricing
      starterBase: 999, businessBase: 2900, enterpriseBase: 10000,
      starterPerAgent: 9, businessPerAgent: 7, enterprisePerAgent: 5,
      // Tier mix
      starterPct, businessPct, enterprisePct,
      // Agents per tier at start
      starterAgents:    +document.getElementById('starter-agents').value,
      businessAgents:   +document.getElementById('business-agents').value,
      enterpriseAgents: +document.getElementById('enterprise-agents').value,
      // Growth
      c1:          +document.getElementById('c1').value,
      c2:          +document.getElementById('c2').value,
      c3:          +document.getElementById('c3').value,
      agentGrowth: +document.getElementById('agent-growth').value,
      churn:       +document.getElementById('churn').value / 100,
      // Costs
      cac:         +document.getElementById('cac').value,
      cogs:        +document.getElementById('cogs').value / 100,
      hc:          +document.getElementById('hc').value,
      hcGrowth:    +document.getElementById('hc-growth').value,
      comp:        +document.getElementById('comp').value * 1000,
      mkt:         +document.getElementById('mkt').value,
      // Request volume
      starterReqDay:    +document.getElementById('starter-req').value,
      businessReqDay:   +document.getElementById('business-req').value,
      enterpriseReqDay: +document.getElementById('enterprise-req').value,
      starterIncluded:  +document.getElementById('starter-incl').value * 1000,
      businessIncluded: +document.getElementById('business-incl').value * 1000,
      overageRate:      +document.getElementById('overage-rate').value / 1000, // €/req
    };
  }

  // ── CALCULATION ENGINE ──
  function calc(p) {
    const years = [1, 2, 3];
    const customers = [p.c1, p.c2, p.c3];

    // Customers per tier
    const starterC  = customers.map(c => Math.max(0, Math.round(c * p.starterPct)));
    const businessC = customers.map(c => Math.max(0, Math.round(c * p.businessPct)));
    const enterpriseC = customers.map((c, i) => Math.max(0, c - starterC[i] - businessC[i]));

    // Agents per tier per year (with caps)
    const mult = [1, p.agentGrowth, p.agentGrowth * p.agentGrowth];
    const starterAgentsY    = mult.map(m => Math.min(25,  p.starterAgents * m));
    const businessAgentsY   = mult.map(m => Math.min(250, p.businessAgents * m));
    const enterpriseAgentsY = mult.map(m => p.enterpriseAgents * m);

    // Request volume overage per customer per tier (monthly)
    const starterOverageMo  = mult.map((m, i) => {
      const agents = starterAgentsY[i];
      const totalReq = agents * p.starterReqDay * 30;
      return Math.max(0, totalReq - p.starterIncluded) * p.overageRate;
    });
    const businessOverageMo = mult.map((m, i) => {
      const agents = businessAgentsY[i];
      const totalReq = agents * p.businessReqDay * 30;
      return Math.max(0, totalReq - p.businessIncluded) * p.overageRate;
    });
    // Enterprise: unlimited requests included — no overage

    // Revenue per tier (base + agent fee + overage)
    const starterRev    = years.map((_, i) => starterC[i]    * (p.starterBase    * 12 + starterAgentsY[i]    * p.starterPerAgent    * 12 + starterOverageMo[i]  * 12));
    const businessRev   = years.map((_, i) => businessC[i]   * (p.businessBase   * 12 + businessAgentsY[i]   * p.businessPerAgent   * 12 + businessOverageMo[i] * 12));
    const enterpriseRev = years.map((_, i) => enterpriseC[i] * (p.enterpriseBase * 12 + enterpriseAgentsY[i] * p.enterprisePerAgent * 12));
    const totalARR      = years.map((_, i) => starterRev[i] + businessRev[i] + enterpriseRev[i]);

    // Base ARR vs Volume ARR split
    const baseARR   = years.map((_, i) =>
      starterC[i]    * (p.starterBase    * 12 + starterAgentsY[i]    * p.starterPerAgent    * 12) +
      businessC[i]   * (p.businessBase   * 12 + businessAgentsY[i]   * p.businessPerAgent   * 12) +
      enterpriseC[i] * (p.enterpriseBase * 12 + enterpriseAgentsY[i] * p.enterprisePerAgent * 12));
    const volumeARR = years.map((_, i) => totalARR[i] - baseARR[i]);

    const totalAgents = years.map((_, i) =>
      starterC[i] * starterAgentsY[i] + businessC[i] * businessAgentsY[i] + enterpriseC[i] * enterpriseAgentsY[i]);

    // COGS & Gross Profit
    const cogs        = totalARR.map(a => a * p.cogs);
    const grossProfit = totalARR.map((a, i) => a - cogs[i]);
    const grossMargin = grossProfit.map((g, i) => g / totalARR[i]);

    // OpEx — scales with team growth each year
    const headcountCostY1 = p.hc * p.comp;
    const mktAnnualY1     = p.mkt * 12;
    const headcountCost   = headcountCostY1; // alias for Y1 burn calc below
    const mktAnnual       = mktAnnualY1;
    const headcountCostByYear = years.map((_, i) => headcountCostY1 * Math.pow(p.hcGrowth, i));
    const mktAnnualByYear     = years.map((_, i) => mktAnnualY1     * Math.pow(p.hcGrowth, i));
    const opex = years.map((_, i) => headcountCostByYear[i] + mktAnnualByYear[i]);
    // Derived: FTE count per year (for display)
    const hcY = years.map((_, i) => Math.round(p.hc * Math.pow(p.hcGrowth, i)));

    // EBITDA
    const ebitda       = years.map((_, i) => grossProfit[i] - opex[i]);
    const ebitdaMargin = ebitda.map((e, i) => e / totalARR[i]);

    const monthlyBurnY1 = (headcountCost + mktAnnual) / 12;
    const nrr           = p.agentGrowth * (1 - p.churn);

    const avgAcvY3      = totalARR[2] / customers[2];
    const effectiveChurn = Math.max(p.churn, 0.01);
    const ltv           = avgAcvY3 * grossMargin[2] / effectiveChurn;
    const ltvCac        = ltv / p.cac;

    const mrrY3         = totalARR[2] / 12;
    const mrrPerCust    = mrrY3 / customers[2];
    const paybackMonths = p.cac / (mrrPerCust * grossMargin[2]);

    const growthRate    = (totalARR[2] - totalARR[1]) / totalARR[1] * 100;
    const growthRateY2  = (totalARR[1] - totalARR[0]) / totalARR[0] * 100;
    const rule40        = growthRate + (ebitdaMargin[2] * 100);

    // Capital efficiency
    const netBurnY1     = Math.max(0, opex[0] + cogs[0] - totalARR[0]);
    const burnMultiple  = totalARR[0] > 0 ? netBurnY1 / totalARR[0] : Infinity;
    const magicNumber   = mktAnnual > 0 ? totalARR[0] / mktAnnual : 0;
    // ARR per FTE — use actual Y3 headcount
    const arrPerFte     = hcY[2] > 0 ? totalARR[2] / hcY[2] : 0;

    // Waterfall Y3
    const newArr       = (customers[2] - Math.round(customers[1] * (1 - p.churn))) * avgAcvY3;
    const expansionArr = Math.round(customers[1] * (1 - p.churn)) * avgAcvY3 * (p.agentGrowth - 1);
    const churnArr     = customers[1] * avgAcvY3 * p.churn;

    // Monthly expansion — blended avg customer (36 months)
    const avgBase = p.starterPct * p.starterBase + p.businessPct * p.businessBase + p.enterprisePct * p.enterpriseBase;
    const avgAgentRevStart =
      p.starterPct * p.starterAgents * p.starterPerAgent +
      p.businessPct * p.businessAgents * p.businessPerAgent +
      p.enterprisePct * p.enterpriseAgents * p.enterprisePerAgent;
    const monthlyRev36 = Array.from({length: 36}, (_, m) => {
      const yr = m / 12;
      return avgBase + avgAgentRevStart * Math.pow(p.agentGrowth, yr);
    });

    return {
      customers, starterC, businessC, enterpriseC,
      starterAgentsY, businessAgentsY, enterpriseAgentsY, totalAgents,
      starterRev, businessRev, enterpriseRev, totalARR,
      baseARR, volumeARR, starterOverageMo, businessOverageMo,
      cogs, grossProfit, grossMargin,
      opex, ebitda, ebitdaMargin,
      monthlyBurnY1, nrr, ltv, ltvCac, paybackMonths,
      avgAcvY3, mrrY3, growthRate, growthRateY2, rule40,
      burnMultiple, magicNumber, arrPerFte, hcY,
      newArr, expansionArr, churnArr, monthlyRev36,
      headcountCost, mktAnnual,
      headcountCostByYear, mktAnnualByYear,
    };
  }

  // ── RENDER ──
  function render() {
    const p = getInputs();
    const d = calc(p);

    // ── KPI Cards ──

    // Row 1: Revenue Quality
    document.getElementById('kpi-arr').textContent  = fmt(d.totalARR[2]);
    document.getElementById('kpi-arr').className    = 'kpi-value kpi-neutral';

    const gr3 = d.growthRate;
    document.getElementById('kpi-growth').textContent = Math.round(gr3) + '%';
    document.getElementById('kpi-growth').className   = 'kpi-value ' + (gr3 > 150 ? 'kpi-good' : gr3 > 80 ? 'kpi-warn' : 'kpi-bad');

    const gm3 = d.grossMargin[2] * 100;
    document.getElementById('kpi-gm').textContent = pct(gm3);
    document.getElementById('kpi-gm').className   = 'kpi-value ' + (gm3 > 75 ? 'kpi-good' : gm3 > 60 ? 'kpi-warn' : 'kpi-bad');

    const eb3 = d.ebitdaMargin[2] * 100;
    const ebitdaAbs = d.ebitda[2];
    document.getElementById('kpi-ebitda').textContent = fmt(ebitdaAbs);
    document.getElementById('kpi-ebitda').className   = 'kpi-value ' + (eb3 > 20 ? 'kpi-good' : eb3 > 0 ? 'kpi-warn' : 'kpi-bad');
    document.getElementById('kpi-ebitda-sub').textContent = pct(eb3) + ' margin · ' + (ebitdaAbs >= 0 ? 'profitable' : 'loss-making');

    // Row 2: Capital Efficiency
    const bm = d.burnMultiple;
    document.getElementById('kpi-burn-mult').textContent = isFinite(bm) ? bm.toFixed(1) + '×' : '∞';
    document.getElementById('kpi-burn-mult').className   = 'kpi-value ' + (!isFinite(bm) ? 'kpi-bad' : bm < 1.5 ? 'kpi-good' : bm < 2.5 ? 'kpi-warn' : 'kpi-bad');

    const mn = d.magicNumber;
    document.getElementById('kpi-magic').textContent = mn.toFixed(2);
    document.getElementById('kpi-magic').className   = 'kpi-value ' + (mn > 1.5 ? 'kpi-good' : mn > 0.75 ? 'kpi-warn' : 'kpi-bad');

    document.getElementById('kpi-arrfte').textContent    = '€' + (d.arrPerFte / 1000).toFixed(0) + 'k';
    document.getElementById('kpi-arrfte').className      = 'kpi-value ' + (d.arrPerFte > 300000 ? 'kpi-good' : d.arrPerFte > 150000 ? 'kpi-warn' : 'kpi-bad');
    document.getElementById('kpi-arrfte-sub').textContent = d.hcY[2] + ' FTEs in Y3 · target €200k+';

    document.getElementById('kpi-burn').textContent = fmt(d.monthlyBurnY1) + '/mo';

    // Row 3: Unit Economics
    const nrrPct = d.nrr * 100;
    document.getElementById('kpi-nrr').textContent = pct(nrrPct);
    document.getElementById('kpi-nrr').className   = 'kpi-value ' + (nrrPct > 130 ? 'kpi-good' : nrrPct > 100 ? 'kpi-warn' : 'kpi-bad');

    document.getElementById('kpi-ltvcac').textContent = d.ltvCac.toFixed(1) + '×';
    document.getElementById('kpi-ltvcac').className   = 'kpi-value ' + (d.ltvCac > 5 ? 'kpi-good' : d.ltvCac > 3 ? 'kpi-warn' : 'kpi-bad');

    document.getElementById('kpi-payback').textContent = Math.round(d.paybackMonths) + ' mo';
    document.getElementById('kpi-payback').className   = 'kpi-value ' + (d.paybackMonths < 18 ? 'kpi-good' : d.paybackMonths < 36 ? 'kpi-warn' : 'kpi-bad');

    const r40 = d.rule40;
    document.getElementById('kpi-r40').textContent = Math.round(r40);
    document.getElementById('kpi-r40').className   = 'kpi-value ' + (r40 > 60 ? 'kpi-good' : r40 > 40 ? 'kpi-warn' : 'kpi-bad');

    // ARR Chart — by tier
    mkChart('chart-arr', {
      type: 'bar',
      data: {
        labels: ['Year 1', 'Year 2', 'Year 3'],
        datasets: [
          { label: 'Starter',     data: d.starterRev,    backgroundColor: Z5,  stack: 's' },
          { label: 'Business',    data: d.businessRev,   backgroundColor: AM,  stack: 's' },
          { label: 'Enterprise',  data: d.enterpriseRev, backgroundColor: EM,  stack: 's' },
        ]
      },
      options: { ...CHART_DEFAULTS, responsive: true, maintainAspectRatio: false,
        plugins: { ...CHART_DEFAULTS.plugins,
          tooltip: { ...CHART_DEFAULTS.plugins.tooltip, callbacks: { label: ctx => ' ' + ctx.dataset.label + ': ' + fmt(ctx.raw) } }
        },
        scales: { ...CHART_DEFAULTS.scales,
          y: { ...CHART_DEFAULTS.scales.y, stacked: true, ticks: { ...CHART_DEFAULTS.scales.y.ticks, callback: v => fmt(v) } },
          x: { ...CHART_DEFAULTS.scales.x, stacked: true }
        }
      }
    });
    const entPct = d.enterpriseRev[2] / d.totalARR[2] * 100;
    const growthAssumptionNote = p.agentGrowth >= 2.5
      ? `⚠ ${p.agentGrowth.toFixed(1)}× agent growth is the Upside Case (Jensen 100:1 ratio, Sequoia $1T services thesis). Base Case ≈ 2×. Project A will probe this — have pilot data ready.`
      : p.agentGrowth >= 1.8
        ? `${p.agentGrowth.toFixed(1)}× agent growth — conservative-to-base range. Defensible with pilot data.`
        : `${p.agentGrowth.toFixed(1)}× agent growth — conservative base case.`;
    document.getElementById('sb-arr').textContent =
      `Year 3 ARR: ${fmt(d.totalARR[2])} across ${d.customers[2]} customers. Enterprise (${d.enterpriseC[2]} customers) contributes ${pct(entPct)} of revenue. ${growthAssumptionNote}`;

    // Waterfall Chart
    const wfData = [d.totalARR[1], d.newArr, d.expansionArr, -d.churnArr, d.totalARR[2]];
    mkChart('chart-waterfall', {
      type: 'bar',
      data: {
        labels: ['ARR Y2', 'New ARR', 'Expansion ARR', 'Churn', 'ARR Y3'],
        datasets: [{ data: wfData, backgroundColor: wfData.map((v, i) => i === 0 ? Z5 : i === 4 ? AM : v >= 0 ? EM : RE) }]
      },
      options: { ...CHART_DEFAULTS, responsive: true, maintainAspectRatio: false,
        plugins: { ...CHART_DEFAULTS.plugins, legend: { display: false },
          tooltip: { ...CHART_DEFAULTS.plugins.tooltip, callbacks: { label: ctx => ' ' + fmt(Math.abs(ctx.raw)) } }
        },
