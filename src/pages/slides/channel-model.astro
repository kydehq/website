---
// KYDE On-Premise + Channel Model — Simple View
// Internal · Not linked publicly
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KYDE — Channel Model</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f1f3f5; --bg1: #ffffff; --bg2: #dde1e6; --bd: #c8cdd4;
      --z3: #0d0e10; --z4: #1e2128; --z5: #3d4350; --z6: #767d8a;
      --am: #fcb830; --em: #0a7c4e; --re: #c62828;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: var(--bg); font-size: 13px; }
    body {
      background: var(--bg); color: var(--z3);
      font-family: 'Montserrat', -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
      line-height: 1.25; display: flex; min-height: 100vh;
    }

    /* ── SIDEBAR ── */
    #sidebar {
      width: 248px; min-width: 248px; background: var(--bg1);
      border-right: 1px solid var(--bg2); height: 100vh; overflow-y: auto;
      position: sticky; top: 0; padding: 24px 0 48px;
      scrollbar-width: thin; scrollbar-color: var(--bg2) transparent;
    }
    #sidebar::-webkit-scrollbar { width: 4px; }
    #sidebar::-webkit-scrollbar-thumb { background: var(--bg2); }
    .sb-header { padding: 0 20px 20px; border-bottom: 1px solid var(--bg2); margin-bottom: 4px; }
    .sb-title { font-family: monospace; font-size: 9px; letter-spacing: .25em; color: var(--z6); text-transform: uppercase; margin-bottom: 6px; }
    .sb-brand { font-size: 14px; font-weight: 800; color: var(--z3); }
    .sb-group { padding: 16px 20px 8px; }
    .sb-group-label {
      font-family: monospace; font-size: 9px; letter-spacing: .22em;
      text-transform: uppercase; color: var(--z5); margin-bottom: 12px;
      display: flex; align-items: center; gap: 8px;
    }
    .sb-group-label::after { content:''; flex:1; height:1px; background: var(--bg2); }
    .input-row { margin-bottom: 12px; }
    .input-label { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
    .input-label span { font-size: 11px; font-weight: 500; color: var(--z4); }
    .input-label .val {
      font-family: monospace; font-size: 11px; color: var(--z3);
      background: var(--bg1); border: 1px solid var(--bd);
      padding: 1px 6px; min-width: 52px; text-align: right; font-weight: 700;
    }
    input[type=range] {
      width: 100%; height: 2px; -webkit-appearance: none;
      background: var(--bg2); border-radius: 1px; cursor: pointer;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none; width: 11px; height: 11px; border-radius: 50%;
      background: var(--z3); border: 2px solid var(--bg1); box-shadow: 0 0 0 1px var(--bd);
    }
    .sub-note { font-size: 10px; color: var(--z6); margin-top: 3px; line-height: 1.3; }

    /* ── MAIN ── */
    #main { flex: 1; padding: 28px 32px 60px; overflow-y: auto; min-width: 0; }
    #main::-webkit-scrollbar { width: 4px; }
    #main::-webkit-scrollbar-thumb { background: var(--bg2); }

    .page-header { margin-bottom: 20px; border-bottom: 2px solid var(--z3); padding-bottom: 14px; }
    .page-title { font-size: 19px; font-weight: 800; letter-spacing: -.02em; text-transform: uppercase; margin-bottom: 3px; }
    .page-sub { font-size: 10px; color: var(--z6); font-family: monospace; letter-spacing: .12em; text-transform: uppercase; }

    /* Scenario bar */
    .scen-bar { display: flex; gap: 1px; background: var(--bg2); margin-bottom: 24px; }
    .scen-btn {
      flex: 1; padding: 14px 16px; border: none; cursor: pointer;
      font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700;
      letter-spacing: .06em; text-transform: uppercase;
      background: var(--bg1); color: var(--z6); transition: all .15s; text-align: left;
    }
    .scen-btn:hover { background: var(--bg); color: var(--z4); }
    .scen-btn.active { background: var(--z3); color: #f1f3f5; }
    .scen-arr { display: block; font-size: 22px; font-weight: 800; letter-spacing: -.03em; margin-top: 5px; color: var(--am); line-height: 1; }
    .scen-cust { display: block; font-family: monospace; font-size: 9px; margin-top: 4px; opacity: .6; }

    /* No-follow-on banner */
    .nofund-banner {
      background: rgba(10,124,78,.07); border: 1px solid rgba(10,124,78,.25);
      padding: 12px 18px; display: flex; align-items: center; gap: 12px; margin-bottom: 24px;
    }
    .nofund-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--em); flex-shrink: 0; }
    .nofund-text { font-size: 12px; font-weight: 700; color: var(--em); }
    .nofund-sub { font-family: monospace; font-size: 10px; color: var(--z6); margin-top: 2px; }

    /* Roadmap */
    .roadmap { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1px; background: var(--bg2); margin-bottom: 24px; }
    .rm-card { background: var(--bg1); padding: 18px 20px; }
    .rm-year { font-family: monospace; font-size: 9px; letter-spacing: .2em; color: var(--z6); text-transform: uppercase; margin-bottom: 10px; }
    .rm-arr { font-size: 26px; font-weight: 800; letter-spacing: -.03em; color: var(--z3); margin-bottom: 3px; }
    .rm-cust { font-family: monospace; font-size: 11px; color: var(--z5); margin-bottom: 10px; }
    .rm-tag {
      display: inline-block; font-family: monospace; font-size: 9px;
      letter-spacing: .08em; text-transform: uppercase; padding: 2px 8px; border: 1px solid;
    }
    .tag-direct   { border-color: var(--z6); color: var(--z6); }
    .tag-break    { border-color: var(--am); color: var(--am); }
    .tag-profit   { border-color: var(--em); color: var(--em); background: rgba(10,124,78,.06); }

    /* KPI grid */
    .kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--bg2); margin-bottom: 24px; }
    .kpi { background: var(--bg1); padding: 14px 16px; }
    .kpi-label { font-family: monospace; font-size: 8px; letter-spacing: .22em; color: var(--z6); text-transform: uppercase; margin-bottom: 6px; }
    .kpi-value { font-size: 21px; font-weight: 800; letter-spacing: -.03em; line-height: 1; margin-bottom: 3px; }
    .kpi-sub { font-size: 9px; color: var(--z6); font-family: monospace; }
    .kpi-good { color: var(--em); } .kpi-warn { color: #c47a00; } .kpi-bad { color: var(--re); } .kpi-neutral { color: var(--z3); }

    /* Section */
    .section { margin-bottom: 24px; }
    .section-label {
      font-family: monospace; font-size: 9px; letter-spacing: .25em; text-transform: uppercase;
      color: var(--z5); display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-weight: 600;
    }
    .section-label::after { content:''; flex:1; height:1px; background: var(--bg2); }

    .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .chart-card { background: var(--bg1); border: 1px solid var(--bg2); padding: 16px 18px; }
    .chart-title { font-size: 11px; font-weight: 700; color: var(--z3); margin-bottom: 2px; text-transform: uppercase; letter-spacing: .02em; }
    .chart-desc { font-size: 9px; color: var(--z6); margin-bottom: 12px; font-family: monospace; }
    .chart-wrap { position: relative; height: 210px; }

    /* Table */
    .data-table { width: 100%; border-collapse: collapse; font-size: 11px; }
    .data-table th {
      font-family: monospace; font-size: 8px; letter-spacing: .18em; text-transform: uppercase;
      color: var(--z6); padding: 7px 11px; border-bottom: 1px solid var(--bg2); text-align: left;
    }
    .data-table td { padding: 7px 11px; border-bottom: 1px solid var(--bg2); color: var(--z4); }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table .num { text-align: right; font-family: monospace; font-weight: 600; }

    /* Soundbite */
    .soundbite { border-left: 2px solid var(--bd); padding: 7px 12px; margin-top: 10px; }
    .soundbite p { font-size: 10.5px; color: var(--z6); line-height: 1.5; font-style: italic; }
  </style>
</head>
<body>

<!-- ══════════ SIDEBAR ══════════ -->
<aside id="sidebar">
  <div class="sb-header">
    <p class="sb-title">Internal · Confidential</p>
    <p class="sb-brand">KYDE Channel Model</p>
  </div>

  <div class="sb-group">
    <div class="sb-group-label">↳ Funding</div>
    <div class="input-row">
      <div class="input-label"><span>Seed Raise</span><span class="val" id="v-raise">€2M</span></div>
      <input type="range" id="raise" min="500000" max="5000000" step="100000" value="2000000" />
      <p class="sub-note">Pre-Series A runway capital</p>
    </div>
  </div>

  <div class="sb-group">
    <div class="sb-group-label">↳ Team</div>
    <div class="input-row">
      <div class="input-label"><span>FTEs Year 1</span><span class="val" id="v-hc">6</span></div>
      <input type="range" id="hc" min="1" max="20" step="1" value="6" />
    </div>
    <div class="input-row">
      <div class="input-label"><span>Avg Total Comp</span><span class="val" id="v-comp">€130k</span></div>
      <input type="range" id="comp" min="60" max="250" step="10" value="130" />
      <p class="sub-note">Incl. employer social costs</p>
    </div>
    <div class="input-row">
      <div class="input-label"><span>Team Growth /yr</span><span class="val" id="v-hc-growth">1.5×</span></div>
      <input type="range" id="hc-growth" min="1.0" max="3.0" step="0.1" value="1.5" />
    </div>
  </div>

  <div class="sb-group">
    <div class="sb-group-label">↳ Channel</div>
    <div class="input-row">
      <div class="input-label"><span>Partner Margin</span><span class="val" id="v-ch-disc">20%</span></div>
      <input type="range" id="ch-disc" min="5" max="40" step="5" value="20" />
      <p class="sub-note">Discount to T-Systems etc.</p>
    </div>
  </div>

  <div class="sb-group">
    <div class="sb-group-label">↳ Costs</div>
    <div class="input-row">
      <div class="input-label"><span>Support COGS %</span><span class="val" id="v-cogs">4%</span></div>
      <input type="range" id="cogs" min="1" max="15" step="1" value="4" />
      <p class="sub-note">On-premise: support + implementation</p>
    </div>
    <div class="input-row">
      <div class="input-label"><span>Marketing Y1 /mo</span><span class="val" id="v-mkt">€15k</span></div>
      <input type="range" id="mkt" min="0" max="60000" step="2500" value="15000" />
    </div>
  </div>

  <div class="sb-group">
    <div class="sb-group-label">↳ Channel Mix (fixed per scenario)</div>
    <div style="display:flex;flex-direction:column;gap:1px;background:var(--bg2)">
      <div style="background:var(--bg);padding:8px 12px">
        <p style="font-family:monospace;font-size:9px;letter-spacing:.15em;color:var(--z6);margin-bottom:2px">YEAR 1</p>
        <p style="font-family:monospace;font-size:11px;color:var(--z4)">100% Direct</p>
      </div>
      <div style="background:var(--bg);padding:8px 12px">
        <p style="font-family:monospace;font-size:9px;letter-spacing:.15em;color:var(--z6);margin-bottom:2px">YEAR 2</p>
        <p style="font-family:monospace;font-size:11px;color:var(--z4)" id="sb-chmix-y2">—</p>
      </div>
      <div style="background:var(--bg);padding:8px 12px">
        <p style="font-family:monospace;font-size:9px;letter-spacing:.15em;color:var(--z6);margin-bottom:2px">YEAR 3</p>
        <p style="font-family:monospace;font-size:11px;color:var(--z4)" id="sb-chmix-y3">—</p>
      </div>
    </div>
  </div>
</aside>

<!-- ══════════ MAIN ══════════ -->
<main id="main">

  <div class="page-header">
    <h1 class="page-title">KYDE — On-Premise + Channel Model</h1>
    <p class="page-sub">↳ ON-PREMISE DEPLOYMENT · CHANNEL FROM YEAR 2 · FIGURES CALCULATED LIVE FROM INPUTS</p>
  </div>

  <!-- SCENARIO SELECTOR -->
  <div class="section">
    <div class="section-label">↳ SCENARIO</div>
    <div class="scen-bar">
      <button class="scen-btn active" id="scen-conservative" onclick="setScenario('conservative')">
        Conservative
        <span class="scen-arr">€6.6M</span>
        <span class="scen-cust">5 → 25 → 70 customers</span>
      </button>
      <button class="scen-btn" id="scen-base" onclick="setScenario('base')">
        Base Case
        <span class="scen-arr">€8.1M</span>
        <span class="scen-cust">5 → 30 → 90 customers</span>
      </button>
      <button class="scen-btn" id="scen-upside" onclick="setScenario('upside')">
        Upside
        <span class="scen-arr">€10.1M</span>
        <span class="scen-cust">5 → 35 → 120 customers</span>
      </button>
    </div>
  </div>

  <!-- NO FOLLOW-ON BANNER -->
  <div class="nofund-banner" id="nofund-banner">
    <div class="nofund-dot"></div>
    <div>
      <p class="nofund-text">No follow-on round required</p>
      <p class="nofund-sub" id="nofund-sub">—</p>
    </div>
  </div>

  <!-- THREE-YEAR ROADMAP -->
  <div class="section">
    <div class="section-label">↳ THREE-YEAR ROADMAP</div>
    <div class="roadmap">
      <div class="rm-card" style="border-top:3px solid var(--z5)">
        <p class="rm-year">↳ Year 1 — Prove It</p>
        <p class="rm-arr" id="rm-arr-1">€323k</p>
        <p class="rm-cust" id="rm-cust-1">5 Customers</p>
        <span class="rm-tag tag-direct">Direct Only</span>
        <p style="margin-top:10px;font-size:10.5px;color:var(--z5);line-height:1.5">
          Signed pilots in regulated sectors. Prove product works, document compliance outcomes, build reference cases.
        </p>
      </div>
      <div class="rm-card" style="border-top:3px solid var(--am)">
        <p class="rm-year">↳ Year 2 — Direct + First Channel</p>
        <p class="rm-arr" id="rm-arr-2">—</p>
        <p class="rm-cust" id="rm-cust-2">—</p>
        <span class="rm-tag tag-break">Break-even</span>
        <p style="margin-top:10px;font-size:10.5px;color:var(--z5);line-height:1.5">
          First T-Systems / BSH-type channel partnerships active. Channel customers add without proportional sales headcount.
        </p>
      </div>
      <div class="rm-card" style="border-top:3px solid var(--em)">
        <p class="rm-year">↳ Year 3 — Scale via Channel</p>
        <p class="rm-arr" id="rm-arr-3">—</p>
        <p class="rm-cust" id="rm-cust-3">—</p>
        <span class="rm-tag tag-profit" id="rm-tag-3">Profitable · No Follow-on</span>
        <p style="margin-top:10px;font-size:10.5px;color:var(--z5);line-height:1.5">
          Channel accounts for majority of new logos. KYDE team stays lean — margin compresses slightly, volume compensates.
        </p>
      </div>
    </div>
  </div>

  <!-- KPI ROW -->
  <div class="section">
    <div class="section-label">↳ KEY METRICS — YEAR 3</div>
    <div class="kpi-grid">
      <div class="kpi">
        <p class="kpi-label">ARR Year 3</p>
        <p class="kpi-value kpi-neutral" id="kpi-arr">—</p>
        <p class="kpi-sub" id="kpi-arr-sub">—</p>
      </div>
      <div class="kpi">
        <p class="kpi-label">Blended Gross Margin</p>
        <p class="kpi-value" id="kpi-gm">—</p>
        <p class="kpi-sub" id="kpi-gm-sub">After channel fees + support COGS</p>
      </div>
      <div class="kpi">
        <p class="kpi-label">EBITDA Year 3</p>
        <p class="kpi-value" id="kpi-ebitda">—</p>
        <p class="kpi-sub" id="kpi-ebitda-sub">—</p>
      </div>
      <div class="kpi">
        <p class="kpi-label">Cash End Y3</p>
        <p class="kpi-value" id="kpi-cash">—</p>
        <p class="kpi-sub">Raise + cumulative EBITDA</p>
      </div>
      <div class="kpi">
        <p class="kpi-label">Avg ACV Y3</p>
        <p class="kpi-value kpi-neutral" id="kpi-acv">—</p>
        <p class="kpi-sub" id="kpi-acv-sub">Per customer · growing via agents</p>
      </div>
    </div>
  </div>

  <!-- P&L + CHART -->
  <div class="chart-grid section">
    <div>
      <div class="section-label">↳ SIMPLIFIED P&L</div>
      <div class="chart-card" style="padding:0;overflow:hidden">
        <table class="data-table">
          <thead>
            <tr>
              <th>Line Item</th>
              <th style="text-align:right">Year 1</th>
              <th style="text-align:right">Year 2</th>
              <th style="text-align:right">Year 3</th>
            </tr>
          </thead>
          <tbody id="pl-tbody"></tbody>
        </table>
      </div>
      <div class="soundbite"><p id="sb-pl">—</p></div>
    </div>

    <div>
      <div class="section-label">↳ ARR + CASH BUILD</div>
      <div class="chart-card">
        <p class="chart-title">ARR (Direct + Channel) & Cash Position</p>
        <p class="chart-desc">Stacked bars = gross ARR · Line = cumulative cash after raise</p>
        <div class="chart-wrap"><canvas id="chart-main"></canvas></div>
      </div>
    </div>
  </div>

  <!-- CHANNEL BREAKDOWN -->
  <div class="chart-grid section">
    <div>
      <div class="section-label">↳ CHANNEL EFFICIENCY</div>
      <div class="chart-card">
        <p class="chart-title">Direct vs. Channel Revenue</p>
        <p class="chart-desc">How revenue shifts from direct to channel over time</p>
        <div class="chart-wrap"><canvas id="chart-channel"></canvas></div>
      </div>
    </div>

    <div>
      <div class="section-label">↳ WHY CHANNEL WINS</div>
      <div class="chart-card" style="padding:0;overflow:hidden">
        <table class="data-table">
          <thead>
            <tr>
              <th></th>
              <th style="text-align:right">Year 1</th>
              <th style="text-align:right">Year 2</th>
              <th style="text-align:right">Year 3</th>
            </tr>
          </thead>
          <tbody id="ch-tbody"></tbody>
        </table>
      </div>
      <div class="soundbite"><p id="sb-channel">—</p></div>
    </div>
  </div>

</main>

<script is:inline>
  // ── SCENARIOS ──
  const SCENARIOS = {
    conservative: { customers: [5, 25, 70],  arr: [323000, 2100000, 6600000],  channelMix: [0, 0.30, 0.55] },
    base:         { customers: [5, 30, 90],  arr: [323000, 2400000, 8100000],  channelMix: [0, 0.35, 0.60] },
    upside:       { customers: [5, 35, 120], arr: [323000, 2800000, 10100000], channelMix: [0, 0.40, 0.65] },
  };

  let currentScenario = 'conservative';

  // ── HELPERS ──
  function fmt(n) {
    const abs = Math.abs(n);
    if (abs >= 1e6) return '€' + (n / 1e6).toFixed(1) + 'M';
    if (abs >= 1e3) return '€' + (n / 1e3).toFixed(0) + 'k';
    return '€' + Math.round(n);
  }
  function pct(n) { return n.toFixed(1) + '%'; }

  const AM = '#fcb830', EM = '#0a7c4e', RE = '#c62828', Z5 = '#3d4350', Z6 = '#767d8a', BG1 = '#ffffff', BG2 = '#dde1e6';
  const MONO = "'Andale Mono','Courier New',ui-monospace,monospace";
  const CHART_BASE = {
    responsive: true, maintainAspectRatio: false,
    plugins: {
      legend: { labels: { color: Z5, font: { size: 10, family: MONO } } },
      tooltip: { backgroundColor: '#0d0e10', titleColor: '#f1f3f5', bodyColor: '#c8cdd4', borderColor: BG2, borderWidth: 1 },
    },
    scales: {
      x: { grid: { color: 'rgba(0,0,0,.06)' }, ticks: { color: Z6, font: { size: 10 } } },
      y: { grid: { color: 'rgba(0,0,0,.06)' }, ticks: { color: Z6, font: { size: 10 }, callback: v => fmt(v) } },
    },
  };

  const charts = {};
  function mkChart(id, cfg) {
    if (charts[id]) charts[id].destroy();
    const el = document.getElementById(id);
    if (el) charts[id] = new Chart(el.getContext('2d'), cfg);
  }

  // ── INPUTS ──
  const INPUTS = {
    raise:    { el: 'raise',     fmt: v => '€' + (v / 1e6).toFixed(1) + 'M', out: 'v-raise' },
    hc:       { el: 'hc',       fmt: v => v,                                   out: 'v-hc' },
    comp:     { el: 'comp',     fmt: v => '€' + v + 'k',                      out: 'v-comp' },
    hcGrowth: { el: 'hc-growth',fmt: v => parseFloat(v).toFixed(1) + '×',    out: 'v-hc-growth' },
    chDisc:   { el: 'ch-disc',  fmt: v => v + '%',                            out: 'v-ch-disc' },
    cogs:     { el: 'cogs',     fmt: v => v + '%',                            out: 'v-cogs' },
    mkt:      { el: 'mkt',      fmt: v => '€' + Math.round(v / 1000) + 'k',  out: 'v-mkt' },
  };

  function getP() {
    return {
      raise:    +document.getElementById('raise').value,
      hc:       +document.getElementById('hc').value,
      comp:     +document.getElementById('comp').value * 1000,
      hcGrowth: +document.getElementById('hc-growth').value,
      chDisc:   +document.getElementById('ch-disc').value / 100,
      cogs:     +document.getElementById('cogs').value / 100,
      mkt:      +document.getElementById('mkt').value,
    };
  }

  // ── CALC ──
  function calc(scKey, p) {
    const sc = SCENARIOS[scKey];
    const YRS = [0, 1, 2];

    const arr = sc.arr;
    const cust = sc.customers;
    const cmix = sc.channelMix; // % via channel

    const chRevGross = arr.map((a, i) => a * cmix[i]);
    const dirRev     = arr.map((a, i) => a * (1 - cmix[i]));
    // KYDE receives: full direct rev + channel rev net of partner margin
    const chFees     = chRevGross.map(r => r * p.chDisc);
    const netRev     = arr.map((a, i) => a - chFees[i]);
    const cogsCost   = arr.map(a => a * p.cogs);
    const grossProfit= netRev.map((n, i) => n - cogsCost[i]);
    const blendedGM  = grossProfit.map((g, i) => arr[i] > 0 ? g / arr[i] : 0);

    const hcCostY1 = p.hc * p.comp;
    const mktY1    = p.mkt * 12;
    const hcCost   = YRS.map(i => hcCostY1 * Math.pow(p.hcGrowth, i));
    const mktCost  = YRS.map(i => mktY1    * Math.pow(p.hcGrowth, i));
    const opex     = YRS.map(i => hcCost[i] + mktCost[i]);
    const hcFTE    = YRS.map(i => Math.round(p.hc * Math.pow(p.hcGrowth, i)));

    const ebitda    = YRS.map(i => grossProfit[i] - opex[i]);
    const ebitdaMgn = ebitda.map((e, i) => arr[i] > 0 ? e / arr[i] : 0);

    // Cumulative cash: raise invested at start, then add each year's EBITDA
    const cashEnd = YRS.map((_, i) => p.raise + ebitda.slice(0, i + 1).reduce((s, v) => s + v, 0));

    const acvY3 = cust[2] > 0 ? arr[2] / cust[2] : 0;
    const acvY1 = cust[0] > 0 ? arr[0] / cust[0] : 0;

    return { arr, cust, cmix, dirRev, chRevGross, chFees, netRev, cogsCost, grossProfit, blendedGM, hcCost, mktCost, opex, hcFTE, ebitda, ebitdaMgn, cashEnd, acvY3, acvY1 };
  }

  // ── RENDER ──
  function render() {
    const p = getP();
    const d = calc(currentScenario, p);
    const sc = SCENARIOS[currentScenario];

    // Roadmap
    document.getElementById('rm-arr-2').textContent = fmt(d.arr[1]);
    document.getElementById('rm-arr-3').textContent = fmt(d.arr[2]);
    document.getElementById('rm-cust-2').textContent = d.cust[1] + ' Customers';
    document.getElementById('rm-cust-3').textContent = d.cust[2] + ' Customers';

    // No-follow-on
    const cashY3 = d.cashEnd[2];
    document.getElementById('nofund-banner').style.display = cashY3 > 0 ? 'flex' : 'none';
    document.getElementById('nofund-sub').textContent =
      `Cash position end Year 3: ${fmt(cashY3)} — no further funding required from this seed round.`;

    // Sidebar channel mix labels
    document.getElementById('sb-chmix-y2').textContent = Math.round(sc.channelMix[1] * 100) + '% Channel';
    document.getElementById('sb-chmix-y3').textContent = Math.round(sc.channelMix[2] * 100) + '% Channel';

    // KPIs
    document.getElementById('kpi-arr').textContent = fmt(d.arr[2]);
    document.getElementById('kpi-arr-sub').textContent = d.cust[2] + ' customers · ' + Math.round(d.cmix[2] * 100) + '% via channel';

    const gm3 = d.blendedGM[2] * 100;
    document.getElementById('kpi-gm').textContent = pct(gm3);
    document.getElementById('kpi-gm').className = 'kpi-value ' + (gm3 > 83 ? 'kpi-good' : gm3 > 70 ? 'kpi-warn' : 'kpi-bad');
    document.getElementById('kpi-gm-sub').textContent = `Y1: 100% → Y3: ${pct(gm3)} (channel effect)`;

    const eb3 = d.ebitda[2];
    document.getElementById('kpi-ebitda').textContent = fmt(eb3);
    document.getElementById('kpi-ebitda').className = 'kpi-value ' + (eb3 > 0 ? 'kpi-good' : 'kpi-bad');
    document.getElementById('kpi-ebitda-sub').textContent = pct(d.ebitdaMgn[2] * 100) + ' EBITDA margin';

    document.getElementById('kpi-cash').textContent = fmt(cashY3);
    document.getElementById('kpi-cash').className = 'kpi-value ' + (cashY3 > 3e6 ? 'kpi-good' : cashY3 > 0 ? 'kpi-warn' : 'kpi-bad');

    document.getElementById('kpi-acv').textContent = fmt(d.acvY3);
    document.getElementById('kpi-acv-sub').textContent = `Y1: ${fmt(d.acvY1)} → Y3: ${fmt(d.acvY3)}`;

    // P&L
    const plLines = [
      { label: 'Gross Revenue',   vals: d.arr,               cls: 'am',  bold: false },
      { label: '↳ Direct',        vals: d.dirRev,             cls: 'dim', bold: false },
      { label: '↳ Channel',       vals: d.chRevGross,         cls: 'dim', bold: false },
      { label: 'Channel Fees',    vals: d.chFees.map(v=>-v),  cls: 're',  bold: false },
      { label: 'Support COGS',    vals: d.cogsCost.map(v=>-v),cls: 're',  bold: false },
      { label: 'GROSS PROFIT',    vals: d.grossProfit,        cls: 'em',  bold: true  },
      { label: 'Gross Margin %',  vals: d.blendedGM.map(v=>v*100), isPct: true },
      { label: `Headcount (${d.hcFTE.join('/')} FTEs)`, vals: d.hcCost.map(v=>-v), cls: 're' },
      { label: `Marketing (×${p.hcGrowth.toFixed(1)}/yr)`, vals: d.mktCost.map(v=>-v), cls: 're' },
      { label: 'EBITDA',          vals: d.ebitda,             cls: null,  bold: true  },
      { label: 'EBITDA Margin %', vals: d.ebitdaMgn.map(v=>v*100), isPct: true },
      { label: 'Cash End Year',   vals: d.cashEnd,            cls: null,  bold: false },
    ];

    document.getElementById('pl-tbody').innerHTML = plLines.map(row => {
      const isHdr = row.bold;
      const isDim = row.label.startsWith('↳');
      const rowStyle = isHdr ? 'font-weight:700;border-top:1px solid var(--bg2)' : '';
      const lblStyle = isHdr ? 'color:var(--z3)' : isDim ? 'color:var(--z6);font-size:10px' : '';
      return `<tr style="${rowStyle}">
        <td style="${lblStyle}">${row.label}</td>
        ${row.vals.map(v => {
          let color;
          if (row.isPct) {
            color = v >= 80 ? 'var(--em)' : v >= 50 ? 'var(--am)' : v >= 0 ? 'var(--z3)' : 'var(--re)';
          } else if (row.cls === 'am')  color = 'var(--am)';
          else if (row.cls === 'em')    color = 'var(--em)';
          else if (row.cls === 're')    color = 'var(--re)';
          else if (row.cls === 'dim')   color = 'var(--z6)';
          else color = v > 0 ? 'var(--em)' : v < 0 ? 'var(--re)' : 'var(--z6)';
          const display = row.isPct ? pct(v) : (v < 0 ? '−' : '') + fmt(Math.abs(v));
          return `<td class="num" style="color:${color}">${display}</td>`;
        }).join('')}
      </tr>`;
    }).join('');

    const beYear = d.ebitda[0] > 0 ? 1 : d.ebitda[1] > 0 ? 2 : d.ebitda[2] > 0 ? 3 : null;
    document.getElementById('sb-pl').textContent = beYear
      ? `Break-even in Year ${beYear}. Y3 EBITDA: ${fmt(d.ebitda[2])} (${pct(d.ebitdaMgn[2]*100)} margin). ${Math.round(p.chDisc*100)}% partner margin compresses blended GM from 100% → ${pct(gm3)} — volume more than compensates.`
      : 'Not break-even by Year 3 with current inputs — adjust raise or reduce costs.';

    // Main chart
    mkChart('chart-main', {
      type: 'bar',
      data: {
        labels: ['Year 1', 'Year 2', 'Year 3'],
        datasets: [
          { label: 'Direct ARR',    data: d.dirRev,    backgroundColor: '#3d4350', stack: 's' },
          { label: 'Channel ARR',   data: d.chRevGross,backgroundColor: AM, stack: 's' },
          { label: 'Cash Position', data: d.cashEnd,   type: 'line', borderColor: EM, backgroundColor: 'transparent', borderWidth: 2.5, pointRadius: 5, pointBackgroundColor: EM, yAxisID: 'y' },
        ],
      },
      options: {
        ...CHART_BASE,
        scales: {
          x: { ...CHART_BASE.scales.x, stacked: true },
          y: { ...CHART_BASE.scales.y, stacked: true },
        },
        plugins: {
          ...CHART_BASE.plugins,
          tooltip: { ...CHART_BASE.plugins.tooltip, callbacks: { label: c => ' ' + c.dataset.label + ': ' + fmt(c.raw) } },
        },
      },
    });

    // Channel split chart
    mkChart('chart-channel', {
      type: 'bar',
      data: {
        labels: ['Year 1', 'Year 2', 'Year 3'],
        datasets: [
          { label: 'Direct Revenue',  data: d.dirRev,    backgroundColor: '#3d4350', stack: 's' },
          { label: 'Channel Revenue', data: d.chRevGross,backgroundColor: AM, stack: 's' },
        ],
      },
      options: {
        ...CHART_BASE,
        scales: {
          x: { ...CHART_BASE.scales.x, stacked: true },
          y: { ...CHART_BASE.scales.y, stacked: true },
        },
        plugins: {
          ...CHART_BASE.plugins,
          tooltip: { ...CHART_BASE.plugins.tooltip, callbacks: { label: c => ' ' + c.dataset.label + ': ' + fmt(c.raw) + ' (' + pct(c.raw / d.arr[c.dataIndex] * 100) + ')' } },
        },
      },
    });

    // Channel table
    const chRows = [
      { label: 'Total Customers',   vals: d.cust },
      { label: 'Direct Customers',  vals: d.cust.map((c, i) => Math.round(c * (1 - d.cmix[i]))) },
      { label: 'Channel Customers', vals: d.cust.map((c, i) => Math.round(c * d.cmix[i])) },
      { label: 'Customers / FTE',   vals: d.cust.map((c, i) => (c / d.hcFTE[i]).toFixed(1)), noFmt: true },
      { label: 'Channel Fees Paid', vals: d.chFees, isMoney: true },
      { label: 'Blended Gross Margin', vals: d.blendedGM.map(v => v * 100), isPct: true },
    ];
    document.getElementById('ch-tbody').innerHTML = chRows.map(row => `
      <tr>
        <td style="color:var(--z5)">${row.label}</td>
        ${row.vals.map((v, i) => {
          let color = 'var(--z3)';
          if (row.isPct) color = v > 83 ? 'var(--em)' : v > 70 ? 'var(--am)' : 'var(--re)';
          if (row.isMoney && v > 0) color = 'var(--re)';
          const display = row.isPct ? pct(v) : row.isMoney ? fmt(v) : row.noFmt ? v : v;
          return `<td class="num" style="color:${color}">${display}</td>`;
        }).join('')}
      </tr>`).join('');

    const custPerFTE3 = (d.cust[2] / d.hcFTE[2]).toFixed(1);
    const chPctY3 = Math.round(d.cmix[2] * 100);
    document.getElementById('sb-channel').textContent =
      `${chPctY3}% of Y3 revenue via channel. Each FTE supports ${custPerFTE3} customers in Y3 vs. ${(d.cust[0] / d.hcFTE[0]).toFixed(1)} in Y1. Channel prevents 1:1 sales-headcount scaling — that's the structural advantage for Project A.`;
  }

  // ── SCENARIO SWITCHER ──
  function setScenario(key) {
    currentScenario = key;
    ['conservative', 'base', 'upside'].forEach(k =>
      document.getElementById('scen-' + k).classList.toggle('active', k === key)
    );
    render();
  }

  // ── BIND INPUTS ──
  Object.entries(INPUTS).forEach(([, cfg]) => {
    const el = document.getElementById(cfg.el);
    if (!el) return;
    document.getElementById(cfg.out).textContent = cfg.fmt(el.value);
    el.addEventListener('input', () => {
      document.getElementById(cfg.out).textContent = cfg.fmt(el.value);
      render();
    });
  });

  // ── AUTH ──
  if (localStorage.getItem('kyde_slides_auth') !== 'kyde_2026') {
    window.location.replace('/slides/');
  }

  // ── INIT ──
  render();
</script>

</body>
</html>
