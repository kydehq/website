---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// The five capabilities, in the order the page argues them. Kept as data so the
// scan list at the top and the deep sections below cannot drift apart.
const capabilities = [
  { n: '01', name: 'Flight recorder', line: 'Record every AI action.',                                    href: '#flight-recorder' },
  { n: '02', name: 'Control',         line: 'Govern every action before it happens.',                     href: '#control'         },
  { n: '03', name: 'Evaluate',        line: 'Continuously test AI against real-world behavior.',           href: '#replay'          },
  { n: '04', name: 'Replay',          line: "Rerun historical work against today's models and policies.", href: '#replay'      },
  { n: '05', name: 'Evidence',        line: 'Produce independently verifiable evidence.',                  href: '#evidence'        },
];

// Four ways in. A compliance partner and an underwriter want the same platform
// and will never search for it with the same words.
const entries = [
  {
    audience: 'For compliance',
    name: 'AI audit trail',
    line: 'Continuous evidence for regulated AI systems.',
    body: 'A hash-chained record written at the boundary, exported as a dated document an auditor recomputes offline. Built against GDPR, the EU AI Act, NIS-2 and DORA.',
    href: '#evidence',
  },
  {
    audience: 'For insurance',
    name: 'AI telemetry',
    line: 'Observe how AI actually behaves in production.',
    body: 'Not what a system was designed to do, and not what a questionnaire says it does. What it did: which actions, against which systems, how often, and how much of that was ever recorded.',
    href: '#flight-recorder',
  },
  {
    audience: 'For AI governance',
    name: 'Continuous evals',
    line: 'Measure whether AI stays reliable as models, data and workflows change.',
    body: 'A recorded run is a set of real cases with known outcomes. Re-run them when a model ships and the drift is a number rather than an anecdote from a support ticket.',
    href: '#replay',
  },
  {
    audience: 'For incident & risk',
    name: 'Replay',
    line: 'Reconstruct and rerun what happened.',
    body: 'A model swapped under the same name does not announce itself. Replaying a recorded run against the present turns "something changed" into a difference you can point at.',
    href: '#replay',
  },
];
---

<Base
  title="KYDE Zero Trust, The Zero Trust Layer for AI Workers and Agents"
  description="Traditional zero trust controls people, devices and networks. KYDE extends it to what AI actually does: identity, policy, data and limits checked at the moment of action, and evidence anyone can verify afterwards."
>
  <Navbar />

  <main>
    <!-- ══════════ HERO ══════════ -->
    <section class="relative bg-bg-1 overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-[0.06] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-32 pb-20 md:border-x md:border-line-0">
        <div class="max-w-3xl">
          <p class="font-mono text-[10px] md:text-[11px] text-white/55 uppercase tracking-[0.2em] mb-6">
            Built for GDPR <span class="text-white/30" aria-hidden="true">·</span> EU AI Act <span class="text-white/30" aria-hidden="true">·</span> NIS-2 <span class="text-white/30" aria-hidden="true">·</span> DORA
          </p>
          <h1 class="hero-h1 text-4xl md:text-5xl lg:text-6xl text-white uppercase tracking-tight leading-[1.05] mb-6">
            KYDE<br />Zero Trust
          </h1>
          <p class="text-lg md:text-xl text-white uppercase tracking-[0.12em] leading-snug mb-5">
            The zero trust layer for AI workers and agents.
          </p>
          <p class="text-lg text-white/50 leading-relaxed max-w-2xl mb-6">
            Control every action. Record every decision. Prove what happened. KYDE sits between AI workers, models, tools and business systems, and every action crosses the same boundary before it executes.
          </p>
          <p class="font-mono text-[10px] md:text-[11px] text-white/45 uppercase tracking-[0.18em] mb-10">
            Identity <span class="text-white/20">·</span> Policy <span class="text-white/20">·</span> Data <span class="text-white/20">·</span> Limits <span class="text-white/20">·</span> Evidence
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <button onclick="openModal()" class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all">
              Talk to us →
            </button>
            <a href="/" class="inline-flex items-center gap-2 border border-white/25 text-white/60 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.12em] hover:border-white/60 hover:text-white/90 transition-all">
              See the workers →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ WHAT IT EXTENDS ══════════ -->
    <!-- A reader who knows NIST SP 800-207 will check this claim in the first ten
         seconds, so the page states the difference itself rather than letting them
         find it. We are not a network access product. The boundary is the action. -->
    <section class="border-t border-line-0 bg-bg-0">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="grid md:grid-cols-2 gap-10 md:gap-0 md:divide-x md:divide-line-0 [&>*:first-child]:md:pr-12 [&>*:last-child]:md:pl-12 lg:[&>*:first-child]:pr-16 lg:[&>*:last-child]:pl-16">
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ink-2 mb-5">Zero trust today</span>
            <p class="text-xl md:text-2xl text-ink-1 leading-snug">
              Controls people, devices and networks. Verifies who is connecting, from what, to which resource.
            </p>
          </div>
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ember mb-5">What KYDE extends it to</span>
            <p class="text-xl md:text-2xl text-ink-0 leading-snug">
              What the AI actually does. The connection was authorized hours ago. The action is the thing that needs verifying, every time, on its own.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ THE FIVE ══════════ -->
    <!-- The fifteen-second read. A partner at an audit firm should be able to scan
         this and know whether the rest of the page is worth their time. -->
    <section class="border-t border-line-0 bg-bg-0">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-10">
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">What the platform does</span>
        </div>
        <ul class="border border-line-0 divide-y divide-line-0">
          {capabilities.map(({ n, name, line, href }) => (
            <li>
              <a href={href} class="group grid md:grid-cols-[56px_minmax(0,220px)_1fr_auto] gap-2 md:gap-8 items-baseline px-5 py-5 md:px-7 md:py-6 hover:bg-bg-1 transition-colors">
                <span class="font-mono text-[11px] tracking-[0.1em] text-gold">{n}</span>
                <span class="font-mono text-xs uppercase tracking-[0.16em] text-ink-0">{name}</span>
                <span class="text-base md:text-lg text-ink-1 leading-relaxed">{line}</span>
                <span class="hidden md:inline font-mono text-xs text-ink-2 group-hover:text-ink-0 transition-colors">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>


    <!-- ══════════ WHERE IT SITS ══════════ -->
    <!-- The layer cake, in the order the layer is actually described: the systems
         are the ground, the trust layer is the slab on top of them, and whatever
         runs the work sits on the slab. Everything reaching a system crosses it.
         Two things sit up there, one we build and one somebody else did, and that
         is the whole reason a single product has two very different buyers. -->
    <section class="border-t border-line-0 bg-bg-0">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-10">
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">Where it sits</span>
          <span class="fig-label">FIG.1</span>
        </div>

        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-ink-0 mb-10 max-w-3xl">
          Under everything that acts. Above everything it can reach.
        </h2>

        <div class="border border-line-0 bg-white/[0.02] px-4 py-5 md:px-8 md:py-7">
          <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-2">Workers are built on it. It also runs on its own.</span>
            <span class="fig-label">FIG.1</span>
          </div>
          <svg viewBox="0 0 1000 400" class="w-full h-auto" aria-hidden="true">
            <path d="M6 21 L6 6 L21 6"           fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
            <path d="M979 6 L994 6 L994 21"      fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
            <path d="M6 379 L6 394 L21 394"      fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
            <path d="M994 379 L994 394 L979 394" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />

            <!-- on top: two things that act -->
            <rect x="110" y="34" width="360" height="88" fill="none" stroke="var(--color-live)" stroke-opacity="0.45" stroke-width="1" />
            <text x="290" y="66" text-anchor="middle" fill="var(--color-live)" fill-opacity="0.90" style="font-family:'JetBrains Mono Variable',monospace;font-size:11px;letter-spacing:0.16em;">KYDE WORKERS</text>
            <text x="290" y="88" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;">code · agents · people</text>
            <text x="290" y="106" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.30" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;">we build these with you</text>

            <rect x="530" y="34" width="360" height="88" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.30" stroke-width="1" />
            <text x="710" y="66" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.80" style="font-family:'JetBrains Mono Variable',monospace;font-size:11px;letter-spacing:0.16em;">AI YOU ALREADY RUN</text>
            <text x="710" y="88" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;">agents · copilots · pipelines</text>
            <text x="710" y="106" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.30" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;">somebody else built these</text>

            <!-- both come down through the same layer -->
            <line x1="290" y1="122" x2="290" y2="168" stroke="var(--color-ink-0)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="3 4" />
            <line x1="710" y1="122" x2="710" y2="168" stroke="var(--color-ink-0)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="3 4" />

            <!-- the slab: wider than what stands on it, and the heaviest line here -->
            <rect x="40" y="168" width="920" height="108" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.70" stroke-width="2" />
            <text x="500" y="206" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.90" style="font-family:'JetBrains Mono Variable',monospace;font-size:13px;letter-spacing:0.2em;">KYDE ZERO TRUST</text>
            <g style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.1em;" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.55">
              <text x="140" y="240">identity</text>
              <text x="320" y="240">policy</text>
              <text x="500" y="240">data</text>
              <text x="680" y="240">limits</text>
              <text x="860" y="240">evidence</text>
            </g>
            <text x="500" y="262" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.32" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.1em;">nothing reaches a system without crossing this</text>

            <!-- and land on the ground -->
            <line x1="500" y1="276" x2="500" y2="314" stroke="var(--color-ink-0)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="3 4" />

            <rect x="40" y="314" width="920" height="58" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.40" stroke-width="1" />
            <text x="500" y="341" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.70" style="font-family:'JetBrains Mono Variable',monospace;font-size:11px;letter-spacing:0.16em;">YOUR SYSTEMS</text>
            <text x="500" y="359" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.32" style="font-family:'JetBrains Mono Variable',monospace;font-size:8px;letter-spacing:0.08em;">ERP · databases · MCP servers · payment APIs</text>
          </svg>
          <p class="mt-6 font-mono text-[10px] text-ink-2 leading-relaxed border-t border-line-0 pt-4">
            FIG.1 · Workers we build and AI you already run cross the same layer. Whichever you start with, the controls and the record are the same.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ FOUR WAYS IN ══════════ -->
    <section class="border-t border-line-0 bg-bg-0">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="flex items-end justify-between border-b border-line-0 pb-3 mb-10">
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">Four ways in</span>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-ink-0 mb-10 max-w-3xl">
          One layer. Five jobs, depending on what brought you here.
        </h2>
        <div class="grid md:grid-cols-2 border border-line-0">
          {entries.map(({ audience, name, line, body, href }, i) => (
            <a href={href} class:list={["group block p-6 md:p-8 hover:bg-bg-1 transition-colors border-line-0", i % 2 === 0 ? "md:border-r" : "", i === entries.length - 1 ? "" : "border-b", i >= entries.length - 2 ? "md:border-b-0" : ""]}>
              <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-ember mb-4">{audience}</span>
              <h3 class="text-xl md:text-2xl font-bold tracking-tight text-ink-0 leading-tight mb-2">{name}</h3>
              <p class="font-mono text-xs uppercase tracking-[0.1em] text-ink-1 mb-4">{line}</p>
              <p class="text-sm text-ink-1 leading-relaxed">{body}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-2 group-hover:text-ink-0 transition-colors">Read on →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
        <!-- ══════════ 01 · FLIGHT RECORDER ══════════ -->
        <!-- First thing past the fold. The topology is the argument: a reader has to
             see that everything crosses one place before "system of record" means
             anything. FIG.2 is full-width for that reason, like the ladder further
             down, and it is the only figure on the page that shows the whole shape. -->
        <section id="flight-recorder" class="scroll-mt-20 border-b border-line-0 bg-bg-0">
            <div class="max-w-7xl mx-auto px-6 py-20 md:py-28 md:border-x md:border-white/10">

                <div class="flex items-end justify-between border-b border-white/10 pb-3 mb-12">
                    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/65">01 · Flight recorder</span>
                    <span class="fig-label">FIG.2</span>
                </div>

                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-white mb-4 max-w-4xl">
                    Record every AI action.
                </h2>
                <p class="font-mono text-sm text-white/70 uppercase tracking-[0.12em] mb-8">Humans · Agents · Tool calls · Approvals</p>
                <p class="text-lg text-white/55 leading-relaxed max-w-3xl mb-12">
                    Every action an AI system takes crosses one layer, and that is where it stops being traffic and becomes a record. Who acted, under whose identity, against which model, reaching which system. Written as it passes, not reconstructed afterwards from four vendor consoles that each saw a different part of it.
                </p>

                <!-- The plot frame gives the topology something to stand in, same
                     treatment as the ladder figure. -->
                <div class="border border-white/10 bg-white/[0.02] px-4 py-5 md:px-8 md:py-7">
                    <div class="flex items-end justify-between border-b border-white/10 pb-3 mb-6">
                        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45">One record, written where the work passes</span>
                        <span class="fig-label">FIG.2</span>
                    </div>
                    <svg id="spine-fig" viewBox="0 0 1000 420" class="w-full h-auto" aria-hidden="true">
                        <!-- corner register marks, as on every other figure -->
                        <path d="M6 21 L6 6 L21 6" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
                        <path d="M979 6 L994 6 L994 21" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
                        <path d="M6 399 L6 414 L21 414" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />
                        <path d="M994 399 L994 414 L979 414" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.45" stroke-width="1" />

                        <text x="40" y="34" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">A COMPANY THAT RUNS ON AGENTS</text>
                        <text x="960" y="34" text-anchor="end" fill="var(--color-ink-0)" fill-opacity="0.55" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.16em;">THE SYSTEMS THEY REACH</text>

                        <!-- left: the agent fleet, by function rather than by three
                             generic boxes, so "a whole company" is visible at a glance -->
                        {[
                            { y: 96,  l: "CODING" },
                            { y: 148, l: "SUPPORT" },
                            { y: 200, l: "FINANCE" },
                            { y: 252, l: "HR" },
                            { y: 304, l: "OPS" },
                        ].map(({ y, l }) => (
                            <>
                                <rect x="40" y={y - 16} width="132" height="32" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.30" stroke-width="1" />
                                <text x="106" y={y + 4} text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.6" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.12em;">{l}</text>
                                <line x1="172" y1={y} x2="436" y2={y} stroke="var(--color-ink-0)" stroke-opacity="0.14" stroke-width="1" stroke-dasharray="3 6" />
                                <line x1="564" y1={y} x2="828" y2={y} stroke="var(--color-ink-0)" stroke-opacity="0.14" stroke-width="1" stroke-dasharray="3 6" />
                            </>
                        ))}

                        <!-- right: the systems, which belong to as many vendors as the agents do -->
                        {[
                            { y: 96,  l: "POSTGRES" },
                            { y: 148, l: "MCP SERVERS" },
                            { y: 200, l: "SAP · ERP" },
                            { y: 252, l: "STRIPE" },
                            { y: 304, l: "S3" },
                        ].map(({ y, l }) => (
                            <>
                                <rect x="828" y={y - 16} width="132" height="32" fill="none" stroke="var(--color-ink-0)" stroke-opacity="0.30" stroke-width="1" />
                                <text x="894" y={y + 4} text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.6" style="font-family:'JetBrains Mono Variable',monospace;font-size:10px;letter-spacing:0.12em;">{l}</text>
                            </>
                        ))}

                        <!-- the spine: one layer, full height, nothing routes around it -->
                        <rect x="436" y="64" width="128" height="276" fill="var(--color-bg-0)" stroke="var(--color-ink-0)" stroke-opacity="0.60" stroke-width="1.5" />
                        <text x="500" y="190" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.9" style="font-family:'JetBrains Mono Variable',monospace;font-size:19px;font-weight:700;letter-spacing:0.22em;">KYDE</text>
                        <text x="500" y="212" text-anchor="middle" fill="var(--color-ink-0)" fill-opacity="0.50" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.14em;">one record</text>

                        <!-- what leaves the spine downward is the chain itself -->
                        <line x1="500" y1="340" x2="500" y2="366" stroke="var(--color-live)" stroke-opacity="0.50" stroke-width="1" stroke-dasharray="3 4" />

                        <defs>
                            <radialGradient id="spine-glow">
                                <stop offset="0%" stop-color="var(--color-ink-0)" stop-opacity="0.9" />
                                <stop offset="25%" stop-color="var(--color-ink-0)" stop-opacity="0.32" />
                                <stop offset="60%" stop-color="var(--color-live)" stop-opacity="0.2" />
                                <stop offset="100%" stop-color="var(--color-live)" stop-opacity="0" />
                            </radialGradient>
                        </defs>
                        <g id="spine-blooms"></g>
                        <g id="spine-actions"></g>
                        <!-- the chain scrolls under a clip, so links leave the frame
                             instead of piling up at the left edge -->
                        <clipPath id="spine-chain-clip"><rect x="30" y="348" width="940" height="48" /></clipPath>
                        <g clip-path="url(#spine-chain-clip)"><g id="spine-chain"></g></g>

                        <text x="40" y="410" fill="var(--color-ink-0)" fill-opacity="0.45" style="font-family:'JetBrains Mono Variable',monospace;font-size:9px;letter-spacing:0.14em;">sha-256 · append-only · recomputed offline</text>
                    </svg>
                    <p class="mt-4 text-center font-mono text-[10px] text-white/35 leading-relaxed">
                        FIG.2 · Every step appends a link. The work writes the record as it happens.
                    </p>
                </div>
            </div>
            <script>
                // FIG.2 · actions cross from the fleet to the systems through the spine.
                // The chain below grows by exactly one link per crossing, because that is
                // the claim: the record is not assembled afterwards from someone's logs,
                // it is a side effect of the traffic passing through.
                const spineFig = document.getElementById("spine-fig");
                const spineReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                if (spineFig) {
                    const NS = "http://www.w3.org/2000/svg";
                    const LANES = [96, 148, 200, 252, 304];
                    const START = 176, CROSS = 500, END = 824;
                    const CHAIN_Y = 372, LINK_W = 46, LINK_X0 = 60, VISIBLE = 17;

                    const actLayer = document.getElementById("spine-actions") as unknown as SVGGElement;
                    const chainLayer = document.getElementById("spine-chain") as unknown as SVGGElement;

                    // Bloom borrowed from the hero canvas: expands on an ease-out and
                    // burns down over roughly two seconds, so a contact glows like an
                    // ember rather than switching on.
                    const bloomLayer = document.getElementById("spine-blooms") as unknown as SVGGElement;
                    const blooms: { el: SVGCircleElement; r: number; a: number; max: number }[] = [];
                    const bloom = (bx: number, by: number, r0 = 8, peak = 0.85) => {
                        const c = document.createElementNS(NS, "circle") as SVGCircleElement;
                        c.setAttribute("cx", String(bx));
                        c.setAttribute("cy", String(by));
                        c.setAttribute("r", String(r0));
                        c.setAttribute("fill", "url(#spine-glow)");
                        c.setAttribute("opacity", String(peak));
                        bloomLayer.appendChild(c);
                        blooms.push({ el: c, r: r0, a: peak, max: r0 + 54 });
                    };
                    const stepBlooms = () => {
                        for (let i = blooms.length - 1; i >= 0; i--) {
                            const b = blooms[i];
                            b.r += (b.max - b.r) * 0.045;
                            b.a *= 0.972;
                            if (b.a < 0.02) { b.el.remove(); blooms.splice(i, 1); }
                            else { b.el.setAttribute("r", b.r.toFixed(1)); b.el.setAttribute("opacity", b.a.toFixed(3)); }
                        }
                    };


                    type Act = { el: SVGCircleElement; x: number; lane: number; signed: boolean };
                    type Link = { g: SVGGElement; x: number };
                    const acts: Act[] = [];
                    let links: Link[] = [];
                    // Absolute position of every link ever written. The chain never
                    // restarts: it slides continuously left while new links are appended
                    // on the right, so the ledger reads as endless rather than as a
                    // buffer that fills up and jumps.
                    let written = 0;
                    let scrollX = 0;

                    const appendLink = () => {
                        const g = document.createElementNS(NS, "g");
                        const conn = document.createElementNS(NS, "line");
                        conn.setAttribute("x1", String(-LINK_W + 26));
                        conn.setAttribute("y1", String(CHAIN_Y));
                        conn.setAttribute("x2", "0");
                        conn.setAttribute("y2", String(CHAIN_Y));
                        conn.setAttribute("stroke", "var(--color-ink-0)");
                        conn.setAttribute("stroke-opacity", "0.4");
                        conn.setAttribute("stroke-width", "1");
                        g.appendChild(conn);

                        const box = document.createElementNS(NS, "rect");
                        box.setAttribute("x", "0");
                        box.setAttribute("y", String(CHAIN_Y - 9));
                        box.setAttribute("width", "26");
                        box.setAttribute("height", "18");
                        box.setAttribute("fill", "none");
                        box.setAttribute("stroke", "var(--color-live)");
                        box.setAttribute("stroke-opacity", "0.85");
                        box.setAttribute("stroke-width", "1.5");
                        g.appendChild(box);

                        chainLayer.appendChild(g);
                        links.push({ g, x: written * LINK_W });
                        written += 1;

                        // the newest link is the bright one; everything behind it settles
                        links.forEach((l, i) => {
                            const r = l.g.children[1] as SVGRectElement;
                            const fresh = i === links.length - 1;
                            r.setAttribute("stroke", fresh ? "var(--color-live)" : "var(--color-ink-0)");
                            r.setAttribute("stroke-opacity", fresh ? "0.9" : "0.42");
                            r.setAttribute("stroke-width", fresh ? "1.5" : "1");
                        });
                    };

                    // Scroll target is derived from how many links exist, not from a fixed
                    // speed, so the chain self-corrects instead of drifting out of step
                    // with the crossings that feed it.
                    const advanceChain = () => {
                        const target = Math.max(0, (written - VISIBLE) * LINK_W);
                        scrollX += (target - scrollX) * 0.08;
                        for (let i = links.length - 1; i >= 0; i--) {
                            const screenX = LINK_X0 + links[i].x - scrollX;
                            if (screenX < -LINK_W * 2) {
                                links[i].g.remove();
                                links.splice(i, 1);
                            } else {
                                links[i].g.setAttribute("transform", `translate(${screenX},0)`);
                            }
                        }
                    };

                    const spawn = (lane: number) => {
                        const el = document.createElementNS(NS, "circle") as SVGCircleElement;
                        el.setAttribute("cx", String(START));
                        el.setAttribute("cy", String(LANES[lane]));
                        el.setAttribute("r", "4");
                        el.setAttribute("fill", "var(--color-ink-0)");
                        el.setAttribute("fill-opacity", "0.62");
                        actLayer.appendChild(el);
                        acts.push({ el, x: START, lane, signed: false });
                    };

                    const step = (a: Act) => {
                        a.x += 1.5;
                        // the crossing is the event: this is the moment a link exists
                        if (!a.signed && a.x >= CROSS) {
                            a.signed = true;
                            a.el.setAttribute("fill", "var(--color-live)");
                            a.el.setAttribute("fill-opacity", "0.9");
                            appendLink();
                            bloom(CROSS, LANES[a.lane]);
                        }
                        a.el.setAttribute("cx", String(a.x));
                        return a.x < END;
                    };

                    if (spineReduced) {
                        // Static equivalent: a settled chain and one action on each side.
                        for (let i = 0; i < VISIBLE; i++) appendLink();
                        advanceChain();
                        links.forEach((l) => l.g.setAttribute("transform", `translate(${LINK_X0 + l.x},0)`));
                        [0, 2, 4].forEach((lane) => {
                            spawn(lane);
                            const a = acts[acts.length - 1];
                            a.x = lane === 2 ? END - 120 : START + 90;
                            a.el.setAttribute("cx", String(a.x));
                        });
                    } else {
                        let visible = false;
                        let spawnAt = 0;
                        let n = 0;
                        new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(spineFig);
                        const loop = (now: number) => {
                            if (visible) {
                                if (now > spawnAt) {
                                    spawn(n % LANES.length);
                                    n += 1;
                                    spawnAt = now + 1000;
                                }
                                for (let i = acts.length - 1; i >= 0; i--) {
                                    if (!step(acts[i])) { acts[i].el.remove(); acts.splice(i, 1); }
                                }
                                advanceChain();
                                stepBlooms();
                            }
                            requestAnimationFrame(loop);
                        };
                        requestAnimationFrame(loop);
                    }
                }
            </script>
        </section>
