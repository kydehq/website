---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const industries = [
  { n: "01", t: "Fintech and BNPL",                    d: "Agents decide creditworthiness in real time. EU AI Act high-risk, plus DORA. You must explain every rejection." },
  { n: "02", t: "HR tech and recruiting",               d: "Agents screen CVs and rank candidates. High-risk under Annex III. If an agent discriminated, you must prove what happened, or that it did not." },
  { n: "03", t: "Insurance",                            d: "Agents assess damage and release payments. When the supervisor asks why claims were systematically underpaid, you need the decision trail." },
  { n: "04", t: "Banking customer service",             d: "Chatbots with transaction rights. If a fraudster changed an address through your agent, the burden of proof is yours." },
  { n: "05", t: "Software delivery for regulated clients", d: "Your developers use coding agents on systems your bank customers get audited on. Your client will ask for proof of code provenance." },
];

const rightFit = [
  { t: "You carry the liability.", d: "You are a CISO, CCO, DPO or board member in a regulated company. NIS-2 makes management personally liable today. DORA requires financial entities to prove operational control today. The EU AI Act adds logging duties for high-risk systems from December 2, 2027. When the regulator asks what your agents did last quarter, the answer lands on your desk." },
  { t: "Your agents act, not just chat.", d: "Your AI does not only answer questions. It screens candidates, approves claims, changes customer records, writes production code or moves money. The moment an agent acts, the question changes from “was the answer good” to “was the action allowed, and can we prove it.”" },
  { t: "You cannot see every agent.", d: "Teams adopt agents faster than security can review them. You suspect there are agents running right now that never crossed your desk. You need governance that covers agents that never opted in, without asking every developer to change code." },
  { t: "You need evidence, not dashboards.", d: "An auditor, a regulator or a court will not accept a screenshot of a monitoring tool. You need records that are hash-chained, tamper-evident and independent of the AI vendor whose agent is under investigation." },
];

const notForYou = [
  { t: "You use AI only for content and chat.", d: "If no agent touches a system of record, a prompt safety tool serves you better than a governance boundary." },
  { t: "You want prompt injection detection as the core feature.", d: "That is the semantic layer. Kyde is the structural layer beneath it: what may execute at all. The two combine well, but do not confuse them." },
  { t: "You are a consumer app.", d: "Kyde is enterprise infrastructure for organizations that answer to regulators." },
  { t: "You want an AI usage policy PDF.", d: "GRC platforms document your program. Kyde enforces it at runtime and produces the evidence. Documentation without enforcement will not survive an incident." },
];

const checklist = [
  "Do you have AI agents in production today, or within two quarters?",
  "Could any of them be classified high-risk under the EU AI Act?",
  "Could you prove, this week, what a specific agent did last week?",
  "Who is personally accountable if an agent causes damage?",
  "Is NIS-2 or DORA already on your compliance roadmap?",
];
---

<Base
  title="Who Kyde Is For (And Who It Is Not)"
  description="Kyde is built for security and compliance leaders in regulated industries who are liable for what AI agents do. Check in two minutes whether that is you."
>
  <Navbar />
  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-36 md:border-x md:border-[#1F1F1F]">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#A8A8A8]">01 · Who it's for</span></div>
        </div>
        <h1 class="hero-h1 max-w-4xl text-5xl text-[#F2F2F2] uppercase tracking-tight md:text-6xl lg:text-7xl mb-8">
          Kyde is not<br /><span class="gradient-text">for everyone.</span>
        </h1>
        <p class="text-lg text-[#A8A8A8] leading-relaxed max-w-2xl">
          It is built for a specific situation: your organization runs AI agents that act, and someone in your organization is legally responsible for what they do. If that sentence describes you, everything on this site was written for you. If not, we would rather tell you now than waste your evaluation cycle.
        </p>
      </div>
    </section>

    <!-- ══════════ YOU ARE IN THE RIGHT PLACE IF ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">
        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#A8A8A8]">02 · You are in the right place if</span></div>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          {rightFit.map(({ t, d }) => (
            <div class="border border-[#1F1F1F] bg-[#0C0C0C] p-8">
              <p class="text-lg font-bold text-[#F2F2F2] mb-3">{t}</p>
              <p class="text-sm text-[#A8A8A8] leading-relaxed">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ INDUSTRIES ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">
        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3 mb-6"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#A8A8A8]">03 · The industries we serve first</span></div>
          <p class="text-sm text-[#A8A8A8] max-w-2xl leading-relaxed">
            Kyde works with early access partners in regulated industries. The deepest fit today:
          </p>
        </div>
        <div class="divide-y divide-[#1F1F1F] border border-[#1F1F1F]">
          {industries.map(({ n, t, d }) => (
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 p-6 md:p-8">
              <span class="font-mono text-xs text-[#FEC106] shrink-0">{n}</span>
              <div>
                <p class="text-base font-bold text-[#F2F2F2] mb-1.5">{t}</p>
                <p class="text-sm text-[#A8A8A8] leading-relaxed">{d}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-[#A8A8A8] max-w-2xl leading-relaxed">
          Also a strong fit: legal tech, healthcare AI, critical infrastructure, education technology and public sector software. Detailed pages per industry are rolling out.
        </p>
      </div>
    </section>

    <!-- ══════════ NOT FOR YOU IF ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">
        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#A8A8A8]">04 · Kyde is probably not for you if</span></div>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          {notForYou.map(({ t, d }) => (
            <div class="border border-[#1F1F1F] bg-[#0C0C0C] p-8">
              <div class="flex items-start gap-3">
                <span class="text-[#6B6B6B] shrink-0 mt-0.5">✕</span>
                <div>
                  <p class="text-base font-bold text-[#F2F2F2] mb-2">{t}</p>
                  <p class="text-sm text-[#A8A8A8] leading-relaxed">{d}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ SELF CHECK ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">
        <div class="mb-12">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#A8A8A8]">05 · A two minute self check</span></div>
        </div>
        <div class="max-w-3xl border border-[#1F1F1F] bg-[#0C0C0C]">
          <ol class="divide-y divide-[#1F1F1F]">
            {checklist.map((q, i) => (
              <li class="flex items-start gap-4 p-6">
                <span class="font-mono text-sm text-[#6B6B6B] shrink-0">{i + 1}</span>
                <p class="text-base text-[#F2F2F2] leading-relaxed">{q}</p>
              </li>
            ))}
          </ol>
        </div>
        <p class="mt-6 max-w-3xl text-sm text-[#A8A8A8] leading-relaxed">
          If you answered yes to question 1, are unsure about question 2, and answered "not really" to question 3: that is exactly the gap Kyde closes. Question 4 is why it matters. Question 5 is why it matters now.
        </p>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-[#1F1F1F]">
        <div class="border border-[#1F1F1F] p-12 md:p-20">
          <div class="max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-[#F2F2F2] mb-4">
              That sentence describes you. Now see it working.
            </h2>
            <p class="text-lg text-[#A8A8A8] mb-10">
              Start with the free Kyde Gateway Starter and see every agent action in a hash-chained ledger, or talk to us about early access.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/starter" class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-[#0A0A0A] hover:bg-[#E5E5E5] transition-all">
                Start Free →
              </a>
              <button onclick="openModal()" class="inline-flex items-center gap-2 border border-[#2E2E2E] px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-[#F2F2F2] hover:border-white/40 transition-all">
                Talk to Us →
              </button>
            </div>
            <p class="mt-8 font-mono text-xs text-[#6B6B6B]">
              <a href="/pricing" class="hover:text-[#F2F2F2] transition-colors">Pricing</a> · <a href="/platform" class="hover:text-[#F2F2F2] transition-colors">Platform</a> · <a href="/compare/kyde-vs-witnessai" class="hover:text-[#F2F2F2] transition-colors">Kyde vs WitnessAI</a>
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
