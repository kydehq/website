<script>
  // ── HERO · exhaust capture loop ─────────────────────────────────────
  // Learning-exhaust particles drift toward the vendor; at the trust
  // boundary they are captured (green pulse) and arc back into your
  // tenant's ledger, which visibly grows. A few are blocked (red X).
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.getElementById("lp-exhaust") as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    let W = 0, H = 0, GATE = 0;
    let vault = { x: 0, y: 0, fill: 0 };

    function hash(n: number): number {
      let t = (n + 0x6d2b79f5) | 0;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }

    type P = {
      x: number; y: number; vx: number; seed: number;
      state: "out" | "captured" | "blocked";
      cx: number; cy: number; sx: number; sy: number; t: number; pulse: number;
    };
    let parts: P[] = [];

    function spawn(p: P, i: number, initial = false) {
      p.x = initial ? hash(i * 7 + 1) * GATE * 0.9 : -10 - hash(i * 13) * 60;
      p.y = 60 + hash(i * 31 + performance.now() % 9973) * (H - 140);
      p.vx = 14 + hash(i * 17) * 22;
      p.seed = i * 7919 + Math.floor(performance.now());
      p.state = "out";
      p.t = 0; p.pulse = 0;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      GATE = W * 0.72;
      vault = { x: W * 0.42, y: H * 0.84, fill: vault.fill };
      parts = [];
      const n = Math.max(36, Math.floor(W / 20));
      for (let i = 0; i < n; i++) { const p = {} as P; spawn(p, i, true); parts.push(p); }
    }

    let last = 0;
    function draw(t: number) {
      const dt = Math.min((t - last) / 1000, 0.05) || 0.016;
      last = t;
      ctx.clearRect(0, 0, W, H);

      // trust boundary line, shimmering mid-height
      const grad = ctx.createLinearGradient(0, 0, 0, H);
      grad.addColorStop(0, "rgba(242,242,242,0)");
      grad.addColorStop(0.5, "rgba(242,242,242,0.14)");
      grad.addColorStop(1, "rgba(242,242,242,0)");
      ctx.fillStyle = grad;
      ctx.fillRect(GATE, 0, 1, H);
      for (let y = 0; y < H; y += 52) {
        const env = Math.sin((Math.PI * y) / H);
        ctx.fillStyle = `rgba(242,242,242,${0.14 * env * env})`;
        ctx.fillRect(GATE - 3, y, 7, 1);
      }
      ctx.save();
      ctx.translate(GATE + 14, H * 0.5);
      ctx.rotate(Math.PI / 2);
      ctx.font = "9px 'JetBrains Mono Variable', monospace";
      ctx.textAlign = "center";
      ctx.fillStyle = "rgba(242,242,242,0.22)";
      ctx.fillText("T R U S T   B O U N D A R Y", 0, 0);
      ctx.restore();

      // the vendor side: faint void beyond the boundary
      ctx.font = "9px 'JetBrains Mono Variable', monospace";
      ctx.textAlign = "center";
      ctx.fillStyle = "rgba(242,242,242,0.14)";
      ctx.fillText("VENDOR MODELS", (GATE + W) / 2, H * 0.5);

      // your tenant vault: grows as exhaust is captured
      const vr = 14 + Math.min(vault.fill, 60) * 0.22;
      ctx.strokeStyle = "rgba(61,220,132,0.5)";
      ctx.lineWidth = 1;
      ctx.strokeRect(vault.x - vr, vault.y - vr, vr * 2, vr * 2);
      ctx.fillStyle = "rgba(61,220,132,0.08)";
      const inner = vr * Math.min(1, vault.fill / 60);
      ctx.fillRect(vault.x - inner, vault.y - inner, inner * 2, inner * 2);
      ctx.fillStyle = "rgba(242,242,242,0.3)";
      ctx.fillText("YOUR LEDGER", vault.x, vault.y + vr + 16);

      for (const p of parts) {
        const jitterSeed = p.seed + Math.floor(t / 300);
        if (p.state === "out") {
          p.x += p.vx * dt;
          p.y += (hash(jitterSeed) - 0.5) * 30 * dt * 2;
          if (p.x >= GATE) {
            if (hash(p.seed + 5) > 0.94) {
              p.state = "blocked"; p.pulse = 1; p.vx = -20;
            } else {
              p.state = "captured"; p.t = 0; p.pulse = 1;
              p.sx = GATE; p.sy = p.y;
              p.cx = GATE - (GATE - vault.x) * 0.35;
              p.cy = p.y - H * 0.3 * (hash(p.seed + 3) * 0.8 + 0.2);
            }
          }
          ctx.fillStyle = "rgba(242,242,242,0.35)";
          ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
        } else if (p.state === "captured") {
          p.t += dt / (2.2 + hash(p.seed + 7));
          const u = Math.min(p.t, 1), v = 1 - u;
          const x = v * v * p.sx + 2 * v * u * p.cx + u * u * vault.x;
          const y = v * v * p.sy + 2 * v * u * p.cy + u * u * vault.y;
          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(61,220,132,${p.pulse * 0.7})`;
            ctx.lineWidth = 1;
            ctx.strokeRect(x - 4, y - 4, 8, 8);
            p.pulse -= dt * 1.6;
          }
          ctx.fillStyle = "rgba(61,220,132,0.75)";
          ctx.fillRect(x - 1, y - 1, 2, 2);
          if (p.t >= 1) { vault.fill += 1; spawn(p, Math.floor(p.seed / 7919)); }
        } else {
          p.x += p.vx * dt;
          if (p.pulse > 0) {
            ctx.strokeStyle = `rgba(255,92,92,${p.pulse * 0.8})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p.x + 4, p.y - 4); ctx.lineTo(p.x - 4, p.y + 4);
            ctx.moveTo(p.x - 4, p.y - 4); ctx.lineTo(p.x + 4, p.y + 4);
            ctx.stroke();
            p.pulse -= dt * 0.9;
          } else spawn(p, Math.floor(p.seed / 7919));
        }
      }
    }

    resize();
    window.addEventListener("resize", resize);
    if (reduced) { vault.fill = 40; draw(1); }
    else {
      let visible = true;
      new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(canvas);
      const loop = (t: number) => { if (visible) draw(t); requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
  }
</script>

<script>
  // ── FIG.1 · items reveal one by one across the boundary ─────────────
  const reducedM = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fig1 = document.getElementById("lp-fig1");
  if (fig1) {
    const outs = [...fig1.querySelectorAll(".lp-fig1-out")] as HTMLElement[];
    const backs = [...fig1.querySelectorAll(".lp-fig1-back")] as HTMLElement[];
    const show = (el: HTMLElement) => { el.classList.remove("opacity-0", "-translate-x-2", "translate-x-2"); };
    if (reducedM) { [...outs, ...backs].forEach(show); }
    else new IntersectionObserver((es, io) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      outs.forEach((el, i) => setTimeout(() => show(el), 150 + i * 180));
      backs.forEach((el, i) => setTimeout(() => show(el), 500 + i * 260));
    }, { threshold: 0.35 }).observe(fig1);
  }
</script>

<script>
  // ── FIG.2 · packets travel the critical path, signed at the gateway ─
  const reducedF = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const flow = document.getElementById("lp-flow");
  const dotLayer = document.getElementById("lp-flow-dots");
  if (flow && dotLayer && !reducedF) {
    const NS = "http://www.w3.org/2000/svg";
    const agents = [75, 205, 335, 465, 595, 725];
    const outs = [140, 400, 660];
    type D = { el: SVGCircleElement; ring: SVGRectElement | null; phase: number; t: number; from: number; to: number };
    const dots: D[] = [];
    let lastSpawn = 0;

    function lerp(a: number, b: number, u: number) { return a + (b - a) * u; }

    function spawnDot() {
      const el = document.createElementNS(NS, "circle");
      el.setAttribute("r", "2.5");
      el.setAttribute("fill", "rgba(242,242,242,0.7)");
      dotLayer.appendChild(el);
      dots.push({ el, ring: null, phase: 0, t: 0, from: agents[Math.floor(Math.random() * agents.length)], to: outs[Math.floor(Math.random() * outs.length)] });
    }

    let visible = true;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(flow);

    let last = 0;
    const loop = (t: number) => {
      requestAnimationFrame(loop);
      if (!visible) { last = t; return; }
      const dt = Math.min((t - last) / 1000, 0.05) || 0.016;
      last = t;
      if (t - lastSpawn > 650 && dots.length < 9) { spawnDot(); lastSpawn = t; }

      for (let i = dots.length - 1; i >= 0; i--) {
        const d = dots[i];
        if (d.phase === 0) {
          d.t += dt / 1.1;
          const u = Math.min(d.t, 1);
          d.el.setAttribute("cx", String(lerp(d.from, 400, u)));
          d.el.setAttribute("cy", String(lerp(60, 190, u)));
          if (u >= 1) {
            d.phase = 1; d.t = 0;
            const ring = document.createElementNS(NS, "rect");
            ring.setAttribute("x", "396"); ring.setAttribute("y", "214");
            ring.setAttribute("width", "8"); ring.setAttribute("height", "8");
            ring.setAttribute("fill", "none");
            ring.setAttribute("stroke", "#3DDC84");
            dotLayer.appendChild(ring);
            d.ring = ring;
            d.el.setAttribute("fill", "rgba(61,220,132,0.9)");
          }
        } else if (d.phase === 1) {
          d.t += dt / 0.35;
          d.el.setAttribute("cx", "400"); d.el.setAttribute("cy", "218");
          if (d.ring) d.ring.setAttribute("stroke-opacity", String(Math.max(0, 1 - d.t)));
          if (d.t >= 1) { d.phase = 2; d.t = 0; if (d.ring) { d.ring.remove(); d.ring = null; } }
        } else {
          d.t += dt / 0.9;
          const u = Math.min(d.t, 1);
          d.el.setAttribute("cx", String(lerp(400, d.to, u)));
          d.el.setAttribute("cy", String(lerp(246, 330, u)));
          d.el.setAttribute("fill-opacity", String(1 - u * 0.5));
          if (u >= 1) { d.el.remove(); dots.splice(i, 1); }
        }
      }
    };
    requestAnimationFrame(loop);
  }
</script>

<script>
  // ── FIG.4 · hash chain grows; tamper attempts break it, get rejected ─
  const reducedC = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const chainEl = document.getElementById("lp-chain");
  const statusEl = document.getElementById("lp-chain-status");
  if (chainEl && statusEl) {
    let head = 0xa4cb;
    const SLOTS = 7;
    let blocks: number[] = [];
    for (let i = 0; i < SLOTS; i++) blocks.push(head++);

    const cell = (id: number, cls: string, mark: string) =>
      `<span class="inline-flex items-center gap-1.5 border px-3 py-2 shrink-0 ${cls}">#${id.toString(16)}<span>${mark}</span></span>`;
    const link = (ok: boolean) =>
      `<span class="px-1 ${ok ? "text-line-1" : "text-alert"}">${ok ? "──" : "─╳─"}</span>`;

    function render(tamperIdx = -1, freshLast = false) {
      let html = "";
      blocks.forEach((b, i) => {
        const broken = tamperIdx >= 0 && i >= tamperIdx;
        if (i > 0) html += link(!(tamperIdx >= 0 && i === tamperIdx));
        if (tamperIdx === i)
          html += cell(b, "border-alert text-alert bg-alert/5", "✕");
        else if (broken)
          html += cell(b, "border-alert/40 text-alert/60", "?");
        else if (freshLast && i === blocks.length - 1)
          html += cell(b, "border-live text-live bg-live/5", "✓");
        else
          html += cell(b, "border-line-0 text-ink-1", `<span class="text-live/70">✓</span>`);
      });
      chainEl.innerHTML = html;
    }

    render();
    if (!reducedC) {
      let visible = true;
      new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(chainEl);
      let n = 0;
      setInterval(() => {
        if (!visible) return;
        n++;
        if (n % 5 === 0) {
          // tamper attempt on a mid-chain block
          const idx = 2 + Math.floor(Math.random() * 2);
          render(idx);
          statusEl.innerHTML = `<span class="text-alert">Tamper attempt on #${blocks[idx].toString(16)} · every hash after it breaks · entry rejected</span>`;
          setTimeout(() => {
            if (!visible) return;
            render();
            statusEl.innerHTML = `<span class="text-white/30">Chain verified · appending entries…</span>`;
          }, 1900);
        } else {
          blocks.push(head++);
          if (blocks.length > SLOTS) blocks.shift();
          render(-1, true);
          statusEl.innerHTML = `<span class="text-white/30">Entry <span class="text-live">#${blocks[blocks.length - 1].toString(16)}</span> hash-chained to <span class="text-white/50">#${blocks[blocks.length - 2].toString(16)}</span> · signed</span>`;
        }
      }, 2100);
    }
  }
</script>

<script>
