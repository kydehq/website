        }
        await wait(3200);
        if (visible) playScenario();
        else {
          const again = setInterval(() => { if (visible) { clearInterval(again); playScenario(); } }, 500);
        }
      }
      playScenario();
    }
  }
</script>

<script>
  // ── FIG.5 · owned curve draws itself on reveal ──────────────────────
  const reducedK = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const curve = document.getElementById("lp-curve-owned") as unknown as SVGPathElement | null;
  if (curve && !reducedK) {
    const len = curve.getTotalLength();
    curve.style.strokeDasharray = String(len);
    curve.style.strokeDashoffset = String(len);
    new IntersectionObserver((es, io) => {
      if (es[0].isIntersecting) {
        curve.style.transition = "stroke-dashoffset 2.6s cubic-bezier(0.2,0.7,0.3,1)";
        curve.style.strokeDashoffset = "0";
        io.disconnect();
      }
    }, { threshold: 0.4 }).observe(curve);
  }
</script>
</Base>
