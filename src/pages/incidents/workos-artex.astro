// cites the initial post. Verification log: seo/drafts/
// incident-2026-11-07-ai-agent-incident-workos-artex.md

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kyde.com/' },
    { '@type': 'ListItem', position: 2, name: 'AI Agent Incidents', item: 'https://kyde.com/incidents/' },
