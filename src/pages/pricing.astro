---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Pricing — KYDE"
  description="Per agent identity. Not per seat. Four tiers from developer sandbox to enterprise defense — one environment variable throughout."
>
  <Navbar />

  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden pt-36 pb-24 md:pt-48 md:pb-36">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6">

        <div class="mb-10">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-[#0d0e10]/20 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#333]">↳ Pricing</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <h1 class="max-w-5xl text-5xl font-bold text-[#0d0e10] uppercase tracking-tight md:text-6xl lg:text-7xl">
          Per agent identity.<br />
          <span class="bg-[#fcb830] text-[#0d0e10] px-2">Not per seat.</span>
        </h1>

        <div class="mt-16 border-t border-dotted border-[#0d0e10]/25 pt-10 grid md:grid-cols-[200px_1fr] gap-8 items-start">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#0d0e10]">Model</p>
            <p class="mt-2 font-mono text-xs text-[#666]">[PER AGENT IDENTITY]</p>
          </div>
          <div>
            <p class="text-sm uppercase tracking-wide leading-relaxed text-[#333]">
              We charge per agent identity, not per human seat. As your AI workforce scales, so does your coverage — automatically.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ THE WORKFORCE FLIP ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/25 py-12">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-3 border border-dotted border-[#0d0e10]/15 divide-y divide-dotted divide-[#0d0e10]/10 md:divide-y-0 md:divide-x">
          <div class="bg-white px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-[#666] mb-4">The Workforce Flip</p>
            <p class="text-xl font-bold text-[#0d0e10] mb-3">AI agents outnumber humans.</p>
            <p class="text-sm text-[#333] leading-relaxed">Legacy SaaS pricing was built for human seats. As agent fleets scale to 10×, 100× headcount, per-seat models collapse.</p>
          </div>
          <div class="bg-white px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-[#666] mb-4">Our Answer</p>
            <p class="text-xl font-bold text-[#0d0e10] mb-3"><span class="bg-[#fcb830] text-[#0d0e10] px-1">Price follows the agent.</span></p>
            <p class="text-sm text-[#333] leading-relaxed">Every agent gets an identity. Every identity gets a price. Coverage scales with your fleet — not your org chart.</p>
          </div>
          <div class="bg-white px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-[#666] mb-4">Unit Economics</p>
            <p class="text-xl font-bold text-[#0d0e10] mb-3">From €0 to enterprise.</p>
            <p class="text-sm text-[#333] leading-relaxed">Start free in Sandbox. Scale to unlimited agents at enterprise rates. One environment variable throughout.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ TIERS ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/25 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid gap-5 lg:grid-cols-4">

          <!-- SANDBOX -->
          <div class="border border-dotted border-[#0d0e10]/15 bg-white flex flex-col">
            <div class="px-7 py-7 border-b border-dotted border-[#0d0e10]/15">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#666] mb-4">Sandbox</p>
              <div class="mb-3">
                <span class="text-4xl font-bold text-[#0d0e10]">€0</span>
                <span class="text-sm text-[#666] ml-1">/ mo</span>
              </div>
              <p class="font-mono text-xs text-[#333] mb-1">€0 / agent · ≤ 5 agents</p>
              <p class="text-xs text-[#666]">Basic policies</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-[#333] leading-relaxed mb-6">For developers and testing. Full zero-trust from day one — no credit card required.</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Agent identity registration", g: "AUTHORIZE" },
                  { text: "Ed25519 cryptographic signing", g: "ATTEST" },
                  { text: "Provider-agnostic interception", g: null },
                  { text: "Tamper-evident audit log", g: "ATTRIBUTE" },
                  { text: "One ENV variable deployment", g: null },
                  { text: "CLI verification tools", g: null },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-[#333] leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-[#333]">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'AUTHORIZE' ? 'text-[#c00000] bg-[#c00000]/8' : g === 'ATTRIBUTE' ? 'text-[#555] bg-[#0d0e10]/6' : 'text-[#4472c4] bg-[#4472c4]/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-dotted border-[#0d0e10]/15">
              <button onclick="openModal()" class="w-full inline-flex items-center justify-center gap-2 border border-dotted border-[#0d0e10]/30 px-5 py-2.5 text-xs font-semibold text-[#0d0e10] hover:border-[#0d0e10] transition-all">
                Start Free →
              </button>
            </div>
          </div>

          <!-- STARTER -->
          <div class="border border-dotted border-[#0d0e10]/15 bg-white flex flex-col">
            <div class="px-7 py-7 border-b border-dotted border-[#0d0e10]/15">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#666] mb-4">Starter</p>
              <div class="mb-3">
                <span class="text-4xl font-bold text-[#0d0e10]">€999</span>
                <span class="text-sm text-[#666] ml-1">/ mo</span>
              </div>
              <p class="font-mono text-xs text-[#333] mb-1">€5 / agent · ≤ 25 agents</p>
              <p class="text-xs text-[#666]">Standard policy set</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-[#333] leading-relaxed mb-4">For small teams deploying AI with accountability. Role boundaries and logging for your first production agents.</p>
              <p class="font-mono text-[9px] uppercase tracking-widest text-[#999] mb-3">Everything in Sandbox, plus:</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Role-based identity & access control", g: "AUTHORIZE" },
                  { text: "API allowlists & blocklists per role", g: "AUTHORIZE" },
                  { text: "7-day audit log retention", g: "ATTRIBUTE" },
                  { text: "Causal context capture", g: "ATTRIBUTE" },
                  { text: "Behavioral anomaly detection", g: "ATTRIBUTE" },
                  { text: "SSO / Okta / Azure AD", g: null },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-[#333] leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-[#333]">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'AUTHORIZE' ? 'text-[#c00000] bg-[#c00000]/8' : 'text-[#555] bg-[#0d0e10]/6'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-dotted border-[#0d0e10]/15">
              <button onclick="openModal()" class="w-full inline-flex items-center justify-center gap-2 bg-[#0d0e10] px-5 py-2.5 text-xs font-semibold text-[#f1f3f5] hover:bg-[#333] transition-all">
                Book a Demo →
              </button>
            </div>
          </div>

          <!-- BUSINESS -->
          <div class="border border-dotted border-[#fcb830]/50 bg-white flex flex-col relative">
            <div class="absolute top-0 left-0 right-0 h-px bg-[#fcb830]"></div>
            <div class="px-7 py-7 border-b border-dotted border-[#0d0e10]/15">
              <div class="flex items-center justify-between mb-4">
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#666]">Business</p>
                <span class="font-mono text-[8px] uppercase tracking-widest text-[#fcb830] border border-dotted border-[#fcb830]/60 px-1.5 py-0.5">Most Popular</span>
              </div>
              <div class="mb-3">
                <span class="text-4xl font-bold text-[#0d0e10]">€2,900</span>
                <span class="text-sm text-[#666] ml-1">/ mo</span>
              </div>
              <p class="font-mono text-xs text-[#333] mb-1">€3 / agent · ≤ 250 agents</p>
              <p class="text-xs text-[#666]">Custom policies</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-[#333] leading-relaxed mb-4">For scaling AI workforces. Full compliance export, custom policy engine, and 30-day audit trail. Court-ready evidence by default.</p>
              <p class="font-mono text-[9px] uppercase tracking-widest text-[#999] mb-3">Everything in Starter, plus:</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Token & cost budgets per agent / role / team", g: "AUTHORIZE" },
                  { text: "Policy Enforcement Point (hard circuit breakers)", g: "AUTHORIZE" },
                  { text: "30-day audit log retention", g: "ATTRIBUTE" },
                  { text: "Continuous data integrity verification", g: "ATTRIBUTE" },
                  { text: "Compliance export (NIS-2, DORA, EU AI Act)", g: "ATTEST" },
                  { text: "Court-ready cryptographic audit trail", g: "ATTEST" },
                  { text: "Machine-readable Proof of Authority", g: "ATTEST" },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-[#333] leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-[#333]">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'AUTHORIZE' ? 'text-[#c00000] bg-[#c00000]/8' : g === 'ATTRIBUTE' ? 'text-[#555] bg-[#0d0e10]/6' : 'text-[#4472c4] bg-[#4472c4]/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-dotted border-[#0d0e10]/15">
              <button onclick="openModal()" class="w-full inline-flex items-center justify-center gap-2 bg-[#0d0e10] px-5 py-2.5 text-xs font-semibold text-[#f1f3f5] hover:bg-[#333] transition-all">
                Book a Demo →
              </button>
            </div>
          </div>

          <!-- ENTERPRISE / DEFENSE -->
          <div class="border border-dotted border-[#0d0e10]/15 bg-white flex flex-col">
            <div class="px-7 py-7 border-b border-dotted border-[#0d0e10]/15">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#666] mb-4">Enterprise / Defense</p>
              <div class="mb-3">
                <span class="text-4xl font-bold text-[#0d0e10]">Custom</span>
              </div>
              <p class="font-mono text-xs text-[#333] mb-1">€1 / agent · Unlimited agents</p>
              <p class="text-xs text-[#666]">Custom + Air-Gapped</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-[#333] leading-relaxed mb-4">For KRITIS, banks, and defense. Hardware-rooted attestation. Air-gapped deployments. Silicon Leash — signing keys never exposed to host OS.</p>
              <p class="font-mono text-[9px] uppercase tracking-widest text-[#999] mb-3">Everything in Business, plus:</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Agent-to-agent trust delegation", g: "AUTHORIZE" },
                  { text: "Unlimited log retention", g: "ATTRIBUTE" },
                  { text: "SIEM / SOC integration", g: "ATTRIBUTE" },
                  { text: "Silicon Leash — TPM/HSM hardware signing", g: "ATTEST" },
                  { text: "TEE attestation (TDX/SEV-SNP)", g: "ATTEST" },
                  { text: "FIPS 140-3 validated crypto modules", g: "ATTEST" },
                  { text: "Air-gapped deployment option", g: null },
                  { text: "EU data residency", g: null },
                  { text: "ISO 27001 / BSI procurement track", g: null },
                  { text: "Dedicated support SLA", g: null },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-[#333] leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-[#333]">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'AUTHORIZE' ? 'text-[#c00000] bg-[#c00000]/8' : g === 'ATTRIBUTE' ? 'text-[#555] bg-[#0d0e10]/6' : 'text-[#4472c4] bg-[#4472c4]/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-dotted border-[#0d0e10]/15">
              <a href="mailto:hello@kyde.com" class="w-full inline-flex items-center justify-center gap-2 border border-dotted border-[#0d0e10]/30 px-5 py-2.5 text-xs font-semibold text-[#0d0e10] hover:border-[#0d0e10] transition-all">
                Contact Sales →
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ QUICK COMPARE TABLE ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/25 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-10">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-1.5 w-1.5 rounded-full bg-[#0d0e10]/20 shrink-0"></span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#333]">↳ Quick Compare</span>
          </div>
          <div class="h-px w-full bg-[#e8e9eb]"></div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full border border-dotted border-[#0d0e10]/15 text-sm">
            <thead>
              <tr class="border-b border-dotted border-[#0d0e10]/15 bg-[#f1f3f5]">
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#666] w-40"></th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#666]">Sandbox</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#666]">Starter</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#fcb830] bg-[#fcb830]/5">Business</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#666]">Enterprise</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-dotted divide-[#0d0e10]/10">
              {[
                { label: "Base price",            vals: ["€0 / mo",   "€999 / mo",  "€2,900 / mo",   "Custom"]      },
                { label: "Per agent",              vals: ["€0",        "€5",         "€3",            "€1"]          },
                { label: "Max agents",             vals: ["5",         "25",         "250",           "Unlimited"]   },
                { label: "Policies",               vals: ["Basic",     "Standard",   "Custom",        "Custom + Air-Gapped"] },
                { label: "Log retention",          vals: ["—",         "7 days",     "30 days",       "Unlimited"]   },
                { label: "Compliance export",      vals: ["—",         "—",          "✓",             "✓"]           },
                { label: "Silicon Leash (TPM/HSM)",vals: ["—",         "—",          "—",             "✓"]           },
              ].map(({ label, vals }) => (
                <tr>
                  <td class="px-5 py-3.5 font-mono text-xs text-[#555] uppercase tracking-wider">{label}</td>
                  {vals.map((v, i) => (
                    <td class={`px-5 py-3.5 text-sm ${i === 2 ? 'bg-[#fcb830]/3 font-medium text-[#0d0e10]' : 'text-[#0d0e10]'}`}>{v}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <!-- ══════════ ALL PLANS INCLUDE ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/25 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-10">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#333] mb-3">↳ All Plans Include</p>
          <div class="h-px bg-[#0d0e10]/20"></div>
        </div>

        <div class="grid border border-dotted border-[#0d0e10]/15 divide-y divide-dotted divide-[#0d0e10]/10 sm:divide-y-0 sm:divide-x sm:grid-cols-2 lg:grid-cols-5">
          {[
            { label: "Provider coverage",         value: "Every model. Every provider." },
            { label: "Deployment",                value: "One ENV variable or Group Policy push" },
            { label: "Latency overhead",           value: "< 100ms" },
            { label: "Code changes required",      value: "None" },
            { label: "Data ownership",             value: "Yours — not ours, not your vendor's" },
          ].map(({ label, value }) => (
            <div class="bg-white px-6 py-6">
              <p class="font-mono text-xs uppercase tracking-widest text-[#666] mb-2">{label}</p>
              <p class="text-sm text-[#0d0e10] leading-relaxed">{value}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ══════════ CLOSING CTA ══════════ -->
    <section class="border-t border-dotted border-[#0d0e10]/25 py-24 md:py-32">
      <div class="max-w-7xl mx-auto px-6">
        <div class="border border-dotted border-[#0d0e10]/20 p-12 md:p-20">
          <div class="max-w-3xl">
            <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-[#333]">↳ Not sure which tier fits?</p>
            <div class="mb-8 h-px bg-[#0d0e10]/20"></div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0d0e10] mb-4">
              Most teams start with Starter and scale to Business within 90 days.
            </h2>
            <p class="text-lg text-[#333] mb-10">
              Book a 30-minute call — we'll tell you exactly where you are and what you need.
            </p>
            <button
              onclick="openModal()"
              class="inline-flex items-center gap-2 bg-[#0d0e10] px-6 py-3.5 text-sm font-semibold text-[#f1f3f5] hover:bg-[#333] transition-all"
            >
              Book a Demo →
            </button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
