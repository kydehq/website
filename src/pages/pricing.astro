---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const costAnchors = [
  { k: "NIS-2",        v: "Fines up to €10M or 2% of global turnover. Management is personally liable." },
  { k: "DORA",         v: "Gives financial supervisors direct enforcement power over operational resilience failures." },
  { k: "EU AI Act",    v: "High-risk violations reach €15M or 3% of turnover once enforcement begins, December 2, 2027." },
  { k: "A failed audit", v: "Consumes more senior time than a year of governance infrastructure." },
];

const pricingFaqs = [
  { q: "Can we start free and upgrade later?", a: "Yes. That is the intended path. Deploy Starter, see your agent landscape, then turn on enforcement where liability lives. Your ledger history carries over." },
  { q: "Does the gateway add latency?", a: "The gateway performs deterministic policy checks, not model calls. There is no LLM in the enforcement path. Ask us for current benchmark figures for your deployment pattern." },
  { q: "What happens if the gateway goes down?", a: "You choose the failure mode per policy: fail-closed for regulated workloads, fail-open for lower-risk traffic. Either way, the decision is documented policy, not an accident." },
  { q: "Do you see our data?", a: "No, not unless you turn it on. Enforcement and the ledger run at your edge, inside your perimeter. Telemetry is opt-in and off by default. Air-gapped operation is available on Enterprise." },
  { q: "Does routing traffic through Kyde make us a “provider” under the EU AI Act?", a: "Kyde is an external proxy. It does not modify your models or pipelines, which is why it avoids the substantial-modification trap under Article 25. You remain the deployer. Ask us for the legal memo." },
  { q: "Is there a proof of concept option?", a: "Yes. Starter is the PoC, on your infrastructure, with your real traffic. For Enterprise evaluations we scope a pilot with success criteria in writing." },
  { q: "We are not in the EU. Is this relevant?", a: "The evidence problem is universal. If your customers, insurers or regulators can ask what your agents did, you need an answer that holds. EU rules are simply the first with dates attached." },
];

const pricingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pricingFaqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<Base
  title="Pricing, KYDE"
  description="Per agent identity. Not per seat. Three tiers from free starter to enterprise defense, one environment variable throughout."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pricingFaqSchema)} />
  </Fragment>
  <Navbar />

  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-36 md:border-x md:border-line-0">

        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">01 · Pricing</span></div>
        </div>

        <h1 class="hero-h1 max-w-5xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl">
          Per agent identity.<br />
          Not per seat.
        </h1>

        <div class="mt-16 border-t border-line-1 pt-10 grid md:grid-cols-[200px_1fr] gap-8 items-start">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-ink-0">Model</p>
            <p class="mt-2 font-mono text-xs text-ink-1">[EARLY ACCESS]</p>
          </div>
          <div>
            <p class="text-sm uppercase tracking-wide leading-relaxed text-ink-1">
              KYDE is currently in active development. We are onboarding a select group of design partners for our upcoming pilot phase. Pilot pricing is available on request, apply below and we'll find the right structure for your team.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ THE WORKFORCE FLIP ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-12 md:border-x md:border-line-0">
        <div class="grid md:grid-cols-3 border border-line-0 divide-y divide-line-0 md:divide-y-0 md:divide-x">
          <div class="bg-bg-1 px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-1 mb-4">The Workforce Flip</p>
            <p class="text-xl font-bold text-ink-0 mb-3">AI agents outnumber humans.</p>
            <p class="text-sm text-ink-1 leading-relaxed">Legacy SaaS pricing was built for human seats. As agent fleets scale to 10×, 100× headcount, per-seat models collapse.</p>
          </div>
          <div class="bg-bg-1 px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-1 mb-4">Our Answer</p>
            <p class="text-xl font-bold text-ink-0 mb-3"><span class="font-semibold text-ink-0">Price follows the agent.</span></p>
            <p class="text-sm text-ink-1 leading-relaxed">Every agent gets an identity. Every identity gets a price. Coverage scales with your fleet, not your org chart.</p>
          </div>
          <div class="bg-bg-1 px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-1 mb-4">Unit Economics</p>
            <p class="text-xl font-bold text-ink-0 mb-3">From free to enterprise.</p>
            <p class="text-sm text-ink-1 leading-relaxed">Start free with Starter. Pilot pricing available on request. One environment variable throughout.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ TIERS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">
        <div class="grid gap-5 lg:grid-cols-3">

          <!-- STARTER -->
          <div class="border border-line-0 bg-bg-1 flex flex-col overflow-hidden">
            <div class="px-7 py-7 border-b border-line-0">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1 mb-4">Starter</p>
              <div class="mb-3">
                <span class="font-mono text-xs uppercase tracking-widest text-ink-0">Free</span>
              </div>
              <p class="font-mono text-xs text-ink-1 mb-1">30-day audit · Self-hosted</p>
              <p class="text-xs text-ink-1">Observe only, no blocking</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-ink-1 leading-relaxed mb-6">A free 30-day audit that ends with a finding: how many agents are running, under which identities, against which providers. An independent witness for every agent action routed through it, hash-chained and tamper-evident, from day one. No credit card required.</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Agent identity registration" },
                  { text: "Hash-chained, tamper-evident ledger", g: "PROVE" },
                  { text: "Provider-agnostic interception", g: null },
                  { text: "Source-available on GitHub", g: null },
                  { text: "One ENV variable deployment", g: null },
                  { text: "CLI verification tools", g: null },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-ink-1 leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-ink-1">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'PREVENT' ? 'text-ember bg-ember/8' : g === 'RATE' ? 'text-live bg-live/8' : 'text-ink-0/70 bg-ink-0/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-line-0">
              <a href="/starter" class="w-full inline-flex items-center justify-center gap-2 border border-line-1 px-5 py-2.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-0 hover:border-white/40 transition-all">
                Start Free →
              </a>
            </div>
          </div>

          <!-- BUSINESS -->
          <div class="border border-line-0 bg-bg-1 flex flex-col relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-[3px] bg-warn"></div>
            <div class="px-7 py-7 border-b border-line-0">
              <div class="flex items-center justify-between mb-4">
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Business</p>
                <span class="font-mono text-[8px] uppercase tracking-widest text-warn border border-warn/60 px-1.5 py-0.5">Most Popular</span>
              </div>
              <div class="mb-3">
                <span class="font-mono text-xs uppercase tracking-widest text-ink-0">Pilot Pricing</span>
              </div>
              <p class="font-mono text-xs text-ink-1 mb-1">Available on request · Early Access</p>
              <p class="text-xs text-ink-1">Custom policies</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-ink-1 leading-relaxed mb-4">For scaling AI workforces. The guard that blocks what must not happen: custom policy engine, hash-chained evidence export, 30-day audit trail. Evidence a third party can recompute offline. Signing each entry with your own keys is an Enterprise capability.</p>
              <p class="font-mono text-[9px] uppercase tracking-widest text-ink-2 mb-3">Everything in Starter, plus:</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Token & cost budgets per agent / role / team", g: "PREVENT" },
                  { text: "Policy Enforcement Point (hard circuit breakers)", g: "PREVENT" },
                  { text: "30-day audit log retention", g: "PROVE" },
                  { text: "Continuous data integrity verification", g: "PROVE" },
                  { text: "Evidence export for the agent layer of NIS-2, DORA, EU AI Act", g: "PROVE" },
                  { text: "Hash-chained audit trail, verifiable by a third party", g: "PROVE" },
                  { text: "Machine-readable Proof of Authority", g: "PROVE" },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-ink-1 leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-ink-1">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'PREVENT' ? 'text-ember bg-ember/8' : g === 'RATE' ? 'text-live bg-live/8' : 'text-ink-0/70 bg-ink-0/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-line-0">
              <button onclick="openModal()" class="w-full inline-flex items-center justify-center gap-2 bg-white px-5 py-2.5 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all">
                Apply for Pilot&nbsp;Program&nbsp;→
              </button>
            </div>
          </div>

          <!-- ENTERPRISE / DEFENSE -->
          <div class="border border-line-0 bg-bg-1 flex flex-col overflow-hidden">
            <div class="px-7 py-7 border-b border-line-0">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1 mb-4">Enterprise / Defense</p>
              <div class="mb-3">
                <span class="font-mono text-xs uppercase tracking-widest text-ink-0">Custom</span>
              </div>
              <p class="font-mono text-xs text-ink-1 mb-1">Available on request · Unlimited agents</p>
              <p class="text-xs text-ink-1">Custom + Air-Gapped</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-ink-1 leading-relaxed mb-4">For KRITIS, banks, and defense. Ed25519 signing with your own keys, air-gapped deployments. Hardware-rooted attestation is planned, not shipped.</p>
              <p class="font-mono text-[9px] uppercase tracking-widest text-ink-2 mb-3">Everything in Business, plus:</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Ed25519 signing of each entry with your own keys", g: "PROVE" },
                  { text: "Agent-to-agent trust delegation", g: "PREVENT" },
                  { text: "Unlimited log retention", g: "PROVE" },
                  { text: "SIEM / SOC integration", g: "PROVE" },
                  { text: "Silicon Leash, TPM/HSM hardware signing (planned)", g: "PROVE" },
                  { text: "TEE attestation, TDX/SEV-SNP (planned)", g: "PROVE" },
                  { text: "FIPS 140-3 validated crypto modules (planned)", g: "PROVE" },
                  { text: "Air-gapped deployment option", g: null },
                  { text: "EU data residency", g: null },
                  { text: "ISO 27001 / BSI procurement track", g: null },
                  { text: "Dedicated support SLA", g: null },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-ink-1 leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-ink-1">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'PREVENT' ? 'text-ember bg-ember/8' : g === 'RATE' ? 'text-live bg-live/8' : 'text-ink-0/70 bg-ink-0/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-line-0">
              <a href="mailto:hello@kyde.com" class="w-full inline-flex items-center justify-center gap-2 border border-line-1 px-5 py-2.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-0 hover:border-line-1 transition-all">
                Discuss Use Case →
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ QUICK COMPARE TABLE ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">

        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">02 · Quick Compare</span></div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full border border-line-0 text-sm">
            <thead>
              <tr class="border-b border-line-0 bg-bg-0">
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-ink-1 w-40"></th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-ink-1">Starter</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-ink-0 bg-bg-1/5">Business</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-ink-1">Enterprise</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line-0">
              {[
                { label: "Pricing",                vals: ["Free",          "Pilot pricing on request",   "Custom"]      },
                { label: "Scale",                  vals: ["30-day audit",  "Scaling fleets",             "Unlimited"]   },
                { label: "Policies",               vals: ["Observe only",  "Custom",                     "Custom + Air-Gapped"] },
                { label: "Log retention",          vals: ["Local, self-hosted", "30 days",               "Unlimited"]   },
                { label: "Evidence export",        vals: ["✓ (hash-chained)", "✓ (hash-chained)",        "✓ (signed with your keys)"] },
                { label: "Silicon Leash (TPM/HSM)",vals: ["—",             "—",                          "Planned"]     },
              ].map(({ label, vals }) => (
                <tr>
                  <td class="px-5 py-3.5 font-mono text-xs text-ink-1 uppercase tracking-wider">{label}</td>
                  {vals.map((v, i) => (
                    <td class={`px-5 py-3.5 text-sm ${i === 1 ? 'bg-bg-1/3 font-medium text-ink-0' : 'text-ink-0'}`}>{v}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <!-- ══════════ HOW PRICING WORKS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">03 · How pricing works</span></div>
        </div>
        <p class="text-lg text-ink-1 leading-relaxed max-w-3xl">
          Governance is infrastructure. Infrastructure pricing should be predictable. Kyde is priced per agent identity, not per seat and not per token. Every agent gets an identity, every identity gets a price, and coverage scales with your fleet, not your org chart or how busy your agents got this month.
        </p>
      </div>
    </section>

    <!-- ══════════ COST ANCHOR ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">04 · The comparison that actually matters</span></div>
        </div>
        <p class="text-lg text-ink-1 leading-relaxed max-w-3xl mb-10">
          The honest benchmark for this budget line is not another tool. It is the cost of not being able to prove what your agents did.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          {costAnchors.map(({ k, v }) => (
            <div class="border border-line-0 bg-bg-1 p-6">
              <p class="font-mono text-xs uppercase tracking-widest text-alert mb-2">{k}</p>
              <p class="text-sm text-ink-0 leading-relaxed">{v}</p>
            </div>
          ))}
        </div>
        <p class="text-sm text-ink-2 max-w-3xl">
          Against a single incident where you cannot produce evidence, every tier on this page is a rounding error.
        </p>
      </div>
    </section>

    <!-- ══════════ PRICING FAQ ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">05 · Pricing FAQ</span></div>
        </div>
        <div class="max-w-3xl space-y-px">
          {pricingFaqs.map(({ q, a }) => (
            <details class="group border border-line-0 bg-bg-1">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                <span class="text-sm font-semibold text-ink-0 pr-4">{q}</span>
                <svg class="h-4 w-4 shrink-0 text-ink-2 group-open:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-sm text-ink-1 leading-relaxed">{a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ ALL PLANS INCLUDE ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">

        <div class="mb-10">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-2 mb-3">All Plans Include</p>
          <div class="h-px bg-bg-1/20"></div>
        </div>

        <div class="grid border border-line-0 divide-y divide-line-0 sm:divide-y-0 sm:divide-x sm:grid-cols-2 lg:grid-cols-5">
          {[
            { label: "Provider coverage",         value: "Every model and provider routed through it" },
            { label: "Deployment",                value: "One ENV variable or Group Policy push" },
            { label: "Latency overhead",           value: "Target: under 100ms" },
            { label: "Code changes required",      value: "None" },
            { label: "Data ownership",             value: "Yours, not ours, not your vendor's" },
          ].map(({ label, value }) => (
            <div class="bg-bg-1 px-6 py-6">
              <p class="font-mono text-xs uppercase tracking-widest text-ink-1 mb-2">{label}</p>
              <p class="text-sm text-ink-0 leading-relaxed">{value}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ══════════ CLOSING CTA ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
        <div class="border border-line-0 p-12 md:p-20">
          <div class="max-w-3xl">
            <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Not sure which tier fits?</p>
            <div class="mb-8 h-px bg-bg-1/20"></div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-ink-0 mb-4">
              Start free. Move to Business when you need enforcement.
            </h2>
            <p class="text-lg text-ink-1 mb-10">
              Book a 30-minute call, we'll tell you exactly where you are and what you need.
            </p>
            <button
              onclick="openModal()"
              class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all"
            >
              Apply for Pilot&nbsp;Program&nbsp;→
            </button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
