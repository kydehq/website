---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Pricing, KYDE"
  description="Per agent identity. Not per seat. Three tiers from developer sandbox to enterprise defense, one environment variable throughout."
>
  <Navbar />

  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-24 md:pt-48 md:pb-36 md:border-x md:border-[#1F1F1F]">

        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#A8A8A8]">01 · Pricing</span></div>
        </div>

        <h1 class="max-w-5xl text-5xl font-bold text-[#F2F2F2] uppercase tracking-tight md:text-6xl lg:text-7xl">
          Per agent identity.<br />
          Not per seat.
        </h1>

        <div class="mt-16 border-t border-[#2E2E2E] pt-10 grid md:grid-cols-[200px_1fr] gap-8 items-start">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#F2F2F2]">Model</p>
            <p class="mt-2 font-mono text-xs text-[#A8A8A8]">[EARLY ACCESS]</p>
          </div>
          <div>
            <p class="text-sm uppercase tracking-wide leading-relaxed text-[#A8A8A8]">
              KYDE is currently in active development. We are onboarding a select group of design partners for our upcoming pilot phase. Pilot pricing is available on request, apply below and we'll find the right structure for your team.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ THE WORKFORCE FLIP ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-12 md:border-x md:border-[#1F1F1F]">
        <div class="grid md:grid-cols-3 border border-[#1F1F1F] divide-y divide-[#1F1F1F] md:divide-y-0 md:divide-x">
          <div class="bg-[#0C0C0C] px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-[#A8A8A8] mb-4">The Workforce Flip</p>
            <p class="text-xl font-bold text-[#F2F2F2] mb-3">AI agents outnumber humans.</p>
            <p class="text-sm text-[#A8A8A8] leading-relaxed">Legacy SaaS pricing was built for human seats. As agent fleets scale to 10×, 100× headcount, per-seat models collapse.</p>
          </div>
          <div class="bg-[#0C0C0C] px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-[#A8A8A8] mb-4">Our Answer</p>
            <p class="text-xl font-bold text-[#F2F2F2] mb-3"><span class="font-semibold text-[#F2F2F2]">Price follows the agent.</span></p>
            <p class="text-sm text-[#A8A8A8] leading-relaxed">Every agent gets an identity. Every identity gets a price. Coverage scales with your fleet, not your org chart.</p>
          </div>
          <div class="bg-[#0C0C0C] px-8 py-8">
            <p class="font-mono text-xs uppercase tracking-widest text-[#A8A8A8] mb-4">Unit Economics</p>
            <p class="text-xl font-bold text-[#F2F2F2] mb-3">From free to enterprise.</p>
            <p class="text-sm text-[#A8A8A8] leading-relaxed">Start free in Sandbox. Pilot pricing available on request. One environment variable throughout.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ TIERS ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">
        <div class="grid gap-5 lg:grid-cols-3">

          <!-- SANDBOX -->
          <div class="border border-[#1F1F1F] bg-[#0C0C0C] flex flex-col overflow-hidden">
            <div class="px-7 py-7 border-b border-[#1F1F1F]">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#A8A8A8] mb-4">Sandbox</p>
              <div class="mb-3">
                <span class="font-mono text-xs uppercase tracking-widest text-[#F2F2F2]">Free</span>
              </div>
              <p class="font-mono text-xs text-[#A8A8A8] mb-1">Developer access · Early Access</p>
              <p class="text-xs text-[#A8A8A8]">Basic policies</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-[#A8A8A8] leading-relaxed mb-6">For developers and testing. Full behavioral firewall protection from day one, no credit card required.</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Agent identity registration", g: "ENFORCE" },
                  { text: "Ed25519 cryptographic signing", g: "PROVE" },
                  { text: "Provider-agnostic interception", g: null },
                  { text: "Tamper-evident audit log", g: "OBSERVE" },
                  { text: "One ENV variable deployment", g: null },
                  { text: "CLI verification tools", g: null },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-[#A8A8A8] leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-[#A8A8A8]">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'ENFORCE' ? 'text-[#FF5C5C] bg-[#FF5C5C]/8' : g === 'OBSERVE' ? 'text-[#A8A8A8] bg-[#0C0C0C]/6' : 'text-[#F2F2F2]/70 bg-[#F2F2F2]/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-[#1F1F1F]">
              <button onclick="openModal()" class="w-full inline-flex items-center justify-center gap-2 border border-[#2E2E2E] px-5 py-2.5 text-xs font-mono uppercase tracking-[0.1em] text-[#F2F2F2] hover:border-[#2E2E2E] transition-all">
                Request Sandbox Access →
              </button>
            </div>
          </div>

          <!-- BUSINESS -->
          <div class="border border-[#1F1F1F] bg-[#0C0C0C] flex flex-col relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-[3px] bg-[#FFB84D]"></div>
            <div class="px-7 py-7 border-b border-[#1F1F1F]">
              <div class="flex items-center justify-between mb-4">
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#A8A8A8]">Business</p>
                <span class="font-mono text-[8px] uppercase tracking-widest text-[#FFB84D] border border-[#FFB84D]/60 px-1.5 py-0.5">Most Popular</span>
              </div>
              <div class="mb-3">
                <span class="font-mono text-xs uppercase tracking-widest text-[#F2F2F2]">Pilot Pricing</span>
              </div>
              <p class="font-mono text-xs text-[#A8A8A8] mb-1">Available on request · Early Access</p>
              <p class="text-xs text-[#A8A8A8]">Custom policies</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-[#A8A8A8] leading-relaxed mb-4">For scaling AI workforces. Full compliance export, custom policy engine, and 30-day audit trail. Court-ready evidence by default.</p>
              <p class="font-mono text-[9px] uppercase tracking-widest text-[#6B6B6B] mb-3">Everything in Sandbox, plus:</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Token & cost budgets per agent / role / team", g: "ENFORCE" },
                  { text: "Policy Enforcement Point (hard circuit breakers)", g: "ENFORCE" },
                  { text: "30-day audit log retention", g: "OBSERVE" },
                  { text: "Continuous data integrity verification", g: "OBSERVE" },
                  { text: "Compliance export (NIS-2, DORA, EU AI Act)", g: "PROVE" },
                  { text: "Court-ready cryptographic audit trail", g: "PROVE" },
                  { text: "Machine-readable Proof of Authority", g: "PROVE" },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-[#A8A8A8] leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-[#A8A8A8]">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'ENFORCE' ? 'text-[#FF5C5C] bg-[#FF5C5C]/8' : g === 'OBSERVE' ? 'text-[#A8A8A8] bg-[#0C0C0C]/6' : 'text-[#F2F2F2]/70 bg-[#F2F2F2]/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-[#1F1F1F]">
              <button onclick="openModal()" class="w-full inline-flex items-center justify-center gap-2 bg-white px-5 py-2.5 text-xs font-mono uppercase tracking-[0.1em] text-[#0A0A0A] hover:bg-[#E5E5E5] transition-all">
                Apply for Pilot Program →
              </button>
            </div>
          </div>

          <!-- ENTERPRISE / DEFENSE -->
          <div class="border border-[#1F1F1F] bg-[#0C0C0C] flex flex-col overflow-hidden">
            <div class="px-7 py-7 border-b border-[#1F1F1F]">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#A8A8A8] mb-4">Enterprise / Defense</p>
              <div class="mb-3">
                <span class="font-mono text-xs uppercase tracking-widest text-[#F2F2F2]">Custom</span>
              </div>
              <p class="font-mono text-xs text-[#A8A8A8] mb-1">Available on request · Unlimited agents</p>
              <p class="text-xs text-[#A8A8A8]">Custom + Air-Gapped</p>
            </div>
            <div class="px-7 py-7 flex-1">
              <p class="text-xs text-[#A8A8A8] leading-relaxed mb-4">For KRITIS, banks, and defense. Hardware-rooted attestation. Air-gapped deployments. Silicon Leash, signing keys never exposed to host OS.</p>
              <p class="font-mono text-[9px] uppercase tracking-widest text-[#6B6B6B] mb-3">Everything in Business, plus:</p>
              <ul class="space-y-2.5">
                {[
                  { text: "Agent-to-agent trust delegation", g: "ENFORCE" },
                  { text: "Unlimited log retention", g: "OBSERVE" },
                  { text: "SIEM / SOC integration", g: "OBSERVE" },
                  { text: "Silicon Leash, TPM/HSM hardware signing", g: "PROVE" },
                  { text: "TEE attestation (TDX/SEV-SNP)", g: "PROVE" },
                  { text: "FIPS 140-3 validated crypto modules", g: "PROVE" },
                  { text: "Air-gapped deployment option", g: null },
                  { text: "EU data residency", g: null },
                  { text: "ISO 27001 / BSI procurement track", g: null },
                  { text: "Dedicated support SLA", g: null },
                ].map(({ text, g }) => (
                  <li class="flex gap-2.5 text-xs text-[#A8A8A8] leading-relaxed">
                    <span class="font-mono shrink-0 mt-0.5 text-[#A8A8A8]">→</span>
                    <span>
                      {text}
                      {g && <span class={`ml-1.5 font-mono text-[8px] tracking-widest px-1 py-0.5 ${g === 'ENFORCE' ? 'text-[#FF5C5C] bg-[#FF5C5C]/8' : g === 'OBSERVE' ? 'text-[#A8A8A8] bg-[#0C0C0C]/6' : 'text-[#F2F2F2]/70 bg-[#F2F2F2]/8'}`}>{g}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-7 py-5 border-t border-[#1F1F1F]">
              <a href="mailto:hello@kyde.com" class="w-full inline-flex items-center justify-center gap-2 border border-[#2E2E2E] px-5 py-2.5 text-xs font-mono uppercase tracking-[0.1em] text-[#F2F2F2] hover:border-[#2E2E2E] transition-all">
                Discuss Use Case →
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════ QUICK COMPARE TABLE ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">

        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-[#1F1F1F] pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#A8A8A8]">02 · Quick Compare</span></div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full border border-[#1F1F1F] text-sm">
            <thead>
              <tr class="border-b border-[#1F1F1F] bg-[#050505]">
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#A8A8A8] w-40"></th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#A8A8A8]">Sandbox</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#F2F2F2] bg-[#0C0C0C]/5">Business</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#A8A8A8]">Enterprise</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#1F1F1F]">
              {[
                { label: "Pricing",                vals: ["Free",          "Pilot pricing on request",   "Custom"]      },
                { label: "Scale",                  vals: ["Dev / Testing", "Scaling fleets",             "Unlimited"]   },
                { label: "Policies",               vals: ["Basic",         "Custom",                     "Custom + Air-Gapped"] },
                { label: "Log retention",          vals: [", ",             "30 days",                    "Unlimited"]   },
                { label: "Compliance export",      vals: [", ",             "✓",                          "✓"]           },
                { label: "Silicon Leash (TPM/HSM)",vals: [", ",             ", ",                          "✓"]           },
              ].map(({ label, vals }) => (
                <tr>
                  <td class="px-5 py-3.5 font-mono text-xs text-[#A8A8A8] uppercase tracking-wider">{label}</td>
                  {vals.map((v, i) => (
                    <td class={`px-5 py-3.5 text-sm ${i === 1 ? 'bg-[#0C0C0C]/3 font-medium text-[#F2F2F2]' : 'text-[#F2F2F2]'}`}>{v}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <!-- ══════════ ALL PLANS INCLUDE ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-[#1F1F1F]">

        <div class="mb-10">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6B6B6B] mb-3">All Plans Include</p>
          <div class="h-px bg-[#0C0C0C]/20"></div>
        </div>

        <div class="grid border border-[#1F1F1F] divide-y divide-[#1F1F1F] sm:divide-y-0 sm:divide-x sm:grid-cols-2 lg:grid-cols-5">
          {[
            { label: "Provider coverage",         value: "Every model. Every provider." },
            { label: "Deployment",                value: "One ENV variable or Group Policy push" },
            { label: "Latency overhead",           value: "< 100ms" },
            { label: "Code changes required",      value: "None" },
            { label: "Data ownership",             value: "Yours, not ours, not your vendor's" },
          ].map(({ label, value }) => (
            <div class="bg-[#0C0C0C] px-6 py-6">
              <p class="font-mono text-xs uppercase tracking-widest text-[#A8A8A8] mb-2">{label}</p>
              <p class="text-sm text-[#F2F2F2] leading-relaxed">{value}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ══════════ CLOSING CTA ══════════ -->
    <section class="border-t border-[#2E2E2E]">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-[#1F1F1F]">
        <div class="border border-[#1F1F1F] p-12 md:p-20">
          <div class="max-w-3xl">
            <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-[#A8A8A8]">Not sure which tier fits?</p>
            <div class="mb-8 h-px bg-[#0C0C0C]/20"></div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-[#F2F2F2] mb-4">
              Most teams start in Sandbox and move to Business within 90 days.
            </h2>
            <p class="text-lg text-[#A8A8A8] mb-10">
              Book a 30-minute call, we'll tell you exactly where you are and what you need.
            </p>
            <button
              onclick="openModal()"
              class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-[#0A0A0A] hover:bg-[#E5E5E5] transition-all"
            >
              Apply for Pilot Program →
            </button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Base>
