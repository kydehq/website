---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LegalNotice from '../components/LegalNotice.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://kyde.com/" },
    { "@type": "ListItem", position: 2, name: "Resources", item: "https://kyde.com/resources" },
    { "@type": "ListItem", position: 3, name: "AI Agent Insurance", item: "https://kyde.com/ai-agent-insurance" },
  ],
};

const faqs = [
  {
    q: "Does this matter if my agents aren't in an EU AI Act high-risk area?",
    a: "Possibly. The EU AI Act's high-risk obligations apply from 2 December 2027 to the eight areas listed in Annex III, including employment, access to credit, certain insurance pricing, critical infrastructure and law enforcement. The Product Liability Directive 2024/2853 is broader: it treats software, including AI systems, as a product regardless of sector. It covers harm to natural persons, such as personal injury, damage to private property and loss of non-professional data, rather than pure financial loss between businesses. If your agents could cause that kind of harm, the directive's disclosure rules and presumptions are relevant to you. In either case, the practical question is whether you could show what your agent did.",
  },
  {
    q: "What's the relationship between AIUC-1 certification and insurance coverage?",
    a: "They answer different questions. Certification tells an insurer what a system looked like when it was audited and tested. Coverage transfers the financial risk that remains. Some certified companies, ElevenLabs among them, have paired AIUC-1 certification with AI insurance, but certification is not itself a policy. We expect insurers to ask more often for evidence that certified controls stayed in place between tests, which is where continuous monitoring comes in.",
  },
  {
    q: "What does DORA mean for records of AI agent activity?",
    a: "DORA does not mention AI agents, and it does not prescribe a specific audit trail for them. It does treat an LLM provider used by a financial entity as an ICT third-party service provider. Article 28 keeps the financial entity responsible for that risk, and Article 30 requires its contracts to secure access, inspection and audit rights. In practice, a log that exists only in the provider's console depends on the provider's cooperation to produce. A record the financial entity writes and keeps itself does not, which makes incident handling and reporting easier.",
  },
  {
    q: "How does parametric AI agent insurance work in practice?",
    a: "A parametric policy defines a trigger condition in advance, for example an agent's task completion rate falling below an agreed threshold or latency exceeding an SLA. If the monitored metric crosses the threshold, the policy pays out without anyone having to prove which party caused the loss. That only works if both sides trust the metric, so the trigger has to come from continuous, independent monitoring. Kyde records the behavior such a trigger would be checked against today. An insurance product built on that record is not something we ship yet.",
  },
  {
    q: "What does the Moffatt v. Air Canada precedent mean for AI agent liability?",
    a: "In 2024, British Columbia's Civil Resolution Tribunal held Air Canada liable for incorrect information its website chatbot gave a customer, and rejected the argument that the chatbot was responsible for its own actions. The case is a small-claims decision in Canada, not EU law, but its logic is widely cited: the organization that deploys an agent answers for what it says and does. It does not address what happens when the organization cannot reconstruct what the agent did. In the EU, the Product Liability Directive's disclosure rules and presumptions make that question more pressing.",
  },
  {
    q: "How quickly is the AI agent insurance market developing?",
    a: "It is early but moving. Munich Re has offered aiSure, a performance guarantee for AI models, since 2018. In March 2026 HSB, part of Munich Re, launched AI liability cover for small and mid-sized businesses in the US. Specialist cover is also available in the Lloyd's market. Our view is that the main constraint is data: insurers need reliable information about how agents behave to price the risk, and that information comes from monitoring.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<Base
  title="AI Agent Insurance: Liability, Coverage, and the Evidence Infrastructure, Kyde"
  description="Everything enterprises need to know about AI agent insurance: how liability is assigned under EU law, what coverage exists today (Munich Re aiSure, HSB, AIUC-1 certification), why certification alone is not enough, and what kind of behavioral record makes AI agents easier to insure."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Navbar />

  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-20 md:border-x md:border-line-0">

        <div class="mb-10">
          <div class="flex items-center gap-3 mb-3">
            <a href="/resources" class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1 hover:text-ink-0 transition-colors">↑ Resources</a>
            <span class="text-ink-1">/</span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Complete Guide</span>
          </div>
          <div class="h-px w-full bg-line-0"></div>
        </div>

        <div class="grid md:grid-cols-[1fr_340px] gap-12 items-start">
          <div>
            <div class="flex items-center gap-2 mb-6">
              <span class="inline-flex items-center border border-line-0 bg-bg-1 px-3 py-1 text-xs font-mono text-ink-1">Insurance · Liability</span>
              <span class="inline-flex items-center border border-line-0 bg-bg-1 px-3 py-1 text-xs font-mono text-ink-1">Enterprise Guide</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-ink-0 tracking-tight leading-[1.05] mb-6">
              AI Agent Insurance
            </h1>
            <p class="text-lg text-ink-1 leading-relaxed max-w-2xl mb-8">
              EU law is making clear who answers for AI agent failures, and insurers have started to cover the risk. Both depend on being able to show what an agent actually did. This guide explains how the pieces fit together.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <button onclick="openModal()" class="inline-flex items-center gap-2 bg-white text-cta-ink px-6 py-3 text-xs font-mono uppercase tracking-[0.12em] hover:bg-cta-hover transition-all">
                Contact sales →
              </button>
              <a href="/blog/confidence-infrastructure-part-1" class="inline-flex items-center gap-2 border border-line-1 text-ink-0 px-6 py-3 text-xs font-mono uppercase tracking-[0.12em] hover:border-line-1 transition-all">
                Read the Essay Series →
              </a>
            </div>
          </div>

          <!-- Quick stats -->
          <div class="grid grid-cols-2 gap-4">
            {[
              { num: "Dec 2027", label: "EU AI Act enforcement for high-risk agents" },
              { num: "51", label: "AIUC-1 requirements across 6 domains" },
              { num: "Dec 2026", label: "Product Liability Directive transposition deadline" },
              { num: "24h", label: "Latest DORA initial notification of a major ICT incident" },
            ].map(({ num, label }) => (
              <div class="border border-line-0 bg-bg-1 p-5">
                <div class="text-2xl font-bold text-ink-0 mb-1">{num}</div>
                <div class="text-xs text-ink-1 leading-snug">{label}</div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════ TABLE OF CONTENTS ══════════ -->
    <section class="border-t border-b border-line-0 bg-bg-2">
      <div class="max-w-7xl mx-auto px-6 py-8 md:border-x md:border-line-0">
        <div class="flex flex-col md:flex-row gap-8 items-start">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-0 shrink-0 pt-0.5">On this page</p>
          <nav aria-label="Table of contents" class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-2">
            {[
              ["Why AI agent insurance matters now", "#why-now"],
              ["The legal liability framework", "#legal-framework"],
              ["What coverage exists today", "#coverage-today"],
              ["The certification layer (AIUC-1)", "#aiuc-certification"],
              ["Why certification alone isn't enough", "#certification-limits"],
              ["The four evidence requirements", "#evidence-requirements"],
              ["What Kyde contributes to insurability", "#kyde-role"],
              ["FAQ", "#faq"],
            ].map(([label, href]) => (
              <a href={href} class="font-mono text-xs text-ink-1 hover:text-ink-0 transition-colors">{label}</a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    <!-- ══════════ MAIN BODY ══════════ -->
    <section class="">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-24 md:border-x md:border-line-0">
        <div class="grid md:grid-cols-[1fr_300px] gap-6 md:gap-16 items-start">

          <div class="space-y-16 md:space-y-20">

            <!-- WHY NOW -->
            <div id="why-now">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-warn bg-warn/10 border border-warn/40 px-2 py-0.5">01</span>
                <h2 class="text-xl md:text-2xl font-bold text-ink-0 uppercase tracking-wide">Why AI agent insurance matters now</h2>
              </div>
              <div class="prose-kyde">
                <p>
                  AI agents have moved past the prototype stage. They book travel, process invoices, review contracts and route support tickets, and in many workflows no person checks each action before it happens.
                </p>
                <p>
                  As agents take on more consequential work, the cost of their mistakes grows. An agent that approves a fraudulent payment, relies on an outdated policy document, or is manipulated through prompt injection into leaking data creates more than a technical problem. Someone will be asked to pay for the damage.
                </p>
                <p>
                  Two questions follow: who is liable, and can anyone show what happened? In the EU, the AI Act, the revised Product Liability Directive and, for financial firms, DORA each shape the answer. Insurers have started to offer cover. What is still missing in most deployments is a reliable record of agent behavior that both lawyers and underwriters can work from.
                </p>
                <p>
                  This guide covers all three: the legal framework, the coverage available today, and the kind of behavioral record that makes the risk easier to price.
                </p>
              </div>
            </div>

            <!-- LEGAL FRAMEWORK -->
            <div id="legal-framework">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-warn bg-warn/10 border border-warn/40 px-2 py-0.5">02</span>
                <h2 class="text-xl md:text-2xl font-bold text-ink-0 uppercase tracking-wide">The legal liability framework</h2>
              </div>
              <p class="text-sm text-ink-1 mb-6 leading-relaxed">Three EU laws matter most for AI agent liability. They do different jobs: one sets obligations for high-risk AI systems, one governs compensation for defective products, and one sets operational resilience rules for financial firms.</p>

              <div class="space-y-4">
                {[
                  {
                    name: "EU AI Act, Articles 12, 14, 26",
                    deadline: "Dec 2, 2027",
                    badge: "High-Risk",
                    text: "High-risk systems must record events automatically over their lifetime (Art. 12) and be designed for effective human oversight (Art. 14). Deployers must keep the automatically generated logs for at least six months (Art. 26). Applies to the Annex III areas, including recruitment, creditworthiness, life and health insurance pricing, and critical infrastructure, from 2 December 2027.",
                  },
                  {
                    name: "Product Liability Directive 2024/2853",
                    deadline: "Dec 2026",
                    badge: "National transposition",
                    text: "Treats software, including AI systems, as a product subject to strict liability for harm to natural persons. Courts can order defendants to disclose relevant evidence, and can presume defect or causation in defined cases, for example when a defendant fails to disclose or when technical complexity makes proof excessively difficult. Several liable operators can be held jointly and severally liable. Member states must transpose it by 9 December 2026.",
                  },
                  {
                    name: "DORA, Digital Operational Resilience Act",
                    deadline: "In force Jan 2025",
                    badge: "Financial sector",
                    text: "Applies to financial entities since 17 January 2025. They must manage ICT third-party risk (Art. 28), including from model providers, and secure access, inspection and audit rights by contract (Art. 30). Major ICT incidents have to be reported quickly: an initial notification within 4 hours of classification and no later than 24 hours after detection, an intermediate report within 72 hours and a final report within a month.",
                  },
                ].map(({ name, deadline, badge, text }) => (
                  <div class="border border-line-0 bg-bg-1 p-6">
                    <div class="flex flex-wrap items-center gap-3 mb-3">
                      <h3 class="font-bold text-sm text-ink-0">{name}</h3>
                      <span class="font-mono text-[10px] text-ink-1 border border-line-0 px-2 py-0.5">{badge}</span>
                      <span class="font-mono text-[10px] text-warn border border-warn/40 bg-warn/5 px-2 py-0.5">{deadline}</span>
                    </div>
                    <p class="text-sm text-ink-1 leading-relaxed">{text}</p>
                  </div>
                ))}
              </div>

              <div class="mt-6 border border-line-0 bg-bg-2 p-5">
                <p class="text-sm text-ink-1 leading-relaxed">
                  <strong class="text-ink-0">Fragmented accountability:</strong> The UK's Digital Regulation Cooperation Forum (CMA, FCA, ICO and Ofcom) noted in its March 2026 <a href="/blog/drcf-agentic-ai-foresight" class="underline underline-offset-4">foresight paper on agentic AI</a> that responsibility for an agent's behavior can be split across model providers, system providers and the organizations that deploy agents. That makes it harder to attribute a specific outcome, and it is one more reason for a deploying organization to keep its own record of what its agents did.
                </p>
              </div>
            </div>

            <!-- COVERAGE TODAY -->
            <div id="coverage-today">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-warn bg-warn/10 border border-warn/40 px-2 py-0.5">03</span>
                <h2 class="text-xl md:text-2xl font-bold text-ink-0 uppercase tracking-wide">What AI agent insurance coverage exists today</h2>
              </div>
              <p class="text-sm text-ink-1 mb-6 leading-relaxed">The market is early. A few established insurers offer products today, and much of the rest is still being designed.</p>

              <div class="overflow-x-auto">
                <table class="w-full text-xs border-collapse">
                  <thead>
                    <tr class="bg-bg-1 text-white">
                      <th class="text-left font-mono px-4 py-3 font-normal">Provider</th>
                      <th class="text-left font-mono px-4 py-3 font-normal">Product / Vehicle</th>
                      <th class="text-left font-mono px-4 py-3 font-normal">Coverage type</th>
                      <th class="text-left font-mono px-4 py-3 font-normal">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {[
                      ["Munich Re", "aiSure", "Performance guarantee for AI models", "Offered since 2018"],
                      ["HSB (Munich Re)", "AI liability cover", "Liability gaps for small and mid-sized businesses", "Launched March 2026, US"],
                      ["Lloyd's market", "Specialist cover", "Varies by syndicate", "Available, terms vary"],
                      ["Parametric structures", "Trigger-based payout", "Performance or SLA thresholds", "Emerging"],
                      ["Cyber insurers", "Cyber policies and AI extensions", "Incident response, business interruption", "Varies by carrier"],
                    ].map(([prov, prod, cov, status]) => (
                      <tr class="border-b border-line-0 even:bg-bg-2">
                        <td class="px-4 py-3 font-semibold text-ink-0">{prov}</td>
                        <td class="px-4 py-3 text-ink-1">{prod}</td>
                        <td class="px-4 py-3 text-ink-1">{cov}</td>
                        <td class="px-4 py-3 text-ink-1">{status}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div class="mt-6 prose-kyde">
                <p>
                  One development worth watching is <strong>parametric cover</strong>. Traditional liability cover requires showing that a specific system caused a specific harm, which is hard when several parties contribute to an agent's behavior. A parametric policy instead pays out when a predefined condition is met, such as performance falling below a threshold or an SLA being breached, without a dispute about causation.
                </p>
                <p>
                  That structure suits AI agents well, provided both sides trust the measurement. The insurer does not have to reconstruct what happened. It has to verify that the monitored metric crossed the agreed threshold, which requires continuous and independent monitoring.
                </p>
              </div>
            </div>

            <!-- AIUC CERTIFICATION -->
            <div id="aiuc-certification">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-warn bg-warn/10 border border-warn/40 px-2 py-0.5">04</span>
                <h2 class="text-xl md:text-2xl font-bold text-ink-0 uppercase tracking-wide">The certification layer: AIUC-1</h2>
              </div>
              <div class="prose-kyde">
                <p>
                  AIUC-1 is a certification standard for AI agents, often described as a SOC 2 for agents. It was developed with technical contributors including Cisco, the Cloud Security Alliance, Orrick and MITRE, and it gives procurement teams and insurers an audited signal about how an agent is built and tested. Its requirements are organized into six domains. The topics below are our summary of what each covers.
                </p>
              </div>

              <div class="mt-6 grid md:grid-cols-2 gap-4">
                {[
                  { domain: "Data & Privacy", desc: "Handling of personal and customer data, retention" },
                  { domain: "Security", desc: "Prompt injection defenses, access controls, tool and protocol security" },
                  { domain: "Safety", desc: "Harmful output prevention, human override" },
                  { domain: "Reliability", desc: "Consistent behavior, handling of errors and hallucinations" },
                  { domain: "Accountability", desc: "Ownership, audit trails, incident handling" },
                  { domain: "Society", desc: "Misuse prevention, broader societal risks" },
                ].map(({ domain, desc }) => (
                  <div class="border border-line-0 bg-bg-1 p-4">
                    <p class="font-mono text-xs font-semibold text-ink-0 mb-1.5">{domain}</p>
                    <p class="text-xs text-ink-1 leading-snug">{desc}</p>
                  </div>
                ))}
              </div>

              <div class="mt-6 border border-line-0 bg-bg-2 p-5">
                <p class="font-mono text-xs uppercase tracking-widest text-ink-0 mb-2">Key facts</p>
                <ul class="text-sm text-ink-1 space-y-1.5">
                  <li class="flex gap-2"><span class="text-warn font-mono shrink-0">→</span>Around 50 requirements across six domains (ElevenLabs' certification cites 51), updated quarterly</li>
                  <li class="flex gap-2"><span class="text-warn font-mono shrink-0">→</span>The Q2 2026 update added controls for MCP security and agent identity</li>
                  <li class="flex gap-2"><span class="text-warn font-mono shrink-0">→</span>Certificates run for 12 months, with quarterly technical testing to keep them</li>
                  <li class="flex gap-2"><span class="text-warn font-mono shrink-0">→</span>ElevenLabs describes itself as the first voice AI company certified, together with AI insurance</li>
                </ul>
              </div>
            </div>

            <!-- CERTIFICATION LIMITS -->
            <div id="certification-limits">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-warn bg-warn/10 border border-warn/40 px-2 py-0.5">05</span>
                <h2 class="text-xl md:text-2xl font-bold text-ink-0 uppercase tracking-wide">Why certification alone isn't enough</h2>
              </div>
              <div class="prose-kyde">
                <p>
                  Certification answers one question: did this system meet the standard when it was tested? For conventional software that is often enough, because systems change on planned release cycles and the gap between the audit and today stays small.
                </p>
                <p>
                  AI agents change more often and less visibly. The underlying model is updated. <a href="/behavioral-drift" class="text-ink-1 underline underline-offset-4 decoration-ink-0/20 hover:decoration-warn transition-colors">Behavioral drift</a> builds up over time. New attack techniques appear that the audit did not test for. An agent certified in February can carry a noticeably different risk in June without any single failure, simply because many small things changed.
                </p>
                <p>
                  AIUC-1 recognizes this with quarterly testing. Quarterly testing is still a snapshot of a system that runs all the time, though. It tells you how the system behaved on the test date, not what it was doing on the day of an incident.
                </p>
                <p>
                  The law points the same way. The EU AI Act asks high-risk systems to log events automatically throughout their life, not only at audit time. And under the Product Liability Directive, a certification report describing a system four months before an incident says little about what happened on the day.
                </p>
                <p>
                  Car insurance offers a useful comparison. Before telematics, insurers priced risk from proxies such as age, location and vehicle type, because they could not observe driving directly. Usage-based insurance added data about how people actually drive. We expect AI agent insurance to move in a similar direction, adding behavioral data to certification as monitoring becomes common.
                </p>
              </div>
            </div>

            <!-- EVIDENCE REQUIREMENTS -->
            <div id="evidence-requirements">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-warn bg-warn/10 border border-warn/40 px-2 py-0.5">06</span>
                <h2 class="text-xl md:text-2xl font-bold text-ink-0 uppercase tracking-wide">The four evidence requirements</h2>
              </div>
              <p class="text-sm text-ink-1 mb-6 leading-relaxed">None of these laws prescribes exactly how an agent's behavior must be recorded. In our view, a record that will hold up in an incident review, a liability dispute or an underwriting decision needs four properties.</p>

              <div class="space-y-4">
                {[
                  {
                    num: "1",
                    title: "Complete",
                    text: "It covers the agent's actions, model calls, tool calls and data access, not a sample. An investigation that has to stitch the sequence together from separate vendor consoles is slow and leaves gaps.",
                  },
                  {
                    num: "2",
                    title: "Continuous",
                    text: "It exists from the day the agent goes live. A record assembled after an incident cannot show that controls were in place before it.",
                  },
                  {
                    num: "3",
                    title: "Independent",
                    text: "It does not depend on one vendor. A log that exists only in a model provider's console can be useful, but it is kept by the provider and covers only that provider's part of the work. In a dispute involving the provider, an independent record carries more weight.",
                  },
                  {
                    num: "4",
                    title: "Tamper-evident",
                    text: "Later changes are detectable. Ordinary logs on a system the operator controls can be edited without a trace. Chaining each entry to the previous one, and signing entries when they are written, makes any later change visible.",
                  },
                ].map(({ num, title, text }) => (
                  <div class="flex gap-5 border border-line-0 bg-bg-1 p-6">
                    <div class="shrink-0 w-8 h-8 flex items-center justify-center bg-bg-3 text-ink-0 font-bold text-sm">{num}</div>
                    <div>
                      <h3 class="font-bold text-sm text-ink-0 mb-2">{title}</h3>
                      <p class="text-sm text-ink-1 leading-relaxed">{text}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Kyde's ROLE -->
            <div id="kyde-role">
              <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-warn bg-warn/10 border border-warn/40 px-2 py-0.5">07</span>
                <h2 class="text-xl md:text-2xl font-bold text-ink-0 uppercase tracking-wide">What Kyde contributes to AI agent insurability</h2>
              </div>
              <div class="prose-kyde">
                <p>
                  Kyde scores how AI agents behave. Kyde Control also writes a continuous, tamper-evident record of every agent action routed through it, which is the kind of record described above.
                </p>
                <p>
                  Kyde Gateway sits in the data path between the agents and the systems they act on. What you route through the Gateway is captured before it reaches the downstream system, chained to the previous entry so that altering one entry breaks every entry after it, and forwarded unchanged, without modifying agent behavior, without requiring changes to the agent or model provider, in under 100 milliseconds. Signing each entry with your own Ed25519 keys is an Enterprise capability. What the Gateway does not see, it does not record, which is why coverage is reported alongside the record rather than assumed.
                </p>
                <p>
                  An insurance product that prices this record is not something we ship. What runs today is the recording such a product would be priced from.
                </p>
              </div>

              <div class="mt-8 grid md:grid-cols-3 gap-4">
                {[
                  {
                    title: "For the legal frameworks",
                    items: [
                      "A record independent of the model provider, useful for DORA incident handling",
                      "A decision chain per recorded event, supporting EU AI Act logging and oversight",
                      "Produces the evidence you would answer PLD strict liability presumptions with",
                    ],
                  },
                  {
                    title: "For the insurance market",
                    items: [
                      "Provides the continuous behavioral signal a parametric trigger has to be checked against",
                      "Establishes the behavioral baselines dynamic risk pricing would be built on",
                      "Continuous evidence that certified controls stayed in place between tests",
                    ],
                  },
                  {
                    title: "For the enterprise",
                    items: [
                      "Zero changes to model providers or agent code, one ENV variable",
                      "Provider-agnostic: OpenAI, Anthropic, Gemini, local models, MCP, whatever you route through it",
                      "Scoped audit of one process area, then enforcement, signing and SLA",
                    ],
                  },
                ].map(({ title, items }) => (
                  <div class="border border-line-0 bg-bg-1 p-5">
                    <p class="font-mono text-xs font-semibold text-ink-0 uppercase tracking-wider mb-4">{title}</p>
                    <ul class="space-y-2.5">
                      {items.map((item) => (
                        <li class="text-xs text-ink-1 flex gap-2 leading-snug">
                          <span class="text-warn font-mono shrink-0">→</span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

