---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const groups = [
  {
    label: "Deployment and architecture",
    items: [
      {
        q: "Does the gateway add latency?",
        a: "The gateway performs deterministic policy checks, not model calls. There is no LLM in the enforcement path, which is why overhead stays under 100ms in our benchmarks. Ask us for current figures for your specific deployment pattern.",
      },
      {
        q: "What happens if the gateway goes down?",
        a: "You choose the failure mode per policy: fail-closed for regulated workloads, fail-open for lower-risk traffic. Either way, the behavior is documented policy, not an accident.",
      },
      {
        q: "Do my agents need to be modified?",
        a: "No. Point your agent's base URL at the gateway with one environment variable. The agent continues to operate as before; the gateway intercepts transparently. No SDK, no code changes.",
      },
      {
        q: "Does it work with any LLM provider?",
        a: "Yes. One gateway instance proxies OpenAI, Anthropic, Gemini, Copilot, and local models via Ollama, vLLM or LM Studio, simultaneously. MCP-routed calls are also supported.",
      },
    ],
  },
  {
    label: "Data and privacy",
    items: [
      {
        q: "Do you see our data?",
        a: "No, not unless you turn it on. Prompts, responses and payload content stay on your infrastructure at all times. Telemetry is opt-in and off by default; when enabled, it transmits only pseudonymized aggregate counts, never message content. A fully air-gapped deployment is available on Enterprise.",
      },
      {
        q: "Where does the audit ledger live?",
        a: "Inside your own perimeter, on infrastructure you control. It is not a hosted service you have to trust with your evidence.",
      },
    ],
  },
  {
    label: "Compliance and evidence",
    items: [
      {
        q: "What is the difference between Kyde and a SIEM?",
        a: "A SIEM ingests logs your systems choose to emit. Kyde sits at the boundary and generates the record itself, independent of whether the agent or its vendor wanted to log the action. You can forward Kyde's ledger into your SIEM; it does not replace one, and a SIEM cannot replace it.",
      },
      {
        q: "What is the difference between Kyde and an API gateway?",
        a: "An API gateway routes and rate-limits calls between endpoints. It generally has no concept of agent identity, delegation, or policy tied to what an agent is allowed to do. Kyde adds that governance layer on top of the same network position.",
      },
      {
        q: "Does the free tier satisfy audit requirements on its own?",
        a: "The Starter tier records every action into a hash-chained, tamper-evident ledger, real evidence of sequence and content. Cryptographic signing (Ed25519) and managed key infrastructure, the piece auditors typically ask about for non-repudiation, are part of the Enterprise tier.",
      },
      {
        q: "Why not wait until our AI provider builds this?",
        a: "A provider's log lives on their infrastructure, under their control. In a dispute involving that provider's model, their own log is not independent evidence. Kyde is built to be independent of every model provider it governs, including the one under investigation.",
      },
    ],
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: groups.flatMap((g) => g.items).map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<Base
  title="FAQ, Kyde"
  description="Answers to the questions security and compliance teams ask before deploying the Kyde Gateway: latency, data privacy, audit evidence, and how it compares to a SIEM or API gateway."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Navbar />
  <main>

    <!-- ══════════ HERO ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-24 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">FAQ</span></div>
        </div>
        <h1 class="hero-h1 max-w-4xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl">
          Questions we<br /><span class="gradient-text">actually get.</span>
        </h1>
      </div>
    </section>

    {groups.map(({ label, items }) => (
      <section class="border-t border-line-1">
        <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-8">{label}</p>
          <div class="space-y-px">
            {items.map(({ q, a }) => (
              <details class="group border border-line-0 bg-bg-1">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                  <span class="text-sm font-semibold text-ink-0 pr-4">{q}</span>
                  <svg class="h-4 w-4 shrink-0 text-ink-2 group-open:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-sm text-ink-1 leading-relaxed">{a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
        <div class="border border-line-0 p-12 md:p-20">
          <div class="max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-ink-0 mb-4">
              Didn't find your question?
            </h2>
            <p class="text-lg text-ink-1 mb-10">
              We answer every message, and questions from real sales calls get added here within a week.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <button onclick="openModal()" class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all">
                Talk to Us →
              </button>
              <a href="mailto:hello@kyde.com" class="inline-flex items-center gap-2 border border-line-1 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-0 hover:border-white/40 transition-all">
                hello@kyde.com →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
