---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const rows = [
  { axis: "Architecture",                                   x: "SDK and API wrapped around AI calls",                                     kyde: "External gateway at the network boundary" },
  { axis: "No-code deployment, shadow-agent coverage",      x: "Partial: no-code platform UI for policy configuration, but enforcement requires API integration per application", kyde: "Yes: network egress, one environment variable, covers uninstrumented agents" },
  { axis: "Blocks before execution",                        x: "Yes, for wrapped calls, content-rule based",                               kyde: "Yes, deterministic deny-by-default for all boundary traffic" },
  { axis: "What is checked",                                x: "Content of inputs and outputs against compliance rules",                   kyde: "Structure of actions: which agent, which tool, which endpoint, under which policy" },
  { axis: "Cryptographic audit trail",                      x: "Audit logging, software modifiable",                                       kyde: "Hash-chained, tamper-evident, vendor-independent ledger (Ed25519 signing on Enterprise)" },
  { axis: "Regulatory posture",                             x: "Output checking may raise Article 25 questions your counsel should assess", kyde: "External proxy, models and pipelines untouched, deployer status preserved" },
  { axis: "Sweet spot",                                     x: "Fintech content compliance",                                               kyde: "Regulated enterprises governing whole agent fleets" },
];

const faqs = [
  {
    q: "Can Alinia and Kyde run together?",
    a: "Yes, cleanly. Alinia checks content inside applications you build. Kyde governs the egress boundary, which covers every agent routed through it, wrapped or not. Several layers of a real defense.",
  },
  {
    q: "We only have two AI applications. Do we still need a boundary?",
    a: "You have two you know about. The Kyde Starter exists to answer how many you actually have. It is free, and the answer routinely surprises teams.",
  },
  {
    q: "Which one helps with EU AI Act logging duties?",
    a: "Article 12 asks for automatic, trustworthy logs for high-risk systems. A hash-chained, tamper-evident, vendor-independent ledger is built for the agent layer of that duty, not the whole obligation, with Ed25519 signing available on Enterprise. High-risk enforcement begins December 2, 2027. NIS-2 and DORA apply today.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<Base
  title="Kyde vs Alinia AI: Guardrails or Governance? | Kyde"
  description="Alinia wraps AI calls in compliance guardrails via SDK. Kyde governs every agent routed through the network boundary, with a hash-chained audit trail. An honest 2026 comparison."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Navbar />
  <main>

    <!-- ══════════ HERO / VERDICT ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-20 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">Compare · Last verified July 2026</span></div>
        </div>
        <h1 class="hero-h1 max-w-4xl text-5xl text-ink-0 uppercase tracking-tight md:text-6xl lg:text-7xl mb-8">
          Kyde vs <span class="gradient-text">Alinia AI</span>
        </h1>
        <p class="text-lg text-ink-1 leading-relaxed max-w-3xl">
          Alinia and Kyde serve the same regulated buyer with different instruments. Alinia is compliance as code: an SDK and API that wraps your AI calls and checks inputs and outputs against configurable rules, with prebuilt rule sets for frameworks like MiFID II and the EU AI Act. Kyde is governance infrastructure: an external gateway at the network boundary that enforces deterministic policy on every agent action that crosses it and records that action in a hash-chained, tamper-evident ledger. Alinia governs the calls your developers wrap. Kyde governs everything that crosses the boundary, wrapped or not.
        </p>
      </div>
    </section>

    <!-- ══════════ TL;DR ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="grid md:grid-cols-2 gap-5">
          <div class="border border-line-0 bg-bg-1 p-8">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-1 mb-5">Choose Alinia if</p>
            <ul class="space-y-3">
              {[
                "You want content level compliance checks on model outputs, with domain rule sets for financial services",
                "Your AI surface is a handful of applications your own team builds and can integrate an SDK into",
                "You value fintech references. Their anchor customer is a major bank.",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-ink-1 leading-relaxed"><span class="shrink-0 mt-0.5 text-ink-1">→</span>{item}</li>
              ))}
            </ul>
          </div>
          <div class="border border-live/30 bg-bg-1 p-8">
            <p class="font-mono text-xs uppercase tracking-widest text-live mb-5">Choose Kyde if</p>
            <ul class="space-y-3">
              {[
                "Your compliance duty covers all agents, including the ones nobody integrated anything into",
                "You need rollout without touching code: one environment variable or group policy, five minutes",
                "You need evidence, not just filtering: a hash-chained, tamper-evident record of what every agent routed through the boundary did and what was blocked",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-ink-0 leading-relaxed"><span class="shrink-0 mt-0.5 text-live">→</span>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ SIDE BY SIDE ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">Side by side</span></div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border border-line-0 text-sm">
            <thead>
              <tr class="border-b border-line-0 bg-bg-0">
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-ink-1 w-56"></th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-ink-1">Alinia AI</th>
                <th class="px-5 py-3 text-left font-mono text-xs uppercase tracking-widest text-ink-0 bg-bg-1/5">Kyde</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line-0">
              {rows.map(({ axis, x, kyde }) => (
                <tr>
                  <td class="px-5 py-4 font-mono text-xs text-ink-1 uppercase tracking-wider align-top">{axis}</td>
                  <td class="px-5 py-4 text-sm text-ink-1 align-top">{x}</td>
                  <td class="px-5 py-4 text-sm text-ink-0 bg-bg-1/3 align-top">{kyde}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══════════ DEEP DIVE ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0 space-y-16">

        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">What Alinia does well</p>
          <p class="text-base text-ink-1 leading-relaxed max-w-3xl">
            Alinia earned its place: a major bank as anchor customer is not luck. Prebuilt rule sets for MiFID II and the EU AI Act save real work for teams that need domain-specific content checks, and checking what a model says is a legitimate layer that a structural gateway does not replace. If your problem is "our advisory chatbot must never make an unauthorized product recommendation," content guardrails are the right-shaped tool.
          </p>
        </div>

        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Where the approaches differ</p>
          <p class="text-base text-ink-1 leading-relaxed max-w-3xl mb-4">
            Two differences decide most evaluations. First, the integration model. An API layer governs what developers wire in. Alinia now offers a no-code platform UI for configuring policies, which helps compliance teams, but the enforcement itself still lives in the application path: every new application is a new integration, and every agent that skipped the wrapper is outside compliance. There is a second-order problem too: an enforcement layer that lives inside the application shares the application's fate. If the agent can touch the lock, it can pick it.
          </p>
          <p class="text-base text-ink-1 leading-relaxed max-w-3xl">
            Kyde inverts this: the boundary governs by default, outside the agent's reach, and nobody has to remember to opt in. In a company with two AI apps, the difference is small. In a company where every team ships agents, it is the whole game.
          </p>
        </div>

        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">What that means in an audit</p>
          <p class="text-base text-ink-1 leading-relaxed max-w-3xl">
            What a regulator sees afterwards differs too. Content filtering produces a decision in the moment. Kyde produces evidence that survives the moment: a hash-chained record of every action at the boundary, allowed and blocked, where altering one entry breaks every entry after it and a third party can recompute that offline. When the audit comes, the question is not whether you filtered. It is whether you can prove what happened. One question belongs to your lawyers, not to us: solutions that modify model inputs or outputs inline should be assessed against the substantial modification threshold in Article 25 of the EU AI Act, which can shift provider duties onto the deployer. Kyde's external proxy leaves models and pipelines untouched by design.
          </p>
        </div>

        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Can you run both?</p>
          <p class="text-base text-ink-1 leading-relaxed max-w-3xl">
            Yes, cleanly. Alinia checks content inside applications you build. Kyde governs the egress boundary, which covers every agent routed through it, wrapped or not. Several layers of a real defense. If budget forces a choice, start where the liability is broadest: the boundary, since it covers agents you have not built yet.
          </p>
        </div>

      </div>
    </section>

    <!-- ══════════ FAQ ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-end justify-between border-b border-line-0 pb-3"><span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-1">FAQ</span></div>
        </div>
        <div class="max-w-3xl space-y-px">
          {faqs.map(({ q, a }) => (
            <details class="group border border-line-0 bg-bg-1">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                <span class="text-sm font-semibold text-ink-0 pr-4">{q}</span>
                <svg class="h-4 w-4 shrink-0 text-ink-2 group-open:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-sm text-ink-1 leading-relaxed">{a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 md:border-x md:border-line-0">
        <div class="border border-line-0 p-12 md:p-20">
          <div class="max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight text-ink-0 mb-4">
              Govern the agents nobody wrapped, and the ones they did.
            </h2>
            <p class="text-lg text-ink-1 mb-10">
              Deploy the Kyde Gateway Starter in five minutes, or talk to us.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/starter" class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all">
                Start Free →
              </a>
              <button onclick="openModal()" class="inline-flex items-center gap-2 border border-line-1 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-0 hover:border-white/40 transition-all">
                Talk to Us →
              </button>
            </div>
            <p class="mt-8 font-mono text-xs text-ink-2">
              <a href="/who-its-for" class="hover:text-ink-0 transition-colors">Who it's for</a> · <a href="/faq" class="hover:text-ink-0 transition-colors">FAQ</a>
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
