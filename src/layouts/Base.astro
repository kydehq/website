---
import { alternatesFor, localeOf } from "../data/locales";
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import DemoModal from "../components/DemoModal.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    noindex?: boolean;
}

const {
    title = "KYDE · The Behavioral System of Record for Autonomous Work",
    description = "Identity, scope, enforcement at the boundary, and a hash-chained record of every agent action routed through it. Built for the agent layer of GDPR, EU AI Act, NIS-2 and DORA duties.",
    image = "/og-image-v2.png",
    noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// Language and its counterparts come from the URL and one shared table, not
// from per-page props, so a page cannot claim a counterpart that does not
// claim it back.
const locale = localeOf(Astro.url.pathname);
const alternates = alternatesFor(Astro.url.pathname);
const hasAlternates = Object.keys(alternates).length > 0;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang={locale} class="antialiased">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="dark light" />
        <meta name="theme-color" content="#050505" />
        <script is:inline>
            // Theme pre-paint: dark is the default; light only on explicit opt-in.
            // Runs before first paint so there is no flash-of-wrong-theme.
            if (localStorage.getItem("kyde_theme") === "light") {
                document.documentElement.dataset.theme = "light";
                document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#F7F6F3");
            }
        </script>
        <meta name="description" content={description} />
        <title>{title}</title>
        {noindex ? (
            <meta name="robots" content="noindex" />
        ) : (
            <link rel="canonical" href={canonicalURL} />
        )}

        <!-- Reciprocal only: emitted for both languages or for neither, and
             x-default points at English, which is the fuller site. -->
        {!noindex && hasAlternates && (
            <>
                {Object.entries(alternates).map(([lang, path]) => (
                    <link rel="alternate" hreflang={lang} href={new URL(path, Astro.site).href} />
                ))}
                <link rel="alternate" hreflang="x-default" href={new URL(alternates.en!, Astro.site).href} />
            </>
        )}

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="KYDE" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImage} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Favicon (?v=2 busts browser favicon caches still holding the pre-July design) -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Additional head slot -->
        <slot name="head" />

        <!-- Privacy-friendly analytics by Plausible -->
        <script async src="https://plausible.io/js/pa-44yi9etmwZRWONOecCXmL.js"></script>
        <script>
            window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
            plausible.init()
        </script>
    </head>
    <body class="min-h-screen">
        <DemoModal />
        <slot />
        <CookieBanner />
        <script>
            // Scroll reveal (design doc §6) · staggered, once, JS-progressive
            const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!rm) {
                const sections = document.querySelectorAll("main section");
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries) {
                            if (e.isIntersecting) {
                                (e.target as HTMLElement).classList.add("revealed");
                                io.unobserve(e.target);
                            }
                        }
                    },
                    { threshold: 0.08 },
                );
                sections.forEach((el, i) => {
                    if (i === 0) return; // hero is visible immediately
                    el.classList.add("reveal");
                    io.observe(el);
                });
            }
        </script>
    </body>
</html>
