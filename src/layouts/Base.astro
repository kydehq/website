---
import "../styles/global.css";
import "@fontsource-variable/montserrat";
import DemoModal from "../components/DemoModal.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "KYDE — The Trust Laye for the Agentic Economy.",
    description = "KYDE - Secures AI driven Infrastructure.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>

        <!-- Favicon -->
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Additional head slot -->
        <slot name="head" />

        <!-- Privacy-friendly analytics by Plausible -->
        <script async src="https://plausible.io/js/pa-44yi9etmwZRWONOecCXmL.js"></script>
        <script>
            window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
            plausible.init()
        </script>
    </head>
    <body class="min-h-screen font-[Montserrat,sans-serif]">
        <DemoModal />
        <slot />
        <CookieBanner />
    </body>
</html>
