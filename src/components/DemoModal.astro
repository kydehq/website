<!-- Modal overlay -->
<div
  id="demo-modal"
  class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4"
  aria-modal="true"
  role="dialog"
>
  <div class="absolute inset-0 bg-[#0d0e10]/70 backdrop-blur-sm" id="demo-modal-backdrop"></div>

  <div class="relative w-full max-w-lg border border-dotted border-[#0d0e10]/25 bg-[#f1f3f5] shadow-xl transition-all">

    <!-- Close -->
    <button
      id="demo-modal-close"
      class="absolute top-4 right-4 text-[#333] hover:text-[#0d0e10] transition-colors"
      aria-label="Close"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>

    <div class="p-8">
      <h3 class="text-xl font-bold text-[#0d0e10]">Book a Compliance Demo</h3>
      <p class="mt-2 text-sm text-[#333]">
        See how KYDE provides tamper-evident audit trails for your AI agents. 30 min, no commitment.
      </p>

      <!-- Form -->
      <form
        id="demo-form"
        class="mt-6 space-y-4"
      >
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="demo-firstname" class="block text-xs font-medium text-[#333] mb-1.5">First Name</label>
            <input
              type="text" id="demo-firstname" name="firstname" required
              placeholder="Jane"
              class="w-full border border-dotted border-[#0d0e10]/20 bg-white px-4 py-2.5 text-sm text-[#0d0e10] placeholder-[#aaa] focus:border-[#4472c4] focus:outline-none focus:ring-1 focus:ring-[#4472c4] transition-colors"
            />
          </div>
          <div>
            <label for="demo-lastname" class="block text-xs font-medium text-[#333] mb-1.5">Last Name</label>
            <input
              type="text" id="demo-lastname" name="lastname" required
              placeholder="Smith"
              class="w-full border border-dotted border-[#0d0e10]/20 bg-white px-4 py-2.5 text-sm text-[#0d0e10] placeholder-[#aaa] focus:border-[#4472c4] focus:outline-none focus:ring-1 focus:ring-[#4472c4] transition-colors"
            />
          </div>
        </div>
        <div>
          <label for="demo-email" class="block text-xs font-medium text-[#333] mb-1.5">Work Email</label>
          <input
            type="email" id="demo-email" name="email" required
            placeholder="jane@company.com"
            class="w-full border border-dotted border-[#0d0e10]/20 bg-white px-4 py-2.5 text-sm text-[#0d0e10] placeholder-[#aaa] focus:border-[#4472c4] focus:outline-none focus:ring-1 focus:ring-[#4472c4] transition-colors"
          />
        </div>
        <div>
          <label for="demo-company" class="block text-xs font-medium text-[#333] mb-1.5">Company</label>
          <input
            type="text" id="demo-company" name="company"
            placeholder="Acme Corp"
            class="w-full border border-dotted border-[#0d0e10]/20 bg-white px-4 py-2.5 text-sm text-[#0d0e10] placeholder-[#aaa] focus:border-[#4472c4] focus:outline-none focus:ring-1 focus:ring-[#4472c4] transition-colors"
          />
        </div>
        <div>
          <label for="demo-agents" class="block text-xs font-medium text-[#333] mb-1.5">How many AI agents do you run?</label>
          <select
            id="demo-agents" name="agents"
            class="w-full border border-dotted border-[#0d0e10]/20 bg-white px-4 py-2.5 text-sm text-[#0d0e10] focus:border-[#4472c4] focus:outline-none focus:ring-1 focus:ring-[#4472c4] transition-colors"
          >
            <option value="1-5">1–5</option>
            <option value="6-20">6–20</option>
            <option value="21-100">21–100</option>
            <option value="100+">100+</option>
          </select>
        </div>
        <div class="flex items-start gap-3">
          <input
            type="checkbox" id="demo-consent" name="consent" required
            class="mt-0.5 h-4 w-4 shrink-0 border border-dotted border-[#0d0e10]/30 accent-[#0d0e10]"
          />
          <label for="demo-consent" class="text-xs text-[#666] leading-relaxed">
            I agree to allow KYDE to store and process my personal data to handle this request. You can unsubscribe at any time. See our <a href="/legal" class="underline hover:text-[#333]">Privacy Policy</a>.
          </label>
        </div>
        <button
          type="submit" id="demo-submit"
          class="w-full bg-[#0d0e10] px-4 py-3 text-sm font-semibold text-[#f1f3f5] hover:bg-[#333] transition-all"
        >
          Request Demo
        </button>
        <p class="text-xs text-[#666] text-center">We'll get back to you within 24 hours.</p>
      </form>

      <!-- Success state -->
      <div id="demo-success" class="hidden mt-6 text-center py-8">
        <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#0a7c4e]/10">
          <svg class="h-6 w-6 text-[#0a7c4e]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h4 class="text-lg font-semibold text-[#0d0e10]">Request received!</h4>
        <p class="mt-2 text-sm text-[#333]">We'll be in touch within 24 hours.</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Open / close
  function openModal() {
    document.getElementById('demo-modal')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('demo-modal')?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Expose globally
  (window as any).openModal = openModal;
  (window as any).closeModal = closeModal;

  // Close on backdrop / ESC
  document.getElementById('demo-modal-backdrop')?.addEventListener('click', closeModal);
  document.getElementById('demo-modal-close')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Form submit → KYDE API
  const form = document.getElementById('demo-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const consent = form.querySelector<HTMLInputElement>('#demo-consent');
    if (!consent?.checked) {
      consent?.setCustomValidity('Please accept the privacy policy to continue.');
      consent?.reportValidity();
      return;
    }
    consent?.setCustomValidity('');

    const btn = document.getElementById('demo-submit') as HTMLButtonElement;
    btn.textContent = 'Sending…';
    btn.disabled = true;

    const data = new FormData(form);

    const payload = {
      firstname:   data.get('firstname') ?? '',
      lastname:    data.get('lastname') ?? '',
      email:       data.get('email') ?? '',
      company:     data.get('company') ?? '',
      agents:      data.get('agents') ?? '',
      lead_source: 'website_demo_request',
      page_url:    window.location.href,
    };

    try {
      const res = await fetch('https://service.kyde.com/demo-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        form.classList.add('hidden');
        document.getElementById('demo-success')?.classList.remove('hidden');
      } else {
        throw new Error('server error');
      }
    } catch {
      btn.textContent = 'Request Demo';
      btn.disabled = false;
      alert('Something went wrong. Please email hello@kyde.com directly.');
    }
  });
</script>
