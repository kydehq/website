<!-- Modal overlay -->
<div
  id="demo-modal"
  class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4"
  aria-modal="true"
  role="dialog"
>
  <div class="absolute inset-0 bg-bg-0/70 backdrop-blur-sm" id="demo-modal-backdrop"></div>

  <div class="relative w-full max-w-lg border border-line-1 bg-bg-2 transition-all">

    <!-- Close -->
    <button
      id="demo-modal-close"
      class="absolute top-4 right-4 text-ink-1 hover:text-ink-0 transition-colors"
      aria-label="Close"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>

    <div class="p-8">
      <h3 id="demo-title" class="text-xl font-bold text-ink-0">Let's talk.</h3>
      <p id="demo-intro" class="mt-2 text-sm text-ink-1">
        Tell us about your setup. We'll get back to you within 24 hours.
      </p>

      <!-- Form -->
      <form
        id="demo-form"
        class="mt-6 space-y-4"
      >
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="demo-firstname" class="block text-xs font-medium text-ink-1 mb-1.5">First Name</label>
            <input
              type="text" id="demo-firstname" name="firstname" required
              placeholder="Jane"
              class="w-full border border-line-0 bg-bg-1 px-4 py-2.5 text-sm text-ink-0 placeholder-ink-2 focus:border-ink-0 focus:outline-none transition-colors"
            />
          </div>
          <div>
            <label for="demo-lastname" class="block text-xs font-medium text-ink-1 mb-1.5">Last Name</label>
            <input
              type="text" id="demo-lastname" name="lastname" required
              placeholder="Smith"
              class="w-full border border-line-0 bg-bg-1 px-4 py-2.5 text-sm text-ink-0 placeholder-ink-2 focus:border-ink-0 focus:outline-none transition-colors"
            />
          </div>
        </div>
        <div>
          <label for="demo-email" class="block text-xs font-medium text-ink-1 mb-1.5">Work Email</label>
          <input
            type="email" id="demo-email" name="email" required
            placeholder="jane@company.com"
            class="w-full border border-line-0 bg-bg-1 px-4 py-2.5 text-sm text-ink-0 placeholder-ink-2 focus:border-ink-0 focus:outline-none transition-colors"
          />
        </div>
        <div>
          <label for="demo-company" class="block text-xs font-medium text-ink-1 mb-1.5">Company</label>
          <input
            type="text" id="demo-company" name="company"
            placeholder="Acme Corp"
            class="w-full border border-line-0 bg-bg-1 px-4 py-2.5 text-sm text-ink-0 placeholder-ink-2 focus:border-ink-0 focus:outline-none transition-colors"
          />
        </div>
        <div>
          <label for="demo-agents" class="block text-xs font-medium text-ink-1 mb-1.5">How many AI agents do you run?</label>
          <select
            id="demo-agents" name="agents"
            class="w-full border border-line-0 bg-bg-1 px-4 py-2.5 text-sm text-ink-0 focus:border-ink-0 focus:outline-none transition-colors"
          >
            <option value="1-5">1-5</option>
            <option value="6-20">6-20</option>
            <option value="21-100">21-100</option>
            <option value="100+">100+</option>
          </select>
        </div>
        <div>
          <label for="demo-message" id="demo-message-label" class="block text-xs font-medium text-ink-1 mb-1.5">What do you want to talk about?</label>
          <textarea
            id="demo-message" name="message" required minlength="20" maxlength="2000" rows="3"
            placeholder="e.g. We run 12 claims agents and want to stop them when they drift."
            class="w-full border border-line-0 bg-bg-1 px-4 py-2.5 text-sm text-ink-0 placeholder-ink-2 focus:border-ink-0 focus:outline-none transition-colors resize-y"
          ></textarea>
        </div>
        <!-- Spam trap: invisible to people, bots fill it in. -->
        <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
          <label for="demo-website">Website</label>
          <input type="text" id="demo-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="flex items-start gap-3">
          <input
            type="checkbox" id="demo-consent" name="consent" required
            class="mt-0.5 h-4 w-4 shrink-0 border border-line-1 accent-ink-0"
          />
          <label for="demo-consent" class="text-xs text-ink-1 leading-relaxed">
            I agree to allow Kyde to store and process my personal data to handle this request. You can unsubscribe at any time. See our <a href="/legal/" class="underline hover:text-ink-1">Privacy Policy</a>.
          </label>
        </div>
        <button
          type="submit" id="demo-submit"
          class="w-full bg-white px-4 py-3 text-sm font-semibold text-cta-ink hover:bg-cta-hover transition-all"
        >
          Send →
        </button>
        <p class="text-xs text-ink-1 text-center">We'll get back to you within 24 hours.</p>
      </form>

      <!-- Success state -->
      <div id="demo-success" class="hidden mt-6 text-center py-8">
        <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-live/10">
          <svg class="h-6 w-6 text-live" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h4 id="demo-success-title" class="text-lg font-semibold text-ink-0">Message received.</h4>
        <p id="demo-success-text" class="mt-2 text-sm text-ink-1">We'll be in touch within 24 hours.</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Open / close
  let openedAt = 0;
  // Reservation mode: openModal({ plan: 'Solo' }) from the pricing page.
  // While the GmbH is on hold there is no checkout (D-047), so a reservation
  // is a lead with the plan in lead_source. The plan travels in lead_source,
  // not only in message, because demo-request may not store message yet
  // (KYDE-376). Without a plan the dialog is the plain contact form.
  let reservePlan = '';
  // Waitlist mode: openModal({ waitlist: 'stop' }). Pause and block through
  // the hook wait for the GmbH (D-054, 2026-11-11). Same fields and route as
  // a reservation, lead_source website_waitlist_<name>.
  let waitlist = '';
  const texts = {
    title: "Let's talk.",
    intro: "Tell us about your setup. We'll get back to you within 24 hours.",
    label: 'What do you want to talk about?',
    submit: 'Send →',
    okTitle: 'Message received.',
    okText: "We'll be in touch within 24 hours.",
  };
  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }
  function openModal(opts?: { plan?: string; waitlist?: string }) {
    reservePlan = opts?.plan ?? '';
    waitlist = reservePlan ? '' : (opts?.waitlist ?? '');
    const msg = document.getElementById('demo-message') as HTMLTextAreaElement | null;
    if (waitlist) {
      setText('demo-title', 'Join the waitlist.');
      setText('demo-intro', 'Kyde Score warns your agent today. Pause and block open with our GmbH. We email you when they do.');
      setText('demo-message-label', 'Anything we should know? (optional)');
      setText('demo-submit', 'Join the waitlist →');
      setText('demo-success-title', "You're on the list.");
      setText('demo-success-text', "We'll email you when pause and block open.");
      if (msg) { msg.required = false; msg.minLength = 0; }
    } else if (reservePlan) {
      setText('demo-title', `Reserve ${reservePlan}.`);
      setText('demo-intro', `Nothing to pay today. We hold the ${reservePlan} price for you and email you when the plan opens.`);
      setText('demo-message-label', 'Anything we should know? (optional)');
      setText('demo-submit', `Reserve ${reservePlan} →`);
      setText('demo-success-title', 'Reserved.');
      setText('demo-success-text', `We'll email you when ${reservePlan} opens.`);
      if (msg) { msg.required = false; msg.minLength = 0; }
    } else {
      setText('demo-title', texts.title);
      setText('demo-intro', texts.intro);
      setText('demo-message-label', texts.label);
      setText('demo-submit', texts.submit);
      setText('demo-success-title', texts.okTitle);
      setText('demo-success-text', texts.okText);
      if (msg) { msg.required = true; msg.minLength = 20; }
    }
    openedAt = Date.now();
    document.getElementById('demo-modal')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('demo-modal')?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Expose globally
  (window as any).openModal = openModal;
  (window as any).closeModal = closeModal;

  // kyde.com/#contact opens the form, e.g. from the dashboard on score.kyde.com.
  if (location.hash === '#contact') openModal();

  // Close on backdrop / ESC
  document.getElementById('demo-modal-backdrop')?.addEventListener('click', closeModal);
  document.getElementById('demo-modal-close')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Form submit → KYDE API
  const form = document.getElementById('demo-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const consent = form.querySelector<HTMLInputElement>('#demo-consent');
    if (!consent?.checked) {
      consent?.setCustomValidity('Please accept the privacy policy to continue.');
      consent?.reportValidity();
      return;
    }
    consent?.setCustomValidity('');

    // Spam: the hidden field is filled, or the form was sent faster than a
    // person can type. Show success, send nothing.
    const trap = (form.querySelector<HTMLInputElement>('#demo-website')?.value ?? '').trim();
    if (trap || Date.now() - openedAt < 4000) {
      form.classList.add('hidden');
      document.getElementById('demo-success')?.classList.remove('hidden');
      return;
    }

    const btn = document.getElementById('demo-submit') as HTMLButtonElement;
    btn.textContent = 'Sending…';
    btn.disabled = true;

    const data = new FormData(form);

    const payload = {
      firstname:   data.get('firstname') ?? '',
      lastname:    data.get('lastname') ?? '',
      email:       data.get('email') ?? '',
      company:     data.get('company') ?? '',
      agents:      data.get('agents') ?? '',
      message:     waitlist
        ? `[Waitlist: pause and block] ${String(data.get('message') ?? '').trim()}`.trim()
        : reservePlan
        ? `[Reservation: ${reservePlan}] ${String(data.get('message') ?? '').trim()}`.trim()
        : String(data.get('message') ?? '').trim(),
      lead_source: waitlist
        ? `website_waitlist_${waitlist}`
        : reservePlan
        ? `website_reservation_${reservePlan.toLowerCase()}`
        : 'website_demo_request',
      page_url:    window.location.href,
    };

    try {
      const res = await fetch('https://service.kyde.com/demo-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        (window as any).umami?.track(waitlist ? `waitlist-sent-${waitlist}` : reservePlan ? `reserve-sent-${reservePlan.toLowerCase()}` : 'contact-sent');
        form.classList.add('hidden');
        document.getElementById('demo-success')?.classList.remove('hidden');
      } else {
        throw new Error('server error');
      }
    } catch {
      btn.textContent = waitlist ? 'Join the waitlist →' : reservePlan ? `Reserve ${reservePlan} →` : 'Send →';
      btn.disabled = false;
      alert('Something went wrong. Please email hello@kyde.com directly.');
    }
  });
</script>
