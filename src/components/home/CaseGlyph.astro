---
// A small moving picture for each way an agent goes wrong. One idea each,
// drawn in the house line: 2px ink, pink for the thing going wrong, neon for
// where it should have gone.
interface Props { kind: 'money' | 'security' | 'drift' | 'objective' }
const { kind } = Astro.props;
const bars = [10, 14, 20, 30, 44, 62];
---
<figure class={`glyph glyph-${kind}`} data-glyph aria-hidden="true">
  <svg viewBox="0 0 260 100">
    <defs>
      <pattern id={`gh-${kind}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--color-ink)" stroke-width="1" stroke-opacity="0.22" />
      </pattern>
    </defs>

    {kind === 'money' && (
      <>
        <circle cx="50" cy="50" r="34" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="4 5" />
        <g class="orbit"><circle cx="50" cy="16" r="7" fill="var(--color-ink)" /></g>
        <text x="50" y="55" text-anchor="middle" class="t">retry</text>
        {bars.map((h, i) => (
          <rect class="bar" style={`--i:${i}`} x={112 + i * 24} y={90 - h} width="16" height={h}
            fill={i === bars.length - 1 ? 'var(--color-pink)' : 'var(--color-paper)'} stroke="var(--color-ink)" stroke-width="2" />
        ))}
        <line x1="104" y1="90" x2="258" y2="90" stroke="var(--color-ink)" stroke-width="2" />
        <text x="258" y="12" text-anchor="end" class="t">€ per minute</text>
      </>
    )}

    {kind === 'security' && (
      <>
        <rect x="8" y="8" width="72" height="84" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="2" />
        <line x1="18" y1="24" x2="66" y2="24" stroke="var(--color-ink)" stroke-width="2" />
        <line x1="18" y1="36" x2="58" y2="36" stroke="var(--color-ink)" stroke-width="2" />
        <rect x="14" y="44" width="60" height="12" fill="var(--color-pink)" class="inject" />
        <line x1="18" y1="50" x2="68" y2="50" stroke="var(--color-ink)" stroke-width="2" />
        <line x1="18" y1="64" x2="62" y2="64" stroke="var(--color-ink)" stroke-width="2" />
        <line x1="18" y1="76" x2="50" y2="76" stroke="var(--color-ink)" stroke-width="2" />
        <path d="M84 50 L226 30" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="3 6" />
        <circle cx="234" cy="28" r="12" fill="var(--color-neon)" stroke="var(--color-ink)" stroke-width="2" />
        <path id="gs-path" d="M84 50 C 140 50, 170 84, 222 86" fill="none" stroke="var(--color-ink)" stroke-width="2.5" class="draw" />
        <rect x="222" y="76" width="20" height="20" fill="var(--color-card)" />
        <text x="232" y="91" text-anchor="middle" class="t on-dark">!</text>
        <circle r="5" fill="var(--color-ink)"><animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#gs-path" /></animateMotion></circle>
      </>
    )}

    {kind === 'drift' && (
      <>
        <rect x="0" y="24" width="260" height="30" fill={`url(#gh-${kind})`} />
        <line x1="0" y1="54" x2="260" y2="54" stroke="var(--color-ink)" stroke-width="1" stroke-dasharray="2 4" />
        <path d="M0 40 L20 36 L40 43 L60 35 L80 41 L100 37 L120 44 L140 46 L160 55 L180 62 L200 71 L220 78 L240 86 L258 92"
          fill="none" stroke="var(--color-ink)" stroke-width="2.5" stroke-linejoin="round" pathLength="1" class="draw-loop" />
        <circle cx="160" cy="55" r="6" fill="var(--color-pink)" stroke="var(--color-ink)" stroke-width="2" class="pop" />
        <text x="0" y="16" class="t">(Baseline)</text>
      </>
    )}

    {kind === 'objective' && (
      <>
        <circle cx="222" cy="30" r="20" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="4 4" />
        <circle cx="222" cy="30" r="8" fill="var(--color-neon)" stroke="var(--color-ink)" stroke-width="2" />
        <text x="190" y="34" text-anchor="end" class="t">outcome</text>
        <circle cx="200" cy="80" r="12" fill="var(--color-pink)" stroke="var(--color-ink)" stroke-width="2" />
        <text x="170" y="98" text-anchor="end" class="t">proxy</text>
        <path d="M10 84 L184 81" fill="none" stroke="var(--color-ink)" stroke-width="2.5" pathLength="1" class="draw-loop" />
        <circle cx="10" cy="84" r="6" fill="var(--color-ink)" />
      </>
    )}
  </svg>
</figure>

<script>
  const figs = document.querySelectorAll<HTMLElement>('[data-glyph]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((es) => {
    for (const e of es) {
      const svg = e.target.querySelector('svg') as SVGSVGElement;
      e.target.classList.toggle('run', e.isIntersecting && !reduced);
      if (e.isIntersecting && !reduced) svg.unpauseAnimations(); else svg.pauseAnimations();
    }
  });
  figs.forEach((f) => io.observe(f));
</script>

<style>
  .glyph { margin: 4px 0 18px; }
  .glyph svg { width: 100%; max-width: 300px; height: auto; display: block; overflow: visible; }
  .glyph :global(.t) { font-family: var(--font-mono); font-weight: 500; font-size: 12px; fill: var(--color-ink); }
  .glyph :global(.t.on-dark) { fill: var(--color-pink); font-size: 14px; }

  .orbit { transform-origin: 50px 50px; transform-box: view-box; }
  .run .orbit { animation: orbit 1.1s linear infinite; }
  @keyframes orbit { to { transform: rotate(360deg); } }

  .bar { transform-box: fill-box; transform-origin: bottom; }
  .run .bar { animation: bar 2.4s cubic-bezier(.5,0,.2,1) infinite; animation-delay: calc(var(--i) * 0.12s); }
  @keyframes bar { 0% { transform: scaleY(0.15); } 60%, 100% { transform: scaleY(1); } }

  .run .inject { animation: blink 1.3s steps(1) infinite; }
  @keyframes blink { 50% { fill: var(--color-card); } }

  .draw-loop { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .run .draw-loop { animation: draw 3s ease-in-out infinite; }
  @keyframes draw { 0% { stroke-dashoffset: 1; } 60%, 100% { stroke-dashoffset: 0; } }
  .pop { transform-box: fill-box; transform-origin: center; }
  .run .pop { animation: pop 3s ease-in-out infinite; }
  @keyframes pop { 0%, 45% { transform: scale(0); } 55%, 100% { transform: scale(1); } }
</style>
