---
// Two ways an agent ends up somewhere it was never meant to go, drawn still
// on purpose: this is a diagram to read, not a scene to watch. One path is
// aimed at a proxy from its first run. The other sets off on course and
// bends away later, in the deck's motion phases, its outline decaying from
// solid to dashed to dotted as it leaves.
const O = { x: 40, y: 280 };
const GOAL = { x: 520, y: 70 };
const onIntended = (x: number) => O.y + ((GOAL.y - O.y) / (GOAL.x - O.x)) * (x - O.x);
const BEND = { x: 270, y: onIntended(270) };
const phases = [
  { x: 312, y: BEND.y - 4, r: 10, dash: undefined },
  { x: 356, y: BEND.y + 2, r: 12, dash: undefined },
  { x: 398, y: BEND.y + 18, r: 14, dash: '5 4' },
  { x: 436, y: BEND.y + 42, r: 16, dash: '5 4' },
  { x: 468, y: BEND.y + 72, r: 18, dash: '1.5 4.5' },
];
---
<figure class="trajectory" aria-label="Diagram: one agent is aimed at a proxy from day one; another starts on course and bends away later">
  <svg viewBox="0 0 560 330">
    <defs>
      <marker id="trajectory-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--color-ink)" />
      </marker>
    </defs>

    <!-- intended -->
    <line x1={O.x} y1={O.y} x2={GOAL.x} y2={GOAL.y} stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="3 7" />
    <circle cx={GOAL.x} cy={GOAL.y} r="22" fill="var(--color-neon)" stroke="var(--color-ink)" stroke-width="2" />
    <text x={GOAL.x - 32} y={GOAL.y - 30} text-anchor="end" class="t">(Intended outcome)</text>

    <!-- changes later: on course, then phases leaving it -->
    <line x1={O.x} y1={O.y} x2={BEND.x} y2={BEND.y} stroke="var(--color-ink)" stroke-width="2.5" />
    {phases.map((p) => (
      <circle cx={p.x} cy={p.y} r={p.r} fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray={p.dash} />
    ))}
    <text x="296" y="252" class="t">(Changes later)</text>

    <!-- wrong from day one -->
    <line x1={O.x} y1={O.y} x2="452" y2={O.y} stroke="var(--color-ink)" stroke-width="2.5" marker-end="url(#trajectory-arrow)" />
    <circle cx="480" cy={O.y} r="18" fill="var(--color-pink)" stroke="var(--color-ink)" stroke-width="2" />
    <text x="480" y={O.y + 42} text-anchor="middle" class="t">(Proxy)</text>
    <text x="176" y={O.y + 26} class="t">(Wrong from day one)</text>

    <!-- origin -->
    <circle cx={O.x} cy={O.y} r="14" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="2" />
    <text x={O.x - 14} y={O.y + 42} class="t">(Day 1) Checked</text>
  </svg>
</figure>

<style>
  .trajectory { margin: 44px 0 0; max-width: 560px; }
  .trajectory svg { width: 100%; height: auto; overflow: visible; }
  .trajectory :global(.t) { font-family: var(--font-mono); font-weight: 500; font-size: 14px; fill: var(--color-ink); }
</style>
