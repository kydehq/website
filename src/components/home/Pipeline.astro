---
// See it. Score it. Stop it. Prove it, as one moving line. Actions enter
// from the left and cross four gates. Each gets its score at the second
// gate; the hijacked one (pink) is stopped at the third and never reaches
// your systems; everything that passes is chained at the fourth, each link
// carrying the hash of the one before. Illustrative.
const gates = [
  { x: 190, n: '01', name: 'Observe' },
  { x: 440, n: '02', name: 'Score' },
  { x: 690, n: '03', name: 'Enforce' },
  { x: 940, n: '04', name: 'Prove' },
];
---
<figure class="pipe" id="pipe" aria-label="Illustrative: actions pass four gates; a hijacked action is stopped at Enforce, the rest are hash-chained at Prove">
  <svg viewBox="0 0 1200 250">
    <line x1="0" y1="140" x2="1200" y2="140" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="2 6" />
    {gates.map((g) => (
      <g>
        <line x1={g.x} y1="62" x2={g.x} y2="218" stroke="var(--color-ink)" stroke-width="3" />
        <rect x={g.x - 62} y="16" width="124" height="32" fill="var(--color-card)" />
        <text x={g.x} y="37" text-anchor="middle" class="t on-dark">{g.n} {g.name}</text>
      </g>
    ))}
    <text x="690" y="240" text-anchor="middle" class="t" id="pipe-blocked">blocked · 0</text>
    <text x="1070" y="240" text-anchor="middle" class="t" id="pipe-chained">chained · 0</text>
    <g id="pipe-tokens"></g>
    <g id="pipe-chain"></g>
  </svg>
</figure>

<script>
  const fig = document.getElementById('pipe');
  if (fig) {
    const NS = 'http://www.w3.org/2000/svg';
    const tokensG = document.getElementById('pipe-tokens')!;
    const chainG = document.getElementById('pipe-chain')!;
    const blockedT = document.getElementById('pipe-blocked')!;
    const chainedT = document.getElementById('pipe-chained')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const Y = 140, SPEED = 150, SCORE_X = 440, ENFORCE_X = 690, PROVE_X = 940;
    let blocked = 0, chained = 0, n = 0, hash = 0xa4c1;

    type Tok = { id: number; x: number; bad: boolean; g: SVGGElement; label: SVGTextElement; scored: boolean; stopAt?: number };
    const tokens: Tok[] = [];
    const mk = (tag: string, attrs: Record<string, string | number>) => {
      const el = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
      return el;
    };

    const spawn = () => {
      n++;
      const bad = n % 6 === 4;
      const g = mk('g', {}) as SVGGElement;
      g.appendChild(mk('rect', { x: -11, y: -11, width: 22, height: 22, fill: bad ? 'var(--color-pink)' : 'var(--color-paper)', stroke: 'var(--color-ink)', 'stroke-width': 2 }));
      const label = mk('text', { x: 0, y: -22, 'text-anchor': 'middle', class: 't' }) as SVGTextElement;
      g.appendChild(label);
      tokensG.appendChild(g);
      tokens.push({ id: n, x: -20, bad, g, label, scored: false });
    };

    const chain = (h: number) => {
      // newest link enters at the gate side; older links step right
      for (const c of Array.from(chainG.children) as SVGGElement[]) {
        const x = Number(c.dataset.x) + 64;
        c.dataset.x = String(x);
        c.setAttribute('transform', `translate(${x} ${Y})`);
        if (x > 1230) c.remove();
      }
      const c = mk('g', { transform: `translate(978 ${Y})` }) as SVGGElement;
      c.dataset.x = '978';
      c.appendChild(mk('line', { x1: 26, y1: 0, x2: 38, y2: 0, stroke: 'var(--color-ink)', 'stroke-width': 2 }));
      c.appendChild(mk('rect', { x: -26, y: -16, width: 52, height: 32, fill: 'var(--color-neon)', stroke: 'var(--color-ink)', 'stroke-width': 2 }));
      const t = mk('text', { x: 0, y: 5, 'text-anchor': 'middle', class: 't' });
      t.textContent = h.toString(16);
      c.appendChild(t);
      chainG.appendChild(c);
      chainedT.textContent = `chained · ${++chained}`;
    };

    let last = 0, sinceSpawn = 0;
    const frame = (t: number) => {
      const dt = Math.min((t - last) / 1000, 0.05) || 0.016;
      last = t;
      sinceSpawn += dt;
      if (sinceSpawn > 0.82) { spawn(); sinceSpawn = 0; }
      for (let i = tokens.length - 1; i >= 0; i--) {
        const k = tokens[i];
        if (k.stopAt !== undefined) {
          k.stopAt -= dt;
          k.g.setAttribute('opacity', String(Math.max(0, Math.min(1, k.stopAt))));
          if (k.stopAt <= 0) { k.g.remove(); tokens.splice(i, 1); }
          continue;
        }
        k.x += SPEED * dt;
        if (!k.scored && k.x >= SCORE_X) { k.scored = true; k.label.textContent = k.bad ? '41' : String(89 + ((k.id * 5) % 9)); }
        if (k.bad && k.x >= ENFORCE_X - 16) {
          k.x = ENFORCE_X - 16;
          k.stopAt = 1.6;
          k.label.textContent = 'blocked';
          k.label.setAttribute('y', '38');
          k.g.appendChild(mk('path', { d: 'M-7 -7 L7 7 M7 -7 L-7 7', stroke: 'var(--color-ink)', 'stroke-width': 2.5 }));
          blockedT.textContent = `blocked · ${++blocked}`;
        }
        if (!k.bad && k.x >= PROVE_X + 10) { k.g.remove(); tokens.splice(i, 1); hash += 1; chain(hash); continue; }
        k.g.setAttribute('transform', `translate(${k.x.toFixed(1)} ${Y})`);
      }
      if (running) requestAnimationFrame(frame);
    };

    let running = false;
    const start = () => { if (running) return; running = true; last = performance.now(); requestAnimationFrame(frame); };
    const stop = () => { running = false; };

    if (reduced) {
      // a still frame that tells the whole story
      for (let i = 0; i < 4; i++) { hash++; chain(hash); }
      const place = (x: number, bad: boolean, label: string) => {
        spawn(); const k = tokens[tokens.length - 1]; k.x = x; k.bad = bad;
        (k.g.firstChild as SVGRectElement).setAttribute('fill', bad ? 'var(--color-pink)' : 'var(--color-paper)');
        if (bad) k.label.setAttribute('y', '38'); k.label.textContent = label; k.g.setAttribute('transform', `translate(${x} ${Y})`);
      };
      place(90, false, ''); place(560, false, '94'); place(674, true, 'blocked'); place(820, false, '97');
    } else {
      new IntersectionObserver((es) => (es[0].isIntersecting ? start() : stop())).observe(fig);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    }
  }
</script>

<style>
  .pipe { margin: clamp(40px, 5vw, 72px) 0 0; border-top: 2px solid var(--color-ink); border-bottom: 2px solid var(--color-ink); padding: 18px 0 10px; overflow: hidden; }
  .pipe svg { width: 100%; height: auto; display: block; }
  .pipe :global(.t) { font-family: var(--font-mono); font-weight: 500; font-size: 15px; fill: var(--color-ink); }
  .pipe :global(.t.on-dark) { fill: var(--color-pink); }
  @media (max-width: 700px) { .pipe :global(.t) { font-size: 22px; } }
</style>
