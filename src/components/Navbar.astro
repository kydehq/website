---
const navLinks = [
  { label: 'Platform',      href: '/platform'     },
  { label: 'Trust Score™',  href: '/trust-score'  },
  { label: 'Use Cases',     href: '/use-cases'    },
  { label: 'Pricing',       href: '/pricing'      },
  { label: 'Resources',     href: '/resources'    },
  { label: 'Company',       href: '/company'      },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-[#050505]/95 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="/" class="inline-flex items-center shrink-0">
      <img src="/kyde-logo.svg" alt="KYDE" class="h-[33px] w-auto" />
    </a>

    <!-- Nav links (desktop) -->
    <ul class="hidden md:flex items-center gap-7">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class={[
              'font-mono text-xs uppercase tracking-[0.12em] transition-colors',
              currentPath.startsWith(href)
                ? 'text-white'
                : 'text-white/75 hover:text-white',
            ].join(' ')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTAs (desktop) -->
    <div class="hidden md:flex items-center gap-3">
      <button
        onclick="openModal()"
        class="inline-flex h-[33px] items-center gap-2 border border-white/25 px-5 text-[11px] font-mono uppercase tracking-[0.1em] text-white/70 transition-colors hover:border-white hover:text-white"
      >
        Talk to Us
      </button>
      <a
        href="/sandbox"
        class="inline-flex h-[33px] items-center gap-2 bg-white px-5 text-[11px] font-mono uppercase tracking-[0.1em] text-[#0A0A0A] transition-colors hover:bg-[#E5E5E5]"
      >
        Deploy Sandbox &gt;
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-1"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-1"></span>
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-2"></span>
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-3"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/10 bg-[#050505] px-6 py-6"
  >
    <ul class="flex flex-col gap-6 mb-8">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class={[
              'font-mono text-sm uppercase tracking-widest transition-colors',
              currentPath.startsWith(href)
                ? 'text-white'
                : 'text-white/75 hover:text-white',
            ].join(' ')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="space-y-3">
      <a
        href="/sandbox"
        class="block w-full text-center bg-white px-4 py-3 text-xs font-mono uppercase tracking-[0.1em] text-[#0A0A0A] hover:bg-[#E5E5E5] transition-all"
      >
        Deploy Sandbox &gt;
      </a>
      <button
        onclick="openModal(); document.getElementById('mobile-menu').classList.add('hidden');"
        class="w-full border border-white/25 px-4 py-3 text-xs font-mono uppercase tracking-[0.1em] text-white/70 hover:border-white hover:text-white transition-all"
      >
        Talk to Us &gt;
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const b1 = document.getElementById('burger-1');
  const b2 = document.getElementById('burger-2');
  const b3 = document.getElementById('burger-3');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    if (isOpen) {
      b1?.classList.add('translate-y-[7.5px]', 'rotate-45');
      b2?.classList.add('opacity-0');
      b3?.classList.add('-translate-y-[7.5px]', '-rotate-45');
    } else {
      b1?.classList.remove('translate-y-[7.5px]', 'rotate-45');
      b2?.classList.remove('opacity-0');
      b3?.classList.remove('-translate-y-[7.5px]', '-rotate-45');
    }
  });
</script>
