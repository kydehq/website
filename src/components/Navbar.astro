---
import { alternatesFor, localeOf } from "../data/locales";

// Nav is the catalogue, the home page is the story. "Zero Trust" used to sit
// first and point at "/", which meant the chrome sold the mechanism while the
// first sentence sold the category, and a visitor believes the chrome. The
// mechanism lives on /platform now and the label names what it is.
// Offerings first, then the lens over them. Use Cases is not a third thing we
// sell: it is Platform and Services looked at by job, and its own page is two
// tabs in that order. Sitting between them, it split the pair it then
// recombines, and it was the only place on the site ordered that way — the
// footer columns and those tabs both read Platform, Services.
const navLinks = [
  { label: 'Platform',      href: '/platform'     },
  { label: 'Services',      href: '/services'     },
  { label: 'Use Cases',     href: '/use-cases'    },
  { label: 'Resources',     href: '/resources'    },
];

const currentPath = Astro.url.pathname;

// Only rendered where a counterpart actually exists. A switch that dumps the
// reader on a homepage in another language is worse than no switch: it looks
// like the translation exists and then does not deliver it.
const locale = localeOf(currentPath);
const alternates = alternatesFor(currentPath);
const otherLocale = locale === "de" ? "en" : "de";
const otherHref = alternates[otherLocale];
---

<header id="site-nav" class="site-nav fixed top-0 left-0 right-0 z-50">
  <nav aria-label="Main" class="mx-auto flex max-w-[1440px] items-center justify-between px-[clamp(20px,5.5vw,80px)] py-4">
    <!-- Logo -->
    <a href="/" class="inline-flex items-center shrink-0">
      <img src="/kyde-logo.svg" alt="KYDE" class="logo-mark h-[28px] w-auto" />
    </a>

    <!-- Nav links (desktop) -->
    <ul class="hidden lg:flex items-center gap-5 xl:gap-7">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class={[
              'inline-block font-mono text-[13px] whitespace-nowrap transition-colors pb-1.5 border-b',
              (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
                ? 'text-white border-white'
                : 'text-white/50 border-transparent hover:text-white hover:border-white/30',
            ].join(' ')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTAs (desktop) -->
    <div class="hidden lg:flex items-center gap-3">
      <button
        onclick="openModal()"
        class="inline-flex h-[33px] items-center gap-2 whitespace-nowrap bg-ink px-4 text-[13px] font-mono text-paper transition-colors hover:bg-cta-hover"
      >
        Watch your agents →
      </button>
      {otherHref && (
        <a
          href={otherHref}
          hreflang={otherLocale}
          class="ml-3 hidden md:inline-flex items-center border border-white/20 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-white/50 hover:border-white/60 hover:text-white transition-colors"
        >
          {otherLocale.toUpperCase()}
        </a>
      )}
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden flex flex-col gap-1.5 p-1"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-1"></span>
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-2"></span>
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-3"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <!-- Mobile menu · full-height overlay so page content can't show through -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-white/10 bg-bg-0 px-6 py-6 min-h-[calc(100dvh-66px)] overflow-y-auto"
  >
    <ul class="flex flex-col gap-6 mb-8">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class={[
              'font-sans text-2xl tracking-tight transition-colors',
              (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
                ? 'text-white font-bold'
                : 'text-white/50 hover:text-white',
            ].join(' ')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="space-y-3">
      <button
        onclick="openModal()"
        class="block w-full text-center bg-ink px-4 py-3 text-sm font-mono text-paper hover:bg-cta-hover transition-all"
      >
        Watch your agents →
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const b1 = document.getElementById('burger-1');
  const b2 = document.getElementById('burger-2');
  const b3 = document.getElementById('burger-3');

  const setOpen = (isOpen: boolean) => {
    menu?.classList.toggle('hidden', !isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
    document.body.style.overflow = isOpen ? 'hidden' : '';
    if (isOpen) {
      b1?.classList.add('translate-y-[7.5px]', 'rotate-45');
      b2?.classList.add('opacity-0');
      b3?.classList.add('-translate-y-[7.5px]', '-rotate-45');
    } else {
      b1?.classList.remove('translate-y-[7.5px]', 'rotate-45');
      b2?.classList.remove('opacity-0');
      b3?.classList.remove('-translate-y-[7.5px]', '-rotate-45');
    }
  };

  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') === true));

  (window as any).closeMobileMenu = () => setOpen(false);

  // The bar takes the color of whatever section is under it, so it never
  // reads as a separate strip: blush over the hero and the pink bands, paper
  // everywhere else. Sections opt in with data-surface.
  const nav = document.getElementById('site-nav');
  let navTick = false;
  const syncNav = () => {
    navTick = false;
    if (!nav) return;
    const y = nav.offsetHeight;
    const under = Array.from(document.querySelectorAll<HTMLElement>('main > section')).find((sec) => {
      const r = sec.getBoundingClientRect();
      return r.top <= y && r.bottom > y;
    });
    nav.dataset.surface = under?.dataset.surface ?? 'paper';
    nav.classList.toggle('scrolled', window.scrollY > 4);
  };
  window.addEventListener('scroll', () => { if (!navTick) { navTick = true; requestAnimationFrame(syncNav); } }, { passive: true });
  window.addEventListener('resize', syncNav);
  syncNav();

</script>

<style>
  .site-nav { background: var(--color-paper); transition: background-color .25s ease, border-color .25s ease; border-bottom: 1px solid transparent; }
  .site-nav[data-surface="blush"] { background: var(--color-blush); }
  .site-nav.scrolled:not([data-surface="blush"]) { border-bottom-color: color-mix(in srgb, var(--color-ink) 12%, transparent); }
  #mobile-menu { background: inherit; }
</style>
