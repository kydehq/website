---
import { alternatesFor, localeOf } from "../data/locales";

const navLinks = [
  { label: 'Workers',       href: '/'             },
  { label: 'Zero Trust',    href: '/zero-trust'   },
  { label: 'Use Cases',     href: '/use-cases'    },
  { label: 'Resources',     href: '/resources'    },
];

const currentPath = Astro.url.pathname;

// Only rendered where a counterpart actually exists. A switch that dumps the
// reader on a homepage in another language is worse than no switch: it looks
// like the translation exists and then does not deliver it.
const locale = localeOf(currentPath);
const alternates = alternatesFor(currentPath);
const otherLocale = locale === "de" ? "en" : "de";
const otherHref = alternates[otherLocale];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-bg-0/95 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="/" class="inline-flex items-center shrink-0">
      <img src="/kyde-logo.svg" alt="KYDE" class="logo-mark h-[33px] w-auto" />
    </a>

    <!-- Nav links (desktop) -->
    <ul class="hidden lg:flex items-center gap-5 xl:gap-7">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class={[
              'inline-block font-mono text-xs uppercase tracking-[0.12em] whitespace-nowrap transition-colors pb-1.5 border-b',
              (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
                ? 'text-white border-white'
                : 'text-white/50 border-transparent hover:text-white hover:border-white/30',
            ].join(' ')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTAs (desktop) -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href="/audit"
        class="inline-flex h-[33px] items-center gap-2 whitespace-nowrap bg-white px-5 text-[11px] font-mono uppercase tracking-[0.1em] text-cta-ink transition-colors hover:bg-cta-hover"
      >
        Start your audit &gt;
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch between dark and light"
        class="inline-flex h-[33px] w-[33px] items-center justify-center border border-white/20 font-mono text-[11px] text-white/50 hover:border-white/60 hover:text-white transition-colors"
      >
        <span class="theme-glyph-dark">☾</span><span class="theme-glyph-light hidden">☀</span>
      </button>
      {otherHref && (
        <a
          href={otherHref}
          hreflang={otherLocale}
          class="ml-3 hidden md:inline-flex items-center border border-white/20 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-white/50 hover:border-white/60 hover:text-white transition-colors"
        >
          {otherLocale.toUpperCase()}
        </a>
      )}
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden flex flex-col gap-1.5 p-1"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-1"></span>
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-2"></span>
      <span class="block h-px w-6 bg-white transition-all duration-200" id="burger-3"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <!-- Mobile menu · full-height overlay so page content can't show through -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-white/10 bg-bg-0 px-6 py-6 min-h-[calc(100dvh-66px)] overflow-y-auto"
  >
    <ul class="flex flex-col gap-6 mb-8">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class={[
              'font-mono text-sm uppercase tracking-widest transition-colors',
              (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
                ? 'text-white font-bold'
                : 'text-white/50 hover:text-white',
            ].join(' ')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="space-y-3">
      <button
        id="theme-toggle-mobile"
        type="button"
        class="flex w-full items-center justify-between border border-white/20 px-4 py-3 font-mono text-xs uppercase tracking-[0.1em] text-white/60 hover:border-white/60 hover:text-white transition-colors"
      >
        <span>Appearance</span>
        <span><span class="theme-glyph-dark">Dark ☾</span><span class="theme-glyph-light hidden">Light ☀</span></span>
      </button>
      <a
        href="/audit"
        class="block w-full text-center bg-white px-4 py-3 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all"
      >
        Start your audit &gt;
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const b1 = document.getElementById('burger-1');
  const b2 = document.getElementById('burger-2');
  const b3 = document.getElementById('burger-3');

  const setOpen = (isOpen: boolean) => {
    menu?.classList.toggle('hidden', !isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
    document.body.style.overflow = isOpen ? 'hidden' : '';
    if (isOpen) {
      b1?.classList.add('translate-y-[7.5px]', 'rotate-45');
      b2?.classList.add('opacity-0');
      b3?.classList.add('-translate-y-[7.5px]', '-rotate-45');
    } else {
      b1?.classList.remove('translate-y-[7.5px]', 'rotate-45');
      b2?.classList.remove('opacity-0');
      b3?.classList.remove('-translate-y-[7.5px]', '-rotate-45');
    }
  };

  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') === true));

  (window as any).closeMobileMenu = () => setOpen(false);

  // Theme toggle: light is the default; dark is an explicit, persisted opt-in.
  //
  // The key is versioned on purpose. The first version of this wrote to storage
  // on every page load, not just on a click, so every visitor to the old
  // dark-default site is carrying a stored "dark" they never chose. Reading that
  // key now would pin all of them to dark forever and none of them would ever
  // see the new default. A fresh key ignores it, and this one is only written
  // when somebody actually presses the button.
  const THEME_KEY = 'kyde_theme_choice';
  const themeColorMeta = document.querySelector('meta[name="theme-color"]');
  const setTheme = (theme: 'dark' | 'light', persist = false) => {
    if (theme === 'dark') {
      document.documentElement.dataset.theme = 'dark';
      themeColorMeta?.setAttribute('content', '#050505');
    } else {
      delete document.documentElement.dataset.theme;
      themeColorMeta?.setAttribute('content', '#F7F6F3');
    }
    if (persist) localStorage.setItem(THEME_KEY, theme);
    document.querySelectorAll('.theme-glyph-dark').forEach((el) => el.classList.toggle('hidden', theme === 'light'));
    document.querySelectorAll('.theme-glyph-light').forEach((el) => el.classList.toggle('hidden', theme !== 'light'));
    window.dispatchEvent(new CustomEvent('kyde:theme', { detail: { theme } }));
  };
  const toggleTheme = () => {
    setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark', true);
  };
  // Match the pre-paint guard, so the glyph agrees with the ground on load.
  setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
