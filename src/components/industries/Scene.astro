---
import type { Scene } from '../../data/industries';

// An example night, told the way /use-cases told them: what happened, what
// Kyde did. Left the headline and the film, right the timeline. Times and
// numbers are illustrative and the page says so under the scene.
interface Props {
  scene: Scene;
}
const { scene } = Astro.props;
---
<div class="scene">
  <div>
    <h2 class="sc-h">{scene.title}</h2>
    {scene.sub && <p class="sc-sub">{scene.sub}</p>}
    {scene.film && (
      <figure class="sc-film">
        <video class="sc-video" src={`/films/${scene.film}-16x9.mp4`} poster={`/films/${scene.film}-16x9.jpg`} muted loop playsinline preload="none"></video>
        <figcaption class="sc-mono sc-note">(Film) The same night in 27 seconds · *Illustrative</figcaption>
      </figure>
    )}
  </div>
  <div>
    <p class="sc-mono sc-label">(What happened)</p>
    <ol class="sc-timeline">
      {scene.timeline.map((e) => (
        <li>
          <span class="sc-mono sc-t">{e.t}</span>
          <span class="sc-body">{e.mark ? <span class="sc-hl">{e.line}</span> : e.line}</span>
        </li>
      ))}
    </ol>
    <div class="sc-did">
      <p class="sc-mono">(What Kyde did)</p>
      <p class="sc-body">{scene.kyde}</p>
    </div>
    <p class="sc-mono sc-note sc-foot">*Illustrative. Times and numbers are an example, not a customer's.</p>
  </div>
</div>

<script>
  // The film plays silently while it is on screen, and not at all under
  // reduced motion.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        const v = e.target as HTMLVideoElement;
        e.isIntersecting ? v.play().catch(() => {}) : v.pause();
      }
    }, { threshold: 0.35 });
    document.querySelectorAll<HTMLVideoElement>('.sc-video').forEach((v) => io.observe(v));
  }
</script>

<style>
  .scene { display: grid; grid-template-columns: 1fr; gap: 48px clamp(24px, 3.3vw, 48px); }
  @media (min-width: 1024px) { .scene { grid-template-columns: 1fr 1fr; } }
  .sc-h { font-size: var(--kx-h1); font-weight: 400; line-height: 0.98; letter-spacing: -0.045em; max-width: 20ch; text-wrap: balance; }
  .sc-sub { font-size: var(--kx-sub); line-height: 1.25; letter-spacing: -0.02em; color: var(--color-ink-2); margin-top: 1.1rem; max-width: 42ch; }
  .sc-body { font-size: var(--kx-body-l); line-height: 1.32; letter-spacing: -0.012em; }
  .sc-mono { font-family: var(--font-mono); font-weight: 500; letter-spacing: 0; }
  .sc-label { font-size: 0.9375rem; margin-bottom: 0.9rem; }
  .sc-note { font-size: 0.875rem; line-height: 1.5; color: var(--color-ink-2); }
  .sc-hl { padding: 0 0.1em; box-decoration-break: clone; -webkit-box-decoration-break: clone; background-repeat: no-repeat; background-image: linear-gradient(transparent 16%, var(--color-neon) 16%, var(--color-neon) 96%, transparent 96%); }
  .sc-film { margin: clamp(32px, 4vw, 56px) 0 0; }
  .sc-film video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--color-card); }
  .sc-film figcaption { margin-top: 10px; }
  .sc-timeline { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-ink); }
  .sc-timeline li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; align-items: baseline; border-bottom: 1px solid var(--color-ink); padding: 14px 0 16px; }
  .sc-t { font-size: 0.9375rem; }
  .sc-did { background: var(--color-card); color: #fff; padding: 20px 22px 22px; margin-top: 16px; }
  .sc-did .sc-mono { color: var(--color-blush); font-size: 0.875rem; margin-bottom: 8px; }
  .sc-foot { margin-top: 14px; }
</style>
