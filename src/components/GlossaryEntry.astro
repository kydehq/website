---
// Shared layout for glossary entries: definition-first (the snippet LLMs and
// featured snippets pull), then audience, then depth + one real data point
// provided via the default slot. Emits DefinedTerm + BreadcrumbList schema.
import Base from '../layouts/Base.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import LegalNotice from './LegalNotice.astro';

interface Props {
  term: string;          // display name, e.g. "AI Agent Governance"
  slug: string;          // path under /glossary/
  title: string;         // <title>
  description: string;   // meta description
  definition: string;    // 40-60 words, rendered directly under the H1
  who: string;           // "Who needs this", 2-3 sentences
  related: { label: string; href: string }[];
}

const { term, slug, title, description, definition, who, related } = Astro.props;

const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: term,
  description: definition,
  url: `https://kyde.com/glossary/${slug}`,
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: "Kyde AI Agent Governance Glossary",
    url: "https://kyde.com/glossary",
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://kyde.com/" },
    { "@type": "ListItem", position: 2, name: "Glossary", item: "https://kyde.com/glossary" },
    { "@type": "ListItem", position: 3, name: term, item: `https://kyde.com/glossary/${slug}` },
  ],
};
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <Navbar />
  <main>

    <!-- ══════════ DEFINITION ══════════ -->
    <section class="relative overflow-hidden">
      <div class="bg-grid absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto px-6 pt-36 pb-16 md:pt-48 md:pb-20 md:border-x md:border-line-0">
        <div class="mb-10">
          <div class="flex items-center gap-3 mb-3">
            <a href="/glossary" class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1 hover:text-ink-0 transition-colors">↑ Glossary</a>
            <span class="text-ink-1">/</span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-1">Last verified July 2026</span>
          </div>
          <div class="h-px w-full bg-line-0"></div>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-ink-0 tracking-tight leading-tight mb-8 max-w-4xl">
          What Is {term}?
        </h1>
        <p class="text-lg md:text-xl text-ink-0 leading-relaxed max-w-3xl border-l-2 border-line-1 pl-6">
          {definition}
        </p>
      </div>
    </section>

    <!-- ══════════ WHO NEEDS THIS ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-12 md:py-16 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-4">Who needs this</p>
        <p class="text-base text-ink-1 leading-relaxed max-w-3xl">{who}</p>
      </div>
    </section>

    <!-- ══════════ DEPTH + DATA POINT (slot) ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 md:border-x md:border-line-0 space-y-14">
        <slot />
      </div>
    </section>

    <!-- ══════════ RELATED ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-12 md:py-16 md:border-x md:border-line-0">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-2 mb-5">Related</p>
        <div class="flex flex-wrap gap-3">
          {related.map(({ label, href }) => (
            <a href={href} class="inline-flex items-center gap-2 border border-line-0 bg-bg-1 px-4 py-2 text-xs text-ink-1 hover:border-line-1 hover:text-ink-0 transition-all">
              {label} <span class="font-mono text-warn">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="border-t border-line-1">
      <div class="max-w-7xl mx-auto px-6 py-20 md:py-24 md:border-x md:border-line-0">
        <div class="border border-line-0 p-10 md:p-14">
          <div class="max-w-3xl">
            <h2 class="text-2xl md:text-3xl font-bold tracking-tight leading-tight text-ink-0 mb-4">
              See it running, not just defined.
            </h2>
            <p class="text-base text-ink-1 mb-8">
              Deploy the Kyde Gateway Starter in five minutes, or talk to us.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/audit" class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-cta-ink hover:bg-cta-hover transition-all">
                Start your audit →
              </a>
              <a href="/docs/" class="inline-flex items-center gap-2 border border-line-1 px-6 py-3.5 text-xs font-mono uppercase tracking-[0.1em] text-ink-0 hover:border-white/40 transition-all">
                Read the Docs →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  <LegalNotice />
  </main>
  <Footer />
</Base>
