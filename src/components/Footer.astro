---
import { localeOf } from "../data/locales";

const footerLinks = {
    Product: [
        { label: "Platform", href: "/platform" },
        { label: "Trust Score™", href: "/trust-score" },
        { label: "Use Cases", href: "/use-cases" },
        { label: "Who It's For", href: "/who-its-for" },
        { label: "Pricing", href: "/pricing" },
        { label: "Documentation", href: "/docs" },
        { label: "KYDE Labs", href: "/labs" },
    ],
    Learn: [
        { label: "EU AI Act Compliance", href: "/eu-ai-act-compliance" },
        { label: "Qualified Electronic Ledger (eIDAS)", href: "/qualified-electronic-ledger" },
        { label: "Autonomy Management", href: "/ai-agent-governance" },
        { label: "Zero Trust for Agents", href: "/zero-trust-for-ai-agents" },
        { label: "Shadow Agents", href: "/shadow-ai" },
        { label: "Glossary", href: "/glossary" },
        { label: "FAQ", href: "/faq" },
        { label: "All Resources", href: "/resources" },
    ],
    Company: [
        { label: "About", href: "/company" },
        { label: "Privacy & Imprint", href: "/legal" },
    ],
};

// German law wants the provider identification immediately reachable and
// recognizable as such. A German reader should not have to guess that an
// English "Imprint" is the Impressum, so German pages get their own label.
const isGerman = localeOf(Astro.url.pathname) === "de";
const links = isGerman
    ? {
          ...footerLinks,
          Company: [
              ...footerLinks.Company,
              { label: "Impressum", href: "/de/impressum" },
              { label: "Datenschutz", href: "/de/datenschutz" },
          ],
      }
    : footerLinks;

const year = new Date().getFullYear();

// Dot-matrix wordmark, 5×7 grid per letter
const GLYPHS: Record<string, string[]> = {
    K: ["X...X", "X..X.", "X.X..", "XX...", "X.X..", "X..X.", "X...X"],
    Y: ["X...X", "X...X", ".X.X.", "..X..", "..X..", "..X..", "..X.."],
    D: ["XXXX.", "X...X", "X...X", "X...X", "X...X", "X...X", "XXXX."],
    E: ["XXXXX", "X....", "X....", "XXXX.", "X....", "X....", "XXXXX"],
};

const CELL = 12;
const R = 3.2;
const LETTER_GAP = 2; // cols

function wordmarkDots(word: string) {
    const dots: { cx: number; cy: number }[] = [];
    let colOffset = 0;
    for (const ch of word) {
        const glyph = GLYPHS[ch];
        if (!glyph) continue;
        glyph.forEach((row, y) => {
            row.split("").forEach((cell, x) => {
                if (cell === "X") {
                    dots.push({
                        cx: (colOffset + x) * CELL + CELL / 2,
                        cy: y * CELL + CELL / 2,
                    });
                }
            });
        });
        colOffset += 5 + LETTER_GAP;
    }
    return { dots, width: (colOffset - LETTER_GAP) * CELL, height: 7 * CELL };
}

const wm = wordmarkDots("KYDE");
---

<footer class="border-t border-white/10 bg-bg-0">
    <div class="mx-auto max-w-7xl px-6 py-16">
        <div class="grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-5">
            <!-- Brand -->
            <div class="col-span-2">
                <a href="/" class="inline-flex items-center">
                    <img src="/kyde-logo.svg" alt="KYDE" class="logo-mark h-5 w-auto" />
                </a>
                <p class="mt-4 text-sm text-white/40 leading-relaxed">
                    The behavioral system of record for autonomous work.<br />One record of every agent action routed through it. Six readings, not six products.
                </p>
            </div>

            <!-- Link groups -->
            {
                Object.entries(links).map(([group, links]) => (
                    <div>
                        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/30 mb-5">
                            {group}
                        </p>
                        <ul class="space-y-3">
                            {links.map(({ label, href }) => (
                                <li>
                                    <a
                                        href={href}
                                        class="font-mono text-xs uppercase tracking-[0.08em] text-white/50 hover:text-white transition-colors"
                                    >
                                        {label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <!-- Dot-matrix wordmark -->
        <div class="mt-20 mb-4">
            <svg
                viewBox={`0 0 ${wm.width} ${wm.height}`}
                class="w-full max-w-md h-auto"
                aria-hidden="true"
            >
                {wm.dots.map(({ cx, cy }) => (
                    <circle cx={cx} cy={cy} r={R} class="wordmark-dot" />
                ))}
            </svg>
        </div>

        <!-- Bottom bar -->
        <div
            class="mt-8 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 md:flex-row md:items-center"
        >
            <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-white/25">
                &copy; {year} KYDE. All rights reserved.
            </p>
            <button
                onclick="openModal()"
                class="inline-flex items-center gap-2 border border-white/20 px-4 py-2 text-[10px] font-mono uppercase tracking-[0.12em] text-white/50 hover:border-white hover:text-white transition-all"
            >
                Talk to Us &gt;
            </button>
        </div>
    </div>
</footer>
