---
const footerLinks = {
    Product: [
        { label: "Platform", href: "/platform" },
        { label: "Use Cases", href: "/use-cases" },
        { label: "KYDE Labs", href: "/labs" },
    ],
    Company: [
        { label: "About", href: "/company" },
        { label: "Resources", href: "/resources" },
    ],
    Legal: [{ label: "Privacy & Imprint", href: "/legal" }],
};

const year = new Date().getFullYear();
---

<footer class="border-t border-dotted border-[#0d0e10]/15 bg-[#f1f3f5]">
    <div class="mx-auto max-w-7xl px-6 py-16">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
            <!-- Brand -->
            <div class="col-span-2 md:col-span-1">
                <a href="/" class="inline-flex items-center">
                    <img src="/LOGO.png" alt="KYDE" class="h-6 w-auto" />
                </a>
                <p class="mt-3 text-sm text-[#0d0e10]/60 leading-relaxed">
                    The Zero-Trust AI Stack for the Agentic Economy.
                </p>
            </div>

            <!-- Link groups -->
            {
                Object.entries(footerLinks).map(([group, links]) => (
                    <div>
                        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-[#0d0e10]/50 mb-4">
                            {group}
                        </p>
                        <ul class="space-y-3">
                            {links.map(({ label, href }) => (
                                <li>
                                    <a
                                        href={href}
                                        class="text-sm text-[#0d0e10]/60 hover:text-[#0d0e10] transition-colors"
                                    >
                                        {label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <!-- Bottom bar -->
        <div
            class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-dotted border-[#0d0e10]/15 pt-8 md:flex-row md:items-center"
        >
            <p class="font-mono text-xs text-[#0d0e10]/40">
                &copy; {year} KYDE. All rights reserved.
            </p>
            <p class="font-mono text-xs text-[#0d0e10]/40">
                Built with Astro &amp; Tailwind CSS
            </p>
        </div>
    </div>
</footer>
